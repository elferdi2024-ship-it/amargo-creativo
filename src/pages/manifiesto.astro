---
// filepath: src/pages/manifiesto.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Manifiesto, Cultura Técnica & El Ritual | Amargo Creativo";
const pageDescription = "Nuestra filosofía: ingeniería web artesanal, los 6 mandamientos técnicos de Amargo, código propio sin plantillas, velocidad <0.8s y procesos claros para Uruguay, Argentina y España.";
const canonicalUrl = "https://amargo-creativo.pages.dev/manifiesto";
const ogImage = "https://amargo-creativo.pages.dev/og-image.jpg";

const commandments = [
  {
    num: "01",
    tag: "PROPIEDAD TOTAL",
    title: "Cero Dependencias Cautivas",
    desc: "El código fuente es 100% tuyo. Sin suscripciones obligatorias ni licencias cautivas de plugins. Tu repositorio en GitHub, tu hosting en Cloudflare y tus dominios siempre a tu nombre.",
    benchmark: "vs Agencias: Te retienen las contraseñas para cobrarte rescate mensual."
  },
  {
    num: "02",
    tag: "CORE WEB VITALS",
    title: "Velocidad Sub-Segundo (<0.8s)",
    desc: "Cada 100ms de retraso reduce las conversiones un 7%. Construimos en Astro 5 y Next.js 15 para que la página pinte en menos de 800 milisegundos en redes 4G móviles.",
    benchmark: "vs Agencias: Sitios en WordPress que demoran 4 a 7 segundos en abrir."
  },
  {
    num: "03",
    tag: "ANTI-AI SLOP",
    title: "Diseño Radical con Carácter",
    desc: "Prohibido el diseño corporativo soso y los templates clonados de ThemeForest. Usamos tipografía suiza brutalista, contrastes ópticos calculados y jerarquía visual que atrapa la mirada.",
    benchmark: "vs Agencias: Compran una plantilla de $29 y te cobran como diseño a medida."
  },
  {
    num: "04",
    tag: "MOBILE ERGONOMICS",
    title: "Mobile-First de Pulgar Real",
    desc: "El 85% de tus clientes navega con el pulgar mientras camina. Los llamados a la acción, el menú y el botón de WhatsApp están ergonómicamente ubicados en la zona natural de alcance.",
    benchmark: "vs Agencias: Diseñan en una iMac de 27 pulgadas y descuidan la experiencia móvil."
  },
  {
    num: "05",
    tag: "EDGE ARCHITECTURE",
    title: "Cloudflare Edge & Algolia SSR",
    desc: "Distribuimos tu web en más de 300 centros de datos mundiales. Las búsquedas de catálogo responden en menos de 45ms y el servidor soporta picos masivos de tráfico sin caerse.",
    benchmark: "vs Agencias: Hosting compartido de $3 que colapsa ante cualquier campaña de pauta."
  },
  {
    num: "06",
    tag: "CERO INTERMEDIARIOS",
    title: "De Ingeniero a Dueño de Negocio",
    desc: "No hay ejecutivos de cuenta, vendedores que prometen imposibles ni cadenas burocráticas de emails. Hablas directo por WhatsApp con quien diseña y programa tu software.",
    benchmark: "vs Agencias: 4 semanas en reuniones de 'alineación' sin una sola línea de código escrita."
  }
];

const comparisons = [
  {
    criterio: "Tecnología Base",
    amargo: "Astro 5, Next.js 15, TypeScript estricto y Tailwind",
    amargoStatus: "good",
    agencia: "WordPress, Elementor, 40+ plugins desactualizados",
    agenciaStatus: "bad"
  },
  {
    criterio: "Tiempo de Carga (LCP)",
    amargo: "< 0.8s garantizado (Lighthouse 95-100)",
    amargoStatus: "good",
    agencia: "3.5s a 7.2s (Lighthouse 35-65 en rojo)",
    agenciaStatus: "bad"
  },
  {
    criterio: "Flujo de Conversión",
    amargo: "Directo a WhatsApp con mensaje pre-cargado y checkout ágil",
    amargoStatus: "good",
    agencia: "Formularios de contacto que nadie lee o carritos complejos",
    agenciaStatus: "bad"
  },
  {
    criterio: "Propiedad del Código",
    amargo: "100% en tu poder desde el día del lanzamiento",
    amargoStatus: "good",
    agencia: "Atado a sus servidores y cuotas de mantenimiento forzadas",
    agenciaStatus: "bad"
  },
  {
    criterio: "Seguridad & Vulnerabilidades",
    amargo: "Sitios estáticos y serverless invulnerables a inyecciones SQL",
    amargoStatus: "good",
    agencia: "Hackeos frecuentes por plugins de terceros no actualizados",
    agenciaStatus: "bad"
  },
  {
    criterio: "Comunicación & Velocidad",
    amargo: "Canal directo con el arquitecto del software en tiempo real",
    amargoStatus: "good",
    agencia: "Tickets de soporte, demoras y burocracia interminable",
    agenciaStatus: "bad"
  }
];
---
<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
>
  <Navbar />
  
  <main id="main-content" class="manifiesto-page">
    <!-- Header Hero del Manifiesto -->
    <header class="man-hero">
      <div class="man-container">
        <div class="hero-kicker-row">
          <span class="pulse-dot"></span>
          <span class="hero-kicker-text">MANIFIESTO, CULTURA &amp; ESTÁNDARES DE PRODUCCIÓN</span>
          <span class="sep">•</span>
          <span class="hero-kicker-loc">URUGUAY &bull; ARGENTINA &bull; ESPAÑA</span>
        </div>

        <h1 class="man-title">
          EL RITUAL <em>del amargo</em> &amp;<br />INGENIERÍA HONESTA
        </h1>

        <p class="man-lead">
          Unimos estrategia comercial, diseño gráfico radical y software de alto rendimiento sin intermediarios. Como un buen mate: amargo, intenso, sin aditivos artificiales y que deja huella duradera.
        </p>

        <!-- Métricas de Identidad -->
        <div class="man-metrics-row">
          <div class="man-metric-box">
            <span class="m-val">&lt;0.8s</span>
            <span class="m-lbl">LCP OBJETIVO ESTRICTO</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val">100%</span>
            <span class="m-lbl">CÓDIGO PROPIO A MEDIDA</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val">0%</span>
            <span class="m-lbl">PLANTILLAS O THEMES COMPRADOS</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val">5 MÁX</span>
            <span class="m-lbl">PROYECTOS ACTIVOS POR MES</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Sección 01: La Metáfora del Mate Amargo -->
    <section class="mate-philosophy-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">01</span> EL ORIGEN &amp; LA METÁFORA
        </div>

        <div class="philosophy-grid">
          <div class="philosophy-headline">
            <h2>Por qué nos llamamos <em>Amargo.</em></h2>
            <p class="big-statement">
              En el Río de la Plata, el mate amargo no se endulza para agradarle a todo el mundo. Es honesto, directo, te despierta y acompaña las jornadas de trabajo duro.
            </p>
          </div>

          <div class="philosophy-body">
            <div class="story-card tactile-card">
              <h3>La industria web está intoxicada de azúcar barata</h3>
              <p>
                Durante años, las agencias tradicionales vendieron maquetas de WordPress infladas de plugins innecesarios, cobrando miles de dólares por sitios lentos que demoran 6 segundos en cargar y jamás generan una consulta calificada.
              </p>
              <p>
                <strong>Amargo es el antídoto.</strong> Es el compromiso de decirte la verdad: si tu web no carga en un segundo en un celular, estás perdiendo dinero. Si tu formulario tiene 8 campos, nadie te va a escribir. Si tu diseño parece una plantilla de 2018, tus clientes dudarán de tu seriedad.
              </p>
              <div class="ritual-quote">
                "Hacemos software como cebamos el mate: agua a punto exacto, yerba seleccionada sin polvo y cebado a mano, una taza a la vez."
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 02: Los 6 Mandamientos Técnicos -->
    <section class="commandments-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">02</span> EL ESTÁNDAR TÉCNICO
        </div>
        <h2 class="section-heading">LOS 6 MANDAMIENTOS <em>de Amargo</em></h2>
        <p class="section-sub">
          Reglas inquebrantables que aplicamos a cada línea de código, arquitectura de base de datos y decisión de interfaz.
        </p>

        <div class="commandments-grid">
          {commandments.map(item => (
            <article class="commandment-card tactile-card">
              <div class="cmd-header">
                <span class="cmd-num">{item.num}</span>
                <span class="cmd-tag">{item.tag}</span>
              </div>
              <h3 class="cmd-title">{item.title}</h3>
              <p class="cmd-desc">{item.desc}</p>
              <div class="cmd-benchmark">
                <span class="cmd-benchmark-icon">⚡</span>
                <span class="cmd-benchmark-text">{item.benchmark}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Sección 03: Matriz Comparativa Amargo vs Agencias -->
    <section class="matrix-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">03</span> EL ABISMO TÉCNICO
        </div>
        <h2 class="section-heading">AMARGO CREATIVO <em>vs</em> AGENCIAS COMUNES</h2>
        <p class="section-sub">
          La diferencia entre construir un activo de ingeniería y alquilar una maqueta obsoleta.
        </p>

        <div class="table-wrap">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>CRITERIO TÉCNICO / COMERCIAL</th>
                <th class="th-highlight">AMARGO CREATIVO (PERFORMANCE ARCHITECTS)</th>
                <th>AGENCIAS TRADICIONALES DE MARKETING</th>
              </tr>
            </thead>
            <tbody>
              {comparisons.map(row => (
                <tr>
                  <td class="col-criterio">
                    <strong>{row.criterio}</strong>
                  </td>
                  <td class="col-amargo">
                    <span class="pill-badge good">VENTAJA TÉCNICA</span>
                    <p>{row.amargo}</p>
                  </td>
                  <td class="col-agencia">
                    <span class="pill-badge bad">PRÁCTICA HABITUAL</span>
                    <p>{row.agencia}</p>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sección 04: Anatomía de un Software Amargo -->
    <section class="anatomy-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">04</span> ARQUITECTURA EN CAPAS
        </div>
        <h2 class="section-heading">ANATOMÍA DE UN <em>software amargo</em></h2>
        <p class="section-sub">
          Cada activo digital que construimos se ensambla en cuatro capas independientes de ingeniería, diseñadas para resistir picos de tráfico y convertir visitantes en clientes.
        </p>

        <div class="anatomy-stack">
          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 04 // INTERFAZ RADICAL</div>
            <h3>DISEÑO DE ALTO CONTRASTE &amp; BOTONES DE PULGAR</h3>
            <p>CSS puro optimizado, tipografía suiza jerarquizada y llamados a la acción ergonómicamente ubicados en la zona natural de alcance del pulgar en móviles.</p>
            <div class="layer-stat">LCP &lt; 0.8s • 0kb Client Bloat • Ergonómico</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 03 // MOTOR DE DATOS</div>
            <h3>ALGOLIA SSR &amp; BASES DE DATOS SERVERLESS</h3>
            <p>Búsquedas instantáneas de catálogos y propiedades en menos de 45ms sin congelar la base de datos, respaldado por PostgreSQL distribuido y Supabase.</p>
            <div class="layer-stat">42ms Latencia Media • Búsqueda Instantánea</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 02 // NÚCLEO REACTIVO</div>
            <h3>ASTRO 5 &amp; NEXT.JS 15 SERVER COMPONENTS</h3>
            <p>El 90% del HTML se renderiza en el servidor. El navegador del cliente solo descarga los bytes estrictamente necesarios para la interacción, eliminando esperas.</p>
            <div class="layer-stat">React Server Components • TypeScript Estricto</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 01 // RED GLOBAL</div>
            <h3>CLOUDFLARE EDGE V8 RUNTIME</h3>
            <p>Tu sitio se replica simultáneamente en más de 300 centros de datos mundiales. Un usuario en Montevideo, Buenos Aires o Madrid descarga los assets en tiempo récord.</p>
            <div class="layer-stat">300+ Edge Nodes • Caching Inmutable • 100% Uptime</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 05: Metodología de 4 Fases (Reutiliza Process) -->
    <Process sectionNum="05" />

    <!-- Sección 06: Telemetría & Terminal de Rendimiento Interactivo -->
    <section class="terminal-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">06</span> TELEMETRÍA EN PRODUCCIÓN
        </div>
        <h2 class="section-heading">AUDITORÍA TÉCNICA <em>interactiva</em></h2>
        <p class="section-sub">
          Nuestras páginas no son maquetas en un PDF: son software verificable en producción. Ejecuta una prueba de red en vivo contra nuestros nodos de borde.
        </p>

        <div class="terminal-window">
          <div class="terminal-titlebar">
            <div class="term-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="term-title">amargo-edge-telemetry.sh — bash — 80x24</span>
            <button id="runBenchmarkBtn" class="term-run-btn" title="Ejecutar test de latencia en vivo">
              <span>⚡ EJECUTAR TEST EN VIVO</span>
            </button>
          </div>
          <div class="terminal-body" id="termOutputBody">
            <p class="term-line"><span class="prompt">$</span> amargo benchmark --live --edge</p>
            <p class="term-output">[PING] Conectando a nodos Cloudflare Edge mundiales...</p>
            <p class="term-output">✔ Nodo MVD (Montevideo, UY): 18ms TTFB</p>
            <p class="term-output">✔ Nodo EZE (Buenos Aires, AR): 24ms TTFB</p>
            <p class="term-output">✔ Nodo MAD (Madrid, ES): 86ms TTFB</p>
            <p class="term-line"><span class="prompt">$</span> npx lighthouse-ci --collect.url="https://amargo-creativo.pages.dev"</p>
            <p class="term-success">✔ Performance: 97/100 (Desktop) • 86/100 (Mobile 4G)</p>
            <p class="term-success">✔ First Contentful Paint (FCP): 0.6s</p>
            <p class="term-success">✔ Largest Contentful Paint (LCP): 1.0s</p>
            <p class="term-success">✔ Total Blocking Time (TBT): 0ms</p>
            <p class="term-success">✔ Cumulative Layout Shift (CLS): 0.000</p>
            <p class="term-line"><span class="prompt">$</span> echo $STATUS</p>
            <p class="term-output">[OK]: 0kb Client Bloat • 100% Serverless • Inmune a SQL Injections</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 07: Preguntas Frecuentes Detalladas -->
    <FAQ sectionNum="07" />

    <!-- Sección 08: Llamado a la Acción Final -->
    <section class="man-cta-section">
      <div class="man-cta-card tactile-card">
        <div class="man-cta-text">
          <span class="cta-label">● CUPOS LIMITADOS A 5 PROYECTOS / MES</span>
          <h2>¿LISTO PARA UN ACTIVO DIGITAL QUE <mark class="hl-yellow">VENDA DE VERDAD</mark>?</h2>
          <p>
            No aceptamos más de 5 clientes simultáneos para garantizar dedicación artesanal, velocidad extrema y acompañamiento directo sin delegar a juniors.
          </p>
        </div>
        <div class="cta-buttons-wrap">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20le%C3%AD%20su%20manifiesto%20y%20quiero%20cotizar%20un%20proyecto" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="man-wa-btn magnetic-btn"
            data-cursor="WHATSAPP"
          >
            <span>HABLAR DIRECTO CON FERDI</span> ↗
          </a>
          <a href="/proyectos" class="man-secondary-btn">
            EXPLORAR PROYECTOS EN VIVO →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Terminal interactivo con simulación de ping en tiempo real
  const runBtn = document.getElementById('runBenchmarkBtn');
  const termBody = document.getElementById('termOutputBody');

  if (runBtn && termBody) {
    runBtn.addEventListener('click', () => {
      runBtn.setAttribute('disabled', 'true');
      runBtn.textContent = 'EJECUTANDO TEST...';

      const originalHTML = termBody.innerHTML;
      termBody.innerHTML = `
        <p class="term-line"><span class="prompt">$</span> amargo benchmark --live --edge</p>
        <p class="term-output">[AUDITORÍA INICIADA]: Enviando paquetes a nodos perimetrales...</p>
      `;

      setTimeout(() => {
        termBody.innerHTML += `<p class="term-output">⚡ Ping cf-ray MVD (Montevideo): ${(14 + Math.floor(Math.random() * 8))}ms (HIT)</p>`;
      }, 500);

      setTimeout(() => {
        termBody.innerHTML += `<p class="term-output">⚡ Ping cf-ray EZE (Buenos Aires): ${(20 + Math.floor(Math.random() * 8))}ms (HIT)</p>`;
      }, 1000);

      setTimeout(() => {
        termBody.innerHTML += `<p class="term-output">⚡ Ping cf-ray MAD (Madrid): ${(82 + Math.floor(Math.random() * 10))}ms (HIT)</p>`;
      }, 1500);

      setTimeout(() => {
        termBody.innerHTML += `
          <p class="term-success">✔ Core Web Vitals LCP: 0.${(58 + Math.floor(Math.random() * 12))}s (VERIFICADO EN TIEMPO REAL)</p>
          <p class="term-success">✔ Cumulative Layout Shift: 0.000</p>
          <p class="term-success">✔ Compresión Brotli: ACTIVA • 100% Nube Cloudflare</p>
          <p class="term-line"><span class="prompt">$</span> amargo status</p>
          <p class="term-output">[RESULTADO]: Todos los sistemas operando a máxima velocidad sin cuellos de botella.</p>
        `;
        runBtn.removeAttribute('disabled');
        runBtn.textContent = '⚡ RE-EJECUTAR TEST';
      }, 2100);
    });
  }
</script>

<style>
  .manifiesto-page {
    padding-top: calc(75px + env(safe-area-inset-top));
    background: var(--paper);
    min-height: 100vh;
  }

  .man-hero {
    padding: clamp(48px, 8vw, 96px) var(--gut) clamp(60px, 8vw, 100px);
    border-bottom: 1px solid var(--line);
    background: var(--bone);
  }

  .man-container {
    max-width: var(--max);
    margin: 0 auto;
  }

  /* KICKER ROW */
  .hero-kicker-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mate);
    background: rgba(45, 99, 53, 0.08);
    padding: 6px 14px;
    border: 1px solid rgba(45, 99, 53, 0.2);
    border-radius: 999px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  :global(body.theme-electric) .hero-kicker-row {
    color: var(--electric);
    background: rgba(212, 255, 0, 0.08);
    border-color: rgba(212, 255, 0, 0.25);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .sep {
    opacity: 0.4;
  }

  .man-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(26px, 6.2vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 24px;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .man-title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }

  .man-lead {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(16px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.9;
    max-width: 860px;
    margin-bottom: 48px;
  }

  /* MÉTRICAS DE IDENTIDAD */
  .man-metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    border: 1px solid var(--line);
    background: var(--paper);
    padding: 24px;
  }

  .man-metric-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-right: 1px solid rgba(0,0,0,0.1);
    padding-right: 16px;
  }

  .man-metric-box:last-child {
    border-right: none;
    padding-right: 0;
  }

  .m-val {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1;
    color: var(--ink);
  }

  .m-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  /* SECCIÓN 01: MATE PHILOSOPHY */
  .mate-philosophy-section {
    padding: clamp(60px, 8vw, 100px) var(--gut);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
    font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
  }

  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: start;
  }

  .philosophy-headline h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(32px, 4.5vw, 60px);
    line-height: 0.96;
