---
// filepath: src/pages/manifiesto.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import RollText from '../components/motion/RollText.astro';

const pageTitle = "Manifiesto: Apps, IA y Software de Autor | Amargo Creativo";
const pageDescription = "Cómo pensamos y construimos productos digitales: 6 mandamientos de ingeniería, apps a medida, IA aplicada, propiedad total del código y cero plantillas.";
const canonicalUrl = "https://amargo-creativo.pages.dev/manifiesto/";
const ogImage = "https://amargo-creativo.pages.dev/og-image-v3.jpg";

const commandments = [
  {
    num: "01",
    tag: "PROPIEDAD TOTAL",
    title: "Cero Dependencias Cautivas",
    desc: "El código fuente es 100% tuyo. Sin suscripciones obligatorias ni licencias por usuario o comisiones por pedido. Tu repositorio en GitHub, tu infraestructura en Cloudflare y tus dominios siempre a tu nombre.",
    benchmark: "vs Agencias: Te retienen los accesos o te atan a plataformas que cobran rescate mensual."
  },
  {
    num: "02",
    tag: "PRODUCTO OPERATIVO",
    title: "Software Real, No Folletos",
    desc: "Construimos aplicaciones que resuelven operación diaria: escáner y búsqueda con IA documental, mapas ciudadanos en vivo, delivery hiperlocal y tiendas directas conectadas a pagos locales.",
    benchmark: "vs Agencias: Te venden una web estática que nadie usa ni conecta con tu negocio."
  },
  {
    num: "03",
    tag: "ANTI-AI SLOP",
    title: "Diseño Editorial con Carácter",
    desc: "Prohibido el diseño corporativo genérico y los templates clonados. Aplicamos sistemas tipográficos propios, jerarquía visual real y micro-interacciones pensadas para diferenciar tu marca.",
    benchmark: "vs Agencias: Compran una plantilla genérica y te la cobran como diseño a medida."
  },
  {
    num: "04",
    tag: "ERGONOMÍA MÓVIL",
    title: "Mobile-First de Pulgar Real",
    desc: "Más del 85% de tus usuarios entra desde el teléfono. Cada app PWA, catálogo o portal se diseña primero para uso con una sola mano, gestos fluidos y acción directa a WhatsApp.",
    benchmark: "vs Agencias: Diseñan en monitores gigantes y dejan el celular roto o incómodo."
  },
  {
    num: "05",
    tag: "ARQUITECTURA EDGE",
    title: "Ingeniería Lista para Escalar",
    desc: "Desplegamos sobre Next.js 15, Astro 5, PostgreSQL/Supabase y Cloudflare Edge en más de 300 nodos globales. Core Web Vitals en verde y estabilidad real ante picos de tráfico.",
    benchmark: "vs Agencias: Hosting compartido barato que colapsa en tu primera campaña fuerte."
  },
  {
    num: "06",
    tag: "CERO INTERMEDIARIOS",
    title: "De Ingeniero a Dueño de Negocio",
    desc: "No hay ejecutivos de cuenta, vendedores que prometen imposibles ni cadenas de correos. Hablás directo por WhatsApp con quien diseña y programa tu producto.",
    benchmark: "vs Agencias: Semanas en reuniones de 'alineación' sin una sola pantalla real."
  }
];

const comparisons = [
  {
    criterio: "Qué Construimos",
    amargo: "Apps PWA, plataformas con IA/OCR, portales B2B y comercio propio a medida",
    agencia: "Sitios WordPress con Elementor y 40+ plugins repetidos"
  },
  {
    criterio: "Comisiones & Costos",
    amargo: "0% comisiones por pedido y sin cobros por asiento o licencia cautiva",
    agencia: "Cuotas mensuales perpetuas o hasta 30% de comisión en apps de terceros"
  },
  {
    criterio: "Conversión & Pagos",
    amargo: "Flujos directos a WhatsApp, BROU, Mercado Pago, Stripe y CFE DGI",
    agencia: "Formularios que nadie lee o carritos genéricos con alta fuga"
  },
  {
    criterio: "Propiedad del Código",
    amargo: "100% en tu poder desde el lanzamiento (GitHub + Cloudflare + Dominio)",
    agencia: "Código retenido en servidores privados de la agencia"
  },
  {
    criterio: "Rendimiento & Seguridad",
    amargo: "Edge Computing, RLS en PostgreSQL y Core Web Vitals en verde",
    agencia: "Sitios lentos y vulnerables a hackeos por plugins desactualizados"
  },
  {
    criterio: "Comunicación Directa",
    amargo: "Canal abierto en tiempo real con el arquitecto que escribe tu código",
    agencia: "Tickets de soporte, intermediarios y demoras burocráticas"
  }
];
---
<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
  includeFaqSchema={true}
  breadcrumbs={[
    { name: 'Inicio', url: 'https://amargo-creativo.pages.dev/' },
    { name: 'Manifiesto', url: canonicalUrl }
  ]}
>
  <Navbar />
  
  <main id="main-content" class="manifiesto-page">
    <!-- Header Hero del Manifiesto -->
    <header class="man-hero">
      <div class="man-container">
        <div class="hero-kicker-row">
          <span class="num">ESTÁNDAR</span>
          <span class="hero-kicker-text">MANIFIESTO, PRODUCT STUDIO &amp; CULTURA DE INGENIERÍA</span>
          <span class="sep">//</span>
          <span class="hero-kicker-loc">UY &bull; AR &bull; ES</span>
        </div>

        <h1 class="man-title" data-reveal-words>
          EL RITUAL <em>del amargo</em> &amp;<br />PRODUCTO DE AUTOR
        </h1>

        <p class="man-lead">
          Unimos diseño de producto, inteligencia artificial y desarrollo de software a medida sin intermediarios. Como un buen mate: amargo, artesanal, sin aditivos y pensado para resolver problemas reales.
        </p>

        <!-- Métricas de Identidad -->
        <div class="man-metrics-row">
          <div class="man-metric-box">
            <span class="m-val tabular">11+</span>
            <span class="m-lbl">PRODUCTOS EN PRODUCCIÓN</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val tabular">100%</span>
            <span class="m-lbl">CÓDIGO PROPIO A MEDIDA</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val tabular">0%</span>
            <span class="m-lbl">PLANTILLAS O COMISIONES</span>
          </div>
          <div class="man-metric-box">
            <span class="m-val">5 MÁX</span>
            <span class="m-lbl">PROYECTOS ACTIVOS POR MES</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Sección 01: La Metáfora del Mate Amargo -->
    <section class="mate-philosophy-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">01</span> EL ORIGEN &amp; LA METÁFORA
        </div>

        <div class="philosophy-grid">
          <div class="philosophy-headline">
            <h2 data-reveal-words>Por qué nos llamamos <em>Amargo.</em></h2>
            <p class="big-statement">
              En el Río de la Plata, el mate amargo no se endulza para agradarle a todo el mundo. Es honesto, directo, te despierta y acompaña las jornadas de trabajo real.
            </p>
          </div>

          <div class="philosophy-body">
            <div class="story-card tactile-card">
              <h3>La industria digital está llena de humo y plantillas</h3>
              <p>
                Durante años, las agencias tradicionales vendieron maquetas recicladas llenas de plugins o te empujaron a depender de plataformas que se quedan con el 30% de tu margen y nunca te dejan ser dueño de tu producto.
              </p>
              <p>
                <strong>Amargo es el antídoto.</strong> Diseñamos y programamos software que opera negocios de verdad: desde apps de delivery hiperlocal y buscadores con IA documental hasta portales ciudadanos y comercio propio sin intermediarios.
              </p>
              <div class="ritual-quote">
                "Construimos productos digitales como cebamos el mate: temperatura justa, criterio artesanal y cero relleno innecesario."
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 02: Los 6 Mandamientos Técnicos -->
    <section class="commandments-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">02</span> EL ESTÁNDAR DEL ESTUDIO
        </div>
        <h2 class="section-heading" data-reveal-words>LOS 6 MANDAMIENTOS <em>de Amargo</em></h2>
        <p class="section-sub">
          Reglas inquebrantables que aplicamos a cada app, arquitectura de datos y decisión de interfaz.
        </p>

        <div class="commandments-grid">
          {commandments.map(item => (
            <article class="commandment-card tactile-card">
              <div class="cmd-header">
                <span class="cmd-num tabular">{item.num}</span>
                <span class="cmd-tag">{item.tag}</span>
              </div>
              <h3 class="cmd-title">{item.title}</h3>
              <p class="cmd-desc">{item.desc}</p>
              <div class="cmd-benchmark">
                <span class="cmd-benchmark-icon" aria-hidden="true">⚡</span>
                <span class="cmd-benchmark-text">{item.benchmark}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Sección 03: Matriz Comparativa Amargo vs Agencias -->
    <section class="matrix-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">03</span> EL ABISMO TÉCNICO
        </div>
        <h2 class="section-heading" data-reveal-words>PRODUCT STUDIO <em>vs</em> AGENCIAS COMUNES</h2>
        <p class="section-sub">
          La diferencia entre construir un activo propio que escala y alquilar una maqueta obsoleta.
        </p>

        <div class="table-wrap">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>CRITERIO</th>
                <th class="th-highlight">AMARGO CREATIVO (PRODUCT STUDIO)</th>
                <th>AGENCIAS TRADICIONALES</th>
              </tr>
            </thead>
            <tbody>
              {comparisons.map(row => (
                <tr>
                  <td class="col-criterio">
                    <strong>{row.criterio}</strong>
                  </td>
                  <td class="col-amargo">
                    <span class="pill-badge good">VENTAJA REAL</span>
                    <p>{row.amargo}</p>
                  </td>
                  <td class="col-agencia">
                    <span class="pill-badge bad">PRÁCTICA HABITUAL</span>
                    <p>{row.agencia}</p>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sección 04: Anatomía de un Producto Amargo -->
    <section class="anatomy-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">04</span> ARQUITECTURA EN CAPAS
        </div>
        <h2 class="section-heading" data-reveal-words>ANATOMÍA DE UN <em>producto amargo</em></h2>
        <p class="section-sub">
          Cada app o plataforma que construimos se ensambla en cuatro capas independientes, pensadas para operar sin fricción y crecer sin reescribir desde cero.
        </p>

        <div class="anatomy-stack">
          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 04 // EXPERIENCIA &amp; PWA</div>
            <h3>DISEÑO DE AUTOR &amp; ERGONOMÍA DE PULGAR</h3>
            <p>Interfaces instalables en móvil y escritorio, micro-interacciones a 60fps en compositor GPU y flujos pensados para completar tareas o pedidos en segundos.</p>
            <div class="layer-stat">PWA Instalable • Gestos Táctiles • Core Web Vitals Verdes</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 03 // IA &amp; MOTOR DE DATOS</div>
            <h3>BÚSQUEDA SEMÁNTICA, OCR &amp; POSTGRESQL RLS</h3>
            <p>Indexación inteligente de documentos, mapas en vivo y bases relacionales con aislamiento Row-Level Security sobre PostgreSQL y Supabase.</p>
            <div class="layer-stat">IA Documental &amp; OCR • Datos Aislados RLS • Tiempo Real</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 02 // NÚCLEO DE APLICACIÓN</div>
            <h3>NEXT.JS 15, REACT 19 &amp; ASTRO 5</h3>
            <p>Renderizado híbrido con Server Components y TypeScript estricto. Solo se descarga el código mínimo necesario para cada interacción.</p>
            <div class="layer-stat">TypeScript Estricto • Server Actions • Cero Bloat</div>
          </div>

          <div class="layer-card tactile-card">
            <div class="layer-badge">CAPA 01 // RED GLOBAL &amp; PAGOS</div>
            <h3>CLOUDFLARE EDGE + INTEGRACIONES LOCALES</h3>
            <p>Distribución global en 300+ nodos Edge conectada con WhatsApp Cloud API, BROU, Mercado Pago, Stripe y facturación electrónica CFE DGI.</p>
            <div class="layer-stat">300+ Edge Nodes • Pagos UY / AR / ES • 100% Propio</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 05: Metodología de 4 Fases -->
    <Process sectionNum="05" />

    <!-- Sección 06: Telemetría & Terminal Interactivo -->
    <section class="terminal-section">
      <div class="man-container">
        <div class="section-label">
          <span class="num">06</span> TELEMETRÍA EN VIVO
        </div>
        <h2 class="section-heading" data-reveal-words>VERIFICACIÓN <em>en tu navegador</em></h2>
        <p class="section-sub">
          No vendemos promesas en un PDF: ejecutá una medición real de red desde tu conexión actual contra el nodo Edge más cercano.
        </p>

        <div class="terminal-window">
          <div class="terminal-titlebar">
            <div class="term-dots" aria-hidden="true">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="term-title">amargo-edge-telemetry.sh — live</span>
            <button type="button" id="runBenchmarkBtn" class="term-run-btn" title="Ejecutar test de latencia real">
              <span>⚡ MEDIR EN VIVO</span>
            </button>
          </div>
          <div class="terminal-body" id="termOutputBody">
            <p class="term-line"><span class="prompt">$</span> amargo inspect --stack --edge</p>
            <p class="term-output">[RUNTIME] Astro 5 + Cloudflare Edge Network (300+ nodos globales)</p>
            <p class="term-output">✔ Módulos activos: Apps PWA, IA Documental, CivicTech, Comercio Propio</p>
            <p class="term-output">✔ Integraciones nativas: WhatsApp API, BROU, Mercado Pago, DGI CFE</p>
            <p class="term-line"><span class="prompt">$</span> echo $OWNERSHIP</p>
            <p class="term-success">✔ 100% Código propio • 0% Comisiones intermediarias • Cero plantillas</p>
            <p class="term-output">→ Tocá "MEDIR EN VIVO" para ejecutar un test real de Navigation Timing desde tu dispositivo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección 07: Preguntas Frecuentes -->
    <FAQ sectionNum="07" />

    <!-- Sección 08: Llamado a la Acción Final -->
    <section class="man-cta-section">
      <div class="man-cta-card tactile-card">
        <div class="man-cta-text">
          <span class="cta-label">● MÁXIMO 5 PROYECTOS ACTIVOS / MES</span>
          <h2>¿LISTO PARA CONSTRUIR UN <mark class="hl-yellow">PRODUCTO PROPIO</mark>?</h2>
          <p>
            Trabajamos con cupo limitado para dedicar diseño artesanal, ingeniería senior y acompañamiento directo sin delegar a terceros.
          </p>
        </div>
        <div class="cta-buttons-wrap">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20le%C3%AD%20su%20manifiesto%20y%20quiero%20cotizar%20un%20proyecto" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="man-wa-btn ink-fill magnetic-btn"
            data-cursor="WHATSAPP"
          >
            <span class="ink" aria-hidden="true"></span>
            <RollText text="HABLAR CON FERDI" arrow="diag" />
          </a>
          <a href="/proyectos" class="man-secondary-btn ink-fill">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="VER PROYECTOS EN VIVO" arrow="right" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const runBtn = document.getElementById('runBenchmarkBtn') as HTMLButtonElement | null;
  const termBody = document.getElementById('termOutputBody');

  if (runBtn && termBody) {
    runBtn.addEventListener('click', async () => {
      if ('vibrate' in navigator) {
        try { navigator.vibrate(8); } catch {}
      }
      runBtn.disabled = true;
      runBtn.textContent = 'MIDIENDO...';

      termBody.innerHTML = `
        <p class="term-line"><span class="prompt">$</span> amargo telemetry --live --origin</p>
        <p class="term-output">[AUDITORÍA REAL]: Midiendo latencia directa desde tu conexión al nodo Edge...</p>
      `;

      const t0 = performance.now();
      let liveMs = 0;
      let statusLabel = '200 OK';
      try {
        const res = await fetch(window.location.pathname, { method: 'HEAD', cache: 'no-store' });
        liveMs = Math.max(1, Math.round(performance.now() - t0));
        statusLabel = `${res.status} ${res.statusText || 'OK'}`;
      } catch {
        liveMs = Math.max(1, Math.round(performance.now() - t0));
        statusLabel = 'EDGE CACHE';
      }

      const navEntry = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const ttfb = navEntry ? Math.max(1, Math.round(navEntry.responseStart - navEntry.requestStart)) : liveMs;
      const dcl = navEntry ? Math.max(1, Math.round(navEntry.domContentLoadedEventEnd - navEntry.startTime)) : liveMs;
      const transferKb = navEntry && navEntry.transferSize > 0 ? `${(navEntry.transferSize / 1024).toFixed(1)} KB` : 'Brotli Edge';

      termBody.innerHTML += `<p class="term-output">⚡ Round-Trip real (HEAD ${window.location.pathname}): <strong>${liveMs}ms</strong> (${statusLabel})</p>`;
      termBody.innerHTML += `<p class="term-output">⚡ TTFB de esta sesión: <strong>${ttfb}ms</strong> • DOM listo en <strong>${dcl}ms</strong></p>`;
      termBody.innerHTML += `<p class="term-output">⚡ Transferencia del documento: <strong>${transferKb}</strong></p>`;
      termBody.innerHTML += `
        <p class="term-success">✔ Medición verificada con Navigation Timing API en tu navegador.</p>
        <p class="term-success">✔ Infraestructura: Astro 5 + Cloudflare Edge Runtime</p>
        <p class="term-line"><span class="prompt">$</span> echo $VERDICT</p>
        <p class="term-output">[OK]: Software limpio • 100% propiedad del cliente.</p>
      `;

      runBtn.disabled = false;
      runBtn.textContent = '⚡ MEDIR DE NUEVO';
    });
  }
</script>

<style>
  .manifiesto-page {
    padding-top: calc(75px + env(safe-area-inset-top));
    background: var(--paper);
    min-height: 100vh;
  }

  .man-hero {
    padding: clamp(40px, 7vw, 92px) var(--gut) clamp(48px, 7vw, 88px);
    border-bottom: 1px solid var(--line);
    background: var(--bone);
  }

  .man-container {
    max-width: var(--max);
    margin: 0 auto;
  }

  .hero-kicker-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    margin-bottom: 20px;
    flex-wrap: wrap;
    line-height: 1.4;
  }

  .hero-kicker-row .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  :global(body.theme-electric) .hero-kicker-row .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .hero-kicker-text {
    color: var(--ink);
    font-weight: 700;
  }

  .sep {
    opacity: 0.35;
  }

  .man-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 6vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 22px;
    overflow-wrap: break-word;
  }

  .man-title em {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }

  .man-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink);
    opacity: 0.9;
    max-width: 72ch;
    margin-bottom: 36px;
  }

  .man-metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    padding: 22px 24px;
  }

  .man-metric-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-right: 1px solid var(--line);
    padding-right: 16px;
  }

  .man-metric-box:last-child {
    border-right: none;
    padding-right: 0;
  }

  .m-val {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1;
    color: var(--ink);
  }

  .m-lbl {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  /* SECCIÓN 01: MATE PHILOSOPHY */
  .mate-philosophy-section {
    padding: clamp(48px, 7vw, 96px) var(--gut);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 22px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
    border-radius: 3px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }

  .philosophy-headline h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4.3vw, 56px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 18px;
  }

