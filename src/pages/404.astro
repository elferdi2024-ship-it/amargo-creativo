---
// filepath: src/pages/404.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RollText from '../components/motion/RollText.astro';
import { whatsappHref } from '../lib/format';

const waUrl = whatsappHref('Hola Amargo Creativo, intenté abrir un enlace y me salió 404.');
---
<Layout
  title="404 — Ruta no encontrada | Amargo Creativo™"
  description="La página solicitada no existe o fue movida. Volvé al inicio o hablá directo por WhatsApp con Amargo Creativo."
  noindex={true}
>
  <Navbar />
  <main id="main-content" class="nf-page">
    <div class="nf-shell">
      <div class="nf-meta">
        <span class="nf-badge">ERROR 404</span>
        <span>RUTA FUERA DE COORDENADAS // ATLÁNTIDA, UY</span>
      </div>
      <div class="nf-code tabular" aria-hidden="true">404</div>
      <h1 class="nf-title">Este mate se <em>lavó</em> antes de tiempo.</h1>
      <p class="nf-desc">
        El enlace al que intentaste acceder no existe, caducó o fue archivado por el equipo de Amargo Creativo.
      </p>
      <div class="nf-actions">
        <a href="/" class="nf-btn-primary ink-fill" data-cursor="INICIO">
          <span class="ink" aria-hidden="true"></span>
          <RollText text="VOLVER AL INICIO" arrow="right" />
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="nf-btn-secondary ink-fill"
          data-cursor="WHATSAPP"
        >
          <span class="ink" aria-hidden="true"></span>
          <RollText text="CONSULTAR POR WHATSAPP" arrow="diag" />
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf-page {
    min-height: calc(100dvh - 180px);
    padding: calc(110px + env(safe-area-inset-top)) var(--gut) 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bone);
  }

  .nf-shell {
    max-width: 760px;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    padding: clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .nf-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--mute);
  }

  .nf-badge {
    background: var(--mate);
    color: #f5f3ec;
    padding: 4px 10px;
    font-weight: 700;
    border-radius: 2px;
  }

  .nf-code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 16vw, 150px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--ink);
  }

  .nf-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 4vw, 44px);
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--ink);
  }

  .nf-desc {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--mute);
    max-width: 52ch;
  }

  .nf-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .nf-btn-primary,
  .nf-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 24px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nf-btn-primary {
    --mx-fill-ink: #11120f;
    background: var(--electric);
    color: #11120f;
    border: 1px solid #11120f;
  }

  .nf-btn-primary:hover {
    color: var(--electric);
  }

  .nf-btn-secondary {
    --mx-fill-ink: var(--ink);
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .nf-btn-secondary:hover {
    color: var(--bone);
  }
</style>
