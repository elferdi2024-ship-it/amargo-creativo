      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <div class="faq-item" data-index={index}>
            <button class="faq-trigger" aria-expanded="false">
              <span class="faq-num">{faq.num}</span>
              <span class="faq-title">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="growth-cta">
      <div class="cta-box">
        <span class="cta-kicker">¿NO SABES POR DÓNDE ARRANCAR?</span>
        <h2>Charlamos 15 minutos sin compromiso y diagnosticamos tu web.</h2>
        <p>
          Te decimos con honestidad qué cuello de botella está frenando tus ventas y cuál de estos módulos te conviene activar primero. Sin rodeos ni tácticas de venta agresivas.
        </p>
        <div class="cta-actions">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20conversar%20sobre%20el%20crecimiento%20de%20mi%20sitio%20web" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="cta-btn"
            data-cursor="WHATSAPP"
          >
            <span>HABLAR POR WHATSAPP DIRECTO</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
          <span class="cta-note">Respuesta habitual en menos de 2 horas hábiles • Uruguay, Argentina y España</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // FAQ Interactivity
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach(item => {
    const trigger = item.querySelector('.faq-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', () => {
      const isActive = item.classList.contains('active');

      faqItems.forEach(otherItem => {
        otherItem.classList.remove('active');
        const otherTrigger = otherItem.querySelector('.faq-trigger');
        if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
      });

      if (!isActive) {
        item.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

<style>
  .growth-page {
    width: 100%;
    overflow-x: clip;
    padding-top: calc(60px + env(safe-area-inset-top));
  }

  /* HERO SECTION */
  .growth-hero {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(60px, 10vh, 120px) var(--gut);
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 32px;
  }
  .breadcrumb a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s var(--ease);
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--mate);
  }
  :global(body.theme-electric) .breadcrumb a:hover {
    color: var(--electric);
  }
  .breadcrumb-sep {
    opacity: 0.4;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mate);
    font-weight: 700;
    margin-bottom: 24px;
    background: rgba(45, 99, 53, 0.08);
    padding: 6px 12px;
    border: 1px solid rgba(45, 99, 53, 0.2);
  }
  :global(body.theme-electric) .hero-badge {
    color: var(--electric);
    background: rgba(212, 255, 0, 0.08);
    border-color: rgba(212, 255, 0, 0.25);
  }
  .badge-dot {
    width: 7px;
