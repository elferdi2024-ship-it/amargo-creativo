<script>
  // 1. FAQ Interactivity
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const trigger = item.querySelector('.faq-trigger');
    if (!trigger) return;

    trigger.addEventListener('click', () => {
      const isActive = item.classList.contains('active');
      faqItems.forEach(otherItem => {
        otherItem.classList.remove('active');
        const otherTrigger = otherItem.querySelector('.faq-trigger');
        if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
      });

      if (!isActive) {
        item.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Checklist Interactivo con Barra de Salud Digital
  const chkBoxes = document.querySelectorAll('.chk-box') as NodeListOf<HTMLInputElement>;
  const chkBadge = document.getElementById('chkBadge');
  const chkFeedbackTitle = document.getElementById('chkFeedbackTitle');
  const chkFeedbackDesc = document.getElementById('chkFeedbackDesc');
  const chkActionBtn = document.getElementById('chkActionBtn') as HTMLAnchorElement;
  const healthScoreText = document.getElementById('healthScoreText');
  const healthFill = document.getElementById('healthFill');

  function updateChecklist() {
    let checkedCount = 0;
    chkBoxes.forEach(chk => {
      if (chk.checked) checkedCount++;
    });

    const health = Math.max(15, 100 - (checkedCount * 20));

    if (healthScoreText) healthScoreText.textContent = `${health}%`;
    if (healthFill) {
      healthFill.style.width = `${health}%`;
      if (health > 70) {
        healthFill.style.background = '#22c55e';
      } else if (health >= 40) {
        healthFill.style.background = '#f59e0b';
      } else {
        healthFill.style.background = '#dc2626';
      }
    }

    if (checkedCount === 0) {
      if (chkBadge) {
        chkBadge.textContent = 'ESTADO: SALUD ÓPTIMA (0 SÍNTOMAS)';
        chkBadge.className = 'chk-badge';
      }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Selecciona los síntomas de tu web';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = 'Haz clic en las casillas para evaluar la salud técnica y comercial de tu activo digital.';
      if (chkActionBtn) {
        chkActionBtn.textContent = 'SOLICITAR DIAGNÓSTICO PROFUNDO →';
        chkActionBtn.href = 'https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20solicitar%20un%20diagn%C3%B3stico%20de%20mi%20web';
      }
    } else if (checkedCount <= 2) {
      if (chkBadge) {
        chkBadge.textContent = 'ESTADO: RIESGO MODERADO';
        chkBadge.className = 'chk-badge warning';
      }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Estás perdiendo entre 15% y 30% de tus ventas';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = `Has marcado ${checkedCount} síntomas de fuga. Tu tráfico no está convirtiendo al máximo debido a demoras de carga o barreras de contacto.`;
      if (chkActionBtn) {
        chkActionBtn.textContent = 'CORREGIR ESTAS FUGAS POR WHATSAPP →';
        chkActionBtn.href = `https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20marqu%C3%A9%20${checkedCount}%20s%C3%ADntomas%20en%20el%20checklist%20y%20quiero%20corregir%20las%20fugas%20de%20mi%20web`;
      }
    } else {
      if (chkBadge) {
        chkBadge.textContent = 'ESTADO: ALERTA CRÍTICA';
        chkBadge.className = 'chk-badge danger';
      }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Fuga severa de clientes y presupuesto publicitario';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = `Has marcado ${checkedCount} problemas graves. Tu web está quemando dinero de publicidad y alejando a clientes potenciales hacia tus competidores.`;
      if (chkActionBtn) {
        chkActionBtn.textContent = 'ACTIVAR RESCATE TÉCNICO INMEDIATO →';
        chkActionBtn.href = `https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20marqu%C3%A9%20${checkedCount}%20s%C3%ADntomas%20cr%C3%ADticos%20en%20el%20checklist%20y%20necesito%20una%20auditor%C3%ADa%20urgente`;
      }
    }
  }

  chkBoxes.forEach(chk => {
    chk.addEventListener('change', updateChecklist);
  });
</script>

