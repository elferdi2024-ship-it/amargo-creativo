<script>
  // Checklist Interactivo con Barra de Salud de Conversión
  // (El acordeón FAQ lo gestiona globalmente Layout.astro para evitar doble toggle)
  const chkBoxes = document.querySelectorAll<HTMLInputElement>('.chk-box');
  const chkBadge = document.getElementById('chkBadge');
  const chkFeedbackTitle = document.getElementById('chkFeedbackTitle');
  const chkFeedbackDesc = document.getElementById('chkFeedbackDesc');
  const chkActionBtn = document.getElementById('chkActionBtn') as HTMLAnchorElement | null;
  const chkActionLabel = document.getElementById('chkActionLabel');
  const healthScoreText = document.getElementById('healthScoreText');
  const healthFill = document.getElementById('healthFill');

  function updateChecklist() {
    let checkedCount = 0;
    chkBoxes.forEach(chk => {
      const parent = chk.closest('.chk-item');
      parent?.classList.toggle('is-checked', chk.checked);
      if (chk.checked) checkedCount++;
    });

    const health = Math.max(15, 100 - (checkedCount * 20));
    if (healthScoreText) healthScoreText.textContent = `${health}%`;
    if (healthFill) {
      healthFill.style.width = `${health}%`;
      if (health > 70) healthFill.style.background = '#22c55e';
      else if (health >= 40) healthFill.style.background = '#f59e0b';
      else healthFill.style.background = '#dc2626';
    }

    if (checkedCount === 0) {
      if (chkBadge) { chkBadge.textContent = 'ESTADO: SALUD ÓPTIMA (0 SÍNTOMAS)'; chkBadge.className = 'chk-badge'; }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Marcá tus síntomas actuales';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = 'Seleccioná una o más casillas para calcular el impacto comercial y qué módulo conviene activar primero.';
      if (chkActionLabel) chkActionLabel.textContent = 'SOLICITAR DIAGNÓSTICO PROFUNDO →';
      if (chkActionBtn) chkActionBtn.href = 'https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20solicitar%20un%20diagn%C3%B3stico%20para%20mi%20negocio';
    } else if (checkedCount <= 2) {
      if (chkBadge) { chkBadge.textContent = `ESTADO: FUGA MODERADA (${checkedCount} SÍNTOMAS)`; chkBadge.className = 'chk-badge warning'; }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Estás dejando entre 15% y 30% de margen en la mesa';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = `Marcaste ${checkedCount} puntos de fricción. Ajustando el flujo móvil y la automatización por WhatsApp podés recuperar esas ventas rápido.`;
      if (chkActionLabel) chkActionLabel.textContent = 'CORREGIR ESTAS FUGAS POR WHATSAPP →';
      if (chkActionBtn) chkActionBtn.href = `https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20marqu%C3%A9%20${checkedCount}%20s%C3%ADntomas%20en%20el%20diagn%C3%B3stico%20y%20quiero%20corregir%20fugas`;
    } else {
      if (chkBadge) { chkBadge.textContent = `ESTADO: ALERTA CRÍTICA (${checkedCount} SÍNTOMAS)`; chkBadge.className = 'chk-badge danger'; }
      if (chkFeedbackTitle) chkFeedbackTitle.textContent = 'Fuga severa de clientes y margen operativo';
      if (chkFeedbackDesc) chkFeedbackDesc.textContent = `Marcaste ${checkedCount} cuellos de botella críticos. Te conviene pasar a un canal propio con automatización y UX móvil de alto impacto.`;
      if (chkActionLabel) chkActionLabel.textContent = 'ACTIVAR PLAN DE RESCATE POR WHATSAPP →';
      if (chkActionBtn) chkActionBtn.href = `https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20marqu%C3%A9%20${checkedCount}%20s%C3%ADntomas%20cr%C3%ADticos%20y%20necesito%20un%20plan%20de%20mejora`;
    }
  }

  chkBoxes.forEach(chk => chk.addEventListener('change', updateChecklist));
</script>

