---
// filepath: src/pages/servicios-crecimiento.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RollText from '../components/motion/RollText.astro';

const pageTitle = "Servicios de Producto, Apps, IA, CRO & SEO | Amargo Creativo";
const pageDescription = "Evolución continua de apps y plataformas, automatización con IA y WhatsApp, auditoría CRO, landing pages a medida y SEO local en UY, AR y ES.";
const canonicalUrl = "https://amargo-creativo.pages.dev/servicios-crecimiento/";
const ogImage = "https://amargo-creativo.pages.dev/og-image-v3.jpg";

const growthServicesSchema = [
  {
    "@type": "Service",
    "@id": `${canonicalUrl}#evolucion-producto`,
    "name": "Plan de Evolución Continua de Producto",
    "serviceType": "Mantenimiento y Evolución de Apps, SaaS y Webs",
    "provider": { "@id": "https://amargo-creativo.pages.dev/#organization" },
    "areaServed": ["UY", "AR", "ES"],
    "description": "Evolución mensual de apps PWA, plataformas SaaS y webs: nuevas features, seguridad, Core Web Vitals en verde y CRO continuo."
  },
  {
    "@type": "Service",
    "@id": `${canonicalUrl}#ia-whatsapp`,
    "name": "Automatización IA & WhatsApp que Vende",
    "serviceType": "Flujos Comerciales, OCR e Integraciones IA",
    "provider": { "@id": "https://amargo-creativo.pages.dev/#organization" },
    "areaServed": ["UY", "AR", "ES"],
    "description": "WhatsApp Business y Cloud API, precalificación automática, asistentes con IA sobre documentos y cierre comercial sin fricción."
  },
  {
    "@type": "Service",
    "@id": `${canonicalUrl}#auditoria-cro`,
    "name": "Auditoría de Conversión & UX Mobile (CRO)",
    "serviceType": "Optimización de Conversión y Producto Digital",
    "provider": { "@id": "https://amargo-creativo.pages.dev/#organization" },
    "areaServed": ["UY", "AR", "ES"],
    "description": "Diagnóstico integral de fricción en celular, embudos de venta y Core Web Vitals para multiplicar consultas reales."
  },
  {
    "@type": "Service",
    "@id": `${canonicalUrl}#landing-pages`,
    "name": "Landing Pages & Micro-Apps de Campaña",
    "serviceType": "Diseño y Desarrollo de Landing Pages a Medida",
    "provider": { "@id": "https://amargo-creativo.pages.dev/#organization" },
    "areaServed": ["UY", "AR", "ES"],
    "description": "Páginas de autor con cotizadores o flujos directos a WhatsApp diseñadas para maximizar el retorno en Meta Ads y Google Ads."
  },
  {
    "@type": "Service",
    "@id": `${canonicalUrl}#seo-local`,
    "name": "Visibilidad Local & Google Maps",
    "serviceType": "SEO Local y Google Business Profile",
    "provider": { "@id": "https://amargo-creativo.pages.dev/#organization" },
    "areaServed": ["UY", "AR", "ES"],
    "description": "Optimización de Google Business Profile, Schema.org LocalBusiness y posicionamiento en Google Maps."
  }
];

const growthServices = [
  {
    num: "01",
    tag: "EVOLUCIÓN MENSUAL",
    title: "Evolución Continua de Producto",
    subtitle: "Ingeniería proactiva + nuevas mejoras cada mes para tu app o web",
    desc: "Un producto digital vivo no se abandona el día del lanzamiento. Nos encargamos mes a mes de evolucionar funciones, cuidar la seguridad, mantener Core Web Vitals en verde y optimizar cada pantalla según datos reales.",
    features: [
      "Evolución continua de apps PWA, portales SaaS y sitios en producción",
      "Monitoreo de Core Web Vitals, uptime y latencia en Cloudflare Edge",
      "Actualizaciones de dependencias, seguridad y backups",
      "Micro-optimizaciones mensuales de UX móvil y conversión (CRO)",
      "Ajustes de SEO técnico, Schema.org y metadatos",
      "Canal directo por WhatsApp con el ingeniero a cargo"
    ],
    ideal: "Empresas con una app, tienda o sitio en producción que buscan un equipo técnico senior sin los costos fijos de una plantilla interna.",
    investment: "Desde USD 180 / mes",
    period: "Sin permanencia obligatoria",
    delivery: "Servicio Mensual Continuo",
    waText: "Hola Amargo Creativo, me interesa el Plan de Evolución Continua para mi producto digital"
  },
  {
    num: "02",
    tag: "IA & VENTAS",
    title: "WhatsApp que Vende & Automatización IA",
    subtitle: "Embudos de respuesta inmediata y flujos inteligentes conectados a tu operación",
    desc: "WhatsApp es el canal de cierre número 1 en Uruguay, Argentina y España. Lo conectamos con tu web, catálogo o base documental con IA para responder en segundos, precalificar leads y automatizar pedidos o cobranzas.",
    features: [
      "Configuración profesional de WhatsApp Business / Cloud API",
      "Flujos de precalificación y derivación automática con mensaje estructurado",
      "Conexión con constructores de pedidos, cotizadores y pasarelas locales",
      "Módulos opcionales de IA para lectura de documentos, catálogos o FAQs",
      "Plantillas de seguimiento comercial para recuperar conversaciones",
      "Protocolo claro de atención para equipos de venta"
    ],
    ideal: "Negocios que reciben consultas o pedidos por WhatsApp y quieren atender más rápido sin perder oportunidades ni depender de apps con comisiones.",
    investment: "USD 320",
    period: "Pago único (setup base)",
    delivery: "Implementación en 3 a 5 Días",
    waText: "Hola Amargo Creativo, quiero implementar WhatsApp que Vende y automatización en mi negocio"
  },
  {
    num: "03",
    tag: "DIAGNÓSTICO CRO",
    title: "Auditoría de Conversión & UX Mobile",
    subtitle: "Detectamos exactamente dónde se fugan tus clientes en celular y PC",
    desc: "Muchos productos reciben tráfico de pauta o Google pero fallan en convertirlo en consultas o ventas. Auditamos tu flujo real en dispositivos físicos y te entregamos una hoja de ruta concreta ordenada por impacto.",
    features: [
      "Revisión heurística real en móvil (más del 85% del tráfico)",
      "Reescritura de propuesta de valor y llamados a la acción (CTAs)",
      "Detección de fricción en formularios, checkout o navegación",
      "Auditoría técnica de Core Web Vitals, pesos y arquitectura",
      "Hoja de ruta priorizada: qué arreglar primero para vender más",
      "Implementación llave en mano opcional con crédito bonificado"
    ],
    ideal: "Negocios que ya tienen tráfico o inversión en Ads pero sienten que están dejando ventas sobre la mesa por fricción en su plataforma.",
    investment: "USD 240",
    period: "Pago único",
    delivery: "Entrega en 48 Horas Hábiles",
    waText: "Hola Amargo Creativo, quiero solicitar una Auditoría de Conversión y UX Mobile"
  },
  {
    num: "04",
    tag: "CAMPAÑAS & ADS",
    title: "Landing Pages & Micro-Apps de Conversión",
    subtitle: "Páginas de autor con cotizadores o flujos interactivos para campañas",
    desc: "Mandar tráfico pago de Meta Ads o Google Ads a una home genérica quema presupuesto. Construimos landings a medida —con simuladores, selectores o cierre directo a WhatsApp— pensadas para una única meta comercial.",
    features: [
      "Diseño editorial propio sin plantillas recicladas ni distracciones",
      "Componentes interactivos a medida (cotizadores, selectores, reservas)",
      "Embudos directos a WhatsApp con contexto exacto de la campaña",
      "Ergonomía Mobile-First diseñada para convertir con el pulgar",
      "Integración lista con Píxel de Meta, GA4 y eventos de conversión",
      "100% propiedad del código y despliegue en Cloudflare Pages"
    ],
    ideal: "Lanzamientos de servicios, productos D2C, desarrollos inmobiliarios o campañas activas de Google Ads y Meta Ads.",
    investment: "USD 490",
    period: "Pago único",
    delivery: "Entrega en 7 a 10 Días Hábiles",
    waText: "Hola Amargo Creativo, necesito una Landing Page de alta conversión para una campaña"
  },
  {
    num: "05",
    tag: "SEO LOCAL",
    title: "Visibilidad Local & Google Maps",
    subtitle: "Posicionamiento real en búsquedas de tu ciudad y Google Local 3-Pack",
    desc: "Si tus clientes te buscan cerca tuyo, aparecer entre los primeros resultados de Google Maps define quién se lleva la llamada. Optimizamos tu ficha, arquitectura semántica y señales locales.",
    features: [
      "Optimización completa de Google Business Profile",
      "Sistema práctico para captar y responder reseñas verificadas",
      "Consistencia técnica de datos NAP y categorías de negocio",
      "Marcado estructurado Schema.org LocalBusiness + áreas servidas",
      "Arquitectura de páginas geolocalizadas por barrio o ciudad",
      "Seguimiento inicial de visibilidad en el Local 3-Pack"
    ],
    ideal: "Comercios, gastronomía, clínicas, inmobiliarias y servicios profesionales con radio de atención geográfico.",
    investment: "USD 220",
    period: "Pago único",
    delivery: "Optimización en 5 Días Hábiles",
    waText: "Hola Amargo Creativo, quiero potenciar la Visibilidad Local de mi negocio en Google"
  }
];

const targetAudiences = [
  {
    kicker: "01 / PRODUCTO ACTIVO",
    title: "Ya tenés web o app",
    desc: "Pero sentís que quedó estancada, cuesta usarla en el celular o no genera las ventas que tu operación necesita."
  },
  {
    kicker: "02 / PAUTA ACTIVA",
    title: "Invertís en Ads",
    desc: "Pagás tráfico en Instagram o Google y necesitás que cada clic aterrice en un flujo claro que convierta sin rebotes."
  },
  {
    kicker: "03 / COMERCIO PROPIO",
    title: "Basta de comisiones",
    desc: "Querés pasar pedidos y clientes a tu propio canal con WhatsApp y pagos locales sin regalar hasta el 30% a terceros."
  },
  {
    kicker: "04 / EJECUCIÓN SENIOR",
    title: "Trato directo",
    desc: "Preferís trabajar mano a mano con quienes diseñan y programan el producto, con entregas rápidas y código propio."
  }
];

const steps = [
  {
    num: "01",
    title: "Charla de 15 min",
    desc: "Nos contás por WhatsApp o videollamada qué querés resolver y qué métrica comercial importa mover primero."
  },
  {
    num: "02",
    title: "Diagnóstico real",
    desc: "Revisamos tu flujo actual en móvil y escritorio para detectar fricciones, cuellos de botella y oportunidades rápidas."
  },
  {
    num: "03",
    title: "Alcance cerrado",
    desc: "Recibís una propuesta concreta con entregables claros, plazo exacto e inversión cerrada sin letra chica."
  },
  {
    num: "04",
    title: "Ejecución & medición",
    desc: "Implementamos en producción, verificamos en dispositivos reales y medimos el impacto en consultas y ventas."
  }
];

const faqs = [
  {
    num: "01",
    question: "¿Puedo contratar solo uno de estos servicios de forma modular?",
    answer: "Sí. Cada módulo funciona de forma independiente. Analizamos tu etapa actual y arrancamos por la pieza que genera retorno comercial más rápido."
  },
  {
    num: "02",
    question: "¿El Plan de Evolución Continua tiene contrato de permanencia?",
    answer: "No. Se renueva mes a mes sin permanencia obligatoria ni penalizaciones. Si en algún momento decidís pausarlo, conservás el 100% del código y accesos."
  },
  {
    num: "03",
    question: "¿También desarrollan apps PWA o plataformas con IA desde cero?",
    answer: "Sí. Además de estos módulos de crecimiento, construimos productos completos desde cero (como Barrio.uy, DocuBox o Canarios Ya!). Escribinos y cotizamos tu arquitectura a medida."
  },
  {
    num: "04",
    question: "¿Cómo son los pagos en Uruguay, Argentina y España?",
    answer: "Aceptamos transferencias bancarias en Uruguay (BROU, Itaú, Santander), pagos en Argentina (transferencia o Mercado Pago) y cobros internacionales en USD/EUR vía Stripe o Wise."
  },
  {
    num: "05",
    question: "¿Qué garantía técnica ofrecen en cada entrega?",
    answer: "Todo proyecto se entrega verificado en móvil y PC, con Core Web Vitals en verde y 100% de propiedad del código fuente. Si algo no cumple lo acordado, lo ajustamos sin costo adicional."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
  extraSchema={growthServicesSchema}
  breadcrumbs={[
    { name: 'Inicio', url: 'https://amargo-creativo.pages.dev/' },
    { name: 'Servicios & Crecimiento', url: canonicalUrl }
  ]}
>
  <Navbar />

  <main id="main-content" class="growth-page">
    <!-- HERO SECTION -->
    <header class="growth-hero">
      <div class="hero-inner">
        <div class="breadcrumb">
          <a href="/">← INICIO</a>
          <span class="breadcrumb-sep">/</span>
          <span>SERVICIOS &amp; CRECIMIENTO</span>
        </div>

        <div class="section-label hero-section-label">
          <span class="num">PRODUCTO &amp; CRO</span>
          <span>EVOLUCIÓN CONTINUA · IA · WHATSAPP · CONVERSIÓN</span>
        </div>

        <h1 class="hero-headline" data-reveal-words>
          Escalá tu producto.<br />
          <em>Convertí más sin fricción.</em>
        </h1>

        <p class="hero-sub">
          Ya sea que necesites evolucionar una app o sitio en producción, automatizar ventas con <mark class="hl-yellow">IA + WhatsApp</mark> o lanzar una landing a medida para pauta, atacamos los cuellos de botella reales con ingeniería propia y precios claros.
        </p>

        <div class="hero-ctas">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20mejorar%20las%20ventas%20y%20evolucionar%20mi%20producto%20digital" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary ink-fill magnetic-btn"
            data-cursor="WHATSAPP"
          >
            <span class="ink" aria-hidden="true"></span>
            <RollText text="HABLAR POR WHATSAPP" arrow="diag" />
          </a>
          <a href="#diagnostico" class="btn-ghost ink-fill">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="DIAGNÓSTICO EN 30s" arrow="right" />
          </a>
        </div>
      </div>
    </header>

    <!-- CHECKLIST INTERACTIVO DE DIAGNÓSTICO -->
    <section class="checklist-section" id="diagnostico">
      <div class="chk-container">
        <div class="section-label">
          <span class="num">01</span> DIAGNÓSTICO EN 30 SEGUNDOS
        </div>
        <h2 class="chk-title" data-reveal-words>¿TU OPERACIÓN TIENE <em>estos 5 síntomas</em>?</h2>
        <p class="chk-sub">
          Tocá las casillas que aplican hoy a tu negocio para ver dónde se está escapando facturación.
        </p>

        <div class="chk-grid">
          <div class="chk-items-list" id="chkList">
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark" aria-hidden="true"></span>
              <span class="chk-text">Pagás comisiones altas a apps o plataformas intermediarias por cada venta o pedido.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark" aria-hidden="true"></span>
              <span class="chk-text">Tus consultas se pierden en formularios viejos o chats de WhatsApp desordenados sin seguimiento.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark" aria-hidden="true"></span>
              <span class="chk-text">Tu sitio o sistema se ve incómodo en celulares y cuesta completar una acción con una sola mano.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark" aria-hidden="true"></span>
              <span class="chk-text">Invertís en Meta Ads o Google Ads pero mandás todo el tráfico a una home genérica que rebota.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark" aria-hidden="true"></span>
              <span class="chk-text">Tu negocio no aparece entre los primeros 3 lugares de Google Maps cuando buscan tu rubro.</span>
            </label>
          </div>

          <div class="chk-feedback-box tactile-card" id="chkFeedback">
            <div class="chk-badge" id="chkBadge">ESTADO: SALUD ÓPTIMA (0 SÍNTOMAS)</div>

            <div class="health-bar-wrap">
              <div class="health-bar-labels">
                <span>SALUD DE CONVERSIÓN:</span>
                <strong id="healthScoreText" class="tabular">100%</strong>
              </div>
              <div class="health-track">
                <div class="health-fill" id="healthFill" style="width: 100%;"></div>
              </div>
            </div>

            <h3 id="chkFeedbackTitle">Marcá tus síntomas actuales</h3>
            <p id="chkFeedbackDesc">
              Seleccioná una o más casillas para calcular el impacto comercial y qué módulo conviene activar primero.
            </p>
            <a 
              href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20hice%20el%20checklist%20y%20quiero%20un%20diagn%C3%B3stico%20para%20mi%20negocio" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="chk-cta-link ink-fill"
              id="chkActionBtn"
            >
              <span class="ink" aria-hidden="true"></span>
              <span class="chk-cta-label" id="chkActionLabel">SOLICITAR DIAGNÓSTICO PROFUNDO →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 SERVICIOS DETALLADOS CON PRECIOS CLAROS -->
    <section class="services-section" id="servicios">
      <div class="section-head">
        <div class="section-label">
          <span class="num">02</span> CATÁLOGO MODULAR
        </div>
        <h2 data-reveal-words>Módulos de <em>impacto real</em> y precio transparente</h2>
      </div>

      <div class="services-stack">
        {growthServices.map(srv => (
          <article class="service-card tactile-card">
            <div class="service-card-head">
              <div class="service-id-col">
                <span class="service-num tabular">{srv.num}</span>
                <span class="service-tag">{srv.tag}</span>
              </div>
              <div class="service-title-group">
                <h3>{srv.title}</h3>
                <p class="service-sub">{srv.subtitle}</p>
              </div>
              <div class="service-pricing-badge">
                <strong class="price-val">{srv.investment}</strong>
                <span class="price-period">{srv.period}</span>
                <span class="delivery-stamp">{srv.delivery}</span>
              </div>
            </div>

            <p class="service-desc">{srv.desc}</p>

            <div class="service-includes">
              <h4>QUÉ INCLUYE ESTE MÓDULO:</h4>
              <ul>
                {srv.features.map(feat => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="service-ideal">
              <strong>IDEAL PARA:</strong>
              <p>{srv.ideal}</p>
            </div>

            <div class="service-action">
              <a 
                href={`https://wa.me/59898300491?text=${encodeURIComponent(srv.waText)}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="service-btn ink-fill"
                data-cursor="COTIZAR"
              >
                <span class="ink" aria-hidden="true"></span>
                <RollText text="CONTRATAR POR WHATSAPP" arrow="diag" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SELLO DE GARANTÍA -->
    <section class="sla-guarantee-section">
      <div class="sla-container">
        <div class="sla-card tactile-card">
          <div class="sla-badge-wrap">
            <div class="sla-seal">
              <span class="seal-icon" aria-hidden="true">⚡</span>
              <span class="seal-text">100% CÓDIGO PROPIO</span>
            </div>
          </div>
          <div class="sla-content">
            <span class="sla-kicker">COMPROMISO DE INGENIERÍA</span>
            <h2>PROPIEDAD TOTAL DEL CÓDIGO Y ESTÁNDAR EN VERDE</h2>
            <p>
              Cada entrega sale validada en dispositivos móviles reales, con Core Web Vitals en verde y el 100% del repositorio, infraestructura y dominios a tu nombre. Sin contratos trampa, sin comisiones ocultas y sin dependencias cautivas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PARA QUIÉN ES -->
    <section class="audience-section">
      <div class="section-head">
        <div class="section-label">
          <span class="num">03</span> CALIFICACIÓN
        </div>
        <h2 data-reveal-words>¿Para quién son estos <em>módulos</em>?</h2>
      </div>

      <div class="audience-grid">
        {targetAudiences.map(item => (
          <div class="audience-card tactile-card">
            <span class="audience-kicker">{item.kicker}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CÓMO TRABAJAMOS -->
    <section class="process-section">
      <div class="section-head">
        <div class="section-label">
          <span class="num">04</span> METODOLOGÍA
        </div>
        <h2 data-reveal-words>Cómo <em>trabajamos</em> juntos</h2>
      </div>

      <div class="process-grid">
        {steps.map(step => (
          <div class="process-step">
            <div class="step-num tabular">{step.num}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ ACCORDION -->
    <section class="growth-faq">
      <div class="section-head">
        <div class="section-label">
          <span class="num">05</span> PREGUNTAS FRECUENTES
        </div>
        <h2 data-reveal-words>Dudas <em>claras.</em> Respuestas directas.</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <div class="faq-item" data-index={index}>
            <button type="button" class="faq-trigger" aria-expanded="false">
              <span class="faq-num tabular">{faq.num}</span>
              <span class="faq-title">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="growth-cta">
      <div class="cta-box tactile-card">
        <span class="cta-kicker">● ¿NO SABÉS POR DÓNDE ARRANCAR?</span>
        <h2>Charlamos 15 minutos sin compromiso y diagnosticamos tu operación.</h2>
        <p>
          Te decimos con honestidad qué cuello de botella está frenando tus ventas y cuál de estos módulos —o un desarrollo a medida— te conviene activar primero.
        </p>
        <div class="cta-actions">
          <a 
