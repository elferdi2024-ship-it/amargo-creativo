---
// filepath: src/pages/servicios-crecimiento.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Servicios de Crecimiento Web, CRO, Velocidad & WhatsApp | Amargo Creativo";
const pageDescription = "Mantenimiento continuo, auditorías de conversión CRO, velocidad <0.8s, automatizaciones de WhatsApp y SEO local. Hacemos que tu web venda más en Uruguay, Argentina y España.";
const canonicalUrl = "https://amargo-creativo.pages.dev/servicios-crecimiento";
const ogImage = "https://amargo-creativo.pages.dev/og-image.jpg";

const growthSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": {
        "@id": "https://amargo-creativo.pages.dev/#website"
      },
      "about": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "inLanguage": "es"
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#plan-crecimiento`,
      "name": "Plan de Crecimiento Continuo",
      "serviceType": "Mantenimiento y Optimización Web",
      "provider": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "areaServed": ["UY", "AR", "ES"],
      "description": "Plan mensual de mantenimiento técnico, optimización de velocidad, parches de seguridad, mejoras de conversión y ajustes continuos de SEO."
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#auditoria-cro`,
      "name": "Auditoría de Conversión (CRO)",
      "serviceType": "Optimización de Conversión y UX",
      "provider": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "areaServed": ["UY", "AR", "ES"],
      "description": "Diagnóstico integral de puntos de fricción, velocidad LCP y embudos de venta para multiplicar las consultas recibidas."
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#whatsapp-commerce`,
      "name": "WhatsApp que Vende",
      "serviceType": "Automatización y Flujos Comerciales",
      "provider": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "areaServed": ["UY", "AR", "ES"],
      "description": "Configuración profesional de WhatsApp Business, respuestas inmediatas, catalogación e integración directa con formularios de tu web."
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#landing-pages`,
      "name": "Landing Pages de Alta Conversión",
      "serviceType": "Diseño y Desarrollo de Landing Pages",
      "provider": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "areaServed": ["UY", "AR", "ES"],
      "description": "Páginas ultrarrápidas (<0.8s) orientadas a un objetivo unificado, ideales para campañas de Meta Ads y Google Ads."
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#seo-local`,
      "name": "Visibilidad Local & Google Business",
      "serviceType": "SEO Local y Presencia en Maps",
      "provider": {
        "@id": "https://amargo-creativo.pages.dev/#organization"
      },
      "areaServed": ["UY", "AR", "ES"],
      "description": "Optimización de perfil de Google Business, arquitectura semántica LocalBusiness y estrategia de posicionamiento en Google Maps."
    }
  ]
};

const growthServices = [
  {
    num: "01",
    title: "Plan de Crecimiento Continuo",
    subtitle: "Mantenimiento técnico proactivo + Optimización mensual",
    desc: "Tu web no termina cuando se publica. Con este plan nos aseguramos mes a mes de que mantenga su velocidad extrema (<0.8s), seguridad blindada, parches al día y enfoque constante en mejorar la tasa de conversión.",
    features: [
      "Monitoreo semanal de Core Web Vitals y latencia global",
      "Actualizaciones de dependencias y parches de seguridad",
      "Micro-optimizaciones continuas de conversión (CRO)",
      "Ajustes de SEO on-page y arquitectura semántica",
      "Reporte mensual transparente y accionable",
      "Soporte prioritario y canal directo por WhatsApp"
    ],
    ideal: "Empresas con sitio web en producción que buscan rendimiento y tranquilidad técnica sin contratar un equipo interno.",
    investment: "Desde USD 180 / mes",
    period: "Sin permanencia obligatoria",
    delivery: "Servicio Mensual Continuo",
    waText: "Hola Amargo Creativo, me interesa el Plan de Crecimiento Continuo para mi sitio web"
  },
  {
    num: "02",
    title: "Auditoría de Conversión (CRO)",
    subtitle: "Identificamos con precisión matemática por qué no estás cerrando ventas",
    desc: "Muchos sitios reciben tráfico pero fallan en generar consultas calificadas. Analizamos el embudo completo, tiempos de respuesta y puntos de fuga para entregarte una hoja de ruta de impacto inmediato.",
    features: [
      "Análisis heurístico de UX en mobile (85% del tráfico)",
      "Revisión y reescritura de llamados a la acción (CTAs)",
      "Detección de puntos de rebote y fugas de tráfico",
      "Medición de latencia de carga y first contentful paint (FCP)",
      "Hoja de ruta priorizada por impacto vs esfuerzo técnico",
      "Propuesta de implementación llave en mano (opcional)"
    ],
    ideal: "Negocios que ya tienen visitas pero sienten que están dejando dinero sobre la mesa por fricción en la web.",
    investment: "USD 240",
    period: "Pago único",
    delivery: "Entrega en 48 Horas Hábiles",
    waText: "Hola Amargo Creativo, quiero solicitar una Auditoría de Conversión para mi web actual"
  },
  {
    num: "03",
    title: "WhatsApp que Vende",
    subtitle: "Automatización y embudos de respuesta inmediata",
    desc: "WhatsApp es el canal de cierre número 1 en Uruguay, Argentina y España. Lo transformamos en una máquina organizada que responde en segundos, precalifica prospectos y no deja conversaciones colgadas.",
    features: [
      "Configuración profesional de WhatsApp Business y catálogo",
      "Mensajes de bienvenida y respuestas automáticas inteligentes",
      "Flujos de calificación previa para filtrar consultas no viables",
      "Integración directa con botones dinámicos y formularios web",
      "Plantillas de seguimiento comercial para reenganchar prospectos",
      "Protocolo de atención para equipos de venta"
    ],
    ideal: "Negocios que reciben consultas por chat y necesitan profesionalizar y acelerar el tiempo de cierre comercial.",
    investment: "USD 320",
    period: "Pago único",
    delivery: "Setup en 3 a 5 Días",
    waText: "Hola Amargo Creativo, quiero implementar el sistema de WhatsApp que Vende"
  },
  {
    num: "04",
    title: "Landing Pages de Alta Conversión",
    subtitle: "Páginas independientes diseñadas para un solo objetivo: vender",
    desc: "Para campañas publicitarias en Meta o Google Ads, enviar tráfico a la home general es quemar presupuesto. Diseñamos landing pages ultrarrápidas pensadas exclusivamente para una sola acción: cotizar o comprar.",
    features: [
      "Diseño a medida con enfoque editorial brutalista sin distracciones",
      "Carga ultrarrápida (<0.8s) que reduce el costo por clic publicitario",
      "Embudos directos a WhatsApp con mensaje de origen predefinido",
      "Prioridad Mobile-First con botones fijos de conversión ergonómicos",
      "Entrega lista para pauta en 7 a 10 días hábiles",
      "Integración con Píxel de Meta, Google Analytics 4 y Tag Manager"
    ],
    ideal: "Lanzamientos de servicios, productos destacados o campañas activas de Google Ads y Meta Ads.",
    investment: "USD 490",
    period: "Pago único",
    delivery: "Entrega en 7 a 10 Días Hábiles",
    waText: "Hola Amargo Creativo, necesito una Landing Page de alta conversión para una campaña"
  },
  {
    num: "05",
    title: "Visibilidad Local & Google Maps",
    subtitle: "SEO Local y presencia dominante en el Google Local 3-Pack",
    desc: "Si tus clientes están en tu radio de influencia, aparecer entre los primeros resultados locales es decisivo. Optimizamos tu ficha de negocio y arquitectura web para captar clientes en tu zona geográfica.",
    features: [
      "Optimización integral de Google Business Profile (ex GMB)",
      "Estrategia de recolección y respuesta de reseñas verificadas",
      "Consistencia estricta de datos NAP (Nombre, Dirección, Teléfono)",
      "Marcado semántico Schema.org LocalBusiness en tu web",
      "Páginas de aterrizaje geolocalizadas por zona o barrio",
      "Monitoreo de posicionamiento en el Google Local 3-Pack"
    ],
    ideal: "Inmobiliarias, clínicas, servicios profesionales, comercios y empresas con presencia física o radio definido.",
    investment: "USD 220",
    period: "Pago único",
    delivery: "Optimización en 5 Días Hábiles",
    waText: "Hola Amargo Creativo, quiero potenciar la Visibilidad Local de mi negocio en Google"
  }
];

const targetAudiences = [
  {
    kicker: "01 / SITIO ACTIVO",
    title: "Ya tienes web",
    desc: "Pero sientes que es un folleto estático que no genera las consultas ni los ingresos que tu negocio necesita."
  },
  {
    kicker: "02 / PAUTA ACTIVA",
    title: "Inviertes en Ads",
    desc: "Pagas publicidad en Google o Instagram y necesitas que cada visita se transforme en un contacto real antes de rebotar."
  },
  {
    kicker: "03 / TRACCIÓN",
    title: "Crecimiento predecible",
    desc: "Buscas mejoras continuas mes a mes sin lidiar con roturas técnicas, caídas de servidor o lentitud crónica."
  },
  {
    kicker: "04 / EJECUCIÓN",
    title: "Claridad y velocidad",
    desc: "Prefieres trabajar con especialistas directos que hablan con números y código limpio, sin vueltas burocráticas."
  }
];

const steps = [
  {
    num: "01",
    title: "Contacto directo",
    desc: "Una charla rápida de 15 minutos por WhatsApp o videollamada para entender tu situación actual y metas comerciales."
  },
  {
    num: "02",
    title: "Diagnóstico técnico",
    desc: "Auditamos tu web actual, latencia de carga, formularios y embudos para detectar con exactitud dónde se pierde dinero."
  },
  {
    num: "03",
    title: "Propuesta de impacto",
    desc: "Te presentamos una solución puntual con alcance exacto, cronograma de entrega y presupuesto cerrado sin sorpresas."
  },
  {
    num: "04",
    title: "Implementación & Medición",
    desc: "Ejecutamos los cambios en código de producción, validamos métricas en verde y medimos la subida en conversión."
  }
];

const faqs = [
  {
    num: "01",
    question: "¿Puedo contratar solo uno de estos servicios de forma independiente?",
    answer: "Sí. Cada servicio funciona de manera modular e independiente. Analizamos tu situación y arrancamos por el punto que genere el impacto más rápido en tus ventas."
  },
  {
    num: "02",
    question: "¿El Plan de Crecimiento Continuo tiene contrato de permanencia?",
    answer: "No. El servicio se renueva mes a mes sin ningún tipo de permanencia obligatoria. Si en algún momento decides pausarlo o cancelarlo, lo haces sin penalizaciones ni preguntas."
  },
  {
    num: "03",
    question: "¿Hacen cambios grandes de diseño dentro del mantenimiento mensual?",
    answer: "El plan está diseñado para optimizaciones continuas, mejoras de velocidad, parches de seguridad, copywriting y CRO. Nuevos desarrollos de módulos o rediseños de cero se cotizan por separado con precio preferencial."
  },
  {
    num: "04",
    question: "¿Cómo es el esquema de pago para clientes en Uruguay, Argentina y España?",
    answer: "Aceptamos pagos en moneda local o divisas: transferencias bancarias en Uruguay (BROU, Santander, Itaú), pagos en Argentina (vía transferencia o Mercado Pago) y pagos internacionales en EUR o USD mediante Stripe o Wise."
  },
  {
    num: "05",
    question: "¿Qué garantía técnica ofrecen en los servicios de velocidad?",
    answer: "Garantizamos tiempos de carga por debajo de 0.8s y Core Web Vitals en verde en Google Lighthouse. Si no alcanzamos el rendimiento pactado, ajustamos el código sin costo adicional."
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} image={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(growthSchema)} />

  <Navbar />

  <main id="main-content" class="growth-page">
    <!-- HERO SECTION -->
    <header class="growth-hero">
      <div class="hero-inner">
        <div class="breadcrumb">
          <a href="/">← VOLVER AL INICIO</a>
          <span class="breadcrumb-sep">/</span>
          <span>SERVICIOS DE CRECIMIENTO</span>
        </div>

        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>CRECIMIENTO CONTINUO, CRO &amp; RENDIMIENTO WEB</span>
        </div>

        <h1 class="hero-headline">
          Tu web ya existe.<br />
          <em>Ahora hacemos que venda más.</em>
        </h1>

        <p class="hero-sub">
          No todos los negocios necesitan un sitio web nuevo desde cero. Muchos ya tienen uno que simplemente está estancado, lento o perdiendo prospectos en formularios olvidados. Optimizamos velocidad (<mark class="hl-yellow">&lt;0.8s</mark>), pulimos puntos de fricción y conectamos embudos directos a WhatsApp para transformar visitas en facturación real.
        </p>

        <div class="hero-ctas">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20hacer%20crecer%20las%20ventas%20de%20mi%20web%20actual" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary"
            data-cursor="WHATSAPP"
          >
            <span>HABLEMOS POR WHATSAPP DIRECTO</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path>
            </svg>
          </a>
          <a href="#diagnostico" class="btn-ghost">
            <span>DIAGNÓSTICO EN 30 SEGUNDOS ↓</span>
          </a>
        </div>
      </div>
    </header>

    <!-- CHECKLIST INTERACTIVO DE DIAGNÓSTICO -->
    <section class="checklist-section" id="diagnostico">
      <div class="chk-container">
        <div class="section-label">
          <span class="num">01</span> DIAGNÓSTICO EN 30 SEGUNDOS
        </div>
        <h2 class="chk-title">¿TIENE TU WEB ALGUNO DE <em>estos 5 síntomas</em>?</h2>
        <p class="chk-sub">
          Marca las casillas que aplican a tu web hoy para obtener un diagnóstico técnico instantáneo.
        </p>

        <div class="chk-grid">
          <div class="chk-items-list" id="chkList">
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark"></span>
              <span class="chk-text">Tu web tarda más de 2 segundos en cargar en redes móviles 4G.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark"></span>
              <span class="chk-text">Tus prospectos se pierden en formularios de contacto por mail que nadie responde en el día.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark"></span>
              <span class="chk-text">Tu sitio depende de plugins de WordPress propensos a caídas o hackeos.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark"></span>
              <span class="chk-text">No cuentas con un botón fijo ergonómico para iniciar una conversación de WhatsApp.</span>
            </label>
            <label class="chk-item">
              <input type="checkbox" class="chk-box" />
              <span class="chk-custom-mark"></span>
              <span class="chk-text">Tu negocio no aparece en los primeros 3 puestos de Google Maps en tu ciudad o zona.</span>
            </label>
          </div>

          <div class="chk-feedback-box tactile-card" id="chkFeedback">
            <div class="chk-badge" id="chkBadge">ESTADO: SALUD ÓPTIMA (0 SÍNTOMAS)</div>

            <!-- Barra de Salud Digital -->
            <div class="health-bar-wrap">
              <div class="health-bar-labels">
                <span>NIVEL DE SALUD DIGITAL:</span>
                <strong id="healthScoreText">100%</strong>
              </div>
              <div class="health-track">
                <div class="health-fill" id="healthFill" style="width: 100%;"></div>
              </div>
            </div>

            <h3 id="chkFeedbackTitle">Selecciona los síntomas de tu web</h3>
            <p id="chkFeedbackDesc">
              Haz clic en las casillas para evaluar la salud técnica y comercial de tu activo digital en este momento.
            </p>
            <a 
              href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20hice%20el%20checklist%20y%20quiero%20solicitar%20un%20diagn%C3%B3stico%20de%20mi%20web" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="chk-cta-link"
              id="chkActionBtn"
            >
              SOLICITAR DIAGNÓSTICO PROFUNDO →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 SERVICIOS DETALLADOS CON PRECIOS CLAROS -->
    <section class="services-section" id="servicios">
      <div class="section-head">
        <div class="section-label">
          <span class="num">02</span> CATÁLOGO DE SERVICIOS
        </div>
        <h2>Soluciones de <em>alto rendimiento</em> para tu activo digital</h2>
      </div>

      <div class="services-stack">
        {growthServices.map(srv => (
          <article class="service-card tactile-card">
            <div class="service-card-head">
              <span class="service-num">{srv.num}</span>
              <div class="service-title-group">
                <h3>{srv.title}</h3>
                <p class="service-sub">{srv.subtitle}</p>
              </div>
              <div class="service-pricing-badge">
                <strong class="price-val">{srv.investment}</strong>
                <span class="price-period">{srv.period}</span>
                <span class="delivery-stamp">{srv.delivery}</span>
              </div>
            </div>

            <p class="service-desc">{srv.desc}</p>

            <div class="service-includes">
              <h4>QUÉ INCLUYE ESTE MÓDULO:</h4>
              <ul>
                {srv.features.map(feat => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="service-ideal">
              <strong>IDEAL PARA:</strong>
              <p>{srv.ideal}</p>
            </div>

            <div class="service-action">
              <a 
                href={`https://wa.me/59898300491?text=${encodeURIComponent(srv.waText)}`}
                target="_blank" 
                rel="noopener noreferrer" 
                class="service-btn"
                data-cursor="COTIZAR"
              >
                <span>CONTRATAR ESTE SERVICIO POR WHATSAPP</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SELLO DE GARANTÍA AMARGO PERFORMANCE SLA -->
    <section class="sla-guarantee-section">
      <div class="sla-container">
        <div class="sla-card tactile-card">
          <div class="sla-badge-wrap">
            <div class="sla-seal">
              <span class="seal-icon">⚡</span>
              <span class="seal-text">SLA 100% GARANTIZADO</span>
            </div>
          </div>
          <div class="sla-content">
            <span class="sla-kicker">COMPROMISO TÉCNICO VINCULANTE</span>
            <h2>GARANTÍA DE VELOCIDAD &lt;0.8s Y CÓDIGO PROPIO</h2>
            <p>
              Si optimizamos tu sitio y no logramos una puntuación en verde en Google Lighthouse o una carga sub-segundo en móviles, seguimos ajustando el código sin cobrarte un solo dólar adicional hasta cumplir el estándar. Sin contratos trampa ni dependencias cautivas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PARA QUIÉN ES -->
    <section class="audience-section">
      <div class="section-head">
        <div class="section-label">
          <span class="num">03</span> CALIFICACIÓN
        </div>
        <h2>¿Para quién son estos <em>servicios</em>?</h2>
      </div>

      <div class="audience-grid">
        {targetAudiences.map(item => (
          <div class="audience-card tactile-card">
            <span class="audience-kicker">{item.kicker}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CÓMO TRABAJAMOS -->
    <section class="process-section">
      <div class="section-head">
        <div class="section-label">
          <span class="num">04</span> METODOLOGÍA
        </div>
        <h2>Cómo <em>trabajamos</em> juntos</h2>
      </div>

      <div class="process-grid">
        {steps.map(step => (
          <div class="process-step">
            <div class="step-num">{step.num}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ ACCORDION -->
    <section class="growth-faq">
      <div class="section-head">
        <div class="section-label">
          <span class="num">05</span> PREGUNTAS FRECUENTES
        </div>
        <h2>Dudas <em>claras.</em> Respuestas directas.</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <div class="faq-item" data-index={index}>
            <button class="faq-trigger" aria-expanded="false">
              <span class="faq-num">{faq.num}</span>
              <span class="faq-title">{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-content">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="growth-cta">
      <div class="cta-box tactile-card">
        <span class="cta-kicker">¿NO SABES POR DÓNDE ARRANCAR?</span>
        <h2>Charlamos 15 minutos sin compromiso y diagnosticamos tu web.</h2>
        <p>
          Te decimos con honestidad qué cuello de botella está frenando tus ventas y cuál de estos módulos te conviene activar primero. Sin rodeos ni tácticas de venta agresivas.
        </p>
        <div class="cta-actions">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20conversar%20sobre%20el%20crecimiento%20de%20mi%20sitio%20web" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="cta-btn"
            data-cursor="WHATSAPP"
          >
