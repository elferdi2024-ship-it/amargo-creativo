---
// filepath: src/pages/admin/index.astro
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import CopyButton from "../../components/admin/CopyButton";
import ClientModal from "../../components/admin/ClientModal";
import ProjectHealth from "../../components/admin/ProjectHealth";
import { supabaseAdmin } from "../../lib/supabase";
import { formatMoney, formatDate, whatsappHref } from "../../lib/format";
import { calculateHealth } from "../../lib/health";

// 1. Consultas paralelas (mayor velocidad SSR)
const [proposalsRes, projectsRes, clientsRes, contentRes, invoicesRes] = await Promise.all([
  supabaseAdmin.from("proposals").select("*, clients(name, company, phone)").order("created_at", { ascending: false }),
  supabaseAdmin.from("projects").select("*, clients(name, company)").order("created_at", { ascending: false }),
  supabaseAdmin.from("clients").select("id, name, company, email, phone").order("name", { ascending: true }),
  supabaseAdmin.from("content_pieces").select("id, type, title, status, created_at, projects(title)").order("created_at", { ascending: false }).limit(4),
  supabaseAdmin.from("invoices").select("id, total, currency, status, issue_date").order("issue_date", { ascending: false }),
]);

const allProposals = proposalsRes.data || [];
const allProjects = projectsRes.data || [];
const allClients = clientsRes.data || [];
const contentPieces = contentRes.data || [];
const allInvoices = invoicesRes.data || [];

// 2. KPIs con separación estricta de monedas (USD vs UYU)
const totalProposalsCount = allProposals.length;
const draftProposalsCount = allProposals.filter((p) => p.status === "draft").length;
const activeProposalsCount = allProposals.filter((p) => p.status === "active").length;
const acceptedProposalsCount = allProposals.filter((p) => p.status === "accepted").length;
const activeProjectsCount = allProjects.filter((p) => p.status === "active").length;
const finishedProjectsCount = allProjects.filter((p) => p.status === "finished").length;

const conversionRate =
  totalProposalsCount > 0 ? Math.round((acceptedProposalsCount / totalProposalsCount) * 100) : 0;

function extractProposalAmount(p: any): { amount: number; currency: string } {
  const inv = p.investment || {};
  const currency = (inv.currency || "USD").toUpperCase();
  if (inv.type === "plans" && Array.isArray(inv.plans)) {
    const matched = inv.plans.find((pl: any) => pl.name === p.accepted_plan) || inv.plans[0];
    return { amount: Number(matched?.price || 0), currency };
  }
  return { amount: Number(inv.amount || 0), currency };
}

let acceptedUSD = 0;
let acceptedUYU = 0;
for (const p of allProposals.filter((pr) => pr.status === "accepted")) {
  const { amount, currency } = extractProposalAmount(p);
  if (currency === "UYU") acceptedUYU += amount;
  else acceptedUSD += amount;
}

const pendingInvoicesCount = allInvoices.filter((i) => ["issued", "sent", "partial", "overdue"].includes(i.status)).length;

// 3. Serie últimos 6 meses (Propuestas creadas vs Aceptadas) para gráfico nativo SVG
const now = new Date();
const monthNames = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
const monthlySeries = Array.from({ length: 6 }, (_, idx) => {
  const d = new Date(now.getFullYear(), now.getMonth() - (5 - idx), 1);
  const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
  const created = allProposals.filter((p) => (p.created_at || "").startsWith(ym)).length;
  const accepted = allProposals.filter((p) => p.status === "accepted" && ((p.accepted_at || p.created_at || "").startsWith(ym))).length;
  return { label: monthNames[d.getMonth()], created, accepted };
});
const maxMonthly = Math.max(1, ...monthlySeries.map((m) => Math.max(m.created, m.accepted)));

// 4. Proyectos que requieren atención
const attentionNeededProjects = allProjects.filter((pr) => {
  if (pr.status !== "active") return false;
  const h = pr.health_status || calculateHealth(pr.last_checkin_at, pr.updated_at);
  return h === "yellow" || h === "red";
});

const funnelSteps = [
  { label: "Borradores", count: draftProposalsCount, color: "#94a3b8" },
  { label: "En decisión", count: activeProposalsCount, color: "#97bc62" },
  { label: "Aceptadas", count: acceptedProposalsCount, color: "#d4ff33" },
  { label: "En desarrollo", count: activeProjectsCount, color: "#38bdf8" },
  { label: "Finalizados", count: finishedProjectsCount, color: "#34d399" },
];
const maxFunnel = Math.max(1, ...funnelSteps.map((s) => s.count));
---

<AdminLayout title="Dashboard General" activeSection="dashboard">
  <!-- KPI BENTO GRID -->
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="m-top">
        <span class="m-label">Tasa de Cierre</span>
        <span class="m-pill tabular">{conversionRate}%</span>
      </div>
      <div class="m-value-row">
        <span class="m-num text-lime tabular">{acceptedProposalsCount}</span>
        <span class="m-sub">de {totalProposalsCount} propuestas</span>
      </div>
      <div class="m-bar">
        <div class="m-bar-fill bg-lime" style={`width: ${conversionRate}%;`}></div>
      </div>
    </div>

    <div class="metric-card">
      <div class="m-top">
        <span class="m-label">Aprobado (USD)</span>
        {acceptedUYU > 0 && <span class="m-pill-alt tabular">+ {formatMoney(acceptedUYU, "UYU")}</span>}
      </div>
      <div class="m-value-row">
        <span class="m-num tabular">{formatMoney(acceptedUSD, "USD")}</span>
      </div>
      <span class="m-foot">Propuestas confirmadas (monedas separadas)</span>
    </div>

    <div class="metric-card">
      <div class="m-top">
        <span class="m-label">Magic Links Activos</span>
      </div>
      <div class="m-value-row">
        <span class="m-num text-mate-light tabular">{activeProposalsCount}</span>
        <span class="m-sub">en decisión</span>
      </div>
      <span class="m-foot">{pendingInvoicesCount} facturas por cobrar</span>
    </div>

    <div class="metric-card">
      <div class="m-top">
        <span class="m-label">Producción Activa</span>
      </div>
      <div class="m-value-row">
        <span class="m-num tabular">{activeProjectsCount}</span>
        <span class="m-sub">proyectos</span>
      </div>
      <span class="m-foot">{allClients.length} clientes en CRM</span>
    </div>
  </div>

  <!-- QUICK ACTIONS BAR -->
  <div class="quick-actions-bar">
    <span class="qa-title">Accesos rápidos:</span>
    <div class="qa-buttons">
      <a href="/admin/proposals/new" class="btn-primary-sm">+ Propuesta</a>
      <a href="/admin/finanzas/facturas/nueva" class="btn-outline-sm">🧾 Nueva Factura</a>
      <a href="/admin/pipeline" class="btn-outline-sm">📊 Pipeline</a>
      <a href="/admin/contenido" class="btn-outline-sm">✨ Content IA</a>
      <ClientModal client:load buttonLabel="+ Cliente" />
      <a href="/admin/contracts" class="btn-outline-sm">📄 Contrato</a>
    </div>
  </div>

  <!-- ATTENTION NEEDED BANNER -->
  {attentionNeededProjects.length > 0 && (
    <div class="attention-banner">
      <div class="att-header">
        <span class="att-icon">⚠️</span>
        <strong>{attentionNeededProjects.length} proyecto(s) requieren check-in o atención:</strong>
      </div>
      <div class="att-list">
        {attentionNeededProjects.map((pr) => (
          <div class="att-item">
            <a href={`/admin/projects/${pr.id}`} class="att-link">
              {pr.title} ({pr.clients?.name || "Sin cliente"})
            </a>
            <ProjectHealth
              client:load
              projectId={pr.id}
              initialHealth={pr.health_status || calculateHealth(pr.last_checkin_at, pr.updated_at)}
              lastCheckinAt={pr.last_checkin_at}
              updatedAt={pr.updated_at}
              compact={true}
            />
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- ANALYTICS ROW: 6-MONTH ACTIVITY + CONVERSION FUNNEL -->
  <div class="analytics-grid">
    <div class="card-box">
      <div class="box-header">
        <div>
          <h2 class="box-title">Pulso Comercial (6 Meses)</h2>
          <span class="box-sub">Propuestas creadas vs aceptadas por mes</span>
        </div>
        <div class="chart-legend">
          <span class="lg-item"><i class="lg-dot lg-created"></i> Creadas</span>
          <span class="lg-item"><i class="lg-dot lg-accepted"></i> Aceptadas</span>
        </div>
      </div>

      <div class="svg-chart-wrap">
        <svg viewBox="0 0 360 130" class="bar-chart-svg" role="img" aria-label="Gráfico de propuestas de los últimos 6 meses">
          {monthlySeries.map((m, i) => {
            const groupX = 18 + i * 56;
            const hCreated = Math.max(4, Math.round((m.created / maxMonthly) * 84));
            const hAccepted = Math.max(4, Math.round((m.accepted / maxMonthly) * 84));
            return (
              <g>
                <rect x={groupX} y={100 - hCreated} width="14" height={hCreated} rx="4" fill="rgba(151, 188, 98, 0.35)" />
                <rect x={groupX + 18} y={100 - hAccepted} width="14" height={hAccepted} rx="4" fill="#d4ff33" />
                <text x={groupX + 16} y="118" text-anchor="middle" fill="#889b8e" font-size="9.5" font-family="JetBrains Mono">{m.label}</text>
              </g>
            );
          })}
        </svg>
      </div>
    </div>

    <div class="card-box">
      <div class="box-header">
        <div>
          <h2 class="box-title">Embudo Operativo</h2>
          <span class="box-sub">Distribución actual del estudio</span>
        </div>
        <a href="/admin/pipeline" class="link-more">Kanban →</a>
      </div>

      <div class="funnel-list">
        {funnelSteps.map((step) => (
          <div class="funnel-row">
            <div class="funnel-meta">
              <span>{step.label}</span>
              <strong class="tabular">{step.count}</strong>
            </div>
            <div class="funnel-track">
              <div
                class="funnel-fill"
                style={`width: ${Math.max(step.count > 0 ? 12 : 0, Math.round((step.count / maxFunnel) * 100))}%; background: ${step.color};`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- MAIN 2-COLUMN SECTION -->
  <div class="dashboard-grid-2">
    <!-- RECENT PROPOSALS -->
    <div class="card-box section-box">
      <div class="box-header">
        <div>
          <h2 class="box-title">Propuestas Recientes</h2>
          <span class="box-sub">Magic links con envío directo a WhatsApp</span>
        </div>
        <a href="/admin/proposals" class="link-more">Ver todas →</a>
      </div>

      <!-- Mobile Stacked Cards (< 768px) -->
      <div class="dash-mobile-cards">
        {allProposals.slice(0, 6).map((p) => {
          const amount = p.investment?.type === "plans"
            ? `Planes (${p.investment.plans?.length || 0})`
            : formatMoney(p.investment?.amount || 0, p.investment?.currency);
          const magicUrl = `${Astro.url.origin}/p/${p.slug}`;
          const waMsg = `Hola ${p.clients?.name || ""}, te comparto la propuesta interactiva de "${p.project_title}": ${magicUrl}`;
          const waLink = whatsappHref(waMsg, p.clients?.phone);

          return (
            <div class="mini-prop-card">
              <div class="mpc-top">
                <span class={`badge-status status-${p.status}`}>
                  {p.status === "accepted" ? "Aceptada" : p.status === "active" ? "Activa" : p.status === "draft" ? "Borrador" : p.status}
                </span>
                <span class="font-mono mpc-amount tabular">{amount}</span>
              </div>
              <a href={`/admin/proposals/${p.id}`} class="mpc-title">{p.project_title}</a>
              <span class="mpc-client">{p.clients?.name || "Sin cliente"}{p.clients?.company ? ` · ${p.clients.company}` : ""}</span>
              <div class="mpc-actions">
                <CopyButton client:load text={magicUrl} label="Link" />
                <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa-mini">WhatsApp ↗</a>
                <a href={`/admin/proposals/${p.id}`} class="btn-table-action">Detalle</a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Desktop Table (>= 768px) -->
      <div class="dash-desktop-table">
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead>
              <tr>
                <th>Cliente / Proyecto</th>
                <th>Estado</th>
                <th>Monto</th>
                <th>Compartir</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody>
              {allProposals.slice(0, 6).map((p) => {
                const amount = p.investment?.type === "plans"
                  ? `Planes (${p.investment.plans?.length || 0})`
                  : formatMoney(p.investment?.amount || 0, p.investment?.currency);
                const magicUrl = `${Astro.url.origin}/p/${p.slug}`;
                const waMsg = `Hola ${p.clients?.name || ""}, te comparto la propuesta interactiva de "${p.project_title}": ${magicUrl}`;
                const waLink = whatsappHref(waMsg, p.clients?.phone);

                return (
                  <tr>
                    <td>
                      <strong>{p.project_title}</strong>
                      <div class="cell-sub">{p.clients?.name || "Sin cliente"} {p.clients?.company ? `(${p.clients.company})` : ""}</div>
                    </td>
                    <td>
                      <span class={`badge-status status-${p.status}`}>
                        {p.status === "accepted" ? "Aceptada" : p.status === "active" ? "Activa" : p.status === "draft" ? "Borrador" : p.status}
                      </span>
                    </td>
                    <td><span class="font-mono tabular">{amount}</span></td>
                    <td>
                      <div class="share-row">
                        <CopyButton client:load text={magicUrl} label="Copiar" />
                        <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa-mini" title="Enviar por WhatsApp">WA ↗</a>
                      </div>
                    </td>
                    <td>
                      <a href={`/admin/proposals/${p.id}`} class="btn-table-action">Detalle</a>
                    </td>
                  </tr>
                );
              })}
              {allProposals.length === 0 && (
                <tr>
                  <td colspan="5" class="empty-cell">No hay propuestas creadas todavía.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- SIDE SECTIONS -->
    <div class="side-sections">
      <div class="card-box section-box">
        <div class="box-header">
          <div>
            <h2 class="box-title">Proyectos en Marcha</h2>
            <span class="box-sub">Etapas activas y semáforo de salud</span>
          </div>
          <a href="/admin/projects" class="link-more">Ver todos →</a>
        </div>

        <div class="projects-mini-list">
          {allProjects.slice(0, 4).map((pr) => {
            const stages = Array.isArray(pr.stages) ? pr.stages : [];
            const currentStageObj = stages.find((s: any) => s.status === "current") || stages[(pr.current_stage || 1) - 1];
            const health = pr.health_status || calculateHealth(pr.last_checkin_at, pr.updated_at);

            return (
              <div class="project-mini-item">
                <a href={`/admin/projects/${pr.id}`} class="pr-info">
                  <strong>{pr.title}</strong>
                  <span class="pr-client">{pr.clients?.name || "Cliente"}</span>
                </a>
                <div class="pr-stage">
                  <span class="stage-tag">{currentStageObj ? currentStageObj.name : `Etapa ${pr.current_stage || 1}`}</span>
                  <ProjectHealth
                    client:load
                    projectId={pr.id}
                    initialHealth={health}
                    lastCheckinAt={pr.last_checkin_at}
                    updatedAt={pr.updated_at}
                    compact={true}
                  />
                </div>
              </div>
            );
          })}
          {allProjects.length === 0 && (
            <p class="empty-text">No hay proyectos activos aún. Se crean automáticamente al aceptar una propuesta.</p>
          )}
        </div>
      </div>

      <div class="card-box section-box">
        <div class="box-header">
          <div>
            <h2 class="box-title">Content Engine IA</h2>
            <span class="box-sub">Borradores recientes listos para publicar</span>
          </div>
          <a href="/admin/contenido" class="link-more">Ver todas →</a>
        </div>

        <ul class="docs-mini-list">
          {contentPieces.map((cp) => (
            <li class="doc-mini-item">
              <span class="doc-icon">✨</span>
              <div class="doc-meta">
                <strong>{cp.title}</strong>
                <span class="doc-sub">
                  {cp.type} · {formatDate(cp.created_at)} · <span class={`badge-status status-${cp.status}`}>{cp.status}</span>
                </span>
              </div>
              <a href={`/admin/contenido/${cp.id}`} class="btn-doc-down">Editar →</a>
            </li>
          ))}
          {contentPieces.length === 0 && (
            <p class="empty-text">Generá piezas con IA desde el detalle de cualquier proyecto.</p>
          )}
        </ul>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .metric-card {
    background: var(--adm-card);
    border: 1px solid var(--adm-border);
    border-radius: 16px;
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .m-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .m-label {
    font-family: var(--adm-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--adm-mute);
    font-weight: 700;
  }

  .m-pill {
    font-family: var(--adm-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #0b110d;
    background: var(--adm-lime);
    padding: 0.12rem 0.48rem;
    border-radius: 999px;
  }

  .m-pill-alt {
    font-family: var(--adm-font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    color: var(--adm-mate-light);
    background: rgba(151, 188, 98, 0.14);
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
  }

  .m-value-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.5rem 0 0.35rem;
  }

  .m-num {
    font-family: var(--adm-font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--adm-ink);
    line-height: 1;
  }

  .text-lime { color: var(--adm-lime); }
  .text-mate-light { color: var(--adm-mate-light); }

  .m-sub { font-size: 0.78rem; color: var(--adm-mute); }
  .m-foot { font-size: 0.74rem; color: var(--adm-mute); }

  .m-bar {
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    margin-top: 0.45rem;
    overflow: hidden;
  }

  .m-bar-fill { height: 100%; border-radius: 999px; }
  .bg-lime { background: var(--adm-lime); }

  /* Quick Actions Bar */
  .quick-actions-bar {
    background: rgba(21, 33, 25, 0.78);
    border: 1px solid var(--adm-border);
    border-radius: 14px;
    padding: 0.75rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .qa-title {
    font-family: var(--adm-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--adm-mute);
  }

  .qa-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  /* Attention Banner */
  .attention-banner {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.32);
    border-radius: 14px;
    padding: 0.95rem 1.15rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .att-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: #fbbf24;
  }

  .att-list { display: flex; flex-wrap: wrap; gap: 0.65rem; }

  .att-item {
    background: #101913;
    border: 1px solid var(--adm-border);
    border-radius: 10px;
    padding: 0.4rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .att-link { font-size: 0.82rem; color: var(--adm-ink); text-decoration: none; font-weight: 600; }

  /* Analytics Grid */
  .analytics-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .chart-legend {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--adm-font-mono);
    font-size: 0.68rem;
    color: var(--adm-mute);
  }

  .lg-item { display: inline-flex; align-items: center; gap: 5px; }
  .lg-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; }
  .lg-created { background: rgba(151, 188, 98, 0.55); }
  .lg-accepted { background: var(--adm-lime); }

  .svg-chart-wrap {
    margin-top: 0.85rem;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid var(--adm-border);
    border-radius: 12px;
    padding: 0.75rem 0.5rem 0.35rem;
  }

  .bar-chart-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .funnel-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.85rem;
  }

  .funnel-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--adm-ink);
    margin-bottom: 4px;
  }

  .funnel-meta strong { font-family: var(--adm-font-mono); color: var(--adm-lime); }

  .funnel-track {
    height: 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .funnel-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.35s ease;
  }

  /* Grid 2 */
  .dashboard-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
