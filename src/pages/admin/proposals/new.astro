---
// filepath: src/pages/admin/proposals/new.astro
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProposalForm from "../../../components/admin/ProposalForm";
import ClientModal from "../../../components/admin/ClientModal";
import { supabaseAdmin } from "../../../lib/supabase";

const fromTemplateId = Astro.url.searchParams.get("from_template");

// 1. Clientes
const { data: clients } = await supabaseAdmin
  .from("clients")
  .select("id, name, company, email, phone")
  .order("name", { ascending: true });

// 2. Plantillas guardadas
const { data: templates } = await supabaseAdmin
  .from("proposals")
  .select("*")
  .eq("is_template", true)
  .order("created_at", { ascending: false });

// 3. Si vino from_template, traer los datos de esa plantilla
let initialData: any = null;
if (fromTemplateId) {
  const { data: tpl } = await supabaseAdmin
    .from("proposals")
    .select("*")
    .eq("id", fromTemplateId)
    .single();
  if (tpl) {
    initialData = {
      project_title: tpl.project_title,
      value_phrase: tpl.value_phrase,
      challenge: tpl.challenge,
      solution: tpl.solution,
      includes: tpl.includes,
      excludes: tpl.excludes,
      investment: tpl.investment,
      timeline: tpl.timeline,
      roi_table: tpl.roi_table,
      whatsapp_message: tpl.whatsapp_message,
      notes: tpl.notes,
      cloned_from: tpl.id,
    };
  }
}
---

<AdminLayout title="Nueva Propuesta Comercial" activeSection="proposals">
  <div class="new-proposal-page">
    <div class="page-top-banner">
      <div>
        <h2>Crear Propuesta & Magic Link</h2>
        <p>
          Completá el alcance, diagnóstico y planes de inversión. Podés partir de una plantilla prediseñada o crearla desde cero.
        </p>
      </div>
      <div class="banner-actions">
        <ClientModal client:load buttonLabel="+ Crear Nuevo Cliente Primero" />
      </div>
    </div>

    <ProposalForm
      client:load
      clients={clients || []}
      templates={templates || []}
      initial={initialData}
      isEdit={false}
    />
  </div>
</AdminLayout>

<style>
  .new-proposal-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-top-banner {
    background: var(--adm-card);
    border: 1px solid var(--adm-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .page-top-banner h2 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--adm-ink);
  }

  .page-top-banner p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--adm-mute);
  }
</style>
