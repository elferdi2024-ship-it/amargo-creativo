---
// filepath: src/pages/facturacion.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { whatsappHref } from "../lib/format";

const waMessage = "Hola Amargo Creativo, quiero consultar por el desarrollo de un Sistema Web B2B / Portal de Clientes con Facturación CFE para mi empresa.";
const waLink = whatsappHref(waMessage);

const title = "Sistemas Web B2B, Portales de Clientes & Facturación CFE | Amargo Creativo";
const description = "Desarrollo de software a medida para empresas y agencias en Uruguay: Portales de clientes extranet con Magic Link, facturación electrónica CFE DGI, conciliación bancaria y workflows automáticos por WhatsApp.";
---

<Layout title={title} description={description} canonicalUrl="https://amargo-creativo.pages.dev/facturacion">
  <Navbar />

  <main class="facturacion-page">
    <!-- Header de Sección -->
    <header class="fac-hero">
      <div class="fac-container">
        <div class="fac-top-bar">
          <div class="section-label">
            <span class="num">B2B SUITE</span>
            <span>SOFTWARE A MEDIDA · PORTALES EXTRANET · URUGUAY & REGIONAL</span>
          </div>
          <div class="fac-telemetry-stamp">DGI CFE COMPLIANT // POSTGRESQL RLS // LCP &lt;0.8s</div>
        </div>

        <h1 class="fac-h1">
          Sistemas Web B2B, Portales de Clientes y <em>Facturación CFE</em>
        </h1>

        <p class="fac-lead">
          Reemplazá planillas desactualizadas de Excel y ERPs lentos de los 90. Desarrollamos infraestructura digital a medida: portales de autoservicio para tus clientes con Magic Link, conciliación de transferencias bancarias (BROU, Itaú, Santander) y facturación electrónica CFE conectada en tiempo real.
        </p>

        <div class="fac-specs-chips">
          <span class="spec-chip">⚡ NEXT.JS 15 & ASTRO RSC</span>
          <span class="spec-chip">🔒 MAGIC LINK PASSWORDLESS</span>
          <span class="spec-chip">🇺🇾 CFE DGI COMPLIANT</span>
          <span class="spec-chip">💬 WHATSAPP CLOUD API</span>
          <span class="spec-chip">⏱ TIEMPO DE CARGA &lt;0.8s</span>
        </div>

        <div class="fac-cta-row">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="fac-btn-primary" data-cursor="WHATSAPP">
            <span>AGENDAR DEMO TÉCNICA</span> ↗
          </a>
          <a href="#simulator" class="fac-btn-secondary" data-cursor="SIMULADOR">
            <span>PROBAR SIMULADOR EN VIVO</span> ↓
          </a>
        </div>
      </div>
    </header>

    <!-- Interactive Live Simulator Display -->
    <section class="fac-mockup-section" id="simulator">
      <div class="fac-container">
        <div class="simulator-wrapper tactile-card">
          <!-- Terminal Header -->
          <div class="term-header">
            <div class="term-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="term-title">AMARGO_CORE // B2B CLIENT EXTRANET & ENGINE v3.2</div>
            <div class="term-live-tag">● SISTEMA OPERATIVO ACTIVO</div>
          </div>

          <!-- Navigation Tabs -->
          <div class="sim-nav-bar" role="tablist" aria-label="Simulador de Módulos B2B">
            <button class="sim-tab active" data-tab="tab-extranet" role="tab" aria-selected="true" aria-controls="tab-extranet">
              <span class="tab-icon">👤</span> 01. PORTAL CLIENTE (EXTRANET)
            </button>
            <button class="sim-tab" data-tab="tab-cfe" role="tab" aria-selected="false" aria-controls="tab-cfe">
              <span class="tab-icon">🧾</span> 02. FACTURACIÓN CFE & DGI
            </button>
            <button class="sim-tab" data-tab="tab-whatsapp" role="tab" aria-selected="false" aria-controls="tab-whatsapp">
              <span class="tab-icon">💬</span> 03. WORKFLOWS WHATSAPP
            </button>
            <button class="sim-tab" data-tab="tab-security" role="tab" aria-selected="false" aria-controls="tab-security">
              <span class="tab-icon">🛡️</span> 04. TELEMETRÍA & SEGURIDAD
            </button>
          </div>

          <div class="term-body">
            <!-- TAB 1: Portal Cliente (Extranet) -->
            <div class="sim-panel active" id="tab-extranet" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">VISTA DEL CLIENTE FINAL</span>
                  <h4>Portal de Autoservicio con Acceso Magic Link</h4>
                  <p>Tus clientes entran sin contraseñas con un enlace firmado de un solo clic. Ven sus presupuestos aprobados, descargan facturas fiscales y abonan saldos pendientes.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot">●</span> SESIÓN SEGURA: <strong>estudio@barrio.uy</strong>
                  </div>
                </div>
              </div>

              <div class="term-metrics-grid">
                <div class="metric-card">
                  <span class="mc-label">Saldo Pendiente</span>
                  <div class="mc-val mc-green">$ 0,00 UYU</div>
                  <span class="mc-sub">Al día · Próxima cuota 01 OCT</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Presupuestos Aprobados</span>
                  <div class="mc-val mc-bone">3 / 3</div>
                  <span class="mc-sub">Firma digital registrada</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Tiempo de Respuesta</span>
                  <div class="mc-val mc-electric">0.42s</div>
                  <span class="mc-sub">Cache Edge Cloudflare</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Documentos Disponibles</span>
                  <div class="mc-val mc-bone">18 PDFs</div>
                  <span class="mc-sub">Descarga inmediata sin fricción</span>
                </div>
              </div>

              <!-- Interactive Ledger Table Preview -->
              <div class="term-table-wrap">
                <table class="term-table">
                  <thead>
                    <tr>
                      <th>DOCUMENTO</th>
                      <th>CONCEPTO</th>
                      <th>FECHA</th>
                      <th>MONTO</th>
                      <th>ESTADO</th>
                      <th>ACCIÓN</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="font-mono">e-Factura #A-0492</td>
                      <td>Desarrollo Plataforma Inmobiliaria Web (Fase 2)</td>
                      <td>10 SEP 2026</td>
                      <td class="font-mono"><strong>$ 54.000 UYU</strong></td>
                      <td><span class="pill-paid">● PAGADO (BROU)</span></td>
                      <td><a href={waLink} target="_blank" class="table-action-btn">Descargar PDF ↓</a></td>
                    </tr>
                    <tr>
                      <td class="font-mono">e-Factura #A-0480</td>
                      <td>Infraestructura Cloudflare Edge & Optimización LCP</td>
                      <td>15 AGO 2026</td>
                      <td class="font-mono"><strong>$ 38.500 UYU</strong></td>
                      <td><span class="pill-paid">● PAGADO (ITAÚ)</span></td>
                      <td><a href={waLink} target="_blank" class="table-action-btn">Descargar PDF ↓</a></td>
                    </tr>
                    <tr>
                      <td class="font-mono">Presupuesto #PR-2026-09</td>
                      <td>Módulo de Conciliación Bancaria y Alertas WhatsApp</td>
                      <td>01 SEP 2026</td>
                      <td class="font-mono"><strong>$ 42.000 UYU</strong></td>
                      <td><span class="pill-approved">✓ APROBADO</span></td>
                      <td><a href={waLink} target="_blank" class="table-action-btn">Ver Detalle ↗</a></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- TAB 2: Facturación CFE & DGI -->
            <div class="sim-panel" id="tab-cfe" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">CUMPLIMIENTO TRIBUTARIO URUGUAY</span>
                  <h4>Emisión de Comprobantes Fiscales Electrónicos (CFE)</h4>
                  <p>Mapeo directo con DGI. Cálculo estricto de IVA básico (22%), IVA mínimo (10%) y operaciones exentas. Generación de firmas XML y representación gráfica oficial.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#4ade80;">●</span> CAE AUTORIZADO DGI N° 2026-90412
                  </div>
                </div>
              </div>

              <div class="term-metrics-grid">
                <div class="metric-card">
                  <span class="mc-label">Total Emitido (Mes)</span>
                  <div class="mc-val mc-bone">$ 428.500</div>
                  <span class="mc-sub">18 Comprobantes válidos</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">IVA 22% Liquidado</span>
                  <div class="mc-val mc-yellow">$ 77.270</div>
                  <span class="mc-sub">Discriminado automático</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">CFE Aprobados DGI</span>
                  <div class="mc-val mc-green">100%</div>
                  <span class="mc-sub">0 rechazos en validación</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Tiempo Firma Digital</span>
                  <div class="mc-val mc-electric">320ms</div>
                  <span class="mc-sub">Hash criptográfico RSA</span>
                </div>
              </div>

              <div class="term-table-wrap">
                <table class="term-table">
                  <thead>
                    <tr>
                      <th>TIPO CFE</th>
                      <th>SERIE & NÚMERO</th>
                      <th>RECEPTOR (RUT)</th>
                      <th>SUBTOTAL</th>
                      <th>IVA 22%</th>
                      <th>TOTAL FINAL</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><span class="cfe-badge">111 - e-Factura</span></td>
                      <td class="font-mono">Serie A #0492</td>
                      <td>Barrio Inmobiliaria (RUT 218903440012)</td>
                      <td class="font-mono">$ 44.262</td>
                      <td class="font-mono">$ 9.738</td>
                      <td class="font-mono"><strong>$ 54.000 UYU</strong></td>
                    </tr>
                    <tr>
                      <td><span class="cfe-badge">101 - e-Ticket</span></td>
                      <td class="font-mono">Serie A #0493</td>
                      <td>Consumidor Final (CI 4.892.110-3)</td>
                      <td class="font-mono">$ 15.574</td>
                      <td class="font-mono">$ 3.426</td>
                      <td class="font-mono"><strong>$ 19.000 UYU</strong></td>
                    </tr>
                    <tr>
                      <td><span class="cfe-badge">112 - e-Factura Export</span></td>
                      <td class="font-mono">Serie B #0104</td>
                      <td>Tech Studio LLC (Delaware, USA)</td>
                      <td class="font-mono">US$ 2.400</td>
                      <td class="font-mono">Exento (0%)</td>
                      <td class="font-mono"><strong>US$ 2.400</strong></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- TAB 3: Workflows WhatsApp -->
            <div class="sim-panel" id="tab-whatsapp" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">COBROS SIN LLAMADAS INCÓMODAS</span>
                  <h4>Automatización de Mensajería & Conciliación por WhatsApp</h4>
                  <p>Cuando emitís una factura o un pago ingresa en tu cuenta bancaria, el webhook dispara una alerta instantánea con el link directo para ver el recibo o pagar con QR.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#25d366;">●</span> META WHATSAPP CLOUD API ONLINE
                  </div>
                </div>
              </div>

              <div class="wa-chat-simulator">
                <div class="wa-message-bubble incoming">
                  <div class="wa-msg-meta">AMARGO B2B BOT · Hace 2 minutos</div>
                  <p>👋 Hola <strong>Martín</strong>. Te confirmamos que se acreditó la transferencia bancaria (BROU) correspondiente a la <strong>e-Factura #A-0492</strong> por <strong>$ 54.000 UYU</strong>.</p>
                  <p>Podés descargar tu comprobante fiscal firmado y ver tu estado de cuenta actualizado en tu portal:</p>
                  <div class="wa-msg-card">
                    <span class="wa-card-title">📄 e-Factura_A-0492_Barrio.pdf</span>
                    <span class="wa-card-sub">DGI CFE · Descarga instantánea</span>
                  </div>
                  <span class="wa-time">14:32 ✓✓</span>
                </div>

                <div class="wa-message-bubble outgoing">
                  <div class="wa-msg-meta">CLIENTE (BARRIO.UY)</div>
                  <p>Excelente, muchas gracias por la rapidez. Descargada y archivada.</p>
                  <span class="wa-time">14:33</span>
                </div>
              </div>
            </div>

            <!-- TAB 4: Telemetría & Seguridad -->
            <div class="sim-panel" id="tab-security" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">ARQUITECTURA CLOUD A MEDIDA</span>
                  <h4>Base de Datos Aislada & Registro Inmutable de Auditoría</h4>
                  <p>A diferencia de sistemas monolíticos obsoletos, cada cliente opera con aislamiento Row-Level Security (RLS) sobre PostgreSQL. Trazabilidad completa de cada acción y cobro.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#38bdf8;">●</span> POSTGRESQL RLS ENCRYPTED
                  </div>
                </div>
              </div>

              <div class="security-log-terminal">
                <div class="sec-log-row">
                  <span class="log-time">[14:31:02.108]</span>
                  <span class="log-code">POST /api/cfe/emit</span>
                  <span class="log-status ok">200 OK</span>
                  <span class="log-desc">CFE #A-0492 firmado digitalmente con certificado digital DGI (218ms).</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:31:04.450]</span>
                  <span class="log-code">WEBHOOK /bank/brou</span>
                  <span class="log-status ok">MATCH</span>
                  <span class="log-desc">Conciliación automática: Transferencia BROU #89104 coincide por $ 54.000.</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:31:05.120]</span>
                  <span class="log-code">QUEUE /wa/notify</span>
                  <span class="log-status ok">SENT</span>
                  <span class="log-desc">Mensaje de confirmación entregado al cliente via WhatsApp Cloud API.</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:32:40.890]</span>
                  <span class="log-code">AUTH /magic-link</span>
                  <span class="log-status ok">VERIFIED</span>
                  <span class="log-desc">Acceso concedido a estudio@barrio.uy. Token JWT revocado post-uso (RLS activo).</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02. Pilares de la Suite B2B -->
    <section class="fac-features">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">02</span> MÓDULOS DEL SISTEMA</div>
          <h2>Ingeniería pensada para la <em>operativa real</em></h2>
          <p class="section-lead-text">No vendemos software genérico enlatado. Diseñamos la solución exacta que se adapta a las reglas de tu negocio, tu equipo y tus clientes.</p>
        </div>

        <div class="fac-features-grid">
          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num">01</span>
              <span class="feat-badge">EXTRANET</span>
            </div>
            <h3>Portales de Clientes con Magic Link</h3>
            <p>Tus clientes acceden con un enlace seguro a su estado de cuenta en vivo, historial de compras, presupuestos interactivos con firma digital y comprobantes fiscales descargables sin contraseñas.</p>
            <div class="feat-tags">
              <span>#PASSWORDLESS</span>
              <span>#ESTADO EN VIVO</span>
              <span>#FIRMA DIGITAL</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num">02</span>
              <span class="feat-badge">CFE DGI</span>
            </div>
            <h3>Facturación Electrónica CFE (Uruguay)</h3>
            <p>Módulo fiscal 100% homologable con DGI. Soporte para e-Factura, e-Ticket, e-Factura Exportación y Notas de Crédito, con cálculo de IVA 22% / 10% y emisión de PDFs oficiales con código QR.</p>
            <div class="feat-tags">
              <span>#CFE URUGUAY</span>
              <span>#IVA 22%</span>
              <span>#RUT EMPRESAS</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num">03</span>
              <span class="feat-badge">COBROS</span>
            </div>
            <h3>Conciliación Bancaria & Pasarelas</h3>
            <p>Automatizá el registro de transferencias bancarias (BROU, Itaú, Santander, Scotiabank) y aceptá cobros inmediatos con Mercado Pago Checkout Pro o Stripe para clientes en el exterior.</p>
            <div class="feat-tags">
              <span>#BROU</span>
              <span>#ITAÚ</span>
              <span>#MERCADO PAGO</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num">04</span>
              <span class="feat-badge">AUTOMATIZACIÓN</span>
            </div>
            <h3>Disparadores WhatsApp Cloud API</h3>
            <p>Notificá automáticamente al cliente cuando un presupuesto fue emitido, un pago fue acreditado o una factura está próxima a vencer. Cero llamadas incómodas, cobranzas 100% fluidas.</p>
            <div class="feat-tags">
              <span>#WHATSAPP API</span>
              <span>#WEBHOOKS</span>
              <span>#RECORDATORIOS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. Comparativa Técnica (Amargo vs ERPs Tradicionales) -->
    <section class="fac-comparison">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">03</span> DIFERENCIACIÓN TÉCNICA</div>
          <h2>Amargo a medida <em>vs</em> ERPs Tradicionales</h2>
          <p class="section-lead-text">Por qué las empresas que buscan alta conversión y control eligen software propietario en vez de licencias mensuales infladas.</p>
        </div>

        <div class="comparison-table-wrap tactile-card">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>CRITERIO TÉCNICO & OPERATIVO</th>
                <th class="col-amargo">SISTEMA AMARGO A MEDIDA</th>
                <th class="col-generic">ERPS TRADICIONALES (SAP / ODOO / MEMORY)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Velocidad & Carga Móvil (LCP)</strong></td>
                <td class="col-amargo"><span class="check">✓</span> <strong>&lt; 0.8 segundos</strong> (Next.js / Astro Edge)</td>
                <td class="col-generic"><span class="cross">✕</span> 4.5s a 9s (Sistemas pesados basados en servidor)</td>
              </tr>
              <tr>
                <td><strong>Experiencia del Cliente Final</strong></td>
                <td class="col-amargo"><span class="check">✓</span> Portal moderno, Magic Link sin contraseñas, UI premium</td>
                <td class="col-generic"><span class="cross">✕</span> Formularios complejos, captchas, UX anticuada</td>
              </tr>
              <tr>
                <td><strong>Notificaciones & Cobros</strong></td>
                <td class="col-amargo"><span class="check">✓</span> WhatsApp Cloud API nativo con link directo de pago</td>
                <td class="col-generic"><span class="cross">✕</span> Emails genéricos que caen en la carpeta de Spam</td>
              </tr>
              <tr>
                <td><strong>Costos Recurrentes de Licencia</strong></td>
                <td class="col-amargo"><span class="check">✓</span> Código de tu propiedad. Sin cobro por usuario adicional</td>
                <td class="col-generic"><span class="cross">✕</span> Pagos mensuales perpetuos que aumentan por usuario</td>
              </tr>
              <tr>
                <td><strong>Adaptabilidad a tus Reglas</strong></td>
                <td class="col-amargo"><span class="check">✓</span> 100% adaptable a tu flujo comercial específico</td>
                <td class="col-generic"><span class="cross">✕</span> Tu empresa debe forzarse a la estructura del software</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 04. Ecosistema de Integraciones -->
    <section class="fac-integrations">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">04</span> INTEGRACIONES NATIVAS</div>
          <h2>Conectado con tu <em>banca y herramientas</em></h2>
        </div>

        <div class="integrations-grid">
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>DGI CFE URUGUAY</h4>
            <p>e-Factura, e-Ticket, CAE correlativo oficial y firma XML.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>BROU (BANCO REPÚBLICA)</h4>
            <p>Conciliación de transferencias y depósitos bancarios locales.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>BANCO ITAÚ</h4>
            <p>Integración de cuentas comerciales en pesos y dólares.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>SANTANDER URUGUAY</h4>
            <p>Monitoreo de acreditaciones en cuentas corporativas.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>MERCADO PAGO</h4>
            <p>Cobros online inmediatos con tarjetas y saldo digital.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>WHATSAPP CLOUD API</h4>
            <p>Webhooks oficiales de Meta para alertas y comprobantes.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>STRIPE PAYMENTS</h4>
            <p>Cobros internacionales en USD/EUR para clientes en el exterior.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● CONECTOR ACTIVO</span>
            <h4>POSTGRESQL & SUPABASE</h4>
            <p>Base de datos relacional con Row-Level Security y backups en caliente.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 05. Roadmap de Entrega en 15 Días -->
