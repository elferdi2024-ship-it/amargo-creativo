---
// filepath: src/pages/facturacion.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RollText from '../components/motion/RollText.astro';
import { whatsappHref } from "../lib/format";

const waMessage = "Hola Amargo Creativo, quiero consultar por el desarrollo de un Sistema Web B2B / Portal de Clientes con Facturación CFE para mi empresa.";
const waLink = whatsappHref(waMessage);

const title = "Sistemas B2B, Portales & Facturación CFE | Amargo Creativo";
const description = "Software B2B a medida en Uruguay: portales extranet con Magic Link, facturación electrónica CFE DGI, conciliación bancaria y automatización WhatsApp.";
const canonicalUrl = "https://amargo-creativo.pages.dev/facturacion/";
const ogImage = "https://amargo-creativo.pages.dev/og-image-v3.jpg";

const b2bComparisons = [
  {
    criterio: "Experiencia de Uso & Móvil",
    amargo: "Portal ágil y app PWA con Magic Link sin contraseñas y Core Web Vitals en verde",
    generic: "Pantallas de escritorio viejas, captchas y sesiones lentas de 5 a 9 segundos"
  },
  {
    criterio: "Cobros & Notificaciones",
    amargo: "WhatsApp Cloud API nativo con link de descarga y conciliación BROU / Itaú / MP",
    generic: "Correos genéricos que caen en Spam y seguimiento manual en planillas Excel"
  },
  {
    criterio: "Licencias & Propiedad",
    amargo: "Código 100% tuyo, sin cobro mensual por usuario ni licencias perpetuas",
    generic: "Cuotas recurrentes que suben cada vez que sumás un usuario o sucursal"
  },
  {
    criterio: "Adaptabilidad Operativa",
    amargo: "Modelado exacto a tus reglas comerciales, IVA, presupuestos y flujos reales",
    generic: "Tu equipo debe adaptarse a la estructura rígida de un ERP enlatado"
  },
  {
    criterio: "Seguridad & Trazabilidad",
    amargo: "PostgreSQL con Row-Level Security (RLS) y registro inmutable de cada acción",
    generic: "Servidores monolíticos difíciles de auditar y costosos de mantener"
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  image={ogImage}
  breadcrumbs={[
    { name: 'Inicio', url: 'https://amargo-creativo.pages.dev/' },
    { name: 'Sistemas B2B', url: canonicalUrl }
  ]}
>
  <Navbar />

  <main id="main-content" class="facturacion-page">
    <!-- Header de Sección -->
    <header class="fac-hero">
      <div class="fac-container">
        <div class="fac-top-bar">
          <div class="section-label">
            <span class="num">B2B SUITE</span>
            <span>SOFTWARE A MEDIDA · PORTALES EXTRANET · URUGUAY &amp; REGIONAL</span>
          </div>
          <div class="fac-telemetry-stamp">DGI CFE COMPLIANT // POSTGRESQL RLS // EDGE CLOUD</div>
        </div>

        <h1 class="fac-h1" data-reveal-words>
          Sistemas Web B2B, Portales de Clientes y <em>Facturación CFE</em>
        </h1>

        <p class="fac-lead">
          Reemplazá planillas de Excel dispersas y ERPs rígidos de los 90. Desarrollamos infraestructura propia: portales de autoservicio con Magic Link, conciliación bancaria local (BROU, Itaú, Santander) y facturación electrónica CFE conectada en tiempo real.
        </p>

        <div class="fac-specs-chips" aria-label="Especificaciones técnicas">
          <span class="spec-chip">⚡ NEXT.JS 15 &amp; ASTRO</span>
          <span class="spec-chip">🔒 MAGIC LINK PASSWORDLESS</span>
          <span class="spec-chip">🇺🇾 CFE DGI COMPLIANT</span>
          <span class="spec-chip">💬 WHATSAPP CLOUD API</span>
          <span class="spec-chip">🏦 BROU · ITAÚ · MP</span>
        </div>

        <div class="fac-cta-row">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="fac-btn-primary ink-fill magnetic-btn" data-cursor="WHATSAPP">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="AGENDAR DEMO TÉCNICA" arrow="diag" />
          </a>
          <a href="#simulator" class="fac-btn-secondary ink-fill" data-cursor="SIMULADOR">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="PROBAR SIMULADOR EN VIVO" arrow="right" />
          </a>
        </div>
      </div>
    </header>

    <!-- Interactive Live Simulator Display -->
    <section class="fac-mockup-section" id="simulator">
      <div class="fac-container">
        <div class="simulator-wrapper tactile-card">
          <!-- Terminal Header -->
          <div class="term-header">
            <div class="term-dots" aria-hidden="true">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="term-title">AMARGO_CORE // B2B CLIENT EXTRANET v3.2</div>
            <div class="term-live-tag">● ACTIVO</div>
          </div>

          <!-- Navigation Tabs (swipeable rail en mobile) -->
          <div class="sim-nav-bar" role="tablist" aria-label="Simulador de Módulos B2B">
            <button type="button" class="sim-tab active" data-tab="tab-extranet" role="tab" aria-selected="true" aria-controls="tab-extranet">
              <span class="tab-icon" aria-hidden="true">👤</span> 01. EXTRANET
            </button>
            <button type="button" class="sim-tab" data-tab="tab-cfe" role="tab" aria-selected="false" aria-controls="tab-cfe">
              <span class="tab-icon" aria-hidden="true">🧾</span> 02. CFE &amp; DGI
            </button>
            <button type="button" class="sim-tab" data-tab="tab-whatsapp" role="tab" aria-selected="false" aria-controls="tab-whatsapp">
              <span class="tab-icon" aria-hidden="true">💬</span> 03. WHATSAPP
            </button>
            <button type="button" class="sim-tab" data-tab="tab-security" role="tab" aria-selected="false" aria-controls="tab-security">
              <span class="tab-icon" aria-hidden="true">🛡️</span> 04. SEGURIDAD RLS
            </button>
          </div>

          <div class="term-body">
            <!-- TAB 1: Portal Cliente (Extranet) -->
            <div class="sim-panel active" id="tab-extranet" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">VISTA DEL CLIENTE FINAL</span>
                  <h4>Portal de Autoservicio con Acceso Magic Link</h4>
                  <p>Tus clientes entran sin contraseñas con un enlace firmado de un clic. Revisan presupuestos aprobados, descargan comprobantes fiscales y concilian saldos.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" aria-hidden="true">●</span> SESIÓN: <strong>admin@lomax.uy</strong>
                  </div>
                </div>
              </div>

              <div class="term-metrics-grid">
                <div class="metric-card">
                  <span class="mc-label">Saldo Pendiente</span>
                  <div class="mc-val mc-green tabular">$ 0,00</div>
                  <span class="mc-sub">Al día · Próxima 01 OCT</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Presupuestos</span>
                  <div class="mc-val mc-bone tabular">3 / 3</div>
                  <span class="mc-sub">Firma digital activa</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Latencia Edge</span>
                  <div class="mc-val mc-electric tabular">38ms</div>
                  <span class="mc-sub">Cloudflare Anycast</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Documentos</span>
                  <div class="mc-val mc-bone tabular">18 PDFs</div>
                  <span class="mc-sub">Descarga sin fricción</span>
                </div>
              </div>

              <div class="term-table-wrap">
                <table class="term-table">
                  <thead>
                    <tr>
                      <th>DOCUMENTO</th>
                      <th>CONCEPTO</th>
                      <th>FECHA</th>
                      <th>MONTO</th>
                      <th>ESTADO</th>
                      <th>ACCIÓN</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="font-mono">e-Factura #A-0492</td>
                      <td>Portal LOMAX Propiedades &amp; Gestión de Leads (Fase 2)</td>
                      <td>10 SEP 2026</td>
                      <td class="font-mono"><strong>$ 54.000 UYU</strong></td>
                      <td><span class="pill-paid">● PAGADO (BROU)</span></td>
                      <td><a href={waLink} target="_blank" rel="noopener noreferrer" class="table-action-btn">PDF ↓</a></td>
                    </tr>
                    <tr>
                      <td class="font-mono">e-Factura #A-0480</td>
                      <td>Plataforma Barrio.uy CivicTech &amp; Mapa de Reportes</td>
                      <td>15 AGO 2026</td>
                      <td class="font-mono"><strong>$ 46.500 UYU</strong></td>
                      <td><span class="pill-paid">● PAGADO (ITAÚ)</span></td>
                      <td><a href={waLink} target="_blank" rel="noopener noreferrer" class="table-action-btn">PDF ↓</a></td>
                    </tr>
                    <tr>
                      <td class="font-mono">Presupuesto #PR-2026-09</td>
                      <td>Módulo Conciliación Bancaria &amp; Alertas WhatsApp</td>
                      <td>01 SEP 2026</td>
                      <td class="font-mono"><strong>$ 42.000 UYU</strong></td>
                      <td><span class="pill-approved">✓ APROBADO</span></td>
                      <td><a href={waLink} target="_blank" rel="noopener noreferrer" class="table-action-btn">Detalle ↗</a></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- TAB 2: Facturación CFE & DGI -->
            <div class="sim-panel" id="tab-cfe" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">CUMPLIMIENTO TRIBUTARIO URUGUAY</span>
                  <h4>Emisión de Comprobantes Fiscales Electrónicos (CFE)</h4>
                  <p>Mapeo directo con DGI. Cálculo estricto de IVA básico (22%), IVA mínimo (10%) y exportaciones exentas. Firma XML y representación gráfica oficial.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#4ade80;" aria-hidden="true">●</span> CAE DGI N° 2026-90412
                  </div>
                </div>
              </div>

              <div class="term-metrics-grid">
                <div class="metric-card">
                  <span class="mc-label">Emitido (Mes)</span>
                  <div class="mc-val mc-bone tabular">$ 428.5k</div>
                  <span class="mc-sub">18 Comprobantes</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">IVA 22%</span>
                  <div class="mc-val mc-yellow tabular">$ 77.2k</div>
                  <span class="mc-sub">Discriminado</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Aprobados DGI</span>
                  <div class="mc-val mc-green tabular">100%</div>
                  <span class="mc-sub">0 rechazos</span>
                </div>
                <div class="metric-card">
                  <span class="mc-label">Firma RSA</span>
                  <div class="mc-val mc-electric tabular">320ms</div>
                  <span class="mc-sub">Hash certificado</span>
                </div>
              </div>

              <div class="term-table-wrap">
                <table class="term-table">
                  <thead>
                    <tr>
                      <th>TIPO CFE</th>
                      <th>SERIE &amp; NÚMERO</th>
                      <th>RECEPTOR (RUT)</th>
                      <th>SUBTOTAL</th>
                      <th>IVA 22%</th>
                      <th>TOTAL FINAL</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><span class="cfe-badge">111 - e-Factura</span></td>
                      <td class="font-mono">Serie A #0492</td>
                      <td>LOMAX Propiedades SRL (RUT 218903440012)</td>
                      <td class="font-mono">$ 44.262</td>
                      <td class="font-mono">$ 9.738</td>
                      <td class="font-mono"><strong>$ 54.000 UYU</strong></td>
                    </tr>
                    <tr>
                      <td><span class="cfe-badge">101 - e-Ticket</span></td>
                      <td class="font-mono">Serie A #0493</td>
                      <td>Distribuidora El Remate (CI 4.892.110-3)</td>
                      <td class="font-mono">$ 15.574</td>
                      <td class="font-mono">$ 3.426</td>
                      <td class="font-mono"><strong>$ 19.000 UYU</strong></td>
                    </tr>
                    <tr>
                      <td><span class="cfe-badge">112 - Exportación</span></td>
                      <td class="font-mono">Serie B #0104</td>
                      <td>Tech Studio LLC (Delaware, USA)</td>
                      <td class="font-mono">US$ 2.400</td>
                      <td class="font-mono">Exento (0%)</td>
                      <td class="font-mono"><strong>US$ 2.400</strong></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- TAB 3: Workflows WhatsApp -->
            <div class="sim-panel" id="tab-whatsapp" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">COBROS SIN LLAMADAS INCÓMODAS</span>
                  <h4>Automatización de Mensajería &amp; Conciliación por WhatsApp</h4>
                  <p>Cuando emitís una factura o se acredita una transferencia, el webhook dispara una alerta automática con el comprobante listo para descargar.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#25d366;" aria-hidden="true">●</span> META WHATSAPP API ONLINE
                  </div>
                </div>
              </div>

              <div class="wa-chat-simulator">
                <div class="wa-message-bubble incoming">
                  <div class="wa-msg-meta">AMARGO B2B BOT · Hace 2 minutos</div>
                  <p>👋 Hola <strong>Martín</strong>. Confirmamos la acreditación BROU de la <strong>e-Factura #A-0492</strong> por <strong>$ 54.000 UYU</strong>.</p>
                  <p>Ya podés descargar tu comprobante fiscal firmado desde tu portal:</p>
                  <div class="wa-msg-card">
                    <span class="wa-card-title">📄 e-Factura_A-0492_LOMAX.pdf</span>
                    <span class="wa-card-sub">DGI CFE · Descarga instantánea</span>
                  </div>
                  <span class="wa-time">14:32 ✓✓</span>
                </div>

                <div class="wa-message-bubble outgoing">
                  <div class="wa-msg-meta">CLIENTE (LOMAX)</div>
                  <p>Impecable, descargada y enviada al estudio contable.</p>
                  <span class="wa-time">14:33</span>
                </div>
              </div>
            </div>

            <!-- TAB 4: Telemetría & Seguridad -->
            <div class="sim-panel" id="tab-security" role="tabpanel">
              <div class="panel-banner">
                <div class="pb-left">
                  <span class="pb-tag">ARQUITECTURA CLOUD A MEDIDA</span>
                  <h4>Base de Datos Aislada &amp; Auditoría Inmutable</h4>
                  <p>Cada empresa opera con aislamiento Row-Level Security (RLS) en PostgreSQL y trazabilidad completa de emisiones, accesos Magic Link y cobros.</p>
                </div>
                <div class="pb-right">
                  <div class="client-auth-pill">
                    <span class="auth-dot" style="background:#38bdf8;" aria-hidden="true">●</span> POSTGRESQL RLS ENCRYPTED
                  </div>
                </div>
              </div>

              <div class="security-log-terminal">
                <div class="sec-log-row">
                  <span class="log-time">[14:31:02.108]</span>
                  <span class="log-code">POST /api/cfe/emit</span>
                  <span class="log-status ok">200 OK</span>
                  <span class="log-desc">CFE #A-0492 firmado digitalmente con certificado DGI (218ms).</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:31:04.450]</span>
                  <span class="log-code">WEBHOOK /bank/brou</span>
                  <span class="log-status ok">MATCH</span>
                  <span class="log-desc">Conciliación automática: Transferencia BROU #89104 coincide por $ 54.000.</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:31:05.120]</span>
                  <span class="log-code">QUEUE /wa/notify</span>
                  <span class="log-status ok">SENT</span>
                  <span class="log-desc">Confirmación entregada al cliente vía WhatsApp Cloud API.</span>
                </div>
                <div class="sec-log-row">
                  <span class="log-time">[14:32:40.890]</span>
                  <span class="log-code">AUTH /magic-link</span>
                  <span class="log-status ok">VERIFIED</span>
                  <span class="log-desc">Acceso concedido a admin@lomax.uy. Token revocado post-uso (RLS activo).</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02. Pilares de la Suite B2B -->
    <section class="fac-features">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">02</span> MÓDULOS DEL SISTEMA</div>
          <h2 data-reveal-words>Ingeniería pensada para la <em>operativa real</em></h2>
          <p class="section-lead-text">No vendemos software genérico enlatado. Diseñamos el sistema exacto que se adapta a tus reglas comerciales, tu equipo y tus clientes.</p>
        </div>

        <div class="fac-features-grid">
          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num tabular">01</span>
              <span class="feat-badge">EXTRANET</span>
            </div>
            <h3>Portales de Clientes con Magic Link</h3>
            <p>Tus clientes acceden con un enlace seguro a su estado de cuenta en vivo, presupuestos interactivos con firma digital y comprobantes fiscales descargables sin contraseñas.</p>
            <div class="feat-tags">
              <span>#PASSWORDLESS</span>
              <span>#ESTADO EN VIVO</span>
              <span>#FIRMA DIGITAL</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num tabular">02</span>
              <span class="feat-badge">CFE DGI</span>
            </div>
            <h3>Facturación Electrónica CFE (Uruguay)</h3>
            <p>Módulo fiscal homologable con DGI. Soporte para e-Factura, e-Ticket, e-Factura Exportación y Notas de Crédito, con IVA 22% / 10% y PDFs oficiales con QR.</p>
            <div class="feat-tags">
              <span>#CFE URUGUAY</span>
              <span>#IVA 22%</span>
              <span>#RUT EMPRESAS</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num tabular">03</span>
              <span class="feat-badge">COBROS</span>
            </div>
            <h3>Conciliación Bancaria &amp; Pasarelas</h3>
            <p>Automatizá el registro de transferencias locales (BROU, Itaú, Santander, Scotiabank) y aceptá cobros inmediatos con Mercado Pago o Stripe para el exterior.</p>
            <div class="feat-tags">
              <span>#BROU</span>
              <span>#ITAÚ</span>
              <span>#MERCADO PAGO</span>
            </div>
          </div>

          <div class="feat-box tactile-card">
            <div class="feat-top">
              <span class="feat-num tabular">04</span>
              <span class="feat-badge">AUTOMATIZACIÓN</span>
            </div>
            <h3>Disparadores WhatsApp Cloud API</h3>
            <p>Notificá automáticamente cuando se emite un presupuesto, se acredita un pago o vence una factura. Cero llamadas incómodas y cobranzas ordenadas.</p>
            <div class="feat-tags">
              <span>#WHATSAPP API</span>
              <span>#WEBHOOKS</span>
              <span>#RECORDATORIOS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. Comparativa Técnica -->
    <section class="fac-comparison">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">03</span> DIFERENCIACIÓN TÉCNICA</div>
          <h2 data-reveal-words>Amargo a medida <em>vs</em> ERPs Tradicionales</h2>
          <p class="section-lead-text">Por qué las empresas modernas eligen software propietario en vez de licencias mensuales rígidas.</p>
        </div>

        <div class="comparison-table-wrap tactile-card">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>CRITERIO OPERATIVO</th>
                <th class="col-amargo">SISTEMA AMARGO A MEDIDA</th>
                <th class="col-generic">ERPS TRADICIONALES</th>
              </tr>
            </thead>
            <tbody>
              {b2bComparisons.map(row => (
                <tr>
                  <td class="col-key"><strong>{row.criterio}</strong></td>
                  <td class="col-amargo"><span class="check">✓</span> {row.amargo}</td>
                  <td class="col-generic"><span class="cross">✕</span> {row.generic}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 04. Ecosistema de Integraciones -->
    <section class="fac-integrations">
      <div class="fac-container">
        <div class="fac-section-head">
          <div class="section-label"><span class="num">04</span> INTEGRACIONES NATIVAS</div>
          <h2 data-reveal-words>Conectado con tu <em>banca y herramientas</em></h2>
        </div>

        <div class="integrations-grid">
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>DGI CFE URUGUAY</h4>
            <p>e-Factura, e-Ticket, CAE oficial y firma XML.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>BROU</h4>
            <p>Conciliación de transferencias y depósitos locales.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>BANCO ITAÚ</h4>
            <p>Cuentas comerciales en pesos y dólares.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>SANTANDER UY</h4>
            <p>Control de acreditaciones en cuentas empresa.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>MERCADO PAGO</h4>
            <p>Cobros online inmediatos con tarjetas y QR.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>WHATSAPP API</h4>
            <p>Webhooks de Meta para alertas y comprobantes.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>STRIPE PAYMENTS</h4>
            <p>Cobros internacionales en USD y EUR.</p>
          </div>
          <div class="integ-pill">
            <span class="integ-status">● ACTIVO</span>
            <h4>POSTGRESQL RLS</h4>
            <p>Base relacional aislada con backups continuos.</p>
          </div>
        </div>
      </div>
    </section>

