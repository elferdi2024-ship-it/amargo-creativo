<script>
  const haptic = () => {
    if ('vibrate' in navigator) {
      try { navigator.vibrate(8); } catch {}
    }
  };

  // Switcher interactivo de Tabs en el simulador + auto-center en mobile
  const tabs = document.querySelectorAll<HTMLButtonElement>('.sim-tab');
  const panels = document.querySelectorAll<HTMLElement>('.sim-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');
      if (!targetId) return;

      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

      panels.forEach(panel => {
        panel.classList.toggle('active', panel.id === targetId);
      });
      haptic();
    });
  });

  // Formulario limpio de consulta de comprobante (sin alert() nativo ni as any)
  const lookupForm = document.getElementById('facLookupForm') as HTMLFormElement | null;
  const lookupInput = document.getElementById('fac-lookup-input') as HTMLInputElement | null;
  const lookupFeedback = document.getElementById('lookupFeedback') as HTMLElement | null;

  lookupForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = lookupInput?.value.trim() || '';
    if (!val) {
      if (lookupFeedback) lookupFeedback.hidden = false;
      lookupInput?.focus();
      haptic();
      return;
    }
    if (lookupFeedback) lookupFeedback.hidden = true;
    window.location.href = `/comprobante/${encodeURIComponent(val)}`;
  });

  lookupInput?.addEventListener('input', () => {
    if (lookupFeedback && !lookupFeedback.hidden) lookupFeedback.hidden = true;
  });
</script>

