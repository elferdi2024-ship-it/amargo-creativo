---
// filepath: src/pages/proyectos.astro
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RollText from '../components/motion/RollText.astro';
import { projects } from '../lib/projects';

const pageTitle = "Apps, Plataformas IA & Casos Reales | Amargo Creativo™";
const pageDescription = "Productos digitales en producción: Barrio.uy, DocuBox AI, Canarios Ya!, plataformas SaaS y tiendas D2C creadas a medida en UY, AR y ES.";
const canonicalUrl = "https://amargo-creativo.pages.dev/proyectos/";
const ogImage = "https://amargo-creativo.pages.dev/og-image-v3.jpg";

const saasCount = projects.filter(p => p.category === 'saas').length;
const commerceCount = projects.filter(p => p.category === 'ecommerce').length;
const marketplaceCount = projects.filter(p => p.category === 'marketplace').length;

const benchmarks = [
  {
    criterio: "Tipo de Producto",
    amargo: "Apps PWA, plataformas con IA, portales CivicTech y comercio propio",
    agencia: "Sitios institucionales estáticos hechos con plantillas repetidas"
  },
  {
    criterio: "Comisiones y Licencias",
    amargo: "0% comisiones por pedido y sin cuotas cautivas por usuario",
    agencia: "Atado a apps intermediarias (hasta 30%) o plugins pagos mensuales"
  },
  {
    criterio: "Propiedad del Código",
    amargo: "100% tuyo en tu repositorio, hosting y dominio desde el día 1",
    agencia: "Dependencia técnica de servidores propios de la agencia"
  },
  {
    criterio: "Flujo Comercial",
    amargo: "Checkout propio, WhatsApp directo, pagos locales (BROU / MP) y DGI",
    agencia: "Formularios largos que nadie responde o carritos abandonados"
  },
  {
    criterio: "Arquitectura & SEO",
    amargo: "Next.js 15 / Astro 5 en Cloudflare Edge con Core Web Vitals en verde",
    agencia: "WordPress pesado con 35+ plugins lentos y vulnerables"
  },
  {
    criterio: "Relación & Velocidad",
    amargo: "Trato directo con quienes diseñan y programan tu producto",
    agencia: "Ejecutivos de cuenta, tickets eternos y semanas sin código real"
  }
];
---
<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  image={ogImage}
  includeShowcaseSchema={true}
  breadcrumbs={[
    { name: 'Inicio', url: 'https://amargo-creativo.pages.dev/' },
    { name: 'Proyectos', url: canonicalUrl }
  ]}
>
  <Navbar />
  
  <main id="main-content" class="projects-page">
    <!-- Header Hero Editorial -->
    <header class="page-head">
      <div class="page-head-container">
        <div class="header-top-meta">
          <div class="section-label">
            <span class="num">ARCHIVO</span>
            <span>PRODUCCIÓN TÉCNICA // UY &bull; AR &bull; ES</span>
          </div>
          <div class="header-stamp-row">
            <span class="geo-coord">ATLÁNTIDA, UY // -34.77° S, 55.75° W</span>
            <span class="live-counter tabular" id="liveCounter">MOSTRANDO {projects.length} DE {projects.length}</span>
          </div>
        </div>

        <h1 class="page-title" data-reveal-words>
          CASOS REALES &amp; SOFTWARE <em>en producción</em>
        </h1>
        
        <p class="page-subtitle">
          Cada caso es un producto real operando hoy — apps móviles instalables, buscadores con IA documental, portales ciudadanos y tiendas propias sin comisiones intermediarias.
        </p>

        <!-- Barra de Estadísticas Clave (Bento 2x2 en Mobile / 4 cols en PC) -->
        <div class="stats-strip">
          <div class="stat-cell">
            <strong class="tabular">{String(projects.length).padStart(2, '0')}</strong>
            <span>PRODUCTOS EN VIVO</span>
          </div>
          <div class="stat-cell">
            <strong>IA + PWA</strong>
            <span>APPS &amp; PLATAFORMAS</span>
          </div>
          <div class="stat-cell">
            <strong class="tabular">100%</strong>
            <span>PROPIEDAD DEL CÓDIGO</span>
          </div>
          <div class="stat-cell">
            <strong class="tabular">0%</strong>
            <span>COMISIONES CAUTIVAS</span>
          </div>
        </div>

        <!-- Barra de Controles y Búsqueda Reactiva -->
        <div class="controls-bar">
          <div class="filter-controls" role="group" aria-label="Filtrar por categoría">
            <button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">TODOS ({projects.length})</button>
            <button type="button" class="filter-pill" data-filter="saas" aria-pressed="false">APPS, IA &amp; SAAS ({saasCount})</button>
            <button type="button" class="filter-pill" data-filter="ecommerce" aria-pressed="false">COMERCIO &amp; DELIVERY ({commerceCount})</button>
            <button type="button" class="filter-pill" data-filter="marketplace" aria-pressed="false">PORTALES &amp; REAL ESTATE ({marketplaceCount})</button>
          </div>

          <div class="search-input-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input 
              type="text" 
              id="projectSearch" 
              placeholder="Buscar app, industria o stack..." 
              class="search-input"
              aria-label="Buscar en el catálogo de proyectos"
            />
            <button type="button" id="clearSearchBtn" class="clear-search-btn" aria-label="Limpiar búsqueda" hidden>×</button>
          </div>
        </div>

        <!-- Chips de Filtro Rápido por Tecnología / Capacidad -->
        <div class="quick-tags-strip" role="group" aria-label="Filtros rápidos">
          <span class="quick-label">RÁPIDO:</span>
          <button type="button" class="quick-tag-chip" data-tag="ia">#IA</button>
          <button type="button" class="quick-tag-chip" data-tag="pwa">#PWA</button>
          <button type="button" class="quick-tag-chip" data-tag="civictech">#CIVICTECH</button>
          <button type="button" class="quick-tag-chip" data-tag="next.js">#NEXT.JS</button>
          <button type="button" class="quick-tag-chip" data-tag="cloudflare">#CLOUDFLARE</button>
          <button type="button" class="quick-tag-chip" data-tag="whatsapp">#WHATSAPP</button>
        </div>
      </div>
    </header>

    <!-- Grid de Casos de Estudio -->
    <section class="projects-grid-section">
      <div class="projects-grid" id="projectsGrid">
        {projects.map((project, idx) => (
          <article 
            class="project-card tactile-card" 
            data-category={project.category}
            data-search={`${project.title} ${project.client} ${project.yearCategory} ${project.tags.join(' ')} ${project.desc} ${project.location}`.toLowerCase()}
            data-cursor="VER"
          >
            <!-- Media Visual -->
            <div class="project-media">
              <img 
                src={project.img} 
                alt={`Captura de producción de ${project.title}`}
                class="project-img"
                width={project.aspectWidth}
                height={project.aspectHeight}
                loading={idx < 2 ? "eager" : "lazy"}
                decoding="async"
              />
              <div class="media-tags-top">
                <span class="project-num tabular">{String(idx + 1).padStart(2, '0')}</span>
                <span class="project-loc">{project.location}</span>
                <span class="project-status">
                  <span class="status-pulse-mini" aria-hidden="true"></span>
                  EN VIVO
                </span>
              </div>
              <a 
                href={project.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="live-chip"
                aria-label={`Abrir sitio de ${project.title}`}
                data-cursor="VISITAR"
              >
                <span>{project.liveUrlLabel}</span> ↗
              </a>
            </div>

            <!-- Contenido Editorial -->
            <div class="project-body">
              <div class="project-client-row">
                <span class="client-name">{project.client}</span>
                <span class="project-year-label">{project.yearCategory}</span>
              </div>

              <h2 class="project-title">{project.title}</h2>
              <p class="project-summary">{project.desc}</p>

              <!-- Métrica de Impacto Destacada -->
              <div class="project-metric-box">
                <span class="metric-icon" aria-hidden="true">⚡</span>
                <span class="metric-text">{project.keyResult}</span>
              </div>

              <!-- Puntuación Lighthouse Real -->
              <div class="lighthouse-strip" title="Métricas auditadas con Google Lighthouse">
                <div class="lh-pill">
                  <span class="lh-label">PERF</span>
                  <span class="lh-score tabular">{project.lighthouse.perf}</span>
                </div>
                <div class="lh-pill">
                  <span class="lh-label">A11Y</span>
                  <span class="lh-score tabular">{project.lighthouse.a11y}</span>
                </div>
                <div class="lh-pill">
                  <span class="lh-label">PRACT</span>
                  <span class="lh-score tabular">{project.lighthouse.bp}</span>
                </div>
                <div class="lh-pill">
                  <span class="lh-label">SEO</span>
                  <span class="lh-score tabular">{project.lighthouse.seo}</span>
                </div>
              </div>

              <!-- Desafío & Solución Técnica -->
              <div class="case-details">
                <div class="case-detail-item">
                  <strong>EL DESAFÍO:</strong>
                  <p>{project.challenge}</p>
                </div>
                <div class="case-detail-item">
                  <strong>LA SOLUCIÓN:</strong>
                  <p>{project.solution}</p>
                </div>
              </div>

              <!-- Acordeón Desplegable de Ficha de Arquitectura -->
              <details class="tech-spec-drawer">
                <summary class="spec-drawer-toggle">
                  <span>ARQUITECTURA &amp; STACK</span>
                  <span class="toggle-arrow" aria-hidden="true">▾</span>
                </summary>
                <div class="spec-drawer-content">
                  <div class="spec-item">
                    <span class="spec-kicker">STACK &amp; RUNTIME:</span>
                    <span class="spec-val">{project.architecture.stack}</span>
                  </div>
                  <div class="spec-item">
                    <span class="spec-kicker">EDGE CDN &amp; INFRA:</span>
                    <span class="spec-val">{project.architecture.edge}</span>
                  </div>
                  <div class="spec-item">
                    <span class="spec-kicker">DATOS / INDEXACIÓN:</span>
                    <span class="spec-val">{project.architecture.database}</span>
                  </div>
                  <div class="spec-item">
                    <span class="spec-kicker">TELEMETRÍA CWV:</span>
                    <span class="spec-val highlight-speed">{project.architecture.speed}</span>
                  </div>
                </div>
              </details>

              <!-- Tech Stack Badges con Interacción de Filtro -->
              <div class="tech-stack-row">
                {project.tags.map(tag => (
                  <button 
                    type="button" 
                    class="stack-badge filter-by-tag-btn" 
                    data-tag={tag.toLowerCase()} 
                    title={`Filtrar por ${tag}`}
                  >
                    {tag}
                  </button>
                ))}
              </div>

              <!-- Botones de Acción Directa -->
              <div class="project-actions">
                <a 
                  href={project.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="action-btn-live ink-fill"
                  data-cursor="VISITAR"
                >
                  <span class="ink" aria-hidden="true"></span>
                  <RollText text="VER EN VIVO" arrow="diag" />
                </a>
                <a 
                  href={`https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20vi%20el%20proyecto%20${encodeURIComponent(project.title)}%20y%20quiero%20cotizar%20un%20producto%20similar`} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="action-btn-quote ink-fill"
                  data-cursor="WHATSAPP"
                >
                  <span class="ink" aria-hidden="true"></span>
                  <RollText text="COTIZAR SIMILAR" arrow="right" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="noResults" class="no-results" hidden>
        <p>No encontramos proyectos con ese filtro.</p>
        <button type="button" id="resetSearch" class="reset-search-btn">VER LOS {projects.length} PROYECTOS</button>
      </div>
    </section>

    <!-- Matriz de Benchmark de Producto -->
    <section class="benchmark-section">
      <div class="benchmark-container">
        <div class="section-label">
          <span class="num">02</span> COMPARATIVA DE ENFOQUE
        </div>
        <h2 class="benchmark-heading" data-reveal-words>PRODUCT STUDIO <em>vs</em> AGENCIAS DE PLANTILLAS</h2>
        <p class="benchmark-sub">
          La diferencia entre ser dueño de un producto digital a medida y alquilar una maqueta que te cobra por cada límite.
        </p>

        <div class="table-wrap">
          <table class="benchmark-table">
            <thead>
              <tr>
                <th>CRITERIO</th>
                <th class="col-highlight">AMARGO CREATIVO (PRODUCT STUDIO)</th>
                <th>AGENCIAS TRADICIONALES / PLANTILLAS</th>
              </tr>
            </thead>
            <tbody>
              {benchmarks.map(row => (
                <tr>
                  <td data-label="Criterio"><strong>{row.criterio}</strong></td>
                  <td class="col-highlight" data-label="Amargo Creativo">
                    <span class="cell-pill good">✓ PRODUCTO PROPIO</span>
                    <span>{row.amargo}</span>
                  </td>
                  <td data-label="Agencias tradicionales">
                    <span class="cell-pill bad">✕ LÍMITE HABITUAL</span>
                    <span>{row.agencia}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Banner de Cierre con Conversión a WhatsApp -->
    <section class="cta-banner-wrap">
      <div class="cta-card">
        <div class="cta-info">
          <span class="cta-mini-tag">● DISPONIBILIDAD INMEDIATA</span>
          <h2 class="cta-title">¿CONSTRUIMOS TU PRÓXIMA <mark class="hl-yellow">APP O PLATAFORMA</mark>?</h2>
          <p class="cta-desc">
            Bajamos tu idea a arquitectura real, diseñamos las pantallas y la llevamos a producción con código 100% tuyo.
          </p>
        </div>
        <div class="cta-buttons">
          <a 
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20una%20app%20o%20producto%20digital" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="cta-wa-btn ink-fill magnetic-btn"
            data-cursor="WHATSAPP"
          >
            <span class="ink" aria-hidden="true"></span>
            <RollText text="HABLAR POR WHATSAPP" arrow="diag" />
          </a>
          <a href="/servicios-crecimiento" class="cta-secondary-link ink-fill">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="VER SERVICIOS & PLANES" arrow="right" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const searchInput = document.getElementById('projectSearch') as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement | null;
  const noResults = document.getElementById('noResults') as HTMLElement | null;
  const resetBtn = document.getElementById('resetSearch') as HTMLButtonElement | null;
  const liveCounter = document.getElementById('liveCounter');
  const quickTags = document.querySelectorAll<HTMLButtonElement>('.quick-tag-chip');
  const tagBtns = document.querySelectorAll<HTMLButtonElement>('.filter-by-tag-btn');

  let currentCategory = 'all';
  let currentSearchQuery = '';
  const totalProjects = cards.length;

  const haptic = () => {
    if ('vibrate' in navigator) {
      try { navigator.vibrate(8); } catch {}
    }
  };

  function syncUrl() {
    const url = new URL(window.location.href);
    if (currentCategory && currentCategory !== 'all') url.searchParams.set('cat', currentCategory);
    else url.searchParams.delete('cat');
    if (currentSearchQuery) url.searchParams.set('q', currentSearchQuery);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url.toString());
  }

  function applyFilters(updateUrl = true) {
    let visibleCount = 0;

    cards.forEach(card => {
      const category = card.getAttribute('data-category');
      const searchText = card.getAttribute('data-search') || '';

      const matchesCat = currentCategory === 'all' || category === currentCategory;
      const matchesSearch = !currentSearchQuery || searchText.includes(currentSearchQuery);

      if (matchesCat && matchesSearch) {
        card.hidden = false;
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.hidden = true;
        card.style.display = 'none';
      }
    });

    if (noResults) noResults.hidden = visibleCount !== 0;
    if (clearSearchBtn) clearSearchBtn.hidden = currentSearchQuery.length === 0;
    if (liveCounter) liveCounter.textContent = `MOSTRANDO ${visibleCount} DE ${totalProjects}`;

    quickTags.forEach(chip => {
      const t = (chip.getAttribute('data-tag') || '').toLowerCase();
      chip.classList.toggle('is-active', currentSearchQuery === t && t.length > 0);
    });

    if (updateUrl) syncUrl();
  }

  // Hidratar desde URL si existe ?cat= o ?q=
  const params = new URLSearchParams(window.location.search);
  const initialCat = params.get('cat');
  const initialQ = params.get('q');
  if (initialCat) {
    const matchPill = Array.from(pills).find(p => p.getAttribute('data-filter') === initialCat);
    if (matchPill) {
      pills.forEach(p => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
      matchPill.classList.add('active');
      matchPill.setAttribute('aria-pressed', 'true');
      currentCategory = initialCat;
    }
  }
  if (initialQ && searchInput) {
    searchInput.value = initialQ;
    currentSearchQuery = initialQ.trim().toLowerCase();
  }
  if (initialCat || initialQ) applyFilters(false);

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => {
        p.classList.remove('active');
        p.setAttribute('aria-pressed', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-pressed', 'true');
      currentCategory = pill.getAttribute('data-filter') || 'all';
      pill.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      haptic();
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    currentSearchQuery = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearchQuery = '';
    haptic();
    applyFilters();
    searchInput?.focus();
  });

  quickTags.forEach(chip => {
    chip.addEventListener('click', () => {
      const tag = (chip.getAttribute('data-tag') || '').toLowerCase();
      currentSearchQuery = currentSearchQuery === tag ? '' : tag;
      if (searchInput) searchInput.value = currentSearchQuery;
      chip.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      haptic();
      applyFilters();
    });
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const tag = (btn.getAttribute('data-tag') || '').toLowerCase();
      if (searchInput) searchInput.value = tag;
      currentSearchQuery = tag;
      haptic();
      applyFilters();
      document.getElementById('projectsGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearchQuery = '';
    currentCategory = 'all';
    pills.forEach(p => { p.classList.remove('active'); p.setAttribute('aria-pressed', 'false'); });
    if (pills[0]) {
      pills[0].classList.add('active');
      pills[0].setAttribute('aria-pressed', 'true');
    }
    haptic();
    applyFilters();
  });
</script>

<style>
  .projects-page {
    padding-top: calc(70px + env(safe-area-inset-top));
    background: var(--paper);
    min-height: 100vh;
  }

  .page-head {
    padding: clamp(36px, 6vw, 80px) var(--gut) clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
    background: var(--bone);
  }

  .page-head-container {
    max-width: var(--max);
    margin: 0 auto;
  }

  .header-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .header-top-meta .section-label {
    margin-bottom: 0;
  }

  .header-stamp-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--mute);
    flex-wrap: wrap;
  }

  .geo-coord {
    opacity: 0.72;
    letter-spacing: 0.05em;
  }

  .live-counter {
    background: var(--ink);
    color: var(--bone);
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  :global(body.theme-electric) .live-counter {
    background: var(--electric);
    color: #0a0a0a;
  }

  .page-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 6vw, 84px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 18px;
    overflow-wrap: break-word;
  }

  .page-title em {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }

  .page-subtitle {
    font-family: var(--font-body);
    font-size: clamp(14.5px, 1.35vw, 18.5px);
    line-height: 1.55;
    color: var(--ink);
    opacity: 0.88;
    max-width: 78ch;
    margin-bottom: 28px;
  }

  /* BARRA DE ESTADÍSTICAS */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    padding: 20px 24px;
    margin-bottom: 28px;
  }

  .stat-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-right: 1px solid var(--line);
    padding-right: 16px;
  }

  .stat-cell:last-child {
    border-right: none;
    padding-right: 0;
  }

  .stat-cell strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1;
    color: var(--ink);
  }

  .stat-cell span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  /* CONTROLES Y BUSCADOR */
  .controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .filter-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-pill {
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 9px 16px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease), border-color 0.22s var(--ease), transform 0.15s var(--ease);
  }

  .filter-pill:active {
    transform: scale(0.95);
  }

  @media (hover: hover) {
    .filter-pill:hover {
      background: var(--ink);
      color: var(--bone);
      transform: translate3d(0, -1px, 0);
    }
  }

  .filter-pill.active {
    background: var(--mate);
    color: #f5f3ec;
    border-color: var(--mate);
  }

  :global(body.theme-electric) .filter-pill.active,
  :global(body.theme-dark) .filter-pill.active {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  .search-input-wrap {
    position: relative;
    min-width: 260px;
    flex: 1;
    max-width: 360px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    color: var(--mute);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 10px 36px 10px 38px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 13px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-input:focus {
    border-color: var(--mate);
    box-shadow: 0 0 0 3px rgba(45, 99, 53, 0.14);
  }

  :global(body.theme-electric) .search-input:focus {
    border-color: var(--electric);
    box-shadow: 0 0 0 3px rgba(241, 255, 90, 0.16);
  }

  .clear-search-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: var(--line);
    color: var(--ink);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .clear-search-btn[hidden] {
    display: none;
  }

  .quick-tags-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: 2px;
  }

  .quick-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--mute);
    flex-shrink: 0;
  }

  .quick-tag-chip {
    background: var(--paper);
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-style 0.2s, transform 0.15s;
  }

  .quick-tag-chip:active {
    transform: scale(0.94);
  }

  .quick-tag-chip.is-active {
    background: var(--ink);
    color: var(--bone);
    border-style: solid;
  }

  @media (hover: hover) {
    .quick-tag-chip:hover {
      background: var(--ink);
      color: var(--bone);
      border-style: solid;
    }
  }

  /* GRID DE PROYECTOS */
  .projects-grid-section {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(32px, 5vw, 72px) var(--gut);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(clamp(310px, 44vw, 540px), 1fr));
    gap: clamp(24px, 3.5vw, 44px);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bone);
    position: relative;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translate3d(0, -4px, 0);
      box-shadow: 0 18px 40px rgba(17, 18, 15, 0.1);
      border-color: var(--line-strong);
    }
    .project-card:hover .project-img {
      transform: scale(1.035);
    }
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--hover-bg);
    border-bottom: 1px solid var(--line);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }

  .media-tags-top {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 6px;
    z-index: 2;
    flex-wrap: wrap;
  }

  .project-num {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    background: #0a0a0a;
    color: var(--electric);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .project-loc {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    background: rgba(10, 10, 10, 0.84);
    backdrop-filter: blur(8px);
    color: #ffffff;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(244, 241, 234, 0.94);
    color: #0a0a0a;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .status-pulse-mini {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 4px #22c55e;
  }

  .live-chip {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: var(--electric);
    color: #0a0a0a;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 5px 11px;
    text-decoration: none;
    border: 1px solid #0a0a0a;
    border-radius: 999px;
    z-index: 2;
    transition: transform 0.2s, background-color 0.2s;
  }

  @media (hover: hover) {
    .live-chip:hover {
      background: #ffffff;
      transform: translate3d(0, -2px, 0);
    }
  }

  /* CUERPO DEL PROYECTO */
  .project-body {
    padding: clamp(18px, 2.8vw, 30px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-client-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .client-name {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mate);
  }

  :global(body.theme-electric) .client-name {
    color: var(--electric);
  }

  .project-year-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--mute);
  }

  .project-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(21px, 2.3vw, 29px);
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 10px;
    line-height: 1.08;
  }

  .project-summary {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.52;
    color: var(--ink);
    opacity: 0.88;
    margin-bottom: 14px;
  }

  /* MÉTRICA DESTACADA */
  .project-metric-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 12px;
    margin-bottom: 12px;
  }

  .metric-icon {
    font-size: 13px;
  }

  .metric-text {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.4;
  }

  /* LIGHTHOUSE STRIP */
  .lighthouse-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-bottom: 14px;
  }

  .lh-pill {
    background: #11120f;
    color: #f5f3ec;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 8px;
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .lh-label {
    opacity: 0.7;
  }

  .lh-score {
    font-weight: 800;
    color: #4ade80;
  }

  /* DESAFÍO Y SOLUCIÓN */
  .case-details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
    margin-bottom: 14px;
  }

  .case-detail-item strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--mute);
    margin-bottom: 2px;
  }

  .case-detail-item p {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.48;
    color: var(--ink);
    opacity: 0.86;
  }

  /* FICHA TÉCNICA DRAWER */
  .tech-spec-drawer {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 14px;
    overflow: hidden;
  }

  .spec-drawer-toggle {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .spec-drawer-toggle::-webkit-details-marker {
    display: none;
  }

  .toggle-arrow {
    transition: transform 0.25s var(--ease);
  }

  .tech-spec-drawer[open] .toggle-arrow {
    transform: rotate(180deg);
  }

  .spec-drawer-content {
    padding: 10px 14px 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-kicker {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 700;
    color: var(--mute);
    letter-spacing: 0.06em;
  }

  .spec-val {
    font-family: var(--font-body);
    font-size: 11.5px;
    color: var(--ink);
    font-weight: 500;
  }

  .spec-val.highlight-speed {
    color: var(--mate);
    font-weight: 700;
    font-family: var(--font-mono);
  }

  :global(body.theme-electric) .spec-val.highlight-speed {
    color: var(--electric);
  }

  /* STACK PILLS */
  .tech-stack-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .stack-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease), transform 0.15s;
  }

  .stack-badge:active {
    transform: scale(0.94);
  }

  @media (hover: hover) {
    .stack-badge:hover {
      background: var(--mate);
      color: #ffffff;
      border-color: var(--mate);
    }
    :global(body.theme-electric) .stack-badge:hover {
      background: var(--electric);
      color: #0a0a0a;
      border-color: var(--electric);
    }
  }

  /* ACCIONES */
  .project-actions {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 8px;
    margin-top: auto;
  }

  .action-btn-live,
  .action-btn-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    height: 40px;
    padding: 0 12px;
    text-decoration: none;
    box-sizing: border-box;
    border-radius: 999px;
    transition: transform var(--spring-snap-dur) var(--spring-snap), color 0.35s var(--ease);
  }

  .action-btn-live:active,
  .action-btn-quote:active {
    transform: scale(0.97);
    transition-duration: 90ms;
  }

  .action-btn-live {
    --mx-fill-ink: #11120f;
    background: var(--electric);
    color: #11120f;
    border: 1px solid #11120f;
  }

  @media (hover: hover) {
    .action-btn-live:hover {
      color: var(--electric);
    }
  }

  .action-btn-quote {
    --mx-fill-ink: var(--ink);
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  @media (hover: hover) {
    .action-btn-quote:hover {
      color: var(--bone);
    }
  }

  .no-results {
    text-align: center;
    padding: 56px 20px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--mute);
  }

  .no-results[hidden] {
    display: none;
  }

  .reset-search-btn {
    margin-top: 16px;
    background: var(--mate);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 11px 22px;
    border: none;
    border-radius: 999px;
    cursor: pointer;
  }

  /* BENCHMARK TABLE */
  .benchmark-section {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bone);
    padding: clamp(52px, 7vw, 96px) var(--gut);
  }

  .benchmark-container {
    max-width: var(--max);
    margin: 0 auto;
  }

  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
    border-radius: 3px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .benchmark-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4.4vw, 58px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .benchmark-heading em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--rust);
  }

  .benchmark-sub {
    font-family: var(--font-body);
    font-size: clamp(14px, 1.2vw, 17px);
    color: var(--ink);
    opacity: 0.85;
    margin-bottom: 32px;
    max-width: 68ch;
  }

  .table-wrap {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: var(--radius-md);
  }

  .benchmark-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }

  .benchmark-table th,
  .benchmark-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .benchmark-table tr:last-child td {
    border-bottom: none;
  }

  .benchmark-table th {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: #11120f;
    color: #f5f3ec;
    text-transform: uppercase;
  }

  .benchmark-table th.col-highlight {
    background: var(--mate);
    color: #ffffff;
  }

  :global(body.theme-electric) .benchmark-table th.col-highlight {
    background: var(--electric);
    color: #0a0a0a;
  }

  .benchmark-table td.col-highlight {
    background: rgba(45, 99, 53, 0.07);
    font-weight: 600;
  }

  :global(body.theme-electric) .benchmark-table td.col-highlight {
    background: rgba(212, 255, 0, 0.06);
  }

  .cell-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 999px;
    margin-bottom: 6px;
    display: block;
    width: fit-content;
  }

  .cell-pill.good {
    background: var(--mate);
    color: #ffffff;
  }

  :global(body.theme-electric) .cell-pill.good {
    background: var(--electric);
    color: #0a0a0a;
  }

  .cell-pill.bad {
    background: rgba(220, 38, 38, 0.14);
    color: #dc2626;
  }

  /* BANNER FINAL */
  .cta-banner-wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) var(--gut);
  }

  .cta-card {
    background: linear-gradient(145deg, #122416 0%, #0c180e 100%);
    color: #f4f1ea;
    border: 1px solid #244b2c;
    border-radius: 20px;
    box-shadow: 0 14px 40px rgba(17, 35, 21, 0.25);
    padding: clamp(28px, 5vw, 60px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
  }

  :global(body.theme-electric) .cta-card {
    background: #000000;
    border-color: #2e3010;
    box-shadow: none;
  }

  .cta-info {
    max-width: 640px;
  }

  .cta-mini-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--mate-light);
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  :global(body.theme-electric) .cta-mini-tag {
    color: var(--electric);
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 3.6vw, 42px);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #f4f1ea;
    margin-bottom: 12px;
  }

  .cta-desc {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(244, 241, 234, 0.85);
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 280px;
  }

  .cta-wa-btn,
  .cta-secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--spring-snap-dur) var(--spring-snap), color 0.35s var(--ease);
  }

  .cta-wa-btn {
    --mx-fill-ink: #0a0a0a;
    background: var(--electric);
    color: #0a0a0a;
    border: 1px solid #0a0a0a;
  }

  @media (hover: hover) {
    .cta-wa-btn:hover {
      color: var(--electric);
    }
  }

  .cta-secondary-link {
    --mx-fill-ink: #f4f1ea;
    background: transparent;
    color: #f4f1ea;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  @media (hover: hover) {
    .cta-secondary-link:hover {
      color: #0c180e;
    }
  }

  @media (max-width: 900px) {
    .geo-coord {
      display: none;
    }
    .stats-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      padding: 16px;
    }
    .stat-cell {
      border-right: none;
      padding-right: 0;
    }
    .controls-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .filter-controls,
    .quick-tags-strip {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      margin-inline: calc(var(--gut) * -1);
      padding-inline: var(--gut);
      padding-bottom: 4px;
    }
    .filter-controls::-webkit-scrollbar,
    .quick-tags-strip::-webkit-scrollbar {
