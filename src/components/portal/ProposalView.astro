---
// filepath: src/components/portal/ProposalView.astro
import AcceptButton from "./AcceptButton";
import { formatMoney, formatDate, whatsappHref, defaultWhatsappMessage } from "../../lib/format";

interface Props {
  proposal: any;
  project?: any;
  documents?: any[];
}

const { proposal, project, documents = [] } = Astro.props;

// Jerarquía: Cliente como protagonista, Objetivo como subtítulo de alto impacto
const clientName = proposal.clients?.name || proposal.client_name || proposal.clientName || "Cliente";
const clientCompany = proposal.clients?.company;
const projectObjective = proposal.project_title || proposal.projectTitle || "Propuesta de Desarrollo Web";

const stages = project?.stages || [
  { id: 1, name: "Propuesta y Alcance", status: "done" },
  { id: 2, name: "Kick-off y Contenidos", status: "pending" },
  { id: 3, name: "Diseño UI/UX", status: "pending" },
  { id: 4, name: "Desarrollo", status: "pending" },
  { id: 5, name: "Revisiones", status: "pending" },
  { id: 6, name: "Lanzamiento", status: "pending" },
  { id: 7, name: "Soporte post-lanzamiento", status: "pending" },
];

const inv = proposal.investment || {};
const plans = inv.plans || [];
const recommended = plans.find((p: any) => p.recommended || p.featured || p.badge === "RECOMENDADO")?.name ?? plans[1]?.name ?? plans[0]?.name;

const waMessage = proposal.whatsapp_message || proposal.whatsappMessage || defaultWhatsappMessage(clientName, projectObjective);
const wa = whatsappHref(waMessage);

// Detección de Demo / Prototipo interactivo en vivo
let previewUrl = proposal.preview_url || null;
if (!previewUrl && proposal.slug === "mercado-atlantida") {
  previewUrl = "https://mercado-atlantida.elferdi2024.workers.dev/";
}
if (!previewUrl && proposal.slug === "deal-motors") {
  previewUrl = "https://driveprime-eta.vercel.app/";
}
if (!previewUrl && proposal.notes && proposal.notes.includes("http")) {
  const match = proposal.notes.match(/https?:\/\/[^\s]+/);
  if (match) previewUrl = match[0];
}

const proxyPreviewUrl = previewUrl ? `/api/preview-proxy?url=${encodeURIComponent(previewUrl)}` : null;

// Helper para formatear texto editorial con itálicas serif y resaltado flúor delicado
function formatEditorial(text: string) {
  if (!text) return "";
  let res = text;
  // _italics_ -> serif editorial
  res = res.replace(/_([^_]+)_/g, '<em class="editorial-serif">$1</em>');
  // *highlight* -> resaltador flúor suave en palabras clave
  res = res.replace(/\*([^*]+)\*/g, '<mark class="editorial-fluor">$1</mark>');
  return res;
}
---

<article class="portal">
  <!-- TOP BRAND & METADATA -->
  <header class="portal-header">
    <a href="/" class="brand">
      AMARGO<span class="brand-dot">.</span>
    </a>
    <div class="meta">
      <span class="label">PROPUESTA<br />COMERCIAL</span>
      {proposal.status !== "active" && (
        <span class={`badge badge-${proposal.status}`}>
          {proposal.status === "accepted" ? "✓ Aceptada" : proposal.status === "disabled" ? "No disponible" : proposal.status}
        </span>
      )}
    </div>
  </header>

  <!-- HERO: CLIENTE PRINCIPAL + OBJETIVO -->
  <div class="hero-block">
    <div class="hero-tag-wrap">
      <span class="hero-pretitle">PROPUESTA EXCLUSIVA PARA</span>
      <span class="hero-pretitle-line"></span>
    </div>

    <!-- Título Principal: Nombre del Cliente / Marca -->
    <h1 class="client-hero-title">{clientName}</h1>
    {clientCompany && clientCompany !== clientName && (
      <span class="client-company-tag">{clientCompany}</span>
    )}

    <!-- Objetivo del Proyecto: Subtítulo elegante y directo -->
    <div class="objective-badge-wrap">
      <h2 class="project-objective-title">{projectObjective}</h2>
    </div>

    {proposal.value_phrase && (
      <p class="value-phrase" set:html={formatEditorial(proposal.value_phrase)} />
    )}
  </div>

  {proposal.status === "accepted" && (proposal.accepted_at || proposal.acceptedAt) && (
    <div class="accepted-banner">
      ✓ Propuesta aceptada el {formatDate(proposal.accepted_at || proposal.acceptedAt)}
      {(proposal.accepted_name || proposal.acceptedName) && ` por ${proposal.accepted_name || proposal.acceptedName}`}
      {(proposal.accepted_plan || proposal.acceptedPlan) && ` · Plan ${proposal.accepted_plan || proposal.acceptedPlan}`}.
    </div>
  )}

  <!-- 01 Desafío (Texto limpio con palabras clave resaltadas) -->
  {proposal.challenge && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">01</span>
        <span class="line"></span>
        <span class="title">EL DESAFÍO</span>
      </div>
      <p class="body-text" set:html={formatEditorial(proposal.challenge)} />
    </section>
  )}

  <!-- 02 Solución (Texto limpio con palabras clave resaltadas) -->
  {proposal.solution && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">02</span>
        <span class="line"></span>
        <span class="title">LA SOLUCIÓN</span>
      </div>
      <p class="body-text" set:html={formatEditorial(proposal.solution)} />
    </section>
  )}

  <!-- 03 Prototipo / Maqueta Interactiva en Vivo (Si existe) -->
  {previewUrl && (
    <section class="section preview-section">
      <div class="section-kicker">
        <span class="num">03</span>
        <span class="line"></span>
        <span class="title">MAQUETA INTERACTIVA EN VIVO</span>
      </div>

      <div class="demo-card-frame">
        <!-- Mockup Browser Top Bar -->
        <div class="demo-browser-bar">
          <div class="browser-dots">
            <span class="b-dot dot-red"></span>
            <span class="b-dot dot-yellow"></span>
            <span class="b-dot dot-green"></span>
          </div>

          <div class="browser-address-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="browser-url font-mono">
              {proposal.slug === "deal-motors" ? "dealmotors.uy" : proposal.slug === "mercado-atlantida" ? "mercadoatlantida.uy" : "demo.amargo.uy"}
            </span>
            <span class="live-pulse-badge font-mono">
              <span class="pulse-dot"></span> EN VIVO
            </span>
          </div>

          <div class="browser-actions">
            <a
              href={previewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-open-external"
              title="Abrir en pantalla completa en nueva pestaña"
            >
              <span>Pantalla completa</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

        <!-- Embedded Live Iframe -->
        <div class="demo-iframe-container">
          <iframe
            src={proxyPreviewUrl || previewUrl}
            title={`Prototipo en vivo para ${clientName}`}
            class="demo-iframe"
            loading="lazy"
            allow="fullscreen; clipboard-read; clipboard-write"
          ></iframe>
        </div>

        <!-- Demo Footer info -->
        <div class="demo-footer-caption">
          <span class="demo-hint-icon">👆</span>
          <span>
            <strong>Prototipo navegable:</strong> Podés interactuar directamente con la plataforma aquí arriba, explorar los vehículos/productos y probar la experiencia en tiempo real.
          </span>
        </div>
      </div>
    </section>
  )}

  <!-- Alcance (Diseño limpio original) -->
  {((proposal.includes?.length > 0) || (proposal.excludes?.length > 0)) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "04" : "03"}</span>
        <span class="line"></span>
        <span class="title">ALCANCE DEL SERVICIO</span>
      </div>
      <div class="scope-container">
        {proposal.includes?.length > 0 && (
          <div class="scope-group">
            <h3 class="scope-title">INCLUYE</h3>
            <ul class="scope-list">
              {proposal.includes.map((item: string) => {
                const isFullPack = item.includes("Pack de Marketing y Lanzamiento") || item.includes("Plan Full") || item.includes("Pack Lanzamiento");
                return (
                  <li class={isFullPack ? "scope-item-highlight" : ""}>
                    <span class="check">{isFullPack ? "★" : "✓"}</span>
                    <span>{item}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        {proposal.excludes?.length > 0 && (
          <div class="scope-group excludes-group">
            <h3 class="scope-title">NO INCLUYE</h3>
            <ul class="scope-list muted">
              {proposal.excludes.map((item: string) => (
                <li>
                  <span class="minus">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Inversión -->
  <section class="section" id="inversion">
    <div class="section-kicker">
      <span class="num">{previewUrl ? "05" : "04"}</span>
      <span class="line"></span>
      <span class="title">INVERSIÓN Y PLANES</span>
    </div>

    {inv.type === "plans" && plans.length > 0 ? (
      <div class="plans-grid-3" id="plans-grid">
        {plans.map((plan: any) => {
          const isSelected = plan.name === recommended;
          const badgeText = plan.badge || (plan.recommended ? "RECOMENDADO" : null);
          const isRec = badgeText === "RECOMENDADO";
          const isLimitless = badgeText === "SIN LÍMITES";
          const hasDiscount = Boolean(plan.original_price || plan.originalPrice);
          const origPrice = plan.original_price || plan.originalPrice;

          // Cálculo o asignación del equivalente diario
          let dailyEq = plan.daily_equivalent || plan.dailyEquivalent || null;
          if (!dailyEq && plan.period && plan.period.includes("/mes") && plan.price) {
            const roundedDaily = Math.ceil((Number(plan.price) / 30) / 10) * 10;
            dailyEq = `Menos de $${roundedDaily}/día`;
          }

          return (
            <div
              class={`plan-card-pro ${isSelected ? "selected" : ""} ${isRec ? "is-recommended" : ""} ${isLimitless ? "is-limitless" : ""}`}
              data-plan={plan.name}
            >
              {badgeText && (
                <div class={`rec-badge-pill ${isRec ? "badge-green" : isLimitless ? "badge-dark" : "badge-neutral"}`}>
                  <span>{badgeText}</span>
                </div>
              )}

              <div class="plan-pro-header">
                <h3 class="plan-pro-name">{plan.name}</h3>
                {plan.description && <p class="plan-pro-desc">{plan.description}</p>}
              </div>

              <!-- Bloque de Precio con soporte para Precio Tachado, Descuento y Equivalente Diario -->
              <div class="plan-pro-price-block">
                {hasDiscount ? (
                  <div class="discount-price-container">
                    <div class="strikethrough-row">
                      <span class="strikethrough-val">
                        {formatMoney(origPrice, inv.currency)}
                      </span>
                      <span class="discount-chip">
                        {plan.discount_badge || "-7% Lanzamiento"}
                      </span>
                    </div>
                    <div class="final-price-row">
                      <span class="plan-price-num price-highlight">
                        {formatMoney(plan.price, inv.currency)}
                      </span>
                      {plan.period && <span class="plan-price-period">{plan.period}</span>}
                    </div>
                  </div>
                ) : (
                  <div class="normal-price-row">
                    <span class="plan-price-num">
                      {formatMoney(plan.price, inv.currency)}
                    </span>
                    {plan.period && <span class="plan-price-period">{plan.period}</span>}
                  </div>
                )}

                <!-- Equivalente Diario Delicado -->
                {dailyEq && (
                  <div class="daily-eq-wrap">
                    <span class="daily-eq-chip">
                      <span class="daily-eq-icon">≈</span> {dailyEq}
                    </span>
                  </div>
                )}
              </div>

              {plan.features?.length > 0 && (
                <ul class="plan-pro-features">
                  {plan.features.map((f: string) => {
                    const isCumulative = f.toLowerCase().includes("todo lo del") || f.toLowerCase().includes("todo lo de") || f.toLowerCase().includes("incluye todo");
                    const isFeatureHero = f.includes("Pack Lanzamiento") || f.includes("10 imágenes");

                    if (isCumulative) {
                      return (
                        <li class="feature-cumulative-pill">
                          <span class="f-plus">＋</span>
                          <span class="cumulative-text">{f}</span>
                        </li>
                      );
                    }

                    return (
                      <li class={isFeatureHero ? "feature-hero-item" : ""}>
                        <span class="f-check">{isFeatureHero ? "★" : "✓"}</span>
                        <span>{f}</span>
                      </li>
                    );
                  })}
                </ul>
              )}

              <!-- Botón interactivo de selección del plan -->
              <div class="plan-card-action-bar">
                <button
                  type="button"
                  class={`btn-plan-select-card ${isSelected ? "is-selected" : ""}`}
                  data-plan-target={plan.name}
                >
                  <span class="plan-dot-indicator"></span>
                  <span class="plan-select-label">
                    {isSelected ? "✓ Plan Seleccionado" : "Elegir este Plan"}
                  </span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="fixed-price-card">
        <div class="fixed-price-header">
          <div>
            <span class="fixed-price-label">Inversión del Proyecto</span>
            <div class="amount">{formatMoney(inv.amount ?? 0, inv.currency)}</div>
          </div>
          <span class="fixed-badge">Llave en mano</span>
        </div>
        {inv.paymentTerms && <p class="terms">{inv.paymentTerms}</p>}
      </div>
    )}

    {inv.paymentTerms && inv.type === "plans" && (
      <div class="payment-terms-box">
        <span class="pt-icon">ℹ️</span>
        <p class="payment-terms">{inv.paymentTerms}</p>
      </div>
    )}
  </section>

  <!-- Tiempos (Tarjeta editorial sutil) -->
  {proposal.timeline && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "06" : "05"}</span>
        <span class="line"></span>
        <span class="title">TIEMPOS Y CRONOGRAMA</span>
      </div>
      <div class="editorial-narrative-card timeline-card">
        <p class="body-text" set:html={formatEditorial(proposal.timeline)} />
      </div>
    </section>
  )}

  <!-- ROI (Tabla con columna objetivo en verde suave) -->
  {(proposal.roi_table?.headers?.length > 0 || proposal.roiTable?.headers?.length > 0) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "07" : "06"}</span>
        <span class="line"></span>
        <span class="title">RETORNO ESTIMADO</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              {(proposal.roi_table?.headers || proposal.roiTable?.headers || []).map((h: string, idx: number) => (
                <th class={idx === 2 ? "th-target-highlight" : ""}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {(proposal.roi_table?.rows || proposal.roiTable?.rows || []).map((row: string[]) => (
              <tr>
                {row.map((cell: string, idx: number) => (
                  <td class={idx === 2 ? "td-target-highlight" : ""}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Timeline Stages / Estado del Proyecto Elevado -->
  <section class="section">
    <div class="section-kicker">
      <span class="num">{previewUrl ? "08" : "07"}</span>
      <span class="line"></span>
      <span class="title">ESTADO Y PROGRESO DEL PROYECTO</span>
    </div>

    <div class="timeline-container-card">
      <div class="timeline-header-meta">
        <div class="timeline-progress-label">
          <span class="tl-pulse-dot"></span>
          <span>{stages.filter((s: any) => s.status === "done").length} de {stages.length} etapas completadas</span>
        </div>
        <span class="tl-current-pill">
          {stages.find((s: any) => s.status === "current")?.name || (stages.every((s: any) => s.status === "done") ? "Proyecto Finalizado" : "En fase inicial")}
        </span>
      </div>

      <div class="timeline-stages-track">
        {stages.map((stage: any, idx: number) => {
          const isDone = stage.status === "done";
          const isCurrent = stage.status === "current";
          const isLast = idx === stages.length - 1;

          return (
            <div class={`stage-row stage-${stage.status}`}>
              <div class="stage-indicator-col">
                <div class={`stage-node ${isDone ? "node-done" : isCurrent ? "node-current" : "node-pending"}`}>
                  {isDone ? (
                    <span class="node-check">✓</span>
                  ) : isCurrent ? (
                    <span class="node-pulse"></span>
                  ) : (
                    <span class="node-num font-mono">{String(stage.id || idx + 1).padStart(2, "0")}</span>
                  )}
                </div>
                {!isLast && <div class={`stage-connector ${isDone ? "connector-done" : ""}`}></div>}
              </div>

              <div class="stage-content-col">
                <div class="stage-title-wrap">
                  <h4 class="stage-name">{stage.name}</h4>
                  <span class={`stage-status-badge ${isDone ? "status-done" : isCurrent ? "status-current" : "status-pending"}`}>
                    {isDone ? "Completado" : isCurrent ? "En curso" : "Pendiente"}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Documentos Adjuntos Oficiales -->
  {documents.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "09" : "08"}</span>
        <span class="line"></span>
        <span class="title">DOCUMENTACIÓN OFICIAL ADJUNTA</span>
      </div>
      <div class="documents-grid">
        {documents.map((doc: any) => {
          const typeLabel = doc.type === "contract" ? "CONTRATO" : doc.type === "invoice" ? "FACTURA" : doc.type === "brief" ? "ESPECIFICACIÓN" : doc.type?.toUpperCase() || "DOCUMENTO";
          const isContract = doc.type === "contract";
          const isInvoice = doc.type === "invoice";
          const isRealStorageFile = doc.storage_path && !doc.storage_path.startsWith("http") && (doc.storage_path.endsWith(".pdf") || doc.storage_path.endsWith(".zip") || doc.storage_path.endsWith(".png") || doc.storage_path.endsWith(".jpg"));
          const downloadUrl = isRealStorageFile ? `/api/documents/${doc.id}/download` : `/p/documents/${doc.id}`;

          return (
            <a href={downloadUrl} target="_blank" rel="noopener noreferrer" class="doc-card-premium">
              <div class="doc-card-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>

              <div class="doc-card-info">
                <div class="doc-card-top">
                  <span class={`doc-type-pill ${isContract ? "pill-contract" : isInvoice ? "pill-invoice" : "pill-default"}`}>
                    {typeLabel}
                  </span>
                  {doc.uploaded_at && (
                    <span class="doc-date font-mono">{formatDate(doc.uploaded_at)}</span>
                  )}
                </div>
                <h4 class="doc-title">{doc.name}</h4>
                <span class="doc-action-hint">
                  <span>Descargar / Ver archivo</span>
                  <span class="doc-arrow">↗</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Acciones -->
  <section class="actions no-print">
    <AcceptButton
      client:load
      slug={proposal.slug}
      status={proposal.status}
      plans={plans}
      planName={recommended}
      clientName={clientName}
      currency={inv.currency || "UYU"}
    />

    <div class="secondary-actions">
      <a href={wa} target="_blank" rel="noopener" class="btn-outline-wa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Hablar por WhatsApp</span>
      </a>
      <button type="button" class="btn-pdf-print" onclick="window.print()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Guardar como PDF</span>
      </button>
    </div>

    <p class="note">
      El magic link no caduca. Si esta propuesta deja de estar disponible, Amargo la desactiva a mano. Aceptar registra fecha, contacto y plan elegido.
    </p>
  </section>

  <footer class="portal-footer">
    <div class="footer-brand-line">
      <span>AMARGO CREATIVO · ATLÁNTIDA, URUGUAY</span>
      <span class="footer-dot">✦</span>
      <span>AGENCIA DIGITAL DE ALTO RENDIMIENTO</span>
    </div>
  </footer>
</article>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".plan-card-pro");
  const waBtn = document.querySelector<HTMLAnchorElement>(".btn-outline-wa");
  const baseWaHref = waBtn ? waBtn.getAttribute("href") || "" : "";

  function setPlanSelection(targetPlan: string) {
    cards.forEach((card) => {
      const pName = card.getAttribute("data-plan");
      const isTarget = pName === targetPlan;
      if (isTarget) {
        card.classList.add("selected");
      } else {
        card.classList.remove("selected");
      }

      const btn = card.querySelector<HTMLElement>(".btn-plan-select-card");
      if (btn) {
        if (isTarget) {
          btn.classList.add("is-selected");
          btn.innerHTML = '<span class="plan-dot-indicator"></span><span class="plan-select-label">✓ Plan Seleccionado</span>';
        } else {
          btn.classList.remove("is-selected");
          btn.innerHTML = '<span class="plan-dot-indicator"></span><span class="plan-select-label">Elegir este Plan</span>';
        }
      }
    });

    // Actualizar WhatsApp link dinámicamente con el plan seleccionado
    if (waBtn && baseWaHref) {
      try {
        const url = new URL(baseWaHref);
        const originalText = url.searchParams.get("text") || "";
        const updatedText = originalText.replace(/Plan [A-Za-z0-9\s]+|con el [A-Za-z0-9\s]+/i, `con el ${targetPlan}`);
        url.searchParams.set("text", updatedText);
        waBtn.setAttribute("href", url.toString());
      } catch (err) {}
    }

    // Notificar al componente React AcceptButton
    window.dispatchEvent(
      new CustomEvent("amargo:plan-selected", {
        detail: { planName: targetPlan },
      })
    );
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const planName = card.getAttribute("data-plan");
      if (planName) setPlanSelection(planName);
    });
  });

  window.addEventListener("amargo:plan-selected", ((e: CustomEvent) => {
    if (e.detail?.planName) {
      cards.forEach((card) => {
        const pName = card.getAttribute("data-plan");
        const isTarget = pName === e.detail.planName;
        if (isTarget) {
          card.classList.add("selected");
        } else {
          card.classList.remove("selected");
        }
        const btn = card.querySelector<HTMLElement>(".btn-plan-select-card");
        if (btn) {
          if (isTarget) {
            btn.classList.add("is-selected");
            btn.innerHTML = '<span class="plan-dot-indicator"></span><span class="plan-select-label">✓ Plan Seleccionado</span>';
          } else {
            btn.classList.remove("is-selected");
            btn.innerHTML = '<span class="plan-dot-indicator"></span><span class="plan-select-label">Elegir este Plan</span>';
          }
        }
      });
    }
  }) as EventListener);
</script>

