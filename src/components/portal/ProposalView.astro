---
// filepath: src/components/portal/ProposalView.astro
import AcceptButton from "./AcceptButton";
import { formatMoney, formatDate, whatsappHref, defaultWhatsappMessage } from "../../lib/format";

interface Props {
  proposal: any;
  project?: any;
  documents?: any[];
}

const { proposal, project, documents = [] } = Astro.props;

// Jerarquía: Cliente como protagonista, Objetivo como subtítulo de alto impacto
const clientName = proposal.clients?.name || proposal.client_name || proposal.clientName || "Cliente";
const clientCompany = proposal.clients?.company;
const projectObjective = proposal.project_title || proposal.projectTitle || "Propuesta de Desarrollo Web";

const stages = project?.stages || [
  { id: 1, name: "Propuesta y Alcance", status: "done" },
  { id: 2, name: "Kick-off y Contenidos", status: "pending" },
  { id: 3, name: "Diseño UI/UX", status: "pending" },
  { id: 4, name: "Desarrollo", status: "pending" },
  { id: 5, name: "Revisiones", status: "pending" },
  { id: 6, name: "Lanzamiento", status: "pending" },
  { id: 7, name: "Soporte post-lanzamiento", status: "pending" },
];

const inv = proposal.investment || {};
const plans = inv.plans || [];
const recommended = plans.find((p: any) => p.recommended || p.featured)?.name ?? plans[1]?.name ?? plans[0]?.name;

const waMessage = proposal.whatsapp_message || proposal.whatsappMessage || defaultWhatsappMessage(clientName, projectObjective);
const wa = whatsappHref(waMessage);

// Detección de Demo / Prototipo interactivo en vivo
let previewUrl = proposal.preview_url || null;
if (!previewUrl && proposal.slug === "mercado-atlantida") {
  previewUrl = "https://mercado-atlantida.elferdi2024.workers.dev/";
}
if (!previewUrl && proposal.notes && proposal.notes.includes("http")) {
  const match = proposal.notes.match(/https?:\/\/[^\s]+/);
  if (match) previewUrl = match[0];
}

const proxyPreviewUrl = previewUrl ? `/api/preview-proxy?url=${encodeURIComponent(previewUrl)}` : null;
---

<article class="portal">
  <!-- TOP BRAND & METADATA -->
  <header class="portal-header">
    <a href="/" class="brand">AMARGO.</a>
    <div class="meta">
      <span class="label">PROPUESTA<br />COMERCIAL</span>
      {proposal.status !== "active" && (
        <span class={`badge badge-${proposal.status}`}>
          {proposal.status === "accepted" ? "✓ Aceptada" : proposal.status === "disabled" ? "No disponible" : proposal.status}
        </span>
      )}
    </div>
  </header>

  <!-- HERO: CLIENTE PRINCIPAL + OBJETIVO -->
  <div class="hero-block">
    <span class="hero-pretitle">PROPUESTA EXCLUSIVA PARA</span>
    <!-- Título Principal: Nombre del Cliente / Marca -->
    <h1 class="client-hero-title">{clientName}</h1>
    {clientCompany && clientCompany !== clientName && (
      <span class="client-company-tag">{clientCompany}</span>
    )}

    <!-- Objetivo del Proyecto: Subtítulo elegante y directo -->
    <div class="objective-badge-wrap">
      <h2 class="project-objective-title">{projectObjective}</h2>
    </div>

    {proposal.value_phrase && (
      <p class="value-phrase">{proposal.value_phrase}</p>
    )}
  </div>

  {proposal.status === "accepted" && (proposal.accepted_at || proposal.acceptedAt) && (
    <div class="accepted-banner">
      ✓ Propuesta aceptada el {formatDate(proposal.accepted_at || proposal.acceptedAt)}
      {(proposal.accepted_name || proposal.acceptedName) && ` por ${proposal.accepted_name || proposal.acceptedName}`}
      {(proposal.accepted_plan || proposal.acceptedPlan) && ` · Plan ${proposal.accepted_plan || proposal.acceptedPlan}`}.
    </div>
  )}

  <!-- 01 Desafío -->
  {proposal.challenge && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">01</span>
        <span class="line"></span>
        <span class="title">EL DESAFÍO</span>
      </div>
      <p class="body-text">{proposal.challenge}</p>
    </section>
  )}

  <!-- 02 Solución -->
  {proposal.solution && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">02</span>
        <span class="line"></span>
        <span class="title">LA SOLUCIÓN</span>
      </div>
      <p class="body-text">{proposal.solution}</p>
    </section>
  )}

  <!-- 03 Prototipo / Maqueta Interactiva en Vivo (Si existe) -->
  {previewUrl && (
    <section class="section preview-section">
      <div class="section-kicker">
        <span class="num">03</span>
        <span class="line"></span>
        <span class="title">MAQUETA INTERACTIVA EN VIVO</span>
      </div>

      <div class="demo-card-frame">
        <!-- Mockup Browser Top Bar -->
        <div class="demo-browser-bar">
          <div class="browser-dots">
            <span class="b-dot dot-red"></span>
            <span class="b-dot dot-yellow"></span>
            <span class="b-dot dot-green"></span>
          </div>

          <div class="browser-address-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span class="browser-url font-mono">mercadoatlantida.uy</span>
            <span class="live-pulse-badge font-mono">
              <span class="pulse-dot"></span> EN VIVO
            </span>
          </div>

          <div class="browser-actions">
            <a
              href={previewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-open-external"
              title="Abrir en pantalla completa en nueva pestaña"
            >
              <span>Pantalla completa</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>

        <!-- Embedded Live Iframe -->
        <div class="demo-iframe-container">
          <iframe
            src={proxyPreviewUrl || previewUrl}
            title={`Prototipo en vivo para ${clientName}`}
            class="demo-iframe"
            loading="lazy"
            allow="fullscreen; clipboard-read; clipboard-write"
          ></iframe>
        </div>

        <!-- Demo Footer info -->
        <div class="demo-footer-caption">
          <span class="demo-hint-icon">👆</span>
          <span>
            <strong>Prototipo navegable:</strong> Podés interactuar directamente con la web aquí arriba, explorar los puestos y probar cómo funciona la experiencia en tiempo real.
          </span>
        </div>
      </div>
    </section>
  )}

  <!-- Alcance -->
  {((proposal.includes?.length > 0) || (proposal.excludes?.length > 0)) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "04" : "03"}</span>
        <span class="line"></span>
        <span class="title">ALCANCE DEL SERVICIO</span>
      </div>
      <div class="scope-container">
        {proposal.includes?.length > 0 && (
          <div class="scope-group">
            <h3 class="scope-title">INCLUYE</h3>
            <ul class="scope-list">
              {proposal.includes.map((item: string) => {
                const isFullPack = item.includes("Pack de Marketing y Lanzamiento") || item.includes("Plan Full");
                return (
                  <li class={isFullPack ? "scope-item-highlight" : ""}>
                    <span class="check">{isFullPack ? "★" : "✓"}</span>
                    <span>{item}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
        {proposal.excludes?.length > 0 && (
          <div class="scope-group excludes-group">
            <h3 class="scope-title">NO INCLUYE</h3>
            <ul class="scope-list muted">
              {proposal.excludes.map((item: string) => (
                <li>
                  <span class="minus">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Inversión -->
  <section class="section" id="inversion">
    <div class="section-kicker">
      <span class="num">{previewUrl ? "05" : "04"}</span>
      <span class="line"></span>
      <span class="title">INVERSIÓN Y PLANES</span>
    </div>

    {inv.type === "plans" && plans.length > 0 ? (
      <div class="plans-grid-3" id="plans-grid">
        {plans.map((plan: any) => {
          const isSelected = plan.name === recommended;
          const isRec = plan.recommended || plan.featured;
          return (
            <div
              class={`plan-card-pro ${isSelected ? "selected" : ""} ${isRec ? "is-recommended" : ""}`}
              data-plan={plan.name}
            >
              {isRec && (
                <div class="rec-badge-pill">
                  <span>RECOMENDADO</span>
                </div>
              )}

              <div class="plan-pro-header">
                <h3 class="plan-pro-name">{plan.name}</h3>
                {plan.description && <p class="plan-pro-desc">{plan.description}</p>}
              </div>

              <div class="plan-pro-price-row">
                <span class="plan-price-num">
                  {formatMoney(plan.price, inv.currency)}
                </span>
                {plan.period && <span class="plan-price-period">{plan.period}</span>}
              </div>

              {plan.features?.length > 0 && (
                <ul class="plan-pro-features">
                  {plan.features.map((f: string) => (
                    <li>
                      <span class="f-check">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div class="fixed-price-card">
        <div class="fixed-price-header">
          <div>
            <span class="fixed-price-label">Inversión del Proyecto</span>
            <div class="amount">{formatMoney(inv.amount ?? 0, inv.currency)}</div>
          </div>
          <span class="fixed-badge">Llave en mano</span>
        </div>
        {inv.paymentTerms && <p class="terms">{inv.paymentTerms}</p>}
      </div>
    )}

    {inv.paymentTerms && inv.type === "plans" && (
      <div class="payment-terms-box">
        <span class="pt-icon">ℹ️</span>
        <p class="payment-terms">{inv.paymentTerms}</p>
      </div>
    )}
  </section>

  <!-- Tiempos -->
  {proposal.timeline && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "06" : "05"}</span>
        <span class="line"></span>
        <span class="title">TIEMPOS Y CRONOGRAMA</span>
      </div>
      <p class="body-text">{proposal.timeline}</p>
    </section>
  )}

  <!-- ROI -->
  {(proposal.roi_table?.headers?.length > 0 || proposal.roiTable?.headers?.length > 0) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "07" : "06"}</span>
        <span class="line"></span>
        <span class="title">RETORNO ESTIMADO</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              {(proposal.roi_table?.headers || proposal.roiTable?.headers || []).map((h: string) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {(proposal.roi_table?.rows || proposal.roiTable?.rows || []).map((row: string[]) => (
              <tr>
                {row.map((cell: string) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Timeline Stages -->
  <section class="section">
    <div class="section-kicker">
      <span class="num">{previewUrl ? "08" : "07"}</span>
      <span class="line"></span>
      <span class="title">ESTADO DEL PROYECTO</span>
    </div>
    <div class="timeline">
      {stages.map((stage: any) => (
        <div class={`stage stage-${stage.status}`}>
          <div class="dot"></div>
          <div class="stage-info">
            <strong>{stage.name}</strong>
            <span>
              {stage.status === "done" ? "Completado" : stage.status === "current" ? "En curso" : "Pendiente"}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Documentos -->
  {documents.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">{previewUrl ? "09" : "08"}</span>
        <span class="line"></span>
        <span class="title">DOCUMENTOS ADJUNTOS</span>
      </div>
      <ul class="documents">
        {documents.map((doc: any) => (
          <li>
            <a href={doc.url || `/api/documents/${doc.id}/download`} target="_blank" rel="noopener">
              <span class="doc-type">{doc.type}</span>
              <span class="doc-name">{doc.name}</span>
              <span class="arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Acciones -->
  <section class="actions no-print">
    <AcceptButton
      client:load
      slug={proposal.slug}
      status={proposal.status}
      plans={plans}
      planName={recommended}
      clientName={clientName}
    />

    <div class="secondary-actions">
      <a href={wa} target="_blank" rel="noopener" class="btn-outline-wa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Hablar por WhatsApp</span>
      </a>
      <button type="button" class="btn-pdf-print" onclick="window.print()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Guardar como PDF</span>
      </button>
    </div>

    <p class="note">
      El magic link no caduca. Si esta propuesta deja de estar disponible, Amargo la desactiva a mano. Aceptar registra fecha, contacto y plan elegido.
    </p>
  </section>

  <footer class="portal-footer">
    <span>AMARGO CREATIVO · ATLÁNTIDA, URUGUAY</span>
    <span>AGENCIA DIGITAL DE ALTO RENDIMIENTO</span>
  </footer>
</article>

<script>
  const cards = document.querySelectorAll(".plan-card-pro");
  cards.forEach((card) => {
    card.addEventListener("click", () => {
      cards.forEach((c) => c.classList.remove("selected"));
      card.classList.add("selected");
    });
  });
</script>

<style>
  :root {
    --bg: #F4F3EE;
    --ink: #141E18;
    --mute: #6C776E;
    --mate: #2E5339;
    --lime: #D4FF00;
    --border: #E5E4DC;
    --card: #FFFFFF;
    --card-dark: #0D1510;
  }

  .portal {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 2rem) 6rem;
    background: var(--bg);
    color: var(--ink);
    font-family: "Archivo", system-ui, -apple-system, sans-serif;
    line-height: 1.55;
    box-sizing: border-box;
  }

  /* Header */
  .portal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 3.5rem;
  }

  .brand {
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  .meta {
    text-align: right;
  }

  .label {
    display: block;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mute);
    line-height: 1.35;
  }

  .badge {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.2rem 0.55rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    background: var(--border);
  }
  .badge-accepted {
    background: rgba(46, 83, 57, 0.15);
    color: var(--mate);
    border: 1px solid rgba(46, 83, 57, 0.3);
  }
  .badge-disabled {
    background: #fee2e2;
    color: #991b1b;
  }

  /* Hero */
  .hero-block {
    margin-bottom: 2.75rem;
  }

  .hero-pretitle {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mate);
    display: block;
    margin-bottom: 0.6rem;
  }

  /* Nombre del Cliente en Grande */
  .client-hero-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--ink);
    word-break: break-word;
  }

  .client-company-tag {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--mute);
    margin-top: 0.35rem;
    font-weight: 500;
  }

  /* Objetivo del Proyecto */
  .objective-badge-wrap {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
  }

  .project-objective-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(1.2rem, 3.5vw, 1.65rem);
    font-weight: 700;
    color: #2D3D32;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .value-phrase {
    margin-top: 1.5rem;
    font-size: clamp(1.02rem, 2.3vw, 1.18rem);
    line-height: 1.6;
    color: #38423B;
    max-width: 40rem;
  }

  .accepted-banner {
    margin-top: 2rem;
    padding: 0.85rem 1.15rem;
    border-radius: 10px;
    border: 1px solid rgba(46, 83, 57, 0.3);
    background: rgba(46, 83, 57, 0.08);
    color: var(--mate);
    font-weight: 700;
    font-size: 0.92rem;
  }

  /* Sections */
  .section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .section-kicker .num {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--mate);
    font-weight: 700;
  }

  .section-kicker .line {
    flex: 1;
    height: 1px;
    background: #DCDCD4;
  }

  .section-kicker .title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #6B756E;
  }

  .body-text {
    font-size: clamp(0.98rem, 2.2vw, 1.05rem);
    line-height: 1.68;
    color: #354038;
    white-space: pre-line;
    margin: 0;
  }

  /* LIVE DEMO BROWSER FRAME */
  .preview-section {
    margin-top: clamp(2.75rem, 6vw, 3.75rem);
  }

  .demo-card-frame {
    background: #0D1510;
    border: 1px solid #233328;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(13, 21, 16, 0.15);
  }

  .demo-browser-bar {
    background: #141E18;
    border-bottom: 1px solid #24352A;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .browser-dots {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .b-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .browser-address-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0E1611;
    border: 1px solid #24352A;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    color: #A3B8AC;
  }

  .browser-url {
    color: #F4F6F2;
    font-weight: 600;
  }

  .live-pulse-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    color: var(--lime);
    font-weight: 700;
    letter-spacing: 0.08em;
    background: rgba(212, 255, 0, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 10px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 6px var(--lime);
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .btn-open-external {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lime);
    text-decoration: none;
    background: rgba(212, 255, 0, 0.1);
    border: 1px solid rgba(212, 255, 0, 0.3);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-open-external:hover {
    background: var(--lime);
    color: #0D1510;
  }

  .demo-iframe-container {
    width: 100%;
    height: 500px;
    background: #0E1611;
    position: relative;
  }

  @media (max-width: 640px) {
    .demo-iframe-container {
      height: 440px;
    }
  }

  .demo-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    background: #FFFFFF;
  }

  .demo-footer-caption {
    background: #141E18;
