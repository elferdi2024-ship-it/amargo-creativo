---
// filepath: src/components/portal/ProposalView.astro
import AcceptButton from "./AcceptButton";
import { formatMoney, formatDate, whatsappHref, defaultWhatsappMessage } from "../../lib/format";

interface Props {
  proposal: any;
  project?: any;
  documents?: any[];
}

const { proposal, project, documents = [] } = Astro.props;

const clientName = proposal.clients?.name || proposal.client_name || "Cliente";
const stages = project?.stages || [
  { id: 1, name: "Propuesta y Alcance", status: "done" },
  { id: 2, name: "Kick-off y Contenidos", status: "pending" },
  { id: 3, name: "Diseño UI/UX", status: "pending" },
  { id: 4, name: "Desarrollo", status: "pending" },
  { id: 5, name: "Revisiones", status: "pending" },
  { id: 6, name: "Lanzamiento", status: "pending" },
  { id: 7, name: "Soporte post-lanzamiento", status: "pending" },
];

const inv = proposal.investment || {};
const plans = inv.plans || [];
const waMessage = proposal.whatsapp_message || defaultWhatsappMessage(clientName, proposal.project_title);
const wa = whatsappHref(waMessage);
---

<article class="portal">
  <!-- TOP HEADER -->
  <header class="portal-header">
    <a href="/" class="brand">AMARGO.</a>
    <div class="meta">
      <span class="label">Propuesta comercial</span>
      {proposal.status !== "active" && (
        <span class={`badge badge-${proposal.status}`}>
          {proposal.status === "accepted" ? "✓ Aceptada" : proposal.status === "disabled" ? "No disponible" : proposal.status}
        </span>
      )}
    </div>
  </header>

  <!-- HERO TITLE & CLIENT -->
  <div class="hero-section">
    <p class="client-label">Para {clientName}</p>
    <h1 class="project-title">{proposal.project_title}</h1>

    {proposal.value_phrase && (
      <p class="value-phrase">{proposal.value_phrase}</p>
    )}
  </div>

  {proposal.status === "accepted" && proposal.accepted_at && (
    <div class="accepted-banner">
      ✓ Propuesta aceptada el {formatDate(proposal.accepted_at)}
      {proposal.accepted_name && ` por ${proposal.accepted_name}`}
      {proposal.accepted_plan && ` · Plan ${proposal.accepted_plan}`}.
    </div>
  )}

  <!-- 01 Desafío -->
  {proposal.challenge && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">01</span>
        <span class="line"></span>
        <span class="title">El desafío</span>
      </div>
      <p class="body-text">{proposal.challenge}</p>
    </section>
  )}

  <!-- 02 Solución -->
  {proposal.solution && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">02</span>
        <span class="line"></span>
        <span class="title">La solución</span>
      </div>
      <p class="body-text">{proposal.solution}</p>
    </section>
  )}

  <!-- 03 Alcance -->
  {(proposal.includes?.length > 0 || proposal.excludes?.length > 0) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">03</span>
        <span class="line"></span>
        <span class="title">Alcance</span>
      </div>
      <div class="scope-grid">
        {proposal.includes?.length > 0 && (
          <div class="scope-box">
            <h3>Incluye</h3>
            <ul class="includes-list">
              {proposal.includes.map((item: string) => (
                <li>
                  <span class="check">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {proposal.excludes?.length > 0 && (
          <div class="scope-box excludes-box">
            <h3>No incluye</h3>
            <ul class="excludes-list">
              {proposal.excludes.map((item: string) => (
                <li>
                  <span class="minus">−</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 04 Inversión -->
  <section class="section" id="inversion">
    <div class="section-kicker">
      <span class="num">04</span>
      <span class="line"></span>
      <span class="title">Inversión</span>
    </div>

    {inv.type === "plans" && plans.length > 0 ? (
      <div class="plans-grid">
        {plans.map((plan: any) => (
          <div class={`plan-card ${plan.recommended || plan.featured ? "recommended" : ""}`}>
            <div class="plan-header">
              <strong class="plan-title">{plan.name}</strong>
              {(plan.recommended || plan.featured) && <span class="sugerido">Recomendado</span>}
            </div>
            <div class="plan-price-wrap">
              <span class="plan-price">{formatMoney(plan.price, inv.currency)}</span>
              {plan.period && <span class="plan-period">/ {plan.period}</span>}
            </div>
            {plan.description && <p class="plan-desc">{plan.description}</p>}
            {plan.features?.length > 0 && (
              <ul class="plan-features">
                {plan.features.map((f: string) => (
                  <li>✓ {f}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="fixed-price-card">
        <div class="amount">{formatMoney(inv.amount || 0, inv.currency)}</div>
        {inv.paymentTerms && <p class="terms">{inv.paymentTerms}</p>}
      </div>
    )}
  </section>

  <!-- 05 Tiempos -->
  {proposal.timeline && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">05</span>
        <span class="line"></span>
        <span class="title">Tiempos de entrega</span>
      </div>
      <p class="body-text">{proposal.timeline}</p>
    </section>
  )}

  <!-- 06 ROI -->
  {proposal.roi_table?.headers?.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">06</span>
        <span class="line"></span>
        <span class="title">Retorno de Inversión (ROI)</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              {proposal.roi_table.headers.map((h: string) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {proposal.roi_table.rows?.map((row: string[]) => (
              <tr>
                {row.map((cell: string) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- 07 Timeline -->
  <section class="section timeline-section">
    <div class="section-kicker">
      <span class="num">07</span>
      <span class="line"></span>
      <span class="title">Etapas del proyecto</span>
    </div>
    <div class="timeline">
      {stages.map((stage: any) => (
        <div class={`stage stage-${stage.status}`}>
          <div class="dot"></div>
          <div class="stage-info">
            <strong>{stage.name}</strong>
            <span class="status-label">
              {stage.status === "done" ? "✓ Completado" : stage.status === "current" ? "● En curso" : "○ Pendiente"}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 08 Documentos -->
  {documents.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">08</span>
        <span class="line"></span>
        <span class="title">Documentos adjuntos</span>
      </div>
      <ul class="documents-list">
        {documents.map((doc: any) => (
          <li>
            <a href={doc.url || `/api/documents/${doc.id}/download`} target="_blank" rel="noopener">
              <span class="doc-type">{doc.type}</span>
              <span class="doc-name">{doc.name}</span>
              <span class="doc-arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Acciones Principales -->
  <section class="actions no-print">
    <AcceptButton
      client:load
      slug={proposal.slug}
      status={proposal.status}
      plans={plans}
      planName={inv.type === "plans" ? (plans.find((p: any) => p.recommended || p.featured)?.name) : undefined}
      clientName={clientName}
    />

    <div class="secondary-actions">
      <a href={wa} target="_blank" rel="noopener" class="btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <span>Hablar por WhatsApp</span>
      </a>
      <button type="button" class="btn-ghost" onclick="window.print()">
        Guardar como PDF
      </button>
    </div>

    <p class="note">
      Este Magic Link es personal y confidencial. Ante cualquier duda podés responder directamente por WhatsApp.
    </p>
  </section>

  <footer class="portal-footer">
    <span>AMARGO CREATIVO · Atlántida, Canelones, Uruguay</span>
    <span>Arquitectura limpia · Conversión directa · Cero bloat</span>
  </footer>
</article>

<style>
  :root {
    --bg: #F8F9F6;
    --ink: #141E18;
    --mute: #6B756E;
    --mate: #2E4A3A;
    --mate-light: #97BC62;
    --lime: #C8FF00;
    --border: #E2E4DC;
    --card: #FFFFFF;
  }

  .portal {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2rem) 6rem;
    background: var(--bg);
    color: var(--ink);
    font-family: "Archivo", system-ui, -apple-system, sans-serif;
    line-height: 1.55;
    box-sizing: border-box;
  }

  .portal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }

  .meta {
    text-align: right;
  }

  .label {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mute);
    font-weight: 700;
  }

  .badge {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    background: var(--border);
    font-weight: 700;
  }

  .badge-accepted { background: rgba(31, 138, 76, 0.15); color: #166534; border: 1px solid #C4EAD0; }
  .badge-disabled { background: #fee2e2; color: #991b1b; }

  .hero-section {
    margin-bottom: 2rem;
  }

  .client-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mate);
    font-weight: 800;
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-size: clamp(1.85rem, 5.5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
    color: var(--ink);
    word-break: break-word;
  }

  .value-phrase {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: #2E3831;
    max-width: 42rem;
    margin-bottom: 1.5rem;
    line-height: 1.45;
  }

  .accepted-banner {
    background: #EBF7EE;
    border: 1.5px solid #C4EAD0;
    color: #166534;
    padding: 0.85rem 1.15rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .section {
    margin-top: clamp(2.5rem, 6vw, 3.75rem);
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .section-kicker .num {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--mate);
    font-weight: 800;
  }

  .section-kicker .line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .section-kicker .title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mute);
    font-weight: 700;
  }

  .body-text {
    font-size: clamp(0.98rem, 2.2vw, 1.08rem);
    color: #2B332D;
    line-height: 1.65;
    white-space: pre-line;
  }

  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .scope-grid { grid-template-columns: 1fr 1fr; }
  }

  .scope-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.35rem;
  }

  .scope-box h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
    color: var(--ink);
    font-weight: 800;
  }

  .includes-list, .excludes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .includes-list li, .excludes-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .check { color: #1F8A4C; font-weight: 900; flex-shrink: 0; }
  .minus { color: #94A3B8; font-weight: 900; flex-shrink: 0; }

  .excludes-list li { color: var(--mute); }

  /* Plans Grid */
  .plans-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .plans-grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  }

  .plan-card {
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    background: var(--card);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan-card.recommended {
    border-color: var(--mate);
    background: #FAFCFA;
    box-shadow: 0 10px 25px rgba(46, 74, 58, 0.08);
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .plan-title {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .sugerido {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1F8A4C;
    font-weight: 800;
    background: #EBF7EE;
    border: 1px solid #C4EAD0;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
  }

  .plan-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0.4rem 0 0.6rem;
  }

  .plan-price {
    font-size: clamp(1.6rem, 3.5vw, 1.95rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .plan-period {
    font-size: 0.8rem;
    color: var(--mute);
    font-weight: 600;
  }

  .plan-desc {
    font-size: 0.85rem;
    color: var(--mute);
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }

  .plan-features li {
    line-height: 1.4;
  }

  .fixed-price-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    background: var(--card);
  }

  .amount {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .terms {
    margin-top: 0.5rem;
    color: var(--mute);
    font-size: 0.95rem;
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  table {
    width: 100%;
    min-width: 500px;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  th {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    font-weight: 800;
    color: var(--ink);
    background: #F4F6F2;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    color: #2B332D;
  }

  tr:last-child td {
    border-bottom: none;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .stage {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--border);
    margin-top: 0.25rem;
    flex-shrink: 0;
  }

  .stage-done .dot {
    background: #1F8A4C;
    box-shadow: 0 0 0 3px rgba(31, 138, 76, 0.25);
  }

  .stage-current .dot {
    background: var(--ink);
    box-shadow: 0 0 0 4px rgba(200, 255, 0, 0.6);
  }

  .stage-info strong {
    display: block;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .status-label {
    font-size: 0.75rem;
    color: var(--mute);
  }

  .stage-done .status-label { color: #1F8A4C; font-weight: 700; }
  .stage-current .status-label { color: var(--ink); font-weight: 800; }

  /* Documents */
  .documents-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .documents-list a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .documents-list a:hover {
    border-color: var(--ink);
  }

  .doc-type {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .doc-name {
    flex: 1;
  }

  .doc-arrow {
    color: var(--mute);
    font-weight: 700;
  }

  /* Actions */
  .actions {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  :global(.btn-primary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--ink);
    color: white;
    padding: 0.95rem 1.85rem;
    font-weight: 800;
    font-size: 1rem;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    width: 100%;
    transition: background 0.15s ease, transform 0.1s ease;
    min-height: 48px;
  }

  @media (min-width: 640px) {
    :global(.btn-primary) { width: auto; }
  }

  :global(.btn-primary:hover) { background: #000; transform: translateY(-1px); }
  :global(.btn-primary:disabled) { opacity: 0.6; cursor: not-allowed; transform: none; }

  :global(.plan-tag) { font-weight: 400; opacity: 0.85; }

  .secondary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn-outline, :global(.btn-outline) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 48px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .btn-outline, :global(.btn-outline) { width: auto; }
  }

  .btn-outline:hover, :global(.btn-outline:hover) {
    border-color: var(--ink);
  }

  .btn-ghost {
    background: none;
    border: none;
    color: var(--mute);
    font-size: 0.88rem;
    cursor: pointer;
    padding: 0.75rem 0.5rem;
    font-weight: 600;
    text-decoration: underline;
  }

  .btn-ghost:hover {
    color: var(--ink);
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: var(--mute);
    max-width: 32rem;
    line-height: 1.5;
  }

  .portal-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mute);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* Modals */
  :global(.modal-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(20, 30, 24, 0.7);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
