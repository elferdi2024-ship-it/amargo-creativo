---
// filepath: src/components/portal/ProposalView.astro
import AcceptButton from "./AcceptButton";
import { formatMoney, formatDate, whatsappHref, defaultWhatsappMessage } from "../../lib/format";

interface Props {
  proposal: any;
  project?: any;
  documents?: any[];
}

const { proposal, project, documents = [] } = Astro.props;

const clientName = proposal.clients?.name || proposal.client_name || proposal.clientName || "Cliente";
const stages = project?.stages || [
  { id: 1, name: "Propuesta y Alcance", status: "done" },
  { id: 2, name: "Kick-off y Contenidos", status: "pending" },
  { id: 3, name: "Diseño UI/UX", status: "pending" },
  { id: 4, name: "Desarrollo", status: "pending" },
  { id: 5, name: "Revisiones", status: "pending" },
  { id: 6, name: "Lanzamiento", status: "pending" },
  { id: 7, name: "Soporte post-lanzamiento", status: "pending" },
];

const inv = proposal.investment || {};
const plans = inv.plans || [];
const recommended = plans.find((p: any) => p.recommended || p.featured)?.name ?? plans[0]?.name;

const waMessage = proposal.whatsapp_message || proposal.whatsappMessage || defaultWhatsappMessage(clientName, proposal.project_title || proposal.projectTitle);
const wa = whatsappHref(waMessage);
---

<article class="portal">
  <!-- HEADER -->
  <header class="portal-header">
    <a href="/" class="brand">AMARGO.</a>
    <div class="meta">
      <span class="label">PROPUESTA<br />COMERCIAL</span>
      {proposal.status !== "active" && (
        <span class={`badge badge-${proposal.status}`}>
          {proposal.status === "accepted" ? "Aceptada" : proposal.status === "disabled" ? "No disponible" : proposal.status}
        </span>
      )}
    </div>
  </header>

  <!-- CLIENT & TITLE -->
  <div class="hero-block">
    <p class="client-label">PARA {clientName.toUpperCase()}</p>
    <h1 class="project-title">{proposal.project_title || proposal.projectTitle}</h1>

    {(proposal.value_phrase || proposal.valuePhrase) && (
      <p class="value-phrase">{proposal.value_phrase || proposal.valuePhrase}</p>
    )}
  </div>

  {proposal.status === "accepted" && (proposal.accepted_at || proposal.acceptedAt) && (
    <div class="accepted-banner">
      ✓ Propuesta aceptada el {formatDate(proposal.accepted_at || proposal.acceptedAt)}
      {(proposal.accepted_name || proposal.acceptedName) && ` por ${proposal.accepted_name || proposal.acceptedName}`}
      {(proposal.accepted_plan || proposal.acceptedPlan) && ` · Plan ${proposal.accepted_plan || proposal.acceptedPlan}`}.
    </div>
  )}

  <!-- 01 Desafío -->
  {proposal.challenge && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">01</span>
        <span class="line"></span>
        <span class="title">EL DESAFÍO</span>
      </div>
      <p class="body-text">{proposal.challenge}</p>
    </section>
  )}

  <!-- 02 Solución -->
  {proposal.solution && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">02</span>
        <span class="line"></span>
        <span class="title">LA SOLUCIÓN</span>
      </div>
      <p class="body-text">{proposal.solution}</p>
    </section>
  )}

  <!-- 03 Alcance -->
  {((proposal.includes?.length > 0) || (proposal.excludes?.length > 0)) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">03</span>
        <span class="line"></span>
        <span class="title">ALCANCE</span>
      </div>
      <div class="scope-container">
        {proposal.includes?.length > 0 && (
          <div class="scope-group">
            <h3 class="scope-title">INCLUYE</h3>
            <ul class="scope-list">
              {proposal.includes.map((item: string) => (
                <li>
                  <span class="check">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {proposal.excludes?.length > 0 && (
          <div class="scope-group excludes-group">
            <h3 class="scope-title">NO INCLUYE</h3>
            <ul class="scope-list muted">
              {proposal.excludes.map((item: string) => (
                <li>
                  <span class="minus">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 04 Inversión -->
  <section class="section" id="inversion">
    <div class="section-kicker">
      <span class="num">04</span>
      <span class="line"></span>
      <span class="title">INVERSIÓN</span>
    </div>

    {inv.type === "plans" && plans.length > 0 ? (
      <div class="plans-grid" id="plans-grid">
        {plans.map((plan: any) => {
          const isSelected = plan.name === recommended;
          return (
            <div
              class={`plan-card ${isSelected ? "selected" : ""}`}
              data-plan={plan.name}
            >
              <div class="plan-header">
                <span class="plan-name">{plan.name}</span>
                {(plan.recommended || plan.featured) && <span class="sugerido">SUGERIDO</span>}
              </div>
              <div class="plan-price">
                {formatMoney(plan.price, inv.currency)}
                {plan.period && <span class="plan-period"> {plan.period}</span>}
              </div>
              {plan.description && <p class="plan-desc">{plan.description}</p>}
              {plan.features?.length > 0 && (
                <ul class="plan-features">
                  {plan.features.map((f: string) => (
                    <li>
                      <span class="feat-check">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div class="fixed-price">
        <p class="amount">{formatMoney(inv.amount ?? 0, inv.currency)}</p>
        {inv.paymentTerms && <p class="terms">{inv.paymentTerms}</p>}
      </div>
    )}

    {inv.paymentTerms && (
      <p class="payment-terms">{inv.paymentTerms}</p>
    )}
  </section>

  <!-- 05 Tiempos -->
  {proposal.timeline && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">05</span>
        <span class="line"></span>
        <span class="title">TIEMPOS</span>
      </div>
      <p class="body-text">{proposal.timeline}</p>
    </section>
  )}

  <!-- 06 ROI -->
  {(proposal.roi_table?.headers?.length > 0 || proposal.roiTable?.headers?.length > 0) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">06</span>
        <span class="line"></span>
        <span class="title">RETORNO</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              {(proposal.roi_table?.headers || proposal.roiTable?.headers || []).map((h: string) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {(proposal.roi_table?.rows || proposal.roiTable?.rows || []).map((row: string[]) => (
              <tr>
                {row.map((cell: string) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- 07 Timeline -->
  <section class="section">
    <div class="section-kicker">
      <span class="num">07</span>
      <span class="line"></span>
      <span class="title">ESTADO DEL PROYECTO</span>
    </div>
    <div class="timeline">
      {stages.map((stage: any) => (
        <div class={`stage stage-${stage.status}`}>
          <div class="dot"></div>
          <div class="stage-info">
            <strong>{stage.name}</strong>
            <span>
              {stage.status === "done" ? "Completado" : stage.status === "current" ? "En curso" : "Pendiente"}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 08 Documentos -->
  {documents.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">08</span>
        <span class="line"></span>
        <span class="title">DOCUMENTOS</span>
      </div>
      <ul class="documents">
        {documents.map((doc: any) => (
          <li>
            <a href={doc.url || `/api/documents/${doc.id}/download`} target="_blank" rel="noopener">
              <span class="doc-type">{doc.type}</span>
              <span class="doc-name">{doc.name}</span>
              <span class="arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Acciones -->
  <section class="actions no-print">
    <AcceptButton
      client:load
      slug={proposal.slug}
      status={proposal.status}
      plans={plans}
      planName={recommended}
      clientName={clientName}
    />

    <div class="secondary-actions">
      <a href={wa} target="_blank" rel="noopener" class="btn-outline-wa">
        Hablar por WhatsApp
      </a>
      <button type="button" class="btn-pdf-print" onclick="window.print()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Guardar como PDF</span>
      </button>
    </div>

    <p class="note">
      El magic link no caduca. Si esta propuesta deja de estar disponible, Amargo la desactiva a mano. Aceptar registra fecha, contacto y plan elegido.
    </p>
  </section>

  <footer class="portal-footer">
    <span>AMARGO CREATIVO · ATLÁNTIDA, URUGUAY</span>
    <span>AGENCIA DIGITAL DE ALTO RENDIMIENTO</span>
  </footer>
</article>

<script>
  const cards = document.querySelectorAll(".plan-card");
  cards.forEach((card) => {
    card.addEventListener("click", () => {
      cards.forEach((c) => c.classList.remove("selected"));
      card.classList.add("selected");
    });
  });
</script>

<style>
  :root {
    --bg: #F4F3EE;
    --ink: #141E18;
    --mute: #7A847C;
    --mate: #2E5339;
    --lime: #D4FF00;
    --border: #E5E4DC;
    --card: #FFFFFF;
    --card-dark: #0D1510;
  }

  .portal {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 2rem) 6rem;
    background: var(--bg);
    color: var(--ink);
    font-family: "Archivo", system-ui, -apple-system, sans-serif;
    line-height: 1.55;
    box-sizing: border-box;
  }

  /* Header */
  .portal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 3.5rem;
  }

  .brand {
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
    color: var(--ink);
    text-decoration: none;
  }

  .meta {
    text-align: right;
  }

  .label {
    display: block;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mute);
    line-height: 1.35;
  }

  .badge {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.2rem 0.55rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    background: var(--border);
  }
  .badge-accepted {
    background: rgba(46, 83, 57, 0.15);
    color: var(--mate);
    border: 1px solid rgba(46, 83, 57, 0.3);
  }
  .badge-disabled {
    background: #fee2e2;
    color: #991b1b;
  }

  /* Hero */
  .hero-block {
    margin-bottom: 2.5rem;
  }

  .client-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mate);
    margin: 0 0 1rem;
  }

  .project-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(2.3rem, 7vw, 3.8rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--ink);
    word-break: break-word;
  }

  .value-phrase {
    margin-top: 1.75rem;
    font-size: clamp(1.05rem, 2.5vw, 1.22rem);
    line-height: 1.55;
    color: #2D3630;
    max-width: 38rem;
  }

  .accepted-banner {
    margin-top: 2rem;
    padding: 0.85rem 1.15rem;
    border-radius: 10px;
    border: 1px solid rgba(46, 83, 57, 0.3);
    background: rgba(46, 83, 57, 0.08);
    color: var(--mate);
    font-weight: 700;
    font-size: 0.92rem;
  }

  /* Sections */
  .section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
  }

  .section-kicker .num {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--mate);
    font-weight: 700;
  }

  .section-kicker .line {
    flex: 1;
    height: 1px;
    background: #DCDCD4;
  }

  .section-kicker .title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #6B756E;
  }

  .body-text {
    font-size: clamp(0.98rem, 2.2vw, 1.05rem);
    line-height: 1.65;
    color: #354038;
    white-space: pre-line;
    margin: 0;
  }

  /* Scope */
  .scope-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .scope-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .scope-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #2D3630;
  }

  .check {
    color: var(--mate);
    font-weight: 900;
    flex-shrink: 0;
    font-size: 1.05rem;
  }

  .minus {
    color: var(--mute);
    font-weight: 700;
    flex-shrink: 0;
    font-size: 1.05rem;
  }

  .scope-list.muted li {
    color: var(--mute);
  }

  /* Plans Grid */
  .plans-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plan-card {
    border: 1.5px solid var(--border);
    border-radius: 20px;
    padding: 1.6rem 1.75rem;
    background: var(--card);
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .plan-card:hover {
    border-color: #B5B4A8;
    transform: translateY(-2px);
  }

  .plan-card.selected {
    border-color: var(--card-dark);
    background: var(--card-dark);
    color: #FFFFFF;
    box-shadow: 0 12px 36px rgba(13, 21, 16, 0.16);
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .plan-name {
    font-family: "Syne", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .sugerido {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mate);
  }

  .plan-card.selected .sugerido {
    color: var(--lime);
  }

  .plan-price {
    font-family: "Syne", sans-serif;
    margin: 0.85rem 0 0.5rem;
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .plan-period {
    font-family: "Archivo", sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.8;
  }

  .plan-desc {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    color: var(--mute);
    line-height: 1.45;
  }

  .plan-card.selected .plan-desc {
    color: rgba(255, 255, 255, 0.75);
  }

  .plan-features {
    list-style: none;
    padding: 1rem 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.88rem;
    border-top: 1px solid var(--border);
  }

  .plan-card.selected .plan-features {
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    line-height: 1.4;
  }

  .feat-check {
    color: var(--mate);
    font-weight: 900;
  }

  .plan-card.selected .feat-check {
    color: var(--lime);
  }

  .fixed-price {
    border: 1.5px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
    background: var(--card);
  }

  .amount {
    font-family: "Syne", sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .terms {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    color: var(--mute);
  }

  .payment-terms {
    margin-top: 1.25rem;
    font-size: 0.88rem;
    color: var(--mute);
    line-height: 1.5;
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
  }

  table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  th {
    padding: 0.85rem 1.15rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #4A544D;
    background: #ECEBE5;
  }

  td {
    padding: 0.95rem 1.15rem;
    border-top: 1px solid var(--border);
    vertical-align: top;
    color: #2D3630;
    line-height: 1.45;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .stage {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border);
    margin-top: 0.35rem;
    flex-shrink: 0;
  }

  .stage-done .dot {
    background: var(--mate);
    box-shadow: 0 0 0 3px rgba(46, 83, 57, 0.2);
  }

  .stage-current .dot {
    background: var(--ink);
    box-shadow: 0 0 0 4px rgba(212, 255, 0, 0.5);
  }

  .stage-info strong {
    display: block;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .stage-info span {
    font-size: 0.78rem;
    color: var(--mute);
  }

  .stage-done .stage-info span {
    color: var(--mate);
    font-weight: 600;
  }

  /* Documents */
  .documents {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .documents a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .doc-type {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--border);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
  }

  .doc-name {
    flex: 1;
  }

  .arrow {
    color: var(--mute);
    font-weight: 700;
  }

  /* Actions */
  .actions {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid #DCDCD4;
  }

  :global(.btn-primary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--mate);
    color: white;
    padding: 0 1.5rem;
    font-family: "Archivo", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    width: 100%;
    height: 52px;
    box-shadow: 0 4px 14px rgba(46, 83, 57, 0.25);
    transition: all 0.15s ease;
  }

  :global(.btn-primary:hover) {
    background: #23422d;
    transform: translateY(-1px);
  }

  :global(.btn-primary:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .secondary-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn-outline-wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    border: 1.5px solid #DCDCD4;
    border-radius: 12px;
    background: #FFFFFF;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 700;
    transition: border-color 0.15s ease;
  }

  .btn-outline-wa:hover {
