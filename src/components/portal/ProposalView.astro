---
// filepath: src/components/portal/ProposalView.astro
import AcceptButton from "./AcceptButton";
import { formatMoney, formatDate, whatsappHref, defaultWhatsappMessage } from "../../lib/format";

interface Props {
  proposal: any;
  project?: any;
  documents?: any[];
}

const { proposal, project, documents = [] } = Astro.props;

const clientName = proposal.clients?.name || proposal.client_name || proposal.clientName || "Cliente";
const stages = project?.stages || [
  { id: 1, name: "Propuesta y Alcance", status: "done" },
  { id: 2, name: "Kick-off y Contenidos", status: "pending" },
  { id: 3, name: "Diseño UI/UX", status: "pending" },
  { id: 4, name: "Desarrollo", status: "pending" },
  { id: 5, name: "Revisiones", status: "pending" },
  { id: 6, name: "Lanzamiento", status: "pending" },
  { id: 7, name: "Soporte post-lanzamiento", status: "pending" },
];

const inv = proposal.investment || {};
const plans = inv.plans || [];
const recommended = plans.find((p: any) => p.recommended)?.name ?? plans[0]?.name;

const waMessage = proposal.whatsapp_message || proposal.whatsappMessage || defaultWhatsappMessage(clientName, proposal.project_title || proposal.projectTitle);
const wa = whatsappHref(waMessage);
---

<article class="portal">
  <!-- Header -->
  <header class="portal-header">
    <a href="/" class="brand">AMARGO.</a>
    <div class="meta">
      <span class="label">Propuesta comercial</span>
      {proposal.status !== "active" && (
        <span class={`badge badge-${proposal.status}`}>
          {proposal.status === "accepted" ? "Aceptada" : proposal.status === "disabled" ? "No disponible" : proposal.status}
        </span>
      )}
    </div>
  </header>

  <!-- Client + Title -->
  <p class="client-label">Para {clientName}</p>
  <h1 class="project-title">{proposal.project_title || proposal.projectTitle}</h1>

  {(proposal.value_phrase || proposal.valuePhrase) && (
    <p class="value-phrase">{proposal.value_phrase || proposal.valuePhrase}</p>
  )}

  {proposal.status === "accepted" && (proposal.accepted_at || proposal.acceptedAt) && (
    <div class="accepted-banner">
      Aceptada el {formatDate(proposal.accepted_at || proposal.acceptedAt)}
      {(proposal.accepted_name || proposal.acceptedName) && ` por ${proposal.accepted_name || proposal.acceptedName}`}
      {(proposal.accepted_plan || proposal.acceptedPlan) && ` · Plan ${proposal.accepted_plan || proposal.acceptedPlan}`}.
    </div>
  )}

  <!-- 01 Desafío -->
  {(proposal.challenge) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">01</span>
        <span class="line"></span>
        <span class="title">El desafío</span>
      </div>
      <p class="body-text">{proposal.challenge}</p>
    </section>
  )}

  <!-- 02 Solución -->
  {(proposal.solution) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">02</span>
        <span class="line"></span>
        <span class="title">La solución</span>
      </div>
      <p class="body-text">{proposal.solution}</p>
    </section>
  )}

  <!-- 03 Alcance -->
  {((proposal.includes?.length > 0) || (proposal.excludes?.length > 0)) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">03</span>
        <span class="line"></span>
        <span class="title">Alcance</span>
      </div>
      <div class="scope-grid">
        {proposal.includes?.length > 0 && (
          <div>
            <h3 class="scope-title">Incluye</h3>
            <ul class="scope-list">
              {proposal.includes.map((item: string) => (
                <li>
                  <span class="check">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {proposal.excludes?.length > 0 && (
          <div>
            <h3 class="scope-title">No incluye</h3>
            <ul class="scope-list muted">
              {proposal.excludes.map((item: string) => (
                <li>
                  <span class="minus">−</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 04 Inversión -->
  <section class="section">
    <div class="section-kicker">
      <span class="num">04</span>
      <span class="line"></span>
      <span class="title">Inversión</span>
    </div>

    {inv.type === "plans" && plans.length > 0 ? (
      <div class="plans-grid" id="plans-grid">
        {plans.map((plan: any) => (
          <button
            type="button"
            class={`plan-card ${plan.name === recommended ? "selected" : ""}`}
            data-plan={plan.name}
          >
            <div class="plan-header">
              <p class="plan-name">{plan.name}</p>
              {plan.recommended && <span class="sugerido">Sugerido</span>}
            </div>
            <p class="plan-price">{formatMoney(plan.price, inv.currency)}</p>
            {plan.description && <p class="plan-desc">{plan.description}</p>}
            {plan.features?.length > 0 && (
              <ul class="plan-features">
                {plan.features.map((f: string) => (
                  <li>✓ {f}</li>
                ))}
              </ul>
            )}
          </button>
        ))}
      </div>
    ) : (
      <div class="fixed-price">
        <p class="amount">{formatMoney(inv.amount ?? 0, inv.currency)}</p>
        {inv.paymentTerms && <p class="terms">{inv.paymentTerms}</p>}
      </div>
    )}

    {inv.type === "plans" && inv.paymentTerms && (
      <p class="payment-terms">{inv.paymentTerms}</p>
    )}
  </section>

  <!-- 05 Tiempos -->
  {(proposal.timeline) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">05</span>
        <span class="line"></span>
        <span class="title">Tiempos</span>
      </div>
      <p class="body-text">{proposal.timeline}</p>
    </section>
  )}

  <!-- 06 ROI -->
  {(proposal.roi_table?.headers?.length > 0 || proposal.roiTable?.headers?.length > 0) && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">06</span>
        <span class="line"></span>
        <span class="title">Retorno</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              {(proposal.roi_table?.headers || proposal.roiTable?.headers || []).map((h: string) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {(proposal.roi_table?.rows || proposal.roiTable?.rows || []).map((row: string[]) => (
              <tr>
                {row.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- 07 Timeline -->
  <section class="section">
    <div class="section-kicker">
      <span class="num">07</span>
      <span class="line"></span>
      <span class="title">Estado del proyecto</span>
    </div>
    <div class="timeline">
      {stages.map((stage: any) => (
        <div class={`stage stage-${stage.status}`}>
          <div class="dot"></div>
          <div class="stage-info">
            <strong>{stage.name}</strong>
            <span>
              {stage.status === "done" ? "Completado" : stage.status === "current" ? "En curso" : "Pendiente"}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 08 Documentos -->
  {documents.length > 0 && (
    <section class="section">
      <div class="section-kicker">
        <span class="num">08</span>
        <span class="line"></span>
        <span class="title">Documentos</span>
      </div>
      <ul class="documents">
        {documents.map((doc: any) => (
          <li>
            <a href={doc.url || `#`} target="_blank" rel="noopener">
              <span class="doc-type">{doc.type}</span>
              <span class="doc-name">{doc.name}</span>
              <span class="arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Acciones -->
  <section class="actions no-print">
    <AcceptButton
      client:load
      slug={proposal.slug}
      status={proposal.status}
      planName={recommended}
      clientName={clientName}
    />

    <div class="secondary-actions">
      <a href={wa} target="_blank" rel="noopener" class="btn-outline">
        Hablar por WhatsApp
      </a>
      <button type="button" class="btn-ghost" onclick="window.print()">
        Guardar como PDF
      </button>
    </div>

    <p class="note">
      El magic link no caduca. Si esta propuesta deja de estar disponible, Amargo la desactiva a mano. Aceptar registra fecha, contacto y plan elegido.
    </p>
  </section>

  <footer class="portal-footer">
    <span>Amargo Creativo · Atlántida, Uruguay</span>
    <span>Agencia digital de alto rendimiento</span>
  </footer>
</article>

<script>
  // Plan selection (cliente)
  const cards = document.querySelectorAll(".plan-card");
  cards.forEach((card) => {
    card.addEventListener("click", () => {
      cards.forEach((c) => c.classList.remove("selected"));
      card.classList.add("selected");
    });
  });
</script>

<style>
  :root {
    --bg: #F8F9F6;
    --ink: #141E18;
    --mute: #6B756E;
    --mate: #2E4A3A;
    --lime: #C8FF00;
    --border: #E2E4DC;
    --card: #FFFFFF;
    --paper: #F8F9F6;
  }

  .portal {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 6rem;
    background: var(--bg);
    color: var(--ink);
    font-family: "Archivo", system-ui, -apple-system, sans-serif;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .portal {
      padding: 3rem 2rem 6rem;
    }
  }

  /* Header */
  .portal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .brand {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mute);
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    background: var(--border);
  }
  .badge-accepted {
    background: rgba(46, 74, 58, 0.12);
    color: var(--mate);
    border: 1px solid rgba(46, 74, 58, 0.25);
  }
  .badge-disabled {
    background: #fee2e2;
    color: #991b1b;
  }

  /* Hero */
  .client-label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--mate);
    margin-bottom: 0.75rem;
  }

  .project-title {
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: 0 0 0;
    color: var(--ink);
  }

  .value-phrase {
    margin-top: 2rem;
    max-width: 36rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: #3a433d;
  }

  @media (min-width: 640px) {
    .value-phrase {
      font-size: 1.25rem;
    }
  }

  .accepted-banner {
    margin-top: 2rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid rgba(46, 74, 58, 0.25);
    background: rgba(46, 74, 58, 0.08);
    color: var(--mate);
    font-size: 0.9rem;
  }

  /* Sections */
  .section {
    margin-top: 3.5rem;
  }

  .section-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .section-kicker .num {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--mate);
    font-weight: 600;
  }

  .section-kicker .line {
    flex: 1;
    height: 1px;
    background: rgba(20, 30, 24, 0.1);
  }

  .section-kicker .title {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--mute);
  }

  .body-text {
    font-size: 1rem;
    line-height: 1.65;
    color: #3a433d;
  }

  @media (min-width: 640px) {
    .body-text {
      font-size: 1.05rem;
    }
  }

  /* Scope */
  .scope-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .scope-title {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .scope-list li {
    display: flex;
    gap: 0.625rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .check {
    color: var(--mate);
    font-weight: 700;
    flex-shrink: 0;
  }

  .minus {
    color: var(--mute);
    font-weight: 700;
    flex-shrink: 0;
  }

  .scope-list.muted li {
    color: var(--mute);
  }

  /* Plans */
  .plans-grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .plans-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .plan-card {
    border: 1px solid rgba(20, 30, 24, 0.12);
    border-radius: 8px;
    padding: 1.25rem;
    background: var(--card);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
  }

  .plan-card:hover {
    border-color: rgba(20, 30, 24, 0.4);
  }

  .plan-card.selected {
    border-color: var(--ink);
    background: var(--ink);
    color: white;
  }

  .plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .plan-name {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .sugerido {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mate);
  }

  .plan-card.selected .sugerido {
    color: var(--lime);
  }

  .plan-price {
    margin-top: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .plan-desc {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--mute);
  }

  .plan-card.selected .plan-desc {
    color: rgba(255, 255, 255, 0.7);
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.8rem;
  }

  .fixed-price {
    border: 1px solid rgba(20, 30, 24, 0.1);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--card);
  }

  .amount {
    font-size: 2.25rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .terms {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--mute);
  }

  .payment-terms {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--mute);
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(20, 30, 24, 0.1);
    border-radius: 8px;
  }

  table {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  th {
    padding: 0.75rem 1rem;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mute);
    background: rgba(244, 245, 241, 0.8);
  }

  td {
    padding: 0.75rem 1rem;
    border-top: 1px solid rgba(20, 30, 24, 0.08);
    vertical-align: top;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .stage {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border);
    margin-top: 0.3rem;
    flex-shrink: 0;
  }

  .stage-done .dot {
    background: var(--lime);
  }

  .stage-current .dot {
    background: var(--ink);
    box-shadow: 0 0 0 4px rgba(200, 255, 0, 0.25);
  }

  .stage-info strong {
    display: block;
    font-size: 0.95rem;
  }

  .stage-info span {
    font-size: 0.78rem;
    color: var(--mute);
  }

  .stage-done .stage-info span {
    color: var(--mate);
  }

  /* Documents */
  .documents {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .documents li {
    margin-bottom: 0.5rem;
  }

  .documents a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.9rem;
  }

  .doc-type {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--border);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .doc-name {
    flex: 1;
  }

  .arrow {
    color: var(--mute);
  }

  /* Actions */
  .actions {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(20, 30, 24, 0.1);
  }

  .secondary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .btn-ghost {
    background: none;
    border: none;
    color: var(--mute);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0.7rem 0.5rem;
  }

  .note {
    margin-top: 1.5rem;
    max-width: 28rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--mute);
  }

  .portal-footer {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(20, 30, 24, 0.1);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--mute);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .portal {
      padding: 0;
      max-width: none;
    }
  }
</style>
