---
// filepath: src/components/Navbar.astro
const pathname = Astro.url.pathname;
const isProyectos = pathname.startsWith('/proyectos');
const isServicios = pathname.startsWith('/servicios');
const isFacturacion = pathname.startsWith('/facturacion');
const isManifiesto = pathname.startsWith('/manifiesto');
---
<nav id="nav">
  <a href="/" class="brand" id="brandBtn">AMARGO<span class="brand-dot">.</span></a>
  <ul class="nav-links">
    <li><a href="/proyectos" class={isProyectos ? "active" : ""} data-text="Proyectos">Proyectos</a></li>
    <li><a href="/servicios-crecimiento" class={isServicios ? "active" : ""} data-text="Servicios">Servicios</a></li>
    <li><a href="/facturacion" class={isFacturacion ? "active" : ""} data-text="Sistemas B2B">Sistemas B2B</a></li>
    <li><a href="/#performance" data-text="Rendimiento">Rendimiento</a></li>
    <li><a href="/manifiesto" class={isManifiesto ? "active" : ""} data-text="Manifiesto">Manifiesto</a></li>
    <li><a href="/#contact" data-text="Contacto">Contacto</a></li>
  </ul>
  <div class="nav-right">
    <div class="status">
      <span class="status-live-pulse" aria-hidden="true"></span>
      <span class="status-loc">ATLÁNTIDA <strong id="navClockUY">--:--:--</strong></span>
      <span class="status-sep">|</span>
      <button class="nav-sound-btn sound-toggle-btn" id="soundToggleBtn" aria-label="Alternar audio táctil" title="Efectos de sonido táctiles">
        <span class="sound-wave-icon" aria-hidden="true"></span>
        <span class="sound-text">AUDIO <strong class="sound-state-text">OFF</strong></span>
      </button>
      <span class="status-sep">|</span>
      <span class="status-cupos">5 CUPOS</span>
    </div>
    <a 
      href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="nav-cta" 
      data-cursor="WHATSAPP"
      aria-label="Hablar por WhatsApp con Amargo Creativo"
    >
      HABLEMOS ↗
    </a>
    <button class="menu-btn" id="menuBtn" aria-label="Abrir menú" aria-expanded="false" aria-controls="menuOverlay">
      <span>MENÚ</span>
      <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 2h8M2 6h8M2 10h8" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
  </div>
</nav>

<div class="menu-overlay" id="menuOverlay" aria-hidden="true">
  <div class="menu-grid">
    <ul class="menu-items">
      <li><a href="/">01. <em>Inicio</em></a></li>
      <li><a href="/proyectos">02. Proyectos</a></li>
      <li><a href="/servicios-crecimiento">03. <em>Servicios & CRO</em></a></li>
      <li><a href="/facturacion">04. <em>Sistemas B2B & Cobros</em></a></li>
      <li><a href="/manifiesto">05. Manifiesto</a></li>
      <li><a href="/#performance">06. <em>Rendimiento</em></a></li>
      <li><a href="/#contact">07. Contacto</a></li>
      <li><a href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" target="_blank" rel="noopener noreferrer" class="menu-growth-link">★ <em>Hablar por WhatsApp</em></a></li>
    </ul>
    <div class="menu-aside">
      <h4>AGENCIA CREATIVA</h4>
      <p>Más que una agencia creativa: una fuerza que amplifica marcas y genera vínculos reales. Unimos estrategia comercial, diseño radical y software de alto rendimiento para crear activos digitales que se sienten y convierten.</p>
      <h4>FILOSOFÍA</h4>
      <p>Como un buen mate: cercano, intenso y que deja huella.</p>
      <h4>UBICACIÓN & DISPONIBILIDAD</h4>
      <p>Atlántida, Canelones<br>Cobertura en Uruguay, Argentina y España<br><strong class="highlight-cupos">5 cupos disponibles este mes</strong></p>
      
      <div class="menu-theme-row">
        <span class="menu-theme-label">TEMA VISUAL:</span>
        <div class="menu-theme-dots">
          <button class="theme-dot" data-theme="default" aria-label="Tema Hueso"></button>
          <button class="theme-dot" data-theme="dark" aria-label="Tema Carbón"></button>
          <button class="theme-dot" data-theme="electric" aria-label="Tema Eléctrico"></button>
          <button class="theme-dot" data-theme="mate" aria-label="Tema Verde Mate" title="Modo Mate"></button>
        </div>
      </div>
    </div>
  </div>
</div>
<button class="menu-close-btn" id="menuCloseBtn" aria-label="Cerrar menú">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
</button>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 var(--gut);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(232, 230, 224, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    height: calc(60px + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    transition: transform 0.4s var(--ease), background 0.4s var(--ease);
    will-change: transform;
  }
  :global(body.theme-dark) nav {
    background: rgba(20, 20, 19, 0.92);
  }
  :global(body.theme-electric) nav {
    background: rgba(10, 10, 10, 0.9);
  }
  :global(body.theme-mate) nav {
    background: rgba(18, 30, 21, 0.92);
  }
  nav:global(.hide-nav) {
    transform: translateY(-100%);
  }
  nav .brand {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
  }
  .brand-dot {
    color: var(--mate);
    transition: color 0.2s;
  }
  :global(body.theme-dark) .brand-dot,
  :global(body.theme-electric) .brand-dot,
  :global(body.theme-mate) .brand-dot {
    color: var(--electric);
  }
  nav .brand:hover {
    color: var(--rust);
  }
  nav .brand:active {
    transform: scale(0.95);
  }
  nav .nav-links {
    display: flex;
    gap: 20px;
    list-style: none;
    height: 100%;
  }
  nav .nav-links li {
    height: 100%;
    display: flex;
    align-items: center;
  }
  nav .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
    display: inline-block;
    position: relative;
    padding: 4px 0;
  }
  nav .nav-links a:hover {
    color: var(--rust);
  }
  nav .nav-links a.active {
    color: var(--mate);
    font-weight: 700;
  }
  nav .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--mate);
  }
  :global(body.theme-electric) nav .nav-links a.active {
    color: var(--electric);
  }
  :global(body.theme-electric) nav .nav-links a.active::after {
    background: var(--electric);
  }
  nav .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    margin-right: calc(var(--gut) * -1);
  }
  nav .status {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--ink);
    color: var(--bone);
    height: 100%;
    padding: 0 16px;
    font-size: 10.5px;
    border-left: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
  }
  .status-live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--electric);
    box-shadow: 0 0 6px var(--electric);
    animation: pulse 2s infinite;
  }
  .status-loc strong {
    color: var(--electric);
    font-weight: 700;
  }
  .status-sep {
    opacity: 0.3;
  }
  .nav-sound-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--bone);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s var(--ease);
  }
  .nav-sound-btn:hover {
    border-color: var(--electric);
    color: var(--electric);
  }
  .nav-sound-btn.active {
    background: var(--electric);
    color: #0a0a0a;
    border-color: var(--electric);
  }
  .nav-sound-btn.active .sound-state-text {
    color: #0a0a0a;
  }
  .sound-wave-icon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
  }
  .nav-sound-btn.active .sound-wave-icon {
    box-shadow: 0 0 6px #0a0a0a;
    animation: soundPulse 1.2s infinite ease-in-out;
  }
  @keyframes soundPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.4); }
  }
  .status-cupos {
    color: #4ade80;
    font-weight: 700;
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--electric);
    color: #0a0a0a;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid var(--ink);
    transition: transform 0.2s var(--ease), background 0.2s, color 0.2s;
    height: 36px;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--bone);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }
  .nav-cta:active {
    transform: scale(0.96);
  }
  .menu-btn {
    background: none;
    border: 1px solid var(--ink);
    padding: 8px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    cursor: pointer;
    display: none;
    align-items: center;
    gap: 8px;
    height: 36px;
    color: var(--ink);
  }
  @media (max-width: 980px) {
    nav .nav-links {
      display: none;
    }
    .menu-btn {
      display: flex;
    }
    nav .status {
      display: none;
    }
    nav .nav-right {
      margin-right: 0;
      gap: 8px;
    }
    .nav-cta {
      padding: 6px 12px;
      font-size: 10px;
    }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--overlay-bg);
    color: var(--overlay-text);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(80px + env(safe-area-inset-top)) var(--gut) calc(40px + env(safe-area-inset-bottom));
    transform: translateY(-100%);
    transition: transform 0.8s var(--ease-emphasis);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    visibility: hidden;
    width: 100%;
    will-change: transform;
  }
  .menu-overlay:global(.active) {
    transform: translateY(0);
    visibility: visible;
  }
  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    flex: 1;
    align-items: center;
    gap: 32px;
  }
  .menu-items {
    list-style: none;
  }
  .menu-items li {
    margin-bottom: 16px;
    overflow: hidden;
  }
  .menu-items a {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 6.5vw, 72px);
    color: var(--overlay-text);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1;
    transition: color 0.3s, transform 0.3s;
    display: inline-block;
    word-break: break-word;
    transform: translateY(100%);
    opacity: 0;
  }
  .menu-overlay:global(.active) .menu-items a {
    transform: translateY(0);
    opacity: 1;
  }
  .menu-overlay:global(.active) .menu-items li:nth-child(1) a { transition-delay: 0.06s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(2) a { transition-delay: 0.12s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(3) a { transition-delay: 0.18s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(4) a { transition-delay: 0.24s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(5) a { transition-delay: 0.30s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(6) a { transition-delay: 0.36s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(7) a { transition-delay: 0.42s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(8) a { transition-delay: 0.48s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(9) a { transition-delay: 0.54s; }
  .menu-overlay:global(.active) .menu-items li:nth-child(10) a { transition-delay: 0.60s; }
  .menu-growth-link {
    color: var(--electric) !important;
  }
  .menu-items a em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
  }
  .menu-items a:active {
    color: var(--electric);
    transform: scale(0.98);
  }
  .menu-aside {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: 24px;
  }
  :global(body.theme-electric) .menu-aside {
    border-left: 1px solid rgba(241, 255, 90, 0.2);
  }
  :global(body.theme-mate) .menu-aside {
    border-left: 1px solid rgba(151, 188, 98, 0.2);
  }
  .menu-aside h4 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(244, 241, 234, 0.65);
    margin-bottom: 12px;
  }
  :global(body.theme-electric) .menu-aside h4 {
    color: rgba(241, 255, 90, 0.7);
  }
  .menu-aside p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--overlay-text);
    margin-bottom: 20px;
    opacity: 0.9;
  }
  .highlight-cupos {
    color: var(--electric);
    font-weight: 700;
  }
  .menu-close-btn {
    position: fixed;
    top: env(safe-area-inset-top);
    right: 0;
    width: 60px;
    height: 60px;
    background: var(--electric);
    color: #0a0a0a;
    border: none;
    z-index: 200;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s var(--ease);
  }
  .menu-close-btn:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }
  .menu-close-btn:hover {
    transform: rotate(90deg) scale(1.05);
  }
  .menu-close-btn:active {
    transform: scale(0.95);
  }
  .menu-close-btn svg {
    width: 24px;
    height: 24px;
  }
  .menu-theme-row {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .menu-theme-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--mute-on-dark);
    text-transform: uppercase;
  }
  .menu-theme-dots {
    display: flex;
    gap: 8px;
  }
  .menu-theme-dots .theme-dot {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0;
  }
  .menu-theme-dots .theme-dot[data-theme="default"] { background: #e8e6e0; }
  .menu-theme-dots .theme-dot[data-theme="dark"] { background: #1a1a18; }
  .menu-theme-dots .theme-dot[data-theme="electric"] { background: #d4ff00; }
  .menu-theme-dots .theme-dot[data-theme="mate"] { background: #3a7d44; }

  @media (max-width: 768px) {
    .menu-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .menu-aside {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-left: 0;
      padding-top: 24px;
    }
  }
</style>

<script>
  const navClock = document.getElementById('navClockUY');
  if (navClock) {
    const fmt = new Intl.DateTimeFormat('es-UY', {
      timeZone: 'America/Montevideo',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    });
    const updateTime = () => {
      navClock.textContent = fmt.format(new Date());
    };
    setInterval(updateTime, 1000);
    updateTime();
  }

  // Safe Self-Contained Mobile Menu Controller
  const menuBtn = document.getElementById('menuBtn');
  const menuCloseBtn = document.getElementById('menuCloseBtn');
  const menuOverlay = document.getElementById('menuOverlay');

  function openMenuDirect() {
    if (!menuOverlay) return;
    menuOverlay.classList.add('active');
    menuOverlay.setAttribute('aria-hidden', 'false');
    if (menuCloseBtn) menuCloseBtn.classList.add('active');
    if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
    document.body.classList.add('no-scroll');
    const scrollCtl = (window as any).lenis;
    if (scrollCtl && typeof scrollCtl.stop === 'function') scrollCtl.stop();
  }

  function closeMenuDirect() {
    if (!menuOverlay) return;
    menuOverlay.classList.remove('active');
    menuOverlay.setAttribute('aria-hidden', 'true');
    if (menuCloseBtn) menuCloseBtn.classList.remove('active');
    if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('no-scroll');
    const scrollCtl = (window as any).lenis;
    if (scrollCtl && typeof scrollCtl.start === 'function') scrollCtl.start();
  }

  if (menuBtn) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openMenuDirect();
    });
  }

  if (menuCloseBtn) {
    menuCloseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMenuDirect();
    });
  }

  if (menuOverlay) {
    menuOverlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMenuDirect();
      });
    });
  }
</script>
