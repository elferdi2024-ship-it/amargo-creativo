---
// filepath: src/components/ThemeSwitcher.astro
---
<div class="theme-switcher" role="toolbar" aria-label="Cambiar tema de color">
  <button type="button" class="theme-dot active" data-theme="default" aria-label="Tema Hueso"></button>
  <button type="button" class="theme-dot" data-theme="dark" aria-label="Tema Carbón"></button>
  <button type="button" class="theme-dot" data-theme="electric" aria-label="Tema Eléctrico"></button>
  <button type="button" class="theme-dot" data-theme="mate" aria-label="Tema Verde Mate" title="Modo Mate"></button>
</div>

<style>
  .theme-switcher {
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom));
    left: calc(20px + env(safe-area-inset-left));
    z-index: 9999;
    display: flex;
    flex-direction: row;
    gap: 6px;
    padding: 5px;
    background: rgba(10, 10, 10, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto !important;
    touch-action: manipulation;
  }

  @media (max-width: 600px) {
    .theme-switcher {
      bottom: calc(20px + env(safe-area-inset-bottom));
      left: 14px;
      padding: 4px;
      gap: 6px;
    }
  }

  .theme-dot {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: transform 0.2s var(--ease), border-color 0.2s;
    border-radius: 2px;
    padding: 0;
    pointer-events: auto !important;
    touch-action: manipulation;
  }

  .theme-dot:hover {
    transform: scale(1.2);
  }

  .theme-dot:active {
    transform: scale(0.95);
  }

  .theme-dot.active {
    border-color: #fff;
    box-shadow: 0 0 0 2px var(--electric);
    transform: scale(1.1);
  }

  .theme-dot[data-theme="default"] { background: #e8e6e0; }
  .theme-dot[data-theme="dark"] { background: #1a1a18; }
  .theme-dot[data-theme="electric"] { background: #d4ff00; }
  .theme-dot[data-theme="mate"] { background: #3a7d44; }
</style>

<script is:inline>
  (function() {
    function applyGlobalTheme(theme) {
      if (!theme) return;
      var themes = ['default', 'dark', 'electric', 'mate'];
      themes.forEach(function(t) {
        document.body.classList.remove('theme-' + t);
        document.documentElement.classList.remove('theme-' + t);
      });
      document.body.classList.add('theme-' + theme);
      document.documentElement.classList.add('theme-' + theme);
      document.documentElement.setAttribute('data-theme', theme);

      document.querySelectorAll('.theme-dot').forEach(function(dot) {
        var dotTheme = dot.getAttribute('data-theme');
        dot.classList.toggle('active', dotTheme === theme);
      });

      try {
        localStorage.setItem('amargo_theme', theme);
      } catch (e) {}
    }

    // Event delegation global para capturar clics en móvil y desktop
    document.addEventListener('click', function(e) {
      var target = e.target;
      var btn = target && target.closest ? target.closest('.theme-dot') : null;
      if (btn) {
        e.preventDefault();
        var theme = btn.getAttribute('data-theme') || 'default';
        applyGlobalTheme(theme);
      }
    }, true);

    // Sincronizar estado inicial
    try {
      var saved = localStorage.getItem('amargo_theme') || 'default';
      applyGlobalTheme(saved);
    } catch (e) {}
  })();
</script>
