---
// filepath: src/components/ThemeSwitcher.astro
---
<div class="theme-switcher" role="toolbar" aria-label="Cambiar tema de color">
  <button class="theme-dot active" data-theme="default" aria-label="Tema Hueso"></button>
  <button class="theme-dot" data-theme="dark" aria-label="Tema Carbón"></button>
  <button class="theme-dot" data-theme="electric" aria-label="Tema Eléctrico"></button>
  <button class="theme-dot" data-theme="mate" aria-label="Tema Verde Mate" title="Modo Mate"></button>
</div>

<style>
  .theme-switcher {
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom));
    left: calc(20px + env(safe-area-inset-left));
    z-index: 500;
    display: flex;
    flex-direction: row;
    gap: 6px;
    padding: 4px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  @media (max-width: 600px) {
    .theme-switcher {
      bottom: calc(16px + env(safe-area-inset-bottom));
      left: 16px;
    }
  }
  .theme-dot {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: transform 0.2s var(--ease), border-color 0.2s;
    border-radius: 0;
    padding: 0;
  }
  .theme-dot:hover {
    transform: scale(1.2);
  }
  .theme-dot:active {
    transform: scale(0.95);
  }
  .theme-dot.active {
    border-color: #fff;
    box-shadow: 0 0 0 2px var(--electric);
    transform: scale(1.1);
  }
  .theme-dot[data-theme="default"] { background: #e8e6e0; }
  .theme-dot[data-theme="dark"] { background: #1a1a18; }
  .theme-dot[data-theme="electric"] { background: #d4ff00; }
  .theme-dot[data-theme="mate"] { background: #3a7d44; }
</style>
