---
// filepath: src/components/Manifesto.astro
// Manifiesto de Alta Dirección Editorial inspirado en la arquitectura gráfica de Dendra Agency:
// Tipografía monumental, contraste puro, espacio generoso y cero adornos innecesarios.
import RollText from './motion/RollText.astro';

const pillars = [
  {
    num: "01",
    tag: "ESTRATEGIA & SOFTWARE",
    title: "Sin intermediarios",
    desc: "Unimos estrategia comercial, diseño radical y desarrollo propio bajo un mismo techo. Cero plantillas infladas, cero alquileres cautivos: el software es 100% tuyo."
  },
  {
    num: "02",
    tag: "RENDIMIENTO EN EDGE",
    title: "Carga en <0.8s",
    desc: "Construimos motores ultrarrápidos sobre Astro 5 y Cloudflare Global Edge. Cada milisegundo ganado reduce el rebote y multiplica la retención en móviles."
  },
  {
    num: "03",
    tag: "CONVERSIÓN DIRECTA",
    title: "Ventas a WhatsApp",
    desc: "Arquitectura pensada para facturar: flujos de 1-click a WhatsApp, checkout sin fricción y posicionamiento SEO técnico líder en Google Uruguay, Argentina y España."
  }
];
---
<section class="manifesto-section" id="manifesto">
  <!-- Fondo Ambiental Texturizado con Presencia Visual Clara del Personaje con Mate -->
  <div class="manifesto-ambient-bg" aria-hidden="true"></div>
  <div class="manifesto-bg-text" aria-hidden="true">AMARGO</div>

  <div class="manifesto-container">
    
    <!-- Encabezado de sección con jerarquía minimalista -->
    <div class="manifesto-meta-bar">
      <div class="meta-label">
        <span class="meta-idx">01</span>
        <span class="meta-title">MANIFIESTO &bull; DIRECCIÓN CREATIVA</span>
      </div>
      <div class="meta-loc">
        <span class="loc-dot">●</span>
        <span>ATLÁNTIDA &bull; MONTEVIDEO &bull; BUENOS AIRES &bull; MADRID</span>
      </div>
    </div>

    <!-- Gran Bloque Monolítico de Declaración (Estilo Dendra Agency) -->
    <div class="manifesto-statement-block">
      <h2 class="statement-heading">
        <span class="heading-lead">SOMOS MÁS QUE UNA AGENCIA CREATIVA &mdash;</span>
        <span class="heading-accent">UNA FUERZA CREADA PARA POTENCIAR MARCAS Y ACELERAR VENTAS.</span>
      </h2>

      <div class="statement-editorial">
        <p class="editorial-quote">
          Integramos <em>estrategia de negocio, diseño de autor y código de alto rendimiento</em> para crear motores digitales que capturan la atención e inspiran acción inmediata.
        </p>
      </div>
    </div>

    <!-- Grilla de Pilares de Arquitectura: 3 Columnas Limpias con Gran Espacio -->
    <div class="manifesto-pillars-grid">
      {pillars.map((pillar) => (
        <div class="pillar-col">
          <div class="pillar-header">
            <span class="pillar-index">{pillar.num}</span>
            <span class="pillar-tag">{pillar.tag}</span>
          </div>
          <h3 class="pillar-title">{pillar.title}</h3>
          <p class="pillar-desc">{pillar.desc}</p>
        </div>
      ))}
    </div>

    <!-- Barra de Acción y Cierre Editorial -->
    <div class="manifesto-footer-bar">
      <div class="footer-cta-wrap">
        <a href="/manifiesto" class="manifesto-cta ink-fill" data-cursor="MÉTODO" aria-label="Explorar nuestro método y filosofía">
          <span class="ink" aria-hidden="true"></span>
          <RollText text="EXPLORAR NUESTRO MÉTODO" arrow="right" />
        </a>
      </div>
      <div class="footer-stats">
        <div class="stat-item">
          <strong>&lt; 0.8s</strong>
          <span>LCP PROMEDIO</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <strong>100%</strong>
          <span>CÓDIGO PROPIO</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <strong>0%</strong>
          <span>PLANTILLAS CAUTIVAS</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .manifesto-section {
    width: 100%;
    background: var(--bone);
    color: var(--ink);
    padding: clamp(90px, 14vh, 180px) 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Fondo Ambiental Texturizado del Personaje con Mate */
  .manifesto-ambient-bg {
    position: absolute;
    top: 50%;
    right: -2%;
    transform: translateY(-50%);
    width: clamp(340px, 48vw, 760px);
    height: 92%;
    background-image: url('/backgrounds/bg-ambient-1.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center right;
    opacity: 0.22;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
    filter: contrast(1.15) brightness(0.96);
    transition: opacity 0.5s var(--ease);
  }

  :global(body.theme-dark) .manifesto-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: screen;
    filter: invert(1) contrast(1.25);
  }

  :global(body.theme-electric) .manifesto-ambient-bg {
    opacity: 0.22;
    mix-blend-mode: screen;
    filter: grayscale(80%) contrast(1.3) sepia(1) hue-rotate(40deg);
  }

  :global(body.theme-mate) .manifesto-ambient-bg {
    opacity: 0.24;
    mix-blend-mode: multiply;
    filter: grayscale(20%) contrast(1.2) sepia(0.3) hue-rotate(85deg);
  }

  .manifesto-bg-text {
    position: absolute;
    bottom: -20px;
    left: 0;
    width: 100%;
    text-align: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20vw;
    color: var(--mate);
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  :global(body.theme-electric) .manifesto-bg-text {
    opacity: 0.06;
    color: var(--rust);
  }

  .manifesto-container {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gut);
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vw, 96px);
    position: relative;
    z-index: 2;
  }

  /* Barra superior de metadata editorial */
  .manifesto-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    flex-wrap: wrap;
    gap: 16px;
  }

  .meta-label {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta-idx {
    color: var(--bone);
    background: var(--mate);
    padding: 3px 8px;
    font-weight: 700;
  }

  :global(body.theme-electric) .meta-idx {
    background: var(--electric);
    color: #0a0a0a;
  }

  .meta-loc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 10.5px;
  }

  .loc-dot {
    color: var(--rust);
    font-size: 9px;
  }

  :global(body.theme-electric) .loc-dot {
    color: var(--electric);
  }

  /* Bloque Monumental de Declaración */
  .manifesto-statement-block {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
    max-width: 1380px;
  }

  .statement-heading {
    font-family: 'Syne', -apple-system, sans-serif;
    font-weight: 800;
    font-size: clamp(32px, 5.2vw, 86px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  .heading-lead {
    display: block;
    color: var(--ink);
    opacity: 0.92;
  }

  .heading-accent {
    display: block;
    color: var(--rust);
    margin-top: 4px;
  }

  :global(body.theme-electric) .heading-accent {
    color: var(--electric);
  }

  :global(body.theme-mate) .heading-accent {
    color: var(--mate-light);
  }

  .statement-editorial {
    max-width: 920px;
    padding-left: clamp(20px, 3vw, 40px);
    border-left: 2px solid var(--line);
  }

  .editorial-quote {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 2.2vw, 28px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
  }

  .editorial-quote em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--rust);
    font-size: 1.1em;
  }

  :global(body.theme-electric) .editorial-quote em {
    color: var(--electric);
  }

  /* Grilla de 3 Pilares */
  .manifesto-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(32px, 4.5vw, 64px);
    padding-top: clamp(32px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .pillar-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pillar-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--mute);
    text-transform: uppercase;
  }

  .pillar-index {
    font-family: 'Anton', sans-serif;
    font-size: 32px;
    line-height: 1;
    color: var(--rust);
  }

  :global(body.theme-electric) .pillar-index {
    color: var(--electric);
  }

  .pillar-tag {
    font-weight: 700;
    opacity: 0.85;
  }

  .pillar-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-transform: uppercase;
  }

  .pillar-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.6;
    color: var(--mute);
    margin: 0;
  }

  :global(body.theme-dark) .pillar-desc,
  :global(body.theme-mate) .pillar-desc {
    color: rgba(244, 241, 234, 0.75);
  }

  /* Barra de cierre inferior */
  .manifesto-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: clamp(24px, 4vw, 48px);
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 28px;
  }

  .manifesto-cta {
    --mx-fill-ink: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 16px 32px;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 3px 3px 0px var(--line);
    transition:
      transform var(--spring-snap-dur) var(--spring-snap),
      color 0.45s var(--ux-ease),
      box-shadow var(--spring-snap-dur) var(--spring-snap);
  }

  .manifesto-cta:hover,
  .manifesto-cta:focus-visible {
    color: var(--bone);
    transform: translate3d(-2px, -2px, 0);
    box-shadow: 6px 6px 0px var(--electric);
  }

  .manifesto-cta:active {
    transform: translate3d(1px, 1px, 0);
    box-shadow: 0 0 0 var(--line);
  }

  .footer-stats {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-item strong {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(20px, 2.2vw, 30px);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .stat-item span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--mute);
    text-transform: uppercase;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--line);
    opacity: 0.25;
  }

  @media (max-width: 960px) {
    .manifesto-section {
      padding: clamp(64px, 10vh, 100px) 0;
    }
    .manifesto-pillars-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .statement-editorial {
      padding-left: 16px;
    }
    .manifesto-footer-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    .manifesto-cta {
      width: 100%;
      justify-content: center;
    }
    .footer-stats {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
