---
// filepath: src/components/Manifesto.astro
// Editorial Manifesto con tipografía visible de alto contraste y revelado escalonado seguro
import RollText from './motion/RollText.astro';

const manifestoLines = [
  {
    html: 'Unimos <em>estrategia comercial, diseño radical y software</em> <mark class="hl-yellow">sin intermediarios</mark>.'
  },
  {
    html: 'Construimos webs que cargan en <mark class="hl-yellow">&lt;0.8s</mark> y transforman visitas en clientes reales.'
  },
  {
    html: 'Desde <strong>Atlántida, Uruguay</strong>, potenciamos marcas en <em>Argentina y España</em>.'
  },
  {
    html: 'Cero plantillas infladas, cero dependencias cautivas: <mark class="hl-yellow">código propio</mark> que es <em>100% tuyo</em>.'
  },
  {
    html: 'Pensamos con estrategia de negocio y <em>ejecutamos con precisión milimétrica</em>.'
  },
  {
    html: 'Como un buen mate: <em>cercano, intenso y que deja huella</em>.'
  }
];
---
<section class="manifesto" id="manifesto">
  <!-- Marca de Agua Ambiental Decorativa -->
  <div class="manifesto-ambient-bg" id="manifestoBg" aria-hidden="true"></div>
  <div class="manifesto-bg-text" id="manifestoWatermark" aria-hidden="true">AMARGO</div>

  <div class="manifesto-head">
    <div class="section-label"><span class="num">01</span> MANIFIESTO</div>
    <h2 class="manifesto-title" id="manifestoTitle">
      <span class="m-title-lead">Más que una agencia creativa:</span>
      <em class="m-title-highlight">una fuerza que amplifica voces y genera vínculos reales.</em>
    </h2>
  </div>

  <div class="manifesto-body" id="manifestoBody">
    <div class="manifesto-lines">
      {manifestoLines.map((line, index) => (
        <div class="m-line-item" style={`--line-delay: ${index * 80}ms;`}>
          <p class="m-line-content" set:html={line.html}></p>
        </div>
      ))}
    </div>
  </div>

  <div class="manifesto-action">
    <a href="/manifiesto" class="manifesto-cta-link ink-fill" data-cursor="METODOLOGÍA" aria-label="Explorar nuestra metodología y proceso">
      <span class="ink" aria-hidden="true"></span>
      <RollText text="EXPLORAR NUESTRA METODOLOGÍA & PROCESO" arrow="right" />
    </a>
  </div>
</section>

<style>
  .manifesto {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(60px, 9vh, 120px) var(--gut);
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    width: 100%;
    background: var(--bone);
  }

  /* Fondo Ambiental Texturizado detrás del texto */
  .manifesto-ambient-bg {
    position: absolute;
    top: 5%;
    right: -2%;
    width: clamp(280px, 45vw, 680px);
    height: 90%;
    background-image: url('/backgrounds/bg-ambient-1.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center right;
    opacity: 0.16;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
    filter: contrast(1.1) brightness(0.98);
    transition: opacity 0.5s var(--ease);
  }

  :global(body.theme-electric) .manifesto-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: screen;
    filter: grayscale(80%) contrast(1.2) sepia(1) hue-rotate(40deg);
  }

  :global(body.theme-dark) .manifesto-ambient-bg {
    opacity: 0.14;
    mix-blend-mode: screen;
  }

  :global(body.theme-mate) .manifesto-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: multiply;
    filter: grayscale(20%) contrast(1.2) sepia(0.3) hue-rotate(85deg);
  }

  .manifesto-head {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    margin-bottom: 48px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 2;
  }

  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .manifesto-head h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(24px, 4.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .m-title-lead {
    display: block;
    color: var(--ink);
  }

  .m-title-highlight {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--rust);
    display: block;
    margin-top: 4px;
  }

  /* CUERPO DEL MANIFIESTO: 100% VISIBLE Y LEGIBLE SIEMPRE */
  .manifesto-body {
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .manifesto-lines {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2.2vw, 24px);
  }

  .m-line-item {
    position: relative;
    opacity: 1;
    transform: none;
    transition: opacity 0.7s var(--spring-soft), transform 0.7s var(--spring-soft);
    transition-delay: var(--line-delay, 0ms);
  }

  .m-line-content {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 400;
    font-size: clamp(18px, 2.8vw, 34px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
  }

  .m-line-content :global(em) {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--rust);
  }

  .m-line-content :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }

  .m-line-content :global(mark.hl-yellow) {
    background: var(--electric);
    color: #0a0a0a !important;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 2px;
    display: inline-block;
    line-height: 1.15;
  }

  .manifesto-bg-text {
    position: absolute;
    bottom: -20px;
    left: 0;
    width: 100%;
    text-align: center;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20vw;
    color: var(--mate);
    opacity: 0.04;
    pointer-events: none;
    z-index: 1;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  :global(body.theme-electric) .manifesto-bg-text {
    opacity: 0.06;
    color: var(--rust);
  }

  .manifesto-action {
    margin-top: clamp(32px, 5vw, 56px);
    display: flex;
    position: relative;
    z-index: 2;
  }

  .manifesto-cta-link {
    --mx-fill-ink: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 12px 24px;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 2px 2px 0px var(--line);
    transition:
      transform var(--spring-snap-dur) var(--spring-snap),
      color 0.45s var(--ux-ease),
      box-shadow var(--spring-snap-dur) var(--spring-snap);
  }

  .manifesto-cta-link:hover,
  .manifesto-cta-link:focus-visible {
    color: var(--bone);
    transform: translate3d(-2px, -2px, 0);
    box-shadow: 4px 4px 0px var(--electric);
  }

  .manifesto-cta-link:active {
    transform: translate3d(1px, 1px, 0);
    box-shadow: 0 0 0 var(--line);
  }

  @media (max-width: 768px) {
    .manifesto-head {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 16px;
    }
    .m-line-content {
      font-size: clamp(16px, 4.6vw, 22px);
      line-height: 1.45;
    }
    .manifesto-lines {
      gap: 16px;
    }
    .manifesto-ambient-bg {
      width: 70vw;
      right: -8%;
      opacity: 0.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-line-item {
      transition: none !important;
    }
  }
</style>
