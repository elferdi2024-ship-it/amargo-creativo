---
// filepath: src/components/Manifesto.astro
// Radical, distilled editorial manifesto — high visual impact, zero filler paragraphs
import RollText from './motion/RollText.astro';

const pillars = [
  {
    num: "01",
    tag: "APPS & IA",
    title: "Productos reales",
    desc: "Super-apps de delivery, bóvedas con IA, portales ciudadanos y dashboards operativos hechos a medida."
  },
  {
    num: "02",
    tag: "CANAL PROPIO",
    title: "Cero comisiones",
    desc: "Tiendas D2C, catálogos multi-sucursal y flujos a WhatsApp para vender sin ceder 30% a intermediarios."
  },
  {
    num: "03",
    tag: "PROPIEDAD TOTAL",
    title: "100% tuyo",
    desc: "Código propio, diseño de autor e infraestructura rápida en la nube. Sin plantillas ni alquileres cautivos."
  }
];
---
<section class="manifesto-section" id="manifesto">
  <div class="manifesto-ambient-bg ambient-parallax" aria-hidden="true"></div>

  <div class="manifesto-container">
    <div class="manifesto-meta-bar">
      <div class="meta-label">
        <span class="meta-idx">01</span>
        <span class="meta-title">MANIFIESTO &bull; PRODUCT STUDIO</span>
      </div>
      <div class="meta-loc">
        <span class="loc-dot" aria-hidden="true">●</span>
        <span>UY &bull; AR &bull; ES</span>
      </div>
    </div>

    <div class="manifesto-statement-block">
      <h2 class="statement-heading" data-reveal-words>
        <span class="heading-lead">NO HACEMOS FOLLETOS.</span>
        <span class="heading-accent">CONSTRUIMOS APPS Y SOFTWARE QUE OPERAN TU NEGOCIO.</span>
      </h2>

      <div class="statement-editorial" data-reveal-block style="--rd:90ms">
        <p class="editorial-quote">
          Como un buen amargo a 80°C: <em>intenso, artesanal y hecho para durar.</em>
        </p>
      </div>
    </div>

    <div class="manifesto-pillars-grid">
      {pillars.map((pillar, i) => (
        <article class="pillar-col" data-reveal-block style={`--rd:${i * 80}ms`}>
          <div class="pillar-header">
            <span class="pillar-index tabular">{pillar.num}</span>
            <span class="pillar-tag">{pillar.tag}</span>
          </div>
          <h3 class="pillar-title">{pillar.title}</h3>
          <p class="pillar-desc">{pillar.desc}</p>
        </article>
      ))}
    </div>

    <div class="manifesto-footer-bar">
      <a href="/manifiesto" class="manifesto-cta ink-fill" data-cursor="MÉTODO">
        <span class="ink" aria-hidden="true"></span>
        <RollText text="CONOCER NUESTRO MÉTODO" arrow="right" />
      </a>
      <div class="footer-stats">
        <div class="stat-item">
          <strong class="tabular">11+</strong>
          <span>APPS EN VIVO</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <strong class="tabular">100%</strong>
          <span>CÓDIGO TUYO</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <strong class="tabular">0%</strong>
          <span>PLANTILLAS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    width: 100%;
    background: var(--bone);
    color: var(--ink);
    padding: clamp(64px, 11vh, 148px) 0;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .manifesto-ambient-bg {
    position: absolute;
    top: 50%;
    right: -2%;
    transform: translateY(-50%);
    width: clamp(280px, 44vw, 680px);
    height: 88%;
    background-image: url('/backgrounds/bg-ambient-1.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center right;
    opacity: 0.2;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
    filter: contrast(1.15) brightness(0.96);
    mask-image: radial-gradient(ellipse 72% 72% at 68% 50%, black 28%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 72% 72% at 68% 50%, black 28%, transparent 78%);
  }

  :global(body.theme-dark) .manifesto-ambient-bg,
  :global(body.theme-electric) .manifesto-ambient-bg {
    opacity: 0.16;
    mix-blend-mode: screen;
    filter: invert(1) contrast(1.2);
  }

  :global(body.theme-mate) .manifesto-ambient-bg {
    opacity: 0.2;
    mix-blend-mode: screen;
    filter: invert(1) sepia(0.35) hue-rotate(60deg);
  }

  .manifesto-container {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gut);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vw, 64px);
    position: relative;
    z-index: 2;
  }

  .manifesto-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .meta-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .meta-idx {
    color: #f5f3ec;
    background: var(--mate);
    padding: 3px 8px;
    font-weight: 700;
    border-radius: 2px;
  }

  :global(body.theme-electric) .meta-idx {
    background: var(--electric);
    color: #11120f;
  }

  .meta-loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .loc-dot {
    color: var(--rust);
    font-size: 8px;
  }

  .manifesto-statement-block {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3vw, 32px);
    max-width: 1180px;
  }

  .statement-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 5.2vw, 80px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .heading-lead {
    display: block;
  }

  .heading-accent {
    display: block;
    color: var(--rust);
    margin-top: 4px;
  }

  :global(body.theme-electric) .heading-accent {
    color: var(--electric);
  }

  :global(body.theme-mate) .heading-accent {
    color: var(--mate-light);
  }

  .statement-editorial {
    padding-left: clamp(14px, 2.5vw, 28px);
    border-left: 2px solid var(--mate);
  }

  .editorial-quote {
    font-family: var(--font-body);
    font-size: clamp(17px, 2vw, 26px);
    line-height: 1.4;
    color: var(--ink);
  }

  .editorial-quote em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--rust);
    font-size: 1.12em;
  }

  :global(body.theme-electric) .editorial-quote em {
    color: var(--electric);
  }

  .manifesto-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3.5vw, 48px);
    padding-top: clamp(24px, 4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .pillar-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pillar-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--mute);
    text-transform: uppercase;
  }

  .pillar-index {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rust);
  }

  :global(body.theme-electric) .pillar-index {
    color: var(--electric);
  }

  .pillar-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-transform: uppercase;
  }

  .pillar-desc {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--mute);
    max-width: 34ch;
  }

  .manifesto-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: clamp(20px, 3.5vw, 36px);
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 20px;
  }

  .manifesto-cta {
    --mx-fill-ink: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 14px 26px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--paper);
    transition: transform 0.3s var(--ease-emphasis), color 0.35s var(--ease);
  }

  .manifesto-cta:hover,
  .manifesto-cta:focus-visible {
    color: var(--bone);
    transform: translate3d(0, -2px, 0);
  }

  .footer-stats {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-item strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 26px);
    line-height: 1;
    color: var(--ink);
  }

  .stat-item span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--mute);
  }

  .stat-divider {
    width: 1px;
    height: 28px;
    background: var(--line);
  }

  /* MOBILE: Horizontal snap cards for pillars = zero boring vertical wall! */
  @media (max-width: 820px) {
    .manifesto-section {
      padding: 56px 0;
    }
    .manifesto-ambient-bg {
      opacity: 0.12;
      width: 65vw;
    }
    .manifesto-pillars-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-top: 20px;
      padding-bottom: 6px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .manifesto-pillars-grid::-webkit-scrollbar {
      display: none;
    }
    .pillar-col {
      flex: 0 0 78vw;
      scroll-snap-align: start;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      padding: 20px 18px;
      gap: 8px;
    }
    .manifesto-footer-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }
    .manifesto-cta {
      justify-content: center;
    }
    .footer-stats {
      justify-content: space-between;
    }
  }
</style>
