---
// filepath: src/components/Hero.astro
---
<div class="hero-scroll-wrapper" id="heroScrollWrapper">
  <div class="hero-sticky-stage" id="heroStickyStage">
    <!-- Canvas de Renderizado de Ultra Precisión a 60/120fps -->
    <canvas id="heroCanvas" class="hero-canvas"></canvas>
    
    <!-- Video Fuente (Decodificador de Frames en Memoria) -->
    <video 
      id="heroVideo" 
      class="hero-video-source" 
      src="/hero-scroll.mp4" 
      preload="auto" 
      muted 
      playsinline 
      webkit-playsinline
      aria-hidden="true"
    ></video>
    
    <!-- Capa de Tinte Sutil Brutalista & Vignette -->
    <div class="hero-gradient"></div>
    <div class="hero-grid-overlay"></div>

    <!-- UI Perimetral Limpia (Sin textos centrales que tapen el video) -->
    <header class="hero-ui" id="top">
      <div class="hero-top">
        <div class="hero-live-badge"><span>● EN VIVO</span><span>ESTUDIO CREATIVO DIGITAL</span></div>
        <div class="hero-location-badge"><span>ATLÁNTIDA, CANELONES</span><span>v30.0</span></div>
      </div>

      <!-- Indicador Central de Scroll Sutil (Se desvanece en el primer giro) -->
      <div class="hero-scroll-hint" id="heroScrollHint">
        <div class="hint-bar">
          <span class="hint-dot"></span>
        </div>
        <span class="hint-text">GIRA LA RUEDA PARA EXPLORAR</span>
      </div>

      <!-- Barra Inferior de Acción y Métricas -->
      <div class="hero-bottom" id="heroBottom">
        <div class="hero-sub-wrap">
          <p class="hero-sub">Diseñamos páginas web y activos digitales de alto rendimiento que transforman visitas en clientes reales.</p>
          <div class="hero-cta-wrap">
            <a 
              href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hero-cta magnetic-btn" 
              data-cursor="WHATSAPP"
            >
              HABLAR POR WHATSAPP ↗
            </a>
            <a href="#showcase" class="hero-cta-secondary">VER TRABAJOS →</a>
          </div>
        </div>

        <div class="hero-stats">
          <div class="hero-meta">
            <strong>100%</strong>
            <span>ENFOCADO EN VENTAS</span>
          </div>
          <div class="hero-meta">
            <strong>&lt; 1.0s</strong>
            <span>CARGA INSTANTÁNEA</span>
          </div>
        </div>
      </div>

      <!-- Badge Giratorio Brutalista -->
      <div class="hero-badge" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <defs><path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" /></defs>
          <text font-family="JetBrains Mono" font-size="9" font-weight="700" letter-spacing="1.5" fill="currentColor">
            <textPath xlink:href="#circle">AMARGO CREATIVO™ • ESTUDIO CREATIVO • ATLÁNTIDA, UY • </textPath>
          </text>
        </svg>
        <div class="badge-inner">A</div>
      </div>
    </header>
  </div>
</div>

<script>
  // =========================================================================
  // MOTOR DE VIDEO SCRUBBING INSTANTÁNEO (CERO DELAY & RESPUESTA INMEDIATA)
  // =========================================================================
  const wrapper = document.getElementById('heroScrollWrapper');
  const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const scrollHint = document.getElementById('heroScrollHint');

  if (wrapper && canvas && video) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const isMobileOrTouch = window.matchMedia('(max-width: 768px), (hover: none)').matches;

    let targetTime = 0;
    let currentTime = 0;
    let isVideoReady = false;

    // 1. Ajuste de Resolución Retina en Canvas
    function resizeCanvas() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      drawCanvasFrame();
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // 2. Renderizado de Frame con Cobertura Completa (object-fit: cover)
    function drawCanvasFrame() {
      if (!ctx || !canvas || !video || video.readyState < 2) return;
      const vW = video.videoWidth;
      const vH = video.videoHeight;
      if (!vW || !vH) return;

      const cW = canvas.width;
      const cH = canvas.height;
      const videoRatio = vW / vH;
      const canvasRatio = cW / cH;

      let dW: number, dH: number, oX: number, oY: number;

      if (canvasRatio > videoRatio) {
        dW = cW;
        dH = cW / videoRatio;
        oX = 0;
        oY = (cH - dH) / 2;
      } else {
        dW = cH * videoRatio;
        dH = cH;
        oX = (cW - dW) / 2;
        oY = 0;
      }

      ctx.drawImage(video, oX, oY, dW, dH);
    }

    // 3. Inicialización Inmediata del Video
    function readyVideo() {
      video.pause();
      video.currentTime = 0;
      isVideoReady = true;
      drawCanvasFrame();
    }

    if (video.readyState >= 2) {
      readyVideo();
    } else {
      video.addEventListener('loadedmetadata', readyVideo, { once: true });
      video.addEventListener('loadeddata', readyVideo, { once: true });
      video.addEventListener('canplay', readyVideo, { once: true });
    }

    // 4. Modo Móvil: Reproducción fluida en loop sin fricción de scroll
    if (isMobileOrTouch) {
      video.autoplay = true;
      video.loop = true;
      video.play().catch(() => {});

      function mobileLoop() {
        drawCanvasFrame();
        requestAnimationFrame(mobileLoop);
      }
      requestAnimationFrame(mobileLoop);
    } else {
      // 5. Modo Desktop: Cálculo Directo desde el Primer Píxel (Sin Delays)
      function updateScrub() {
        if (!wrapper || !video || !video.duration) return;
        const rect = wrapper.getBoundingClientRect();
        const maxScroll = wrapper.offsetHeight - window.innerHeight;
        
        // currentScroll empieza exactamente en 0 desde el top
        const currentScroll = Math.max(0, -rect.top);
        const progress = Math.min(Math.max(currentScroll / maxScroll, 0), 1);

        // Mapeo directo y ultra-responsivo
        targetTime = progress * video.duration;

        // Ocultar hint de scroll en cuanto se mueve
        if (scrollHint) {
          scrollHint.style.opacity = progress > 0.04 ? '0' : '1';
        }
      }

      window.addEventListener('scroll', updateScrub, { passive: true });
      if ((window as any).lenis?.on) {
        (window as any).lenis.on('scroll', updateScrub);
      }

      // Loop de Renderizado con Interpolación Alta (0.28 = Máxima reactividad y cero delay)
      function render() {
        if (isVideoReady && video && video.duration) {
          const diff = targetTime - currentTime;
          currentTime += diff * 0.28;

          if (Math.abs(video.currentTime - currentTime) > 0.003) {
            video.currentTime = currentTime;
          }
        }

        drawCanvasFrame();
        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);
    }
  }
</script>

<style>
  /* Pista de Scroll Calibrada: 180vh (Exactamente 1.5 a 2 giros rápidos de rueda) */
  .hero-scroll-wrapper {
    position: relative;
    height: 180vh;
    width: 100%;
  }

  @media (max-width: 768px) {
    .hero-scroll-wrapper {
      height: 100vh;
      height: 100svh;
    }
  }

  .hero-sticky-stage {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #0a0a0a;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    filter: contrast(1.08) brightness(0.9);
    transition: filter 0.5s var(--ease);
  }

  :global(body.theme-electric) .hero-canvas {
    filter: grayscale(40%) contrast(1.25) brightness(0.75) sepia(1) hue-rotate(40deg) saturate(1.8);
  }

  :global(body.theme-mate) .hero-canvas {
    filter: grayscale(10%) contrast(1.15) brightness(0.85) sepia(0.2) hue-rotate(85deg);
  }

  .hero-video-source {
    display: none;
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .hero-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 50%, transparent 100%);
    z-index: 2;
    pointer-events: none;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: 2;
    pointer-events: none;
  }

  .hero-ui {
    position: relative;
    height: 100%;
    color: #f4f1ea;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 10;
    width: 100%;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    padding: calc(80px + env(safe-area-inset-top)) var(--gut) 16px;
    font-size: 11px;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: 8px;
    position: relative;
    z-index: 10;
  }

  .hero-top > div {
    display: flex;
    gap: 16px;
  }

  .hero-top span:first-child {
    color: var(--electric);
    font-weight: 700;
  }

  /* Indicador de Scroll Central */
  .hero-scroll-hint {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    pointer-events: none;
    transition: opacity 0.3s ease;
    margin-top: auto;
    margin-bottom: 20px;
  }

  .hint-bar {
    width: 20px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hint-dot {
    width: 4px;
    height: 8px;
    background: var(--electric);
    border-radius: 2px;
    animation: hintScroll 2s infinite ease-in-out;
  }

  @keyframes hintScroll {
    0% { transform: translateY(0); opacity: 1; }
    60% { transform: translateY(12px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }

  .hint-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .hero-bottom {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    padding: 28px var(--gut);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    flex-wrap: wrap;
    background: rgba(10, 10, 10, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  :global(body.theme-electric) .hero-bottom {
    border-top: 1px solid rgba(241, 255, 90, 0.2);
  }

  :global(body.theme-mate) .hero-bottom {
    border-top: 1px solid rgba(151, 188, 98, 0.2);
  }

  .hero-sub-wrap {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #f4f1ea;
    opacity: 0.9;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-cta-wrap {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--electric);
    color: #0a0a0a;
    padding: 12px 22px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
    transition: transform 0.2s var(--ease), background 0.2s;
    will-change: transform;
    height: 42px;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    background: var(--bone);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }

  .hero-cta:active {
    transform: scale(0.96);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #f4f1ea;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 12px 18px;
    height: 42px;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
  }

  .hero-cta-secondary:active {
    transform: scale(0.96);
  }

  .hero-stats {
    display: flex;
    gap: 40px;
    align-items: flex-end;
  }

  .hero-meta {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-meta strong {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 36px);
    display: block;
    text-transform: none;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
    color: #f4f1ea;
    line-height: 1;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.7);
  }

  .hero-badge {
    position: absolute;
    bottom: calc(28px + env(safe-area-inset-bottom));
    right: var(--gut);
    width: 110px;
    height: 110px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-badge svg {
    width: 100%;
    height: 100%;
    animation: spin 20s linear infinite;
    will-change: transform;
  }

  .hero-badge:hover svg {
    animation-duration: 6s;
  }

  .hero-badge .badge-inner {
    position: absolute;
    width: 40px;
    height: 40px;
    background: var(--electric);
    border: 2px dashed var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 18px;
    pointer-events: auto;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }

    .hero-stats {
      width: 100%;
      justify-content: flex-start;
      gap: 28px;
    }

    .hero-cta-wrap {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-cta, .hero-cta-secondary {
      width: 100%;
      text-align: center;
    }

    .hero-badge {
      display: none;
    }
  }
</style>
