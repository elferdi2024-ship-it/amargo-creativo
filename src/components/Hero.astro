---
// filepath: src/components/Hero.astro
// Motion: ver src/styles/motion.css (springs + gating html.mx).
// Lucian UX/UI Prompt #237 · MIT License (c) 2026 Seokwoooo · https://lucianlabs.dev/uxui-prompt/#237
// Lucian UX/UI Prompt #009 · MIT License (c) 2026 Seokwoooo · https://lucianlabs.dev/uxui-prompt/#009
import RollText from './motion/RollText.astro';

const titleWords: string[] = ['MOTORES', 'DE', 'CRECIMIENTO', 'DIGITAL', 'EN', 'URUGUAY'];
const lastIndex = titleWords.length - 1;
---
<header class="hero" id="top">
  <!-- Contenedor de Video Cinemático a Máxima Nitidez y Calidad Original -->
  <div class="hero-media-container">
    <!-- Capa de parallax (puntero + scroll, JS) -->
    <div class="hero-media-inner" id="heroMediaInner">
      <!-- Capa de entrada (zoom-out de cámara, CSS) -->
      <div class="hero-media-zoom">
        <picture class="hero-poster-pic">
          <source media="(max-width: 768px)" srcset="/amargo-hero-mobile.webp" type="image/webp" />
          <source media="(min-width: 769px)" srcset="/amargo-hero-pc.webp" type="image/webp" />
          <img 
            src="/amargo-hero-pc.webp" 
            alt="Amargo Creativo — Hero Poster" 
            class="hero-poster-img"
            fetchpriority="high"
            decoding="async"
            width="2000" 
            height="1116" 
          />
        </picture>
        <video 
          id="heroVideo" 
          class="hero-video" 
          data-src="/new-hero.mp4" 
          poster="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          loop 
          muted 
          playsinline 
          webkit-playsinline
          preload="none"
          aria-hidden="true"
        ></video>
      </div>
    </div>
    <div class="hero-gradient" id="heroGradient"></div>
  </div>

  <!-- Barra Superior del Hero -->
  <div class="hero-top">
    <div class="hero-live-badge hx" style="--d:150ms;--hx-y:-10px">
      <span class="live-label"><span class="live-dot" aria-hidden="true"></span>EN VIVO</span>
      <span>AGENCIA DIGITAL DE ALTO RENDIMIENTO</span>
    </div>
    <div class="hero-location-badge hx" style="--d:230ms;--hx-y:-10px">
      <span>ATLÁNTIDA, CANELONES</span>
      <span>URUGUAY &bull; ARGENTINA &bull; ESPAÑA</span>
    </div>
  </div>

  <!-- Área Central Abierta: El arte original del mate luce al 100% sin solapamientos -->
  <div class="hero-spacer" aria-hidden="true"></div>

  <!-- Barra Inferior Editorial Equilibrada en 3 Columnas (Titular • Pilares • Métricas) -->
  <div class="hero-bottom hx" id="heroBottom" style="--d:200ms;--hx-y:36px">
    <!-- Columna 1: Titular Semántico, Propuesta de Valor & Acciones -->
    <div class="hero-sub-wrap">
      <h1 class="hero-h1">
        <span class="h1-sub hx" style="--d:380ms;--hx-y:8px">CREACIÓN DE PÁGINAS WEB &bull; APPS &bull; SEO &bull; CONVERSIÓN</span>
        <span class="h1-title" style="--d:420ms">
          {titleWords.map((word, i) => (
            i === lastIndex ? (
              <span class="hw-u">
                <span class="hw"><span class="hwi" style={`--i:${i}`}>{word}</span></span>
                <svg class="h1-underline" viewBox="0 0 210 22" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <path d="M3 14c30-8 62-9 96-5s70 6 108-4" />
                </svg>
              </span>
            ) : (
              <><span class="hw"><span class="hwi" style={`--i:${i}`}>{word}</span></span>{' '}</>
            )
          ))}
        </span>
      </h1>
      <p class="hero-sub hx" style="--d:620ms;--hx-y:12px">Webs ultrarrápidas (&lt;0.8s), aplicaciones de autor y conversión directa a WhatsApp.</p>
      <div class="hero-cta-wrap">
        <span class="hero-cta-slot hx-pop" style="--d:760ms">
          <span class="magnetic-btn hero-cta-mag">
            <a 
              href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto%20web" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hero-cta ink-fill" 
              data-cursor="WHATSAPP"
              aria-label="Hablar directamente por WhatsApp para cotizar proyecto"
            >
              <span class="ink" aria-hidden="true"></span>
              <RollText text="HABLAR POR WHATSAPP" arrow="diag" />
            </a>
          </span>
        </span>
        <span class="hero-cta-slot hx-pop" style="--d:840ms">
          <a href="#showcase" class="hero-cta-secondary ink-fill" aria-label="Ver proyectos y casos de éxito">
            <span class="ink" aria-hidden="true"></span>
            <RollText text="VER TRABAJOS" arrow="right" />
          </a>
        </span>
      </div>
    </div>

    <!-- Columna 2: Sellos de Arquitectura Editorial (Síntesis limpia sin saturación de texto) -->
    <div class="hero-pillars" aria-label="Sellos de Arquitectura Editorial">
      <div class="pillar-item hx" style="--d:600ms;--hx-x:-12px;--hx-y:0px">
        <span class="pillar-num">01</span>
        <div class="pillar-content">
          <strong>CÓDIGO PROPIO</strong>
          <span>Astro 5 &bull; Next.js</span>
        </div>
      </div>
      <div class="pillar-item hx" style="--d:680ms;--hx-x:-12px;--hx-y:0px">
        <span class="pillar-num">02</span>
        <div class="pillar-content">
          <strong>CONVERSIÓN</strong>
          <span>Directo a WhatsApp</span>
        </div>
      </div>
      <div class="pillar-item hx" style="--d:760ms;--hx-x:-12px;--hx-y:0px">
        <span class="pillar-num">03</span>
        <div class="pillar-content">
          <strong>SEO & EDGE</strong>
          <span>&lt;0.8s Cloudflare</span>
        </div>
      </div>
    </div>

    <!-- Columna 3: Métricas de Autoridad & Badge Giratorio -->
    <div class="hero-right-wrap">
      <div class="hero-stats">
        <div class="hero-meta hx" style="--d:700ms;--hx-y:10px">
          <strong data-count-from="0" data-count-to="100" data-count-suffix="%">100%</strong>
          <span>ENFOCADO EN VENTAS</span>
        </div>
        <div class="hero-meta hx" style="--d:780ms;--hx-y:10px">
          <strong data-count-from="4.8" data-count-to="0.8" data-count-decimals="1" data-count-prefix="< " data-count-suffix="s">&lt; 0.8s</strong>
          <span>CARGA INSTANTÁNEA</span>
        </div>
      </div>

      <!-- Badge Giratorio Brutalista Integrado -->
      <div class="hero-badge hx-pop" id="heroBadge" style="--d:900ms" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" id="badgeSvg">
          <defs><path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" /></defs>
          <text font-family="JetBrains Mono" font-size="9" font-weight="700" letter-spacing="1.5" fill="currentColor">
            <textPath xlink:href="#circle">AMARGO CREATIVO™ • AGENCIA CREATIVA • ATLÁNTIDA, UY • </textPath>
          </text>
        </svg>
        <div class="badge-inner">A</div>
      </div>
    </div>
  </div>
</header>

<script>
  // =========================================================================
  // CONTROLADOR CINEMATOGRÁFICO DE SCROLL SUAVE (BUTTERY VIDEO SCRUBBER)
  // =========================================================================
  function initPolishedHero() {
    const hero = document.getElementById('top');
    const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
    const badgeSvg = document.getElementById('badgeSvg');

    if (!hero || !video) return;

    const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function loadVideo() {
      if (!video || !video.dataset.src || video.src.includes('new-hero.mp4')) return;
      video.src = video.dataset.src;
      video.load();
      video.play().then(() => {
        video.classList.add('is-playing');
      }).catch(() => {});
    }

    if (!isDesktop || prefersReducedMotion) {
      const startMobileVideo = () => {
        loadVideo();
        window.removeEventListener('scroll', startMobileVideo);
        window.removeEventListener('touchstart', startMobileVideo);
      };
      window.addEventListener('scroll', startMobileVideo, { passive: true, once: true });
      window.addEventListener('touchstart', startMobileVideo, { passive: true, once: true });
      return;
    } else {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => setTimeout(loadVideo, 400), { timeout: 2000 });
      } else {
        setTimeout(loadVideo, 500);
      }
    }

    let targetTime = 0;
    let currentTime = 0;
    let targetProgress = 0;
    let currentProgress = 0;
    let isUserScrolling = false;
    let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
    let lastScrollY = 0;
    let badgeRotation = 0;
    let isSeeking = false;

    function onScrollUpdate() {
      if (!video || !hero) return;
      if (!video.src.includes('new-hero.mp4')) {
        loadVideo();
      }
      const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      const heroHeight = hero.offsetHeight || window.innerHeight;

      if (scrollY <= heroHeight * 1.5 && video.duration) {
        // Mapeo suave y progresivo: solo scrubbea en la primera fase del scroll
        targetProgress = Math.min(Math.max(scrollY / (heroHeight * 1.2), 0), 1);
        targetTime = targetProgress * video.duration;

        const delta = Math.abs(scrollY - lastScrollY);
        lastScrollY = scrollY;

        if (delta > 0.5) {
          isUserScrolling = true;
          if (!video.paused) video.pause();

          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            isUserScrolling = false;
            const currentScroll = window.pageYOffset || document.documentElement.scrollTop || 0;
            if (currentScroll < 30 && video.paused) {
              video.play().catch(() => {});
            }
          }, 180);
        }
      }
    }

    // Lenis scrollea la ventana de forma nativa: un único listener de scroll alcanza.
    window.addEventListener('scroll', onScrollUpdate, { passive: true });

    function renderLoop() {
      if (video && video.duration) {
        // Lerping ultrasuave con amortiguación sedosa (0.07)
        const diffProgress = targetProgress - currentProgress;
        currentProgress += diffProgress * 0.07;

        const diffTime = targetTime - currentTime;
        currentTime += diffTime * 0.09;

        // Búsqueda amortiguada para evitar caídas de frames en el decodificador de video
        if (isUserScrolling && Math.abs(video.currentTime - currentTime) > 0.02 && !isSeeking) {
          isSeeking = true;
          video.currentTime = currentTime;
          video.addEventListener('seeked', () => { isSeeking = false; }, { once: true });
        }

        // Rotación continua del badge (acelera con la velocidad del scroll)
        if (badgeSvg) {
          badgeRotation += 0.35 + (Math.abs(diffProgress) * 15);
          badgeSvg.style.transform = `rotate(${badgeRotation.toFixed(1)}deg)`;
        }
      }

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  // =========================================================================
  // PARALLAX DE CÁMARA (puntero + scroll) — spring semi-implícito, duerme en reposo
  // k=0.075 / c=0.78 por frame ≈ k=270 c=13 a 60fps: peso de papel, sin rebote visible
  // =========================================================================
  function initHeroParallax() {
    const hero = document.getElementById('top');
    const layer = document.getElementById('heroMediaInner');
    if (!hero || !layer) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const K = 0.075;
    const C = 0.78;
    let tx = 0, ty = 0, x = 0, y = 0, vx = 0, vy = 0;
    let pointerX = 0, pointerY = 0, scrollOffset = 0;
    let raf = 0;
    let heroVisible = true;

    const tick = () => {
      raf = 0;
      tx = pointerX;
      ty = pointerY + scrollOffset;
      vx = (vx + (tx - x) * K) * C;
      vy = (vy + (ty - y) * K) * C;
      x += vx;
      y += vy;
      layer.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(1.04)`;
      const settled = Math.abs(tx - x) < 0.05 && Math.abs(ty - y) < 0.05 && Math.abs(vx) < 0.02 && Math.abs(vy) < 0.02;
      if (!settled && heroVisible) raf = requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf && heroVisible) raf = requestAnimationFrame(tick); };

    const onScroll = () => {
      const h = hero.offsetHeight || window.innerHeight;
      scrollOffset = Math.min(window.scrollY, h) * 0.12;
      kick();
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    if (isDesktop) {
      hero.addEventListener('pointermove', (e: PointerEvent) => {
        const r = hero.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        pointerX = nx * -18;
        pointerY = ny * -10;
        kick();
      }, { passive: true });
      hero.addEventListener('pointerleave', () => {
        pointerX = 0;
        pointerY = 0;
        kick();
      });
    }

    new IntersectionObserver((entries) => {
      heroVisible = entries[0]?.isIntersecting ?? true;
      if (heroVisible) kick();
    }).observe(hero);

    layer.style.transform = 'translate3d(0, 0, 0) scale(1.04)';
  }

  // =========================================================================
  // CONTADORES — 100% sube desde 0, la carga BAJA de 4.8s (web tradicional) a 0.8s
  // easeOutExpo, 1100ms, sincronizado con la coreografía de entrada
  // =========================================================================
  function initCounters() {
    const nodes = document.querySelectorAll<HTMLElement>('.hero [data-count-to]');
    if (!nodes.length) return;
    if (!document.documentElement.classList.contains('mx')) return;

    const easeOutExpo = (t: number): number => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));

    nodes.forEach((el, idx) => {
      const from = parseFloat(el.dataset.countFrom ?? '0');
      const to = parseFloat(el.dataset.countTo ?? '0');
      const decimals = parseInt(el.dataset.countDecimals ?? '0', 10);
      const prefix = el.dataset.countPrefix ?? '';
      const suffix = el.dataset.countSuffix ?? '';
      const finalText = el.textContent ?? '';
      const format = (v: number): string => `${prefix}${v.toFixed(decimals)}${suffix}`;
      const duration = 1100;
      const delay = 700 + idx * 80;

      el.textContent = format(from);
      window.setTimeout(() => {
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          el.textContent = format(from + (to - from) * easeOutExpo(t));
          if (t < 1) requestAnimationFrame(step);
          else el.textContent = finalText;
        };
        requestAnimationFrame(step);
      }, delay);
    });
  }

  function onSiteLoaded(cb: () => void) {
    if (document.body.classList.contains('loaded')) {
      cb();
      return;
    }
    const mo = new MutationObserver(() => {
      if (document.body.classList.contains('loaded')) {
        mo.disconnect();
        cb();
      }
    });
    mo.observe(document.body, { attributes: true, attributeFilter: ['class'] });
  }

  function bootHero() {
    initPolishedHero();
    initHeroParallax();
    onSiteLoaded(initCounters);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootHero);
  } else {
    bootHero();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    background: #e4e1d8;
    color: #0a0a0a;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-media-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    background: #e4e1d8;
  }

  .hero-media-inner,
  .hero-media-zoom {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .hero-media-inner {
    transform: scale(1.04);
  }

  /* Entrada: la cámara se aleja del grabado mientras el preloader se levanta */
  @keyframes heroZoomOut {
    from { transform: scale(1.12); }
  }

  :global(html.mx body.loaded) .hero-media-zoom {
    animation: heroZoomOut 1.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-poster-pic,
  .hero-poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .hero-poster-img {
      object-position: center 30%;
    }
  }

  /* Video con renderizado nativo sin estiramientos pixelados */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
    filter: contrast(1.02);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  /* Viñeta sutil en la base para dar contraste sin oscurecer la ilustración */
  .hero-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to top, rgba(228, 225, 216, 0.95) 0%, rgba(228, 225, 216, 0.4) 50%, transparent 100%);
    z-index: 3;
    pointer-events: none;
  }

  :global(body.theme-dark) .hero-gradient,
  :global(body.theme-electric) .hero-gradient {
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.3) 50%, transparent 100%);
  }

  .hero-top {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    padding: calc(75px + env(safe-area-inset-top)) var(--gut) 16px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-wrap: wrap;
    gap: 8px;
    background: linear-gradient(to bottom, rgba(228, 225, 216, 0.85) 0%, transparent 100%);
  }

  :global(body.theme-dark) .hero-top,
  :global(body.theme-electric) .hero-top {
    background: linear-gradient(to bottom, rgba(10, 10, 10, 0.85) 0%, transparent 100%);
  }

  .hero-top > div {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .hero-top span:first-child {
    color: var(--mate);
    font-weight: 700;
  }

  .live-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  :global(body.theme-electric) .hero-top span:first-child {
    color: var(--electric);
  }

  .hero-spacer {
    flex: 1;
    min-height: 120px;
    pointer-events: none;
  }

  /* BARRA INFERIOR EDITORIAL EQUILIBRADA EN 3 COLUMNAS */
  .hero-bottom {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1.4fr 1.15fr 1fr;
    align-items: center;
    gap: clamp(24px, 3.2vw, 48px);
    padding: 24px var(--gut) calc(28px + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(10, 10, 10, 0.14);
    background: rgba(244, 242, 236, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.03);
  }

  :global(body.theme-dark) .hero-bottom {
    background: rgba(15, 15, 14, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--bone);
  }

  :global(body.theme-electric) .hero-bottom {
    background: rgba(10, 10, 10, 0.94);
    border-top: 1px solid rgba(241, 255, 90, 0.25);
    color: #f1ff5a;
  }

  :global(body.theme-mate) .hero-bottom {
    background: rgba(18, 30, 21, 0.92);
    border-top: 1px solid rgba(151, 188, 98, 0.25);
    color: var(--bone);
  }

  .hero-sub-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-h1 {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .h1-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(9px, 1vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rust);
  }

  :global(body.theme-electric) .h1-sub {
    color: var(--electric);
  }

  .h1-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
    font-kerning: normal;
  }

  /* Subrayado a mano bajo URUGUAY — Lucian #237 (.7s cubic-bezier(.6,0,.2,1)) */
  .hw-u {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .h1-underline {
    position: absolute;
    left: -3%;
    bottom: -0.32em;
    width: 106%;
    height: 0.42em;
    overflow: visible;
    fill: none;
    stroke: var(--mx-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 240;
    stroke-dashoffset: 0;
    pointer-events: none;
  }

  @keyframes heroUnderlineDraw {
    from { stroke-dashoffset: 240; }
  }

  :global(html.mx body:not(.loaded)) .h1-underline {
    stroke-dashoffset: 240;
  }

  :global(html.mx body.loaded) .h1-underline {
    animation: heroUnderlineDraw 0.7s cubic-bezier(0.6, 0, 0.2, 1) 1.45s both;
  }

  .hero-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.88;
    max-width: 52ch;
    text-wrap: pretty;
  }

  :global(body.theme-dark) .hero-sub,
  :global(body.theme-mate) .hero-sub {
    color: rgba(244, 241, 234, 0.9);
  }

  .hero-cta-wrap {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 4px;
  }

  .hero-cta-slot,
  .hero-cta-mag {
    display: inline-flex;
  }

  /* CTA PRIMARIO — lima, tinta que sube, letras que ruedan, flecha que dispara */
  .hero-cta {
    --mx-fill-ink: #0a0a0a;
    display: inline-flex;
    align-items: center;
    justify-content: center;
