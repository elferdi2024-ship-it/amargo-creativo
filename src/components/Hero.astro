---
// filepath: src/components/Hero.astro
---
<div class="hero-sticky" id="heroSticky">
  <div class="hero-stage" id="heroStage">
    <!-- Canvas de Renderizado de Alta Precisión (Apple-grade) -->
    <canvas id="heroCanvas" class="hero-canvas"></canvas>
    
    <!-- Video Fuente Precargado (Oculto, usado como decodificador de frames) -->
    <video 
      id="heroVideo" 
      class="hero-video-source" 
      src="/hero-scroll.mp4" 
      preload="auto" 
      muted 
      playsinline 
      webkit-playsinline
      aria-hidden="true"
    ></video>
    
    <!-- Capas de Contraste, Tinte Brutalista y Gradiente -->
    <div class="hero-overlay"></div>
    <div class="hero-gradient"></div>
    <div class="hero-grid-overlay"></div>

    <!-- Interfaz y Contenido del Hero -->
    <header class="hero-ui" id="top">
      <div class="hero-top">
        <div><span>● EN VIVO</span><span>ESTUDIO CREATIVO DIGITAL</span></div>
        <div><span>ATLÁNTIDA, UY</span><span>v30.0</span></div>
      </div>

      <div class="hero-content" id="heroContent">
        <h1 class="hero-title">
          <span class="line"><span>MOTORES</span></span>
          <span class="line line-2"><span><em>de crecimiento</em></span></span>
          <span class="line line-3"><span>DIGITAL</span></span>
        </h1>
      </div>

      <div class="hero-bottom" id="heroBottom">
        <div class="hero-sub-wrap">
          <p class="hero-sub">Tu web no es un folleto. Es tu mejor vendedor. Creamos páginas y aplicaciones que tus clientes disfrutan usar y que ayudan a que tu negocio crezca de verdad.</p>
          <div class="hero-cta-wrap">
            <a 
              href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hero-cta magnetic-btn" 
              data-cursor="WHATSAPP"
            >
              HABLAR POR WHATSAPP ↗
            </a>
            <a href="#contact" class="hero-cta-secondary">COTIZAR ONLINE ↓</a>
            <a href="#showcase" class="hero-cta-link">VER TRABAJOS →</a>
          </div>
        </div>

        <div class="hero-stats">
          <div class="hero-meta">
            <strong>100%</strong>
            <span>ENFOCADO EN VENTAS</span>
          </div>
          <div class="hero-meta">
            <strong>&lt; 1.0s</strong>
            <span>CARGA INSTANTÁNEA</span>
          </div>
        </div>
      </div>

      <div class="hero-badge" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <defs><path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" /></defs>
          <text font-family="JetBrains Mono" font-size="9" font-weight="700" letter-spacing="1.5" fill="currentColor">
            <textPath xlink:href="#circle">AMARGO CREATIVO™ • ESTUDIO CREATIVO • ATLÁNTIDA, UY • </textPath>
          </text>
        </svg>
        <div class="badge-inner">A</div>
      </div>
    </header>
  </div>
</div>

<script>
  // =========================================================================
  // APPLE-GRADE SCROLL SCRUBBING ENGINE VIA HTML5 CANVAS & LERP
  // =========================================================================
  const heroSticky = document.getElementById('heroSticky');
  const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const heroContent = document.getElementById('heroContent');
  const heroBottom = document.getElementById('heroBottom');

  if (heroSticky && canvas && video) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const isMobileOrReduced = window.matchMedia('(max-width: 768px), (prefers-reduced-motion: reduce)').matches;

    let targetTime = 0;
    let currentTime = 0;
    let isSeeking = false;
    let isVideoReady = false;
    let animationFrameId: number;

    // 1. Redimensionar Canvas con soporte para pantallas Retina (HiDPI)
    function resizeCanvas() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      drawFrame();
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // 2. Renderizado de Frame con ajuste 'object-fit: cover' en Canvas
    function drawFrame() {
      if (!ctx || !canvas || !video || video.readyState < 2) return;
      const vW = video.videoWidth;
      const vH = video.videoHeight;
      if (!vW || !vH) return;

      const cW = canvas.width;
      const cH = canvas.height;
      const videoRatio = vW / vH;
      const canvasRatio = cW / cH;

      let dW: number, dH: number, oX: number, oY: number;

      if (canvasRatio > videoRatio) {
        dW = cW;
        dH = cW / videoRatio;
        oX = 0;
        oY = (cH - dH) / 2;
      } else {
        dW = cH * videoRatio;
        dH = cH;
        oX = (cW - dW) / 2;
        oY = 0;
      }

      ctx.drawImage(video, oX, oY, dW, dH);
    }

    // 3. Inicialización & Precarga del Video
    function onVideoLoaded() {
      video.pause();
      video.currentTime = 0;
      isVideoReady = true;
      drawFrame();
    }

    if (video.readyState >= 2) {
      onVideoLoaded();
    } else {
      video.addEventListener('loadeddata', onVideoLoaded, { once: true });
      video.addEventListener('canplay', onVideoLoaded, { once: true });
    }

    video.addEventListener('seeked', () => {
      isSeeking = false;
      drawFrame();
    });

    // 4. Modo Móvil / Reduced Motion: Reproducción automática en loop sin bloqueo
    if (isMobileOrReduced) {
      video.autoplay = true;
      video.loop = true;
      video.play().catch(() => {});

      function loopRender() {
        drawFrame();
        requestAnimationFrame(loopRender);
      }
      requestAnimationFrame(loopRender);
    } else {
      // 5. Modo Desktop: Scrubbing de Scroll Cuadro por Cuadro con Lerp
      function updateScrubProgress() {
        if (!heroSticky || !video || !video.duration) return;
        const rect = heroSticky.getBoundingClientRect();
        const maxScroll = heroSticky.offsetHeight - window.innerHeight;
        const currentScroll = -rect.top;
        const progress = Math.min(Math.max(currentScroll / maxScroll, 0), 1);

        targetTime = progress * video.duration;

        // Transición de la UI (Titular & CTAs se desvanecen suavemente tras el 25% de scroll)
        if (heroContent && heroBottom) {
          const fadeProgress = Math.max(0, Math.min(1, (progress - 0.2) / 0.5));
          const translateY = fadeProgress * -60;
          const opacity = 1 - fadeProgress;

          heroContent.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
          heroContent.style.opacity = opacity.toFixed(2);
          heroBottom.style.opacity = opacity.toFixed(2);

          if (opacity <= 0.02) {
            heroContent.style.pointerEvents = 'none';
            heroBottom.style.pointerEvents = 'none';
          } else {
            heroContent.style.pointerEvents = 'auto';
            heroBottom.style.pointerEvents = 'auto';
          }
        }
      }

      window.addEventListener('scroll', updateScrubProgress, { passive: true });
      if ((window as any).lenis?.on) {
        (window as any).lenis.on('scroll', updateScrubProgress);
      }

      // Loop de renderizado continuo a 60/120fps con inercia suave
      function renderLoop() {
        if (isVideoReady && video && video.duration) {
          currentTime += (targetTime - currentTime) * 0.14; // Lerp suave

          if (!isSeeking && Math.abs(video.currentTime - currentTime) > 0.008) {
            isSeeking = true;
            video.currentTime = currentTime;
          }
        }

        drawFrame();
        animationFrameId = requestAnimationFrame(renderLoop);
      }
      animationFrameId = requestAnimationFrame(renderLoop);
    }
  }
</script>

<style>
  /* Pista de Scroll: 240vh (~2.5 giros de rueda para completar el video fluidamente) */
  .hero-sticky {
    position: relative;
    height: 240vh;
    width: 100%;
  }

  @media (max-width: 768px) {
    .hero-sticky {
      height: 100vh;
      height: 100svh;
    }
  }

  .hero-stage {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--hero-bg);
  }

  /* Canvas de Dibujo de Frames */
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    filter: contrast(1.12) brightness(0.82);
    transition: filter 0.5s var(--ease);
  }

  :global(body.theme-electric) .hero-canvas {
    filter: grayscale(60%) contrast(1.3) brightness(0.65) sepia(1) hue-rotate(40deg) saturate(1.8);
  }

  :global(body.theme-mate) .hero-canvas {
    filter: grayscale(15%) contrast(1.15) brightness(0.72) sepia(0.25) hue-rotate(85deg);
  }

  .hero-video-source {
    display: none;
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.32);
    mix-blend-mode: multiply;
    z-index: 2;
    pointer-events: none;
  }

  .hero-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 45%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    z-index: 3;
    pointer-events: none;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: 3;
    pointer-events: none;
  }

  .hero-ui {
    position: relative;
    height: 100%;
    color: var(--hero-text);
    display: flex;
    flex-direction: column;
    z-index: 10;
    width: 100%;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    padding: calc(80px + env(safe-area-inset-top)) var(--gut) 16px;
    font-size: 11px;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 10;
    position: relative;
  }

  .hero-top > div {
    display: flex;
    gap: 16px;
  }

  .hero-top span:first-child {
    color: var(--electric);
    font-weight: 700;
  }

  .hero-content {
    flex: 1;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--gut);
    will-change: transform, opacity;
  }

  .hero-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(48px, 8.5vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    word-break: keep-all;
    hyphens: none;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 4px;
  }

  .hero-title .line span {
    display: inline-block;
    transform: translateY(110%);
    animation: lineUp 1s var(--ease-emphasis) forwards;
    white-space: nowrap;
    will-change: transform;
  }

  .hero-title .line:nth-child(2) span { animation-delay: 0.15s; }
  .hero-title .line:nth-child(3) span { animation-delay: 0.30s; }

  @keyframes lineUp {
    to { transform: translateY(0); }
  }

  .hero-title .line-2 { align-self: center; }
  .hero-title .line-3 { align-self: flex-end; }

  .hero-title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
    text-shadow: none;
  }

  .hero-bottom {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    padding: 32px var(--gut);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    flex-wrap: wrap;
    will-change: opacity;
  }

  :global(body.theme-electric) .hero-bottom {
    border-top: 1px solid rgba(241, 255, 90, 0.2);
  }

  :global(body.theme-mate) .hero-bottom {
    border-top: 1px solid rgba(151, 188, 98, 0.2);
  }

  .hero-sub-wrap {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: var(--hero-text);
    opacity: 0.9;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-cta-wrap {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--electric);
    color: #0a0a0a;
    padding: 14px 24px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    transition: transform 0.2s var(--ease), background 0.2s;
    will-change: transform;
    height: 44px;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    background: var(--bone);
    color: var(--ink);
  }

  .hero-cta:active {
    transform: scale(0.96);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--hero-text);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 14px 20px;
    height: 44px;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--hero-text);
  }

  .hero-cta-secondary:active {
    transform: scale(0.96);
  }

  .hero-cta-link {
    display: inline-flex;
    align-items: center;
    color: var(--hero-text);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.8;
    padding: 8px 12px;
    transition: opacity 0.2s, color 0.2s;
  }

  .hero-cta-link:hover {
    opacity: 1;
    color: var(--electric);
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    align-items: flex-end;
  }

  .hero-meta {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hero-text);
    opacity: 0.85;
  }

  .hero-meta strong {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.5vw, 44px);
    display: block;
    text-transform: none;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    color: var(--hero-text);
    opacity: 1;
    line-height: 1;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .hero-badge {
    position: absolute;
    bottom: calc(32px + env(safe-area-inset-bottom));
    right: var(--gut);
    width: 120px;
    height: 120px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-badge svg {
    width: 100%;
    height: 100%;
    animation: spin 20s linear infinite;
    will-change: transform;
  }

  .hero-badge:hover svg {
    animation-duration: 6s;
  }

  .hero-badge .badge-inner {
    position: absolute;
    width: 44px;
    height: 44px;
    background: var(--electric);
    border: 2px dashed var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
    pointer-events: auto;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .hero-title {
      font-size: clamp(32px, 10.5vw, 70px);
      letter-spacing: -0.02em;
    }

    .hero-title .line-2, .hero-title .line-3 {
      align-self: flex-start;
    }

    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding-bottom: calc(32px + env(safe-area-inset-bottom));
    }

    .hero-stats {
      width: 100%;
      justify-content: flex-start;
      gap: 36px;
    }

    .hero-cta-wrap {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-cta, .hero-cta-secondary {
      width: 100%;
      text-align: center;
    }

    .hero-badge {
      width: 80px;
      height: 80px;
      bottom: 20px;
      right: 20px;
    }

    .hero-badge .badge-inner {
      width: 32px;
      height: 32px;
      font-size: 14px;
      border-width: 1px;
    }
  }
</style>
