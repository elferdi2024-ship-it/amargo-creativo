---
// filepath: src/components/Hero.astro
---
<header class="hero" id="top">
  <!-- Video de Fondo 100% Borde a Borde -->
  <div class="hero-media-container">
    <video 
      id="heroVideo" 
      class="hero-video" 
      src="/hero-scroll.mp4" 
      poster="/amargo-hero-pc.webp"
      autoplay 
      loop 
      muted 
      playsinline 
      webkit-playsinline
      aria-hidden="true"
    ></video>
    <div class="hero-overlay"></div>
    <div class="hero-gradient" id="heroGradient"></div>
    <div class="hero-grid-overlay"></div>
  </div>

  <!-- Barra Superior del Hero -->
  <div class="hero-top">
    <div class="hero-live-badge"><span>● EN VIVO</span><span>ESTUDIO CREATIVO DIGITAL</span></div>
    <div class="hero-location-badge"><span>ATLÁNTIDA, CANELONES</span><span>v30.0</span></div>
  </div>

  <!-- Barra Inferior de Acción, Métricas y Badge Alineados (Sin Colisiones) -->
  <div class="hero-bottom" id="heroBottom">
    <div class="hero-sub-wrap">
      <p class="hero-sub">Diseñamos páginas web y activos digitales de alto rendimiento que transforman visitas en clientes reales.</p>
      <div class="hero-cta-wrap">
        <a 
          href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hero-cta magnetic-btn" 
          data-cursor="WHATSAPP"
        >
          HABLAR POR WHATSAPP ↗
        </a>
        <a href="#showcase" class="hero-cta-secondary">VER TRABAJOS →</a>
      </div>
    </div>

    <div class="hero-right-wrap">
      <div class="hero-stats">
        <div class="hero-meta">
          <strong>100%</strong>
          <span>ENFOCADO EN VENTAS</span>
        </div>
        <div class="hero-meta">
          <strong>&lt; 1.0s</strong>
          <span>CARGA INSTANTÁNEA</span>
        </div>
      </div>

      <!-- Badge Giratorio Brutalista Integrado con Margen Limpio -->
      <div class="hero-badge" id="heroBadge" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" id="badgeSvg">
          <defs><path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" /></defs>
          <text font-family="JetBrains Mono" font-size="9" font-weight="700" letter-spacing="1.5" fill="currentColor">
            <textPath xlink:href="#circle">AMARGO CREATIVO™ • ESTUDIO CREATIVO • ATLÁNTIDA, UY • </textPath>
          </text>
        </svg>
        <div class="badge-inner">A</div>
      </div>
    </div>
  </div>
</header>

<script>
  // =========================================================================
  // CONTROLADOR CINEMATOGRÁFICO DE SCROLL HERO
  // =========================================================================
  function initPolishedHero() {
    const hero = document.getElementById('top');
    const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
    const heroGradient = document.getElementById('heroGradient');
    const badgeSvg = document.getElementById('badgeSvg');

    if (!hero || !video) return;

    let targetTime = 0;
    let currentTime = 0;
    let targetProgress = 0;
    let currentProgress = 0;
    let isUserScrolling = false;
    let scrollTimeout: any;
    let lastScrollY = 0;
    let badgeRotation = 0;

    function onScrollUpdate() {
      const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      const heroHeight = hero.offsetHeight || window.innerHeight;

      if (scrollY <= heroHeight * 1.6 && video && video.duration) {
        targetProgress = Math.min(Math.max(scrollY / (heroHeight * 1.15), 0), 1);
        targetTime = targetProgress * video.duration;

        const delta = Math.abs(scrollY - lastScrollY);
        lastScrollY = scrollY;

        if (delta > 1) {
          isUserScrolling = true;
          video.pause();

          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            isUserScrolling = false;
            if ((window.pageYOffset || document.documentElement.scrollTop || 0) < 40) {
              video.play().catch(() => {});
            }
          }, 140);
        }
      }
    }

    window.addEventListener('scroll', onScrollUpdate, { passive: true });
    if ((window as any).lenis?.on) {
      (window as any).lenis.on('scroll', onScrollUpdate);
    }

    function renderLoop() {
      if (video && video.duration) {
        const diffProgress = targetProgress - currentProgress;
        currentProgress += diffProgress * 0.18;

        const diffTime = targetTime - currentTime;
        currentTime += diffTime * 0.22;

        if (isUserScrolling && Math.abs(video.currentTime - currentTime) > 0.006) {
          video.currentTime = currentTime;
        }

        const isDesktop = window.innerWidth > 768;
        if (isDesktop) {
          const scale = 1 + currentProgress * 0.06;
          const translateY = currentProgress * 30;
          video.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
        }

        if (heroGradient) {
          heroGradient.style.opacity = (0.8 + currentProgress * 0.2).toFixed(2);
        }

        if (badgeSvg) {
          badgeRotation += 0.4 + (Math.abs(diffProgress) * 20);
          badgeSvg.style.transform = `rotate(${badgeRotation.toFixed(1)}deg)`;
        }
      }

      requestAnimationFrame(renderLoop);
    }

    requestAnimationFrame(renderLoop);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPolishedHero);
  } else {
    initPolishedHero();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    background: #0a0a0a;
    color: #f4f1ea;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-sizing: border-box;
  }

  .hero-media-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    background: #0a0a0a;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: contrast(1.08) brightness(0.9);
    transition: filter 0.5s var(--ease);
    will-change: transform;
    pointer-events: none;
  }

  :global(body.theme-electric) .hero-video {
    filter: grayscale(40%) contrast(1.25) brightness(0.75) sepia(1) hue-rotate(40deg) saturate(1.8);
  }

  :global(body.theme-mate) .hero-video {
    filter: grayscale(10%) contrast(1.15) brightness(0.85) sepia(0.2) hue-rotate(85deg);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.15);
    mix-blend-mode: multiply;
    z-index: 2;
    pointer-events: none;
  }

  .hero-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.95) 0%, rgba(10, 10, 10, 0.4) 50%, transparent 100%);
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.2s ease-out;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: 3;
    pointer-events: none;
  }

  .hero-top {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    padding: calc(80px + env(safe-area-inset-top)) var(--gut) 16px;
    font-size: 11px;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: 8px;
    background: linear-gradient(to bottom, rgba(10, 10, 10, 0.7) 0%, transparent 100%);
  }

  .hero-top > div {
    display: flex;
    gap: 16px;
  }

  .hero-top span:first-child {
    color: var(--electric);
    font-weight: 700;
  }

  .hero-bottom {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    padding: 32px var(--gut);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    flex-wrap: wrap;
    background: rgba(10, 10, 10, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  :global(body.theme-electric) .hero-bottom {
    border-top: 1px solid rgba(241, 255, 90, 0.2);
  }

  :global(body.theme-mate) .hero-bottom {
    border-top: 1px solid rgba(151, 188, 98, 0.2);
  }

  .hero-sub-wrap {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #f4f1ea;
    opacity: 0.9;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-cta-wrap {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--electric);
    color: #0a0a0a;
    padding: 12px 22px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
    transition: transform 0.2s var(--ease), background 0.2s;
    will-change: transform;
    height: 42px;
    box-sizing: border-box;
  }

  .hero-cta:hover {
    background: var(--bone);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }

  .hero-cta:active {
    transform: scale(0.96);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #f4f1ea;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 12px 18px;
    height: 42px;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s;
  }

  .hero-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
  }

  .hero-cta-secondary:active {
    transform: scale(0.96);
  }

  /* Contenedor derecho: Métricas + Badge sin solapamiento */
  .hero-right-wrap {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .hero-stats {
    display: flex;
    gap: 32px;
    align-items: flex-end;
  }

  .hero-meta {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-meta strong {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 2.8vw, 34px);
    display: block;
    text-transform: none;
    letter-spacing: -0.02em;
    margin-bottom: 2px;
    color: #f4f1ea;
    line-height: 1;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.7);
  }

  .hero-badge {
    position: relative;
    width: 86px;
    height: 86px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-badge svg {
    width: 100%;
    height: 100%;
    will-change: transform;
  }

  .hero-badge .badge-inner {
    position: absolute;
    width: 34px;
    height: 34px;
    background: var(--electric);
    border: 2px dashed var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 15px;
    pointer-events: auto;
  }

  @media (max-width: 900px) {
    .hero-video {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      transform: none !important;
    }

    .hero-top {
      padding-top: calc(70px + env(safe-area-inset-top));
    }

    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 20px var(--gut) calc(20px + env(safe-area-inset-bottom));
      background: rgba(10, 10, 10, 0.75);
    }

    .hero-sub {
      font-size: 13px;
    }

    .hero-right-wrap {
      width: 100%;
      justify-content: space-between;
    }

    .hero-stats {
      width: auto;
      gap: 24px;
    }

    .hero-cta-wrap {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-cta, .hero-cta-secondary {
      width: 100%;
      text-align: center;
    }

    .hero-badge {
      display: none;
    }
  }
</style>
