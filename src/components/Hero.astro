---
// filepath: src/components/Hero.astro
---
<header class="hero" id="top">
  <div class="hero-bg" id="heroBg"></div>
  <div class="hero-gradient"></div>
  <div class="hero-grid-overlay"></div>
  
  <div class="hero-top">
    <div><span>● EN VIVO</span><span>ESTUDIO CREATIVO DIGITAL</span></div>
    <div><span>ATLÁNTIDA, UY</span><span>v26.0</span></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      <span class="line"><span>MOTORES</span></span>
      <span class="line line-2"><span><em>de crecimiento</em></span></span>
      <span class="line line-3"><span>DIGITAL</span></span>
    </h1>
  </div>

  <div class="hero-bottom">
    <div class="hero-sub-wrap">
      <p class="hero-sub">Tu web no es un folleto. Es tu mejor vendedor. Creamos páginas y aplicaciones que tus clientes disfrutan usar y que ayudan a que tu negocio crezca de verdad.</p>
      <div class="hero-cta-wrap">
        <a 
          href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hero-cta magnetic-btn" 
          data-cursor="WHATSAPP"
        >
          HABLAR POR WHATSAPP ↗
        </a>
        <a href="#contact" class="hero-cta-secondary">COTIZAR ONLINE ↓</a>
        <a href="#showcase" class="hero-cta-link">VER TRABAJOS →</a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hero-meta">
        <strong>100%</strong>
        <span>ENFOCADO EN VENTAS</span>
      </div>
      <div class="hero-meta">
        <strong>&lt; 1.0s</strong>
        <span>CARGA INSTANTÁNEA</span>
      </div>
    </div>
  </div>

  <div class="hero-badge" aria-hidden="true">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs><path id="circle" d="M 50, 50 m -38, 0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" /></defs>
      <text font-family="JetBrains Mono" font-size="9" font-weight="700" letter-spacing="1.5" fill="currentColor">
        <textPath xlink:href="#circle">AMARGO CREATIVO™ • ESTUDIO CREATIVO • ATLÁNTIDA, UY • </textPath>
      </text>
    </svg>
    <div class="badge-inner">A</div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    background: var(--hero-bg);
    color: var(--hero-text);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-bottom: 1px solid var(--hero-bg);
    width: 100%;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/amargo-hero-pc.webp'), url('/amargo%20hero%20pc.jpg');
    background-size: cover;
    background-position: center;
    background-color: var(--hero-bg);
    background-blend-mode: multiply;
    filter: grayscale(12%) contrast(1.1) brightness(0.72);
    z-index: 1;
    transition: opacity 0.8s var(--ease);
    will-change: transform;
    opacity: 0;
  }
  :global(body.theme-electric) .hero-bg {
    filter: grayscale(70%) contrast(1.3) brightness(0.55) sepia(1) hue-rotate(40deg) saturate(1.8);
  }
  :global(body.theme-mate) .hero-bg {
    filter: grayscale(20%) contrast(1.15) brightness(0.68) sepia(0.25) hue-rotate(85deg);
  }
  :global(body.loaded) .hero-bg {
    opacity: 1;
  }
  .hero-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
    z-index: 2;
    pointer-events: none;
  }
  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    z-index: 2;
    pointer-events: none;
  }
  .hero-top {
    display: flex;
    justify-content: space-between;
    padding: calc(80px + env(safe-area-inset-top)) var(--gut) 16px;
    font-size: 11px;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 10;
    position: relative;
  }
  .hero-top > div {
    display: flex;
    gap: 16px;
  }
  .hero-top span:first-child {
    color: var(--electric);
    font-weight: 700;
  }
  .hero-content {
    flex: 1;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--gut);
  }
  .hero-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(48px, 8.5vw, 140px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    word-break: keep-all;
    hyphens: none;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 4px;
  }
  .hero-title .line span {
    display: inline-block;
    transform: translateY(110%);
    animation: lineUp 1s var(--ease-emphasis) forwards;
    white-space: nowrap;
    will-change: transform;
  }
  .hero-title .line:nth-child(2) span { animation-delay: 0.15s; }
  .hero-title .line:nth-child(3) span { animation-delay: 0.30s; }
  @keyframes lineUp {
    to { transform: translateY(0); }
  }
  .hero-title .line-2 { align-self: center; }
  .hero-title .line-3 { align-self: flex-end; }
  .hero-title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
    text-shadow: none;
  }
  .hero-bottom {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 48px;
    padding: 32px var(--gut);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
  }
  :global(body.theme-electric) .hero-bottom {
    border-top: 1px solid rgba(241, 255, 90, 0.2);
  }
  :global(body.theme-mate) .hero-bottom {
    border-top: 1px solid rgba(151, 188, 98, 0.2);
  }
  .hero-sub-wrap {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero-sub {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: var(--hero-text);
    opacity: 0.9;
  }
  .hero-cta-wrap {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--electric);
    color: #0a0a0a;
    padding: 14px 24px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    transition: transform 0.2s var(--ease), background 0.2s;
    will-change: transform;
    height: 44px;
    box-sizing: border-box;
  }
  .hero-cta:hover {
    background: var(--bone);
    color: var(--ink);
  }
  .hero-cta:active {
    transform: scale(0.96);
  }
  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--hero-text);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 14px 20px;
    height: 44px;
    box-sizing: border-box;
    transition: background 0.2s, border-color 0.2s;
  }
  .hero-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--hero-text);
  }
  .hero-cta-secondary:active {
    transform: scale(0.96);
  }
  .hero-cta-link {
    display: inline-flex;
    align-items: center;
    color: var(--hero-text);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.8;
    padding: 8px 12px;
    transition: opacity 0.2s, color 0.2s;
  }
  .hero-cta-link:hover {
    opacity: 1;
    color: var(--electric);
  }
  .hero-stats {
    display: flex;
    gap: 48px;
    align-items: flex-end;
  }
  .hero-meta {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hero-text);
    opacity: 0.85;
  }
  .hero-meta strong {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.5vw, 44px);
    display: block;
    text-transform: none;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    color: var(--hero-text);
    opacity: 1;
    line-height: 1;
  }
  .hero-badge {
    position: absolute;
    bottom: calc(32px + env(safe-area-inset-bottom));
    right: var(--gut);
    width: 120px;
    height: 120px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .hero-badge svg {
    width: 100%;
    height: 100%;
    animation: spin 20s linear infinite;
    will-change: transform;
  }
  .hero-badge:hover svg {
    animation-duration: 6s;
  }
  .hero-badge .badge-inner {
    position: absolute;
    width: 44px;
    height: 44px;
    background: var(--electric);
    border: 2px dashed var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
    pointer-events: auto;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @media (max-width: 900px) {
    .hero-bg {
      background-image: url('/amargo-hero-mobile.webp'), url('/amargo%20hero%20mobile.jpg');
      background-position: center top;
    }
    .hero-title {
      font-size: clamp(32px, 10.5vw, 70px);
      letter-spacing: -0.02em;
    }
    .hero-title .line-2, .hero-title .line-3 {
      align-self: flex-start;
    }
    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding-bottom: calc(32px + env(safe-area-inset-bottom));
    }
    .hero-stats {
      width: 100%;
      justify-content: flex-start;
      gap: 36px;
    }
    .hero-cta-wrap {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .hero-cta, .hero-cta-secondary {
      width: 100%;
      text-align: center;
    }
    .hero-badge {
      width: 80px;
      height: 80px;
      bottom: 20px;
      right: 20px;
    }
    .hero-badge .badge-inner {
      width: 32px;
      height: 32px;
      font-size: 14px;
      border-width: 1px;
    }
  }
</style>
