---
// filepath: src/components/Contact.astro
// Monumental Awwwards Conversion Finale: WhatsApp Direct Primary + One-Click Email Copy
import RollText from './motion/RollText.astro';
---
<section class="contact" id="contact">
  <div class="contact-bg" aria-hidden="true"></div>
  <div class="contact-ambient-statue ambient-parallax" aria-hidden="true"></div>
  <div class="contact-content">
    <div class="contact-top-meta">
      <span class="contact-idx">06</span>
      <span class="contact-label">5 CUPOS / MES &bull; URUGUAY &bull; ARGENTINA &bull; ESPAÑA</span>
    </div>

    <h2 class="contact-title" data-reveal-words>
      <span class="word-nowrap">CEBEMOS</span>
      <em>tu próximo proyecto</em>
    </h2>

    <p class="contact-lead" data-reveal-block>
      ¿Tenés una app en mente, un proceso para digitalizar o una marca lista para escalar? Hablás directo con quien diseña y programa tu producto.
    </p>

    <div class="contact-actions-wrap" data-reveal-block style="--rd:90ms">
      <div class="magnetic-wrap" id="magneticWaWrap">
        <a
          href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto%20web"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-wa-primary ink-fill"
          data-cursor="WHATSAPP"
        >
          <span class="ink" aria-hidden="true"></span>
          <span class="wa-live-dot" aria-hidden="true"></span>
          <RollText text="HABLAR POR WHATSAPP" arrow="diag" />
        </a>
      </div>

      <div class="contact-email-row">
        <div class="magnetic-wrap" id="magneticEmailWrap">
          <a href="mailto:amargo.creativo@gmail.com" class="contact-email" data-cursor="EMAIL">
            amargo.creativo@gmail.com
          </a>
        </div>
        <button
          type="button"
          class="copy-email-btn"
          id="copyEmailBtn"
          data-email="amargo.creativo@gmail.com"
          data-cursor="COPIAR"
          aria-label="Copiar dirección de correo amargo.creativo@gmail.com"
        >
          COPIAR
        </button>
      </div>
    </div>

    <div class="contact-steps-strip" data-reveal-block style="--rd:150ms">
      <div class="c-step"><span>01</span><strong>Charla 15 min</strong></div>
      <div class="c-step"><span>02</span><strong>Propuesta en 48h</strong></div>
      <div class="c-step"><span>03</span><strong>En vivo en 2–4 sem</strong></div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copyEmailBtn');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email') || 'amargo.creativo@gmail.com';
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = '✓ COPIADO';
      (window as any).amargoToast?.('EMAIL COPIADO AL PORTAPAPELES');
      setTimeout(() => {
        copyBtn.textContent = 'COPIAR EMAIL';
      }, 2200);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>

<style>
  .contact {
    background: var(--contact-bg);
    color: var(--contact-text);
    padding: clamp(100px, 14vh, 180px) var(--gut);
    text-align: center;
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
    border-bottom: 1px solid rgba(245, 243, 236, 0.12);
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(210, 246, 56, 0.08) 0%, transparent 45%),
      radial-gradient(circle at 80% 80%, rgba(137, 179, 88, 0.12) 0%, transparent 50%);
    z-index: 1;
    pointer-events: none;
  }

  .contact-ambient-statue {
    position: absolute;
    bottom: -4%;
    right: -2%;
    width: clamp(260px, 38vw, 520px);
    height: 85%;
    background-image: url('/backgrounds/bg-ambient-4.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: bottom right;
    opacity: 0.14;
    mix-blend-mode: soft-light;
    pointer-events: none;
    z-index: 1;
    filter: grayscale(100%) contrast(1.35) brightness(1.1);
    mask-image: radial-gradient(ellipse 54% 52% at 62% 66%, black 8%, transparent 58%);
    -webkit-mask-image: radial-gradient(ellipse 54% 52% at 62% 66%, black 8%, transparent 58%);
  }

  .contact-content {
    position: relative;
    z-index: 2;
    max-width: var(--max);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-top-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-idx {
    background: var(--electric);
    color: #11120f;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 2px;
  }

  .contact-label {
    color: rgba(245, 243, 236, 0.85);
    border: 1px solid rgba(210, 246, 56, 0.35);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 8vw, 124px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .contact-title em {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
    display: block;
    margin-top: 6px;
  }

  .contact-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.55;
    color: rgba(245, 243, 236, 0.82);
    max-width: 54ch;
    margin-bottom: 36px;
  }

  .contact-actions-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    margin-bottom: 48px;
    width: 100%;
  }

  .magnetic-wrap {
    display: inline-flex;
    max-width: 100%;
  }

  .contact-wa-primary {
    --mx-fill-ink: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--electric);
    color: #11120f;
    border: 1.5px solid var(--electric);
    border-radius: var(--radius-pill);
    padding: 18px 34px;
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.2vw, 13px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.28);
    transition: transform 0.3s var(--ease-emphasis), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .contact-wa-primary:hover {
    color: #11120f;
    border-color: #ffffff;
    transform: translate3d(0, -3px, 0);
  }

  .wa-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mate);
    flex-shrink: 0;
  }

  .contact-email-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .contact-email {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 2.8vw, 34px);
    color: var(--contact-text);
    text-decoration: none;
    border-bottom: 2px solid rgba(210, 246, 56, 0.65);
    padding-bottom: 4px;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
    word-break: break-word;
  }

  .contact-email:hover {
    color: var(--electric);
    border-color: var(--electric);
  }

  .copy-email-btn {
    background: rgba(245, 243, 236, 0.08);
    color: #f5f3ec;
    border: 1px solid rgba(245, 243, 236, 0.25);
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .copy-email-btn:hover {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  .contact-steps-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 780px;
    padding-top: 28px;
    border-top: 1px solid rgba(245, 243, 236, 0.16);
  }

  .c-step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid rgba(245, 243, 236, 0.14);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.03);
  }

  .c-step span {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--electric);
  }

  .c-step strong {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: rgba(245, 243, 236, 0.92);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 68px var(--gut);
    }
    .contact-title {
      font-size: clamp(34px, 11vw, 58px);
      margin-bottom: 16px;
    }
    .contact-lead {
      font-size: 14.5px;
      margin-bottom: 24px;
    }
    .contact-wa-primary {
      width: 100%;
      padding: 15px 18px;
      font-size: 11px;
    }
    .contact-steps-strip {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-top: 20px;
    }
    .c-step {
      justify-content: flex-start;
      padding: 10px 16px;
    }
  }
</style>
