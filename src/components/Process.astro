---
// filepath: src/components/Process.astro

interface Step {
  num: string;
  title: string;
  desc: string;
}

const steps: Step[] = [
  {
    num: "01",
    title: "Charla de 15 Minutos",
    desc: "Nos tomamos un momento para entender tu negocio, qué problemas tenés y qué querés lograr con tu nueva web. Sin vueltas ni tecnicismos raros."
  },
  {
    num: "02",
    title: "Estructura y Diseño Visual",
    desc: "Diseñamos las pantallas completas para que veas exactamente cómo va a quedar tu sitio, cómo se va a navegar en celulares y cómo va a recibir a tus clientes."
  },
  {
    num: "03",
    title: "Desarrollo y Velocidad",
    desc: "Construimos el sitio con código limpio y ultra veloz. Integramos WhatsApp directo, mapas, formularios y todo lo necesario para que funcione como un reloj."
  },
  {
    num: "04",
    title: "Lanzamiento y a Rodar",
    desc: "Probamos todo a fondo, conectamos tu dominio y publicamos tu web en internet. Te entregamos el acceso total y te enseñamos a usarla."
  }
];
---
<section class="process" id="process">
  <!-- Marca de Agua Ambiental Decorativa -->
  <div class="process-ambient-bg" aria-hidden="true"></div>

  <div class="process-head">
    <div class="section-label"><span class="num">04</span> PROCESO</div>
    <h2>Del primer mate <em>al lanzamiento</em></h2>
  </div>
  <div class="process-list" id="processList">
    <div class="spotlight" id="spotlight"></div>
    {steps.map(step => (
      <div class="process-item">
        <div class="process-num">{step.num}</div>
        <div class="process-title">{step.title}</div>
        <div class="process-desc">{step.desc}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: hidden;
  }
  .process-ambient-bg {
    position: absolute;
    top: 5%;
    right: -4%;
    width: clamp(320px, 50vw, 750px);
    height: 90%;
    background-image: url('/backgrounds/bg-ambient-3.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center right;
    opacity: 0.24;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
    filter: contrast(1.15) brightness(0.95);
    transition: opacity 0.5s var(--ease);
  }
  :global(body.theme-electric) .process-ambient-bg {
    opacity: 0.28;
    filter: grayscale(80%) contrast(1.3) sepia(1) hue-rotate(40deg);
  }
  :global(body.theme-mate) .process-ambient-bg {
    opacity: 0.26;
    filter: grayscale(20%) contrast(1.2) sepia(0.3) hue-rotate(85deg);
  }
  @media (max-width: 768px) {
    .process-ambient-bg {
      width: 75vw;
      right: -12%;
      opacity: 0.18;
    }
  }
</style>
