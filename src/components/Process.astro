---
// filepath: src/components/Process.astro

interface Props {
  sectionNum?: string;
}

const { sectionNum = "07" } = Astro.props;

interface Step {
  num: string;
  tag: string;
  title: string;
  desc: string;
}

const steps: Step[] = [
  {
    num: "01",
    tag: "DESCUBRIMIENTO",
    title: "Diagnóstico de 15 Minutos",
    desc: "Charlamos directo sin intermediarios (<mark class=\"hl-yellow\">15 minutos</mark>) para bajar a tierra la lógica de tu negocio, los cuellos de botella y qué app, plataforma o comercio propio genera retorno primero."
  },
  {
    num: "02",
    tag: "DISEÑO & PROTOTIPO",
    title: "Arquitectura y Pantallas Reales",
    desc: "Diseñamos la experiencia móvil y de escritorio completa para que valides cada pantalla, flujo de usuario y arquitectura de datos <mark class=\"hl-yellow\">antes de escribir una sola línea</mark>."
  },
  {
    num: "03",
    tag: "INGENIERÍA",
    title: "Desarrollo, IA e Integraciones",
    desc: "Construimos el producto con <mark class=\"hl-yellow\">código propio a medida</mark>: apps PWA, buscadores con IA, pagos BROU/Mercado Pago, DGI CFE y flujos directos a WhatsApp."
  },
  {
    num: "04",
    tag: "PRODUCCIÓN",
    title: "Lanzamiento y Propiedad Total",
    desc: "Desplegamos en red Edge global, probamos cada caso real en dispositivos físicos y te entregamos el <mark class=\"hl-yellow\">100% del repositorio y accesos</mark> a tu nombre."
  }
];
---
<section class="process" id="process">
  <!-- Marca de Agua Ambiental Decorativa con máscara orgánica -->
  <div class="process-ambient-bg ambient-parallax" aria-hidden="true"></div>

  <div class="process-head">
    <div class="section-label"><span class="num">{sectionNum}</span> METODOLOGÍA &amp; PROCESO</div>
    <h2 data-reveal-words>Del primer mate <em>al lanzamiento</em></h2>
  </div>
  <div class="process-list" id="processList">
    <div class="spotlight" id="spotlight"></div>
    {steps.map(step => (
      <div class="process-item">
        <div class="process-num">{step.num}</div>
        <div class="process-title-wrap">
          <span class="process-tag">{step.tag}</span>
          <div class="process-title">{step.title}</div>
        </div>
        <div class="process-desc" set:html={step.desc} />
      </div>
    ))}
  </div>
</section>

<style>
  .process {
    position: relative;
    overflow: hidden;
  }
  .process-ambient-bg {
    position: absolute;
    top: 4%;
    right: -4%;
    width: clamp(320px, 48vw, 720px);
    height: 92%;
    background-image: url('/backgrounds/bg-ambient-3.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center right;
    opacity: 0.18;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
    filter: contrast(1.08) brightness(0.98);
    -webkit-mask-image: radial-gradient(ellipse 68% 68% at 62% 50%, #000 35%, transparent 78%);
    mask-image: radial-gradient(ellipse 68% 68% at 62% 50%, #000 35%, transparent 78%);
    transition: opacity 0.5s var(--ease);
  }
  :global(body.theme-electric) .process-ambient-bg {
    opacity: 0.16;
    mix-blend-mode: screen;
    filter: grayscale(80%) contrast(1.2) sepia(1) hue-rotate(40deg);
  }
  :global(body.theme-dark) .process-ambient-bg {
    opacity: 0.14;
    mix-blend-mode: screen;
  }
  :global(body.theme-mate) .process-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: multiply;
    filter: grayscale(20%) contrast(1.2) sepia(0.3) hue-rotate(85deg);
  }
  .process-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .process-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--rust);
    text-transform: uppercase;
  }
  :global(body.theme-electric) .process-tag {
    color: var(--electric);
  }
  @media (max-width: 768px) {
    .process-ambient-bg {
      display: none;
    }
  }
</style>
