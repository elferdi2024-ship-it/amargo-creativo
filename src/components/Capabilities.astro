---
// filepath: src/components/Capabilities.astro

interface Service {
  num: string;
  title: string;
  desc: string;
  tags: string[];
  iconType: number;
}

const services: Service[] = [
  {
    num: "01",
    title: "Creación y Diseño Web de Élite",
    desc: "Páginas web y tiendas online ultrarrápidas (<0.8s), responsivas en cualquier celular y diseñadas para convertir visitas en clientes reales en Uruguay, Argentina y España.",
    tags: ["DISEÑO WEB", "TIENDAS ONLINE", "ALTO RENDIMIENTO"],
    iconType: 1
  },
  {
    num: "02",
    title: "Desarrollo de Aplicaciones & SaaS",
    desc: "Sistemas a medida, marketplaces, cotizadores inteligentes y plataformas web con tecnologías modernas (Next.js, Astro) que automatizan tus ventas.",
    tags: ["APPS A MEDIDA", "MARKETPLACES", "SAAS DIGITAL"],
    iconType: 2
  },
  {
    num: "03",
    title: "Posicionamiento SEO & Búsquedas IA",
    desc: "Optimizamos tu sitio con SEO técnico, marcado Schema.org local y arquitectura semántica para liderar en Google y motores de inteligencia artificial.",
    tags: ["SEO TÉCNICO", "GOOGLE URUGUAY / AR", "SCHEMA RICH SNIPPETS"],
    iconType: 4
  },
  {
    num: "04",
    title: "Estrategia Comercial & WhatsApp Commerce",
    desc: "Embudos directos a WhatsApp, checkout simplificado y branding de alto impacto para maximizar la tasa de conversión y cerrar ventas en minutos.",
    tags: ["WHATSAPP DIRECTO", "VENTAS SIN FRICCIÓN", "CRO"],
    iconType: 2
  }
];
---
<section class="capabilities" id="capabilities">
  <!-- Marca de Agua Ambiental Decorativa -->
  <div class="capabilities-ambient-bg" aria-hidden="true"></div>
  <div class="cap-head">
    <div class="section-label"><span class="num">02</span> SERVICIOS</div>
    <h2>Lo que <em>hacemos</em> <span class="no-orphan">por ti</span></h2>
  </div>
  <div class="cap-list">
    {services.map(service => (
      <div class="cap-item">
        <div class="cap-num">{service.num}</div>
        <div class="cap-title">{service.title}</div>
        <div class="cap-desc">{service.desc}</div>
        <div class="cap-tags">
          {service.tags.map(tag => (
            <span class="cap-tag">{tag}</span>
          ))}
        </div>
        <div class="cap-icon">
          {service.iconType === 1 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="0"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          )}
          {service.iconType === 2 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 3v18h18"/>
              <path d="M7 14l4-4 4 4 5-5"/>
            </svg>
          )}
          {service.iconType === 3 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="9"/>
              <path d="M12 3a9 9 0 0 0 0 18M3 12h18"/>
            </svg>
          )}
          {service.iconType === 4 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="M21 21l-4.35-4.35"/>
            </svg>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Bridge a Servicios de Crecimiento -->
  <div class="growth-banner">
    <div class="growth-content">
      <div class="growth-tag">
        <span class="growth-tag-dot"></span>
        <span>¿YA TIENES WEB ACTIVA?</span>
      </div>
      <h3 class="growth-title">Hacemos que tu sitio actual cargue en &lt;0.8s y multiplique sus conversiones.</h3>
      <p class="growth-desc">Mantenimiento continuo, auditorías de fricción CRO, SEO local y flujos automatizados de WhatsApp para empresas en Uruguay, Argentina y España.</p>
    </div>
    <div class="growth-action">
      <a href="/servicios-crecimiento" class="growth-btn" data-cursor="EXPLORAR">
        <span>SERVICIOS DE CRECIMIENTO</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .capabilities {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(60px, 10vh, 120px) var(--gut);
    border-bottom: 1px solid var(--line);
    width: 100%;
    position: relative;
    overflow: hidden;
  }
  .capabilities-ambient-bg {
    position: absolute;
    bottom: -5%;
    left: -5%;
    width: clamp(320px, 50vw, 750px);
    height: 85%;
    background-image: url('/backgrounds/bg-ambient-2.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: bottom left;
    opacity: 0.22;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
    filter: contrast(1.15) brightness(0.95);
    transition: opacity 0.5s var(--ease);
  }
  :global(body.theme-electric) .capabilities-ambient-bg {
    opacity: 0.26;
    filter: grayscale(80%) contrast(1.3) sepia(1) hue-rotate(40deg);
  }
  :global(body.theme-mate) .capabilities-ambient-bg {
    opacity: 0.24;
    filter: grayscale(20%) contrast(1.2) sepia(0.3) hue-rotate(85deg);
  }
  .cap-head {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    margin-bottom: 64px;
    align-items: start;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
    border-radius: 0;
  }
  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }
  .cap-head h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 5vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .cap-head h2 em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }
  .cap-list {
    display: flex;
    flex-direction: column;
  }
  .cap-item {
    display: grid;
    grid-template-columns: 80px 1fr 2fr auto 40px;
    gap: 32px;
    padding: 48px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
    transition: background 0.4s var(--ease), padding 0.4s var(--ease);
    cursor: pointer;
  }
  .cap-item:last-child {
    border-bottom: none;
  }
  .cap-item:hover {
    background: var(--hover-bg);
    color: var(--hover-text);
    padding-left: 24px;
    padding-right: 24px;
  }
  .cap-item:hover .cap-num {
    color: var(--mate-light);
  }
  .cap-item:hover .cap-desc {
    color: rgba(255, 255, 255, 0.7);
  }
  .cap-item:hover .cap-icon svg {
    color: var(--mate-light);
    transform: rotate(45deg);
  }
  .cap-item:hover .cap-tag {
    border-color: var(--mate-light);
    color: var(--mate-light);
  }
  :global(body.theme-electric) .cap-item:hover .cap-desc {
    color: rgba(10, 10, 10, 0.7);
  }
  :global(body.theme-electric) .cap-item:hover .cap-num {
    color: var(--electric);
  }
  :global(body.theme-electric) .cap-item:hover .cap-icon svg {
    color: var(--electric);
  }
  .cap-item:active {
    transform: scale(0.99);
  }
  .cap-num {
    font-family: 'Anton', sans-serif;
    font-size: 48px;
    color: var(--ink);
    opacity: 0.55;
    line-height: 1;
    transition: color 0.3s var(--ease), opacity 0.3s;
  }
  .cap-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 36px);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
  }
  .cap-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink);
    opacity: 0.85;
    max-width: 420px;
    transition: color 0.3s var(--ease), opacity 0.3s;
  }
  .cap-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }
  .cap-tag {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 8px;
    border: 1px solid var(--line);
    color: var(--ink);
    opacity: 0.85;
    transition: all 0.3s var(--ease);
  }
  .cap-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cap-icon svg {
    width: 32px;
    height: 32px;
    color: var(--ink);
    opacity: 0.6;
    transition: color 0.3s var(--ease), transform 0.4s var(--ease), opacity 0.3s;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 900px) {
    .cap-head {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .cap-head h2 {
      font-size: clamp(22px, 6.8vw, 36px);
      line-height: 1.05;
    }
    .cap-item {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 32px 0;
    }
    .cap-item:hover {
      padding-left: 0;
      padding-right: 0;
      background: transparent;
      color: var(--ink);
    }
    .cap-item:hover .cap-num {
      color: var(--mate);
    }
    .cap-item:hover .cap-desc {
      color: var(--mute);
    }
    .cap-item:hover .cap-icon svg {
      color: var(--mate);
      transform: rotate(0deg);
    }
    .cap-tags {
      justify-content: flex-start;
    }
    .cap-icon {
      display: none;
    }
  }

  /* Growth Banner Styling */
  .growth-banner {
    border-top: 1px solid var(--line);
    margin-top: 56px;
    padding-top: 48px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .growth-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mate);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-weight: 700;
  }
  :global(body.theme-electric) .growth-tag {
    color: var(--electric);
  }
  .growth-tag-dot {
    width: 7px;
    height: 7px;
    background: var(--rust);
    border-radius: 50%;
    animation: pulseDot 2s infinite ease-in-out;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .growth-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 34px);
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .growth-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
    opacity: 0.85;
    max-width: 680px;
  }
  .growth-action {
    display: flex;
    align-items: center;
  }
  .growth-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--ink);
    color: var(--bone);
    padding: 16px 28px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid var(--ink);
    transition: all 0.3s var(--ease);
    white-space: nowrap;
  }
  .growth-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s var(--ease);
  }
  .growth-btn:hover {
    background: var(--mate);
    border-color: var(--mate);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(45, 99, 53, 0.25);
  }
  .growth-btn:hover svg {
    transform: translateX(4px);
  }
  :global(body.theme-electric) .growth-btn {
    background: var(--electric);
    color: #0a0a0a;
    border-color: var(--electric);
  }
  :global(body.theme-electric) .growth-btn:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #0a0a0a;
  }
  :global(body.theme-mate) .growth-btn:hover {
    background: var(--mate-light);
    border-color: var(--mate-light);
    color: #0a0a0a;
  }
  @media (max-width: 900px) {
    .growth-banner {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 40px;
      padding-top: 36px;
    }
    .growth-btn {
      width: 100%;
      justify-content: center;
      padding: 14px 20px;
    }
  }
</style>
