---
// filepath: src/components/Capabilities.astro
// Distilled architectural capabilities — punchy copy, mobile-native compact rhythm
import RollText from './motion/RollText.astro';

interface Service {
  num: string;
  title: string;
  desc: string;
  meta: string;
  link?: string;
  linkText?: string;
}

const services: Service[] = [
  {
    num: "01",
    title: "Webs & E-Commerce",
    desc: "Sitios de autor en <mark class=\"hl-yellow\">&lt;0.8s</mark> hechos para convertir.",
    meta: "ASTRO 5 · NEXT.JS · CRO"
  },
  {
    num: "02",
    title: "Software & SaaS B2B",
    desc: "Apps a medida, portales y cobros con <mark class=\"hl-yellow\">código 100% propio</mark>.",
    meta: "SUPABASE · PORTALES · CFE",
    link: "/facturacion",
    linkText: "VER SUITE B2B ↗"
  },
  {
    num: "03",
    title: "SEO & Búsquedas IA",
    desc: "Arquitectura técnica y <mark class=\"hl-yellow\">Schema.org</mark> para liderar Google.",
    meta: "CORE WEB VITALS · LOCAL SEO"
  },
  {
    num: "04",
    title: "WhatsApp Commerce",
    desc: "Embudos <mark class=\"hl-yellow\">1-click a WhatsApp</mark> sin carritos abandonados.",
    meta: "CIERRE EN <60s · SIN FRICCIÓN"
  }
];
---
<section class="capabilities" id="capabilities">
  <div class="capabilities-ambient-bg ambient-parallax" aria-hidden="true"></div>

  <div class="cap-head">
    <div class="section-label">
      <span class="num">02</span>
      <span>CAPACIDADES</span>
    </div>
    <h2 data-reveal-words>Lo que <em>construimos</em></h2>
  </div>

  <div class="cap-list">
    {services.map((service, i) => (
      <article class="cap-item" data-reveal-block style={`--rd:${i * 60}ms`}>
        <div class="cap-num tabular">{service.num}</div>
        <div class="cap-title-wrap">
          <h3 class="cap-title">{service.title}</h3>
          <p class="cap-desc">
            <span set:html={service.desc} />
            {service.link && (
              <a href={service.link} class="cap-service-link">{service.linkText}</a>
            )}
          </p>
        </div>
        <div class="cap-meta-spec">{service.meta}</div>
      </article>
    ))}
  </div>

  <div class="growth-banner">
    <div class="growth-content">
      <span class="growth-tag"><span class="growth-tag-dot" aria-hidden="true"></span>¿YA TENÉS WEB?</span>
      <h3 class="growth-title">La aceleramos a &lt;0.8s y multiplicamos consultas.</h3>
    </div>
    <a href="/servicios-crecimiento" class="growth-btn ink-fill" data-cursor="EXPLORAR">
      <span class="ink" aria-hidden="true"></span>
      <RollText text="PLANES DE CRECIMIENTO" arrow="right" />
    </a>
  </div>
</section>

<style>
  .capabilities {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(64px, 11vh, 140px) var(--gut);
    border-bottom: 1px solid var(--line);
    width: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .capabilities-ambient-bg {
    position: absolute;
    bottom: -4%;
    left: -3%;
    width: clamp(280px, 44vw, 680px);
    height: 82%;
    background-image: url('/backgrounds/bg-ambient-2.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: bottom left;
    opacity: 0.18;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
    filter: contrast(1.15) brightness(0.96);
    mask-image: radial-gradient(ellipse 70% 72% at 32% 62%, black 22%, transparent 74%);
    -webkit-mask-image: radial-gradient(ellipse 70% 72% at 32% 62%, black 22%, transparent 74%);
  }

  :global(body.theme-dark) .capabilities-ambient-bg,
  :global(body.theme-electric) .capabilities-ambient-bg {
    opacity: 0.15;
    mix-blend-mode: screen;
    filter: invert(1) contrast(1.2);
  }

  :global(body.theme-mate) .capabilities-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: screen;
    filter: invert(1) sepia(0.35) hue-rotate(60deg);
  }

  .cap-head {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
    margin-bottom: clamp(32px, 5vw, 56px);
    align-items: end;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 2;
  }

  .section-label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-mono);
  }

  .section-label .num {
    color: #f5f3ec;
    font-weight: 700;
    background: var(--mate);
    padding: 3px 8px;
    border-radius: 2px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #11120f;
  }

  .cap-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 5vw, 72px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .cap-list {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .cap-item {
    display: grid;
    grid-template-columns: 76px 1.8fr auto;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(22px, 3.2vw, 36px) 16px;
    border-bottom: 1px solid var(--line);
    align-items: center;
    transition: background-color 0.3s var(--ease), transform 0.35s var(--ease-emphasis);
    border-radius: var(--radius-sm);
  }

  .cap-item:last-child {
    border-bottom: none;
  }

  .cap-item:hover {
    background: var(--paper);
    transform: translate3d(8px, 0, 0);
  }

  .cap-item:hover .cap-num {
    color: var(--rust);
    opacity: 1;
  }

  .cap-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(26px, 3.4vw, 42px);
    letter-spacing: -0.04em;
    color: var(--ink);
    opacity: 0.28;
    line-height: 1;
    transition: color 0.3s var(--ease), opacity 0.3s;
  }

  .cap-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cap-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 2.2vw, 28px);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ink);
  }

  .cap-desc {
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.48;
    color: var(--mute);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .cap-service-link {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--mate);
    text-decoration: none;
    letter-spacing: 0.06em;
    border-bottom: 1px solid currentColor;
  }

  :global(body.theme-dark) .cap-service-link,
  :global(body.theme-electric) .cap-service-link,
  :global(body.theme-mate) .cap-service-link {
    color: var(--electric);
  }

  .cap-meta-spec {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--mute);
    text-align: right;
    white-space: nowrap;
  }

  .growth-banner {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    margin-top: clamp(32px, 5vw, 56px);
    padding: clamp(20px, 3vw, 32px) clamp(18px, 3vw, 36px);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .growth-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--mate);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    font-weight: 700;
  }

  :global(body.theme-dark) .growth-tag,
  :global(body.theme-electric) .growth-tag,
  :global(body.theme-mate) .growth-tag {
    color: var(--electric);
  }

  .growth-tag-dot {
    width: 6px;
    height: 6px;
    background: var(--rust);
    border-radius: 50%;
  }

  .growth-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.8vw, 22px);
    line-height: 1.2;
    color: var(--ink);
  }

  .growth-btn {
    --mx-fill-ink: var(--mate);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--ink);
    color: var(--bone);
    padding: 13px 24px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    transition: transform 0.3s var(--ease-emphasis), color 0.3s var(--ease);
    white-space: nowrap;
  }

  .growth-btn:hover {
    color: #ffffff;
    border-color: var(--mate);
    transform: translate3d(0, -2px, 0);
  }

  @media (max-width: 820px) {
    .capabilities {
      padding: 56px var(--gut);
    }
    .capabilities-ambient-bg {
      opacity: 0.1;
    }
    .cap-head {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }
    .cap-item {
      grid-template-columns: 42px 1fr;
      gap: 10px 14px;
      padding: 20px 0;
      align-items: start;
    }
    .cap-item:hover {
      background: transparent;
      transform: none;
    }
    .cap-num {
      font-size: 22px;
      padding-top: 2px;
    }
    .cap-meta-spec {
      grid-column: 2;
      text-align: left;
      font-size: 9.5px;
      opacity: 0.78;
    }
    .growth-banner {
      margin-top: 28px;
      gap: 16px;
    }
    .growth-btn {
      width: 100%;
    }
  }
</style>
