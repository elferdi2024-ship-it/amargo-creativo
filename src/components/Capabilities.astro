---
// filepath: src/components/Capabilities.astro
// Servicios & Capacidades: Contenido destilado sin saturación, tipografía de autor y espaciado generoso

interface Service {
  num: string;
  title: string;
  desc: string;
  tags: string[];
  iconType: number;
  link?: string;
  linkText?: string;
}

const services: Service[] = [
  {
    num: "01",
    title: "Creación y Diseño Web de Élite",
    desc: "Páginas y tiendas online de carga inmediata (<mark class=\"hl-yellow\">&lt;0.8s</mark>) diseñadas para convertir visitas en ventas reales en Uruguay, Argentina y España.",
    tags: ["DISEÑO WEB", "TIENDAS ONLINE", "ALTO RENDIMIENTO"],
    iconType: 1
  },
  {
    num: "02",
    title: "Desarrollo de Software & SaaS",
    desc: "Portales B2B a medida, cotizadores inteligentes y aplicaciones escalables con <mark class=\"hl-yellow\">Astro 5 & Next.js</mark> que automatizan tus ventas y cobros.",
    tags: ["PORTALES B2B", "FACTURACIÓN CFE", "SAAS A MEDIDA"],
    iconType: 2,
    link: "/facturacion",
    linkText: "EXPLORAR SUITE B2B ↗"
  },
  {
    num: "03",
    title: "Posicionamiento SEO & Búsquedas IA",
    desc: "Arquitectura semántica y <mark class=\"hl-yellow\">Schema Rich Snippets</mark> para liderar orgánicamente en Google y motores de inteligencia artificial.",
    tags: ["SEO TÉCNICO", "GOOGLE URUGUAY / AR", "SCHEMA IA"],
    iconType: 4
  },
  {
    num: "04",
    title: "Estrategia & WhatsApp Commerce",
    desc: "Embudos directos a <mark class=\"hl-yellow\">WhatsApp 1-click</mark> sin intermediarios ni carritos abandonados para cerrar compras en menos de un minuto.",
    tags: ["WHATSAPP DIRECTO", "VENTAS SIN FRICCIÓN", "CRO"],
    iconType: 2
  }
];
---
<section class="capabilities" id="capabilities">
  <!-- Crosshairs decorativos de plano de arquitectura -->
  <div class="cap-mark mark-tl" aria-hidden="true">+</div>
  <div class="cap-mark mark-tr" aria-hidden="true">+</div>

  <div class="cap-head">
    <div class="section-label">
      <span class="num">02</span>
      <span>CAPACIDADES &bull; SERVICIOS</span>
    </div>
    <h2>Lo que <em>hacemos</em> <span class="no-orphan">por tu marca</span></h2>
  </div>

  <div class="cap-list">
    {services.map(service => (
      <div class="cap-item">
        <div class="cap-num">{service.num}</div>
        <div class="cap-title-wrap">
          <div class="cap-title">{service.title}</div>
          <div class="cap-desc">
            <span set:html={service.desc} />
            {service.link && (
              <div class="cap-service-link-wrap">
                <a href={service.link} class="cap-service-link">{service.linkText}</a>
              </div>
            )}
          </div>
        </div>
        <div class="cap-tags">
          {service.tags.map(tag => (
            <span class="cap-tag">{tag}</span>
          ))}
        </div>
        <div class="cap-icon">
          {service.iconType === 1 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="0"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          )}
          {service.iconType === 2 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 3v18h18"/>
              <path d="M7 14l4-4 4 4 5-5"/>
            </svg>
          )}
          {service.iconType === 4 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="M21 21l-4.35-4.35"/>
            </svg>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- Bridge a Servicios de Crecimiento: Diseño limpio y sintético -->
  <div class="growth-banner">
    <div class="growth-content">
      <div class="growth-tag">
        <span class="growth-tag-dot"></span>
        <span>OPTIMIZACIÓN DE SITIOS ACTIVOS</span>
      </div>
      <h3 class="growth-title">¿Ya tienes web? La aceleramos a &lt;0.8s y multiplicamos conversiones.</h3>
    </div>
    <div class="growth-action">
      <a href="/servicios-crecimiento" class="growth-btn" data-cursor="EXPLORAR">
        <span>SERVICIOS DE CRECIMIENTO</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .capabilities {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(90px, 13vh, 160px) var(--gut);
    border-bottom: 1px solid var(--line);
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .cap-mark {
    position: absolute;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: var(--line);
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
  }
  .mark-tl { top: 24px; left: var(--gut); }
  .mark-tr { top: 24px; right: var(--gut); }

  .cap-head {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 48px;
    margin-bottom: clamp(48px, 7vw, 80px);
    align-items: start;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
  }

  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 3px 8px;
    border-radius: 2px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }

  .cap-head h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 68px);
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }

  .cap-head h2 em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }

  .cap-list {
    display: flex;
    flex-direction: column;
  }

  .cap-item {
    display: grid;
    grid-template-columns: 80px 2.2fr auto 48px;
    gap: clamp(24px, 3.5vw, 48px);
    padding: clamp(32px, 4.5vw, 56px) 16px;
    border-bottom: 1px solid var(--line);
    align-items: center;
    transition: background 0.4s var(--ease), padding 0.4s var(--ease);
    cursor: pointer;
  }

  .cap-item:last-child {
    border-bottom: none;
  }

  .cap-item:hover {
    background: var(--paper);
    padding-left: 28px;
    padding-right: 28px;
  }

  .cap-item:hover .cap-num {
    color: var(--rust);
    opacity: 1;
  }

  :global(body.theme-electric) .cap-item:hover .cap-num {
    color: var(--electric);
  }

  .cap-item:hover .cap-icon svg {
    color: var(--rust);
    transform: rotate(45deg);
  }

  :global(body.theme-electric) .cap-item:hover .cap-icon svg {
    color: var(--electric);
  }

  .cap-num {
    font-family: 'Anton', sans-serif;
    font-size: clamp(36px, 4.2vw, 54px);
    color: var(--ink);
    opacity: 0.4;
    line-height: 1;
    transition: color 0.3s var(--ease), opacity 0.3s;
  }

  .cap-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cap-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 32px);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
  }

  .cap-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.82;
    max-width: 60ch;
  }

  .cap-desc :global(mark.hl-yellow) {
    background: var(--electric);
    color: #0a0a0a !important;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .cap-service-link-wrap {
    margin-top: 8px;
  }

  .cap-service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--mate);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s ease;
  }

  .cap-service-link:hover {
    color: var(--rust);
  }

  :global(body.theme-electric) .cap-service-link {
    color: var(--electric);
  }

  .cap-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }

  .cap-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper);
    transition: all 0.3s var(--ease);
  }

  .cap-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cap-icon svg {
    width: 28px;
    height: 28px;
    color: var(--ink);
    opacity: 0.5;
    transition: color 0.3s var(--ease), transform 0.4s var(--ease), opacity 0.3s;
  }

  /* Growth Banner: Reducido, aireado y sin párrafo largo */
  .growth-banner {
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 4px 4px 0px var(--line);
    margin-top: clamp(48px, 7vw, 80px);
    padding: clamp(24px, 3.5vw, 36px) clamp(20px, 3.5vw, 40px);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .growth-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mate);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-weight: 700;
  }

  :global(body.theme-electric) .growth-tag {
    color: var(--electric);
  }

  .growth-tag-dot {
    width: 7px;
    height: 7px;
    background: var(--rust);
    border-radius: 50%;
  }

  .growth-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(17px, 2vw, 24px);
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.015em;
  }

  .growth-action {
    display: flex;
    align-items: center;
  }

  .growth-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--bone);
    padding: 14px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid var(--ink);
    transition: all 0.3s var(--ease);
    white-space: nowrap;
    box-shadow: 2px 2px 0px var(--line);
  }

  .growth-btn svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--ease);
  }

  .growth-btn:hover {
    background: var(--mate);
    border-color: var(--mate);
    color: #ffffff;
    box-shadow: 4px 4px 0px var(--electric);
    transform: translate3d(-1px, -1px, 0);
  }

  .growth-btn:hover svg {
    transform: translateX(4px);
  }

  :global(body.theme-electric) .growth-btn {
    background: var(--electric);
    color: #0a0a0a;
    border-color: var(--electric);
  }

  @media (max-width: 900px) {
    .capabilities {
      padding: clamp(64px, 10vh, 100px) var(--gut);
    }
    .cap-head {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }
    .cap-item {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 28px 0;
    }
    .cap-item:hover {
      padding-left: 0;
      padding-right: 0;
      background: transparent;
    }
    .cap-tags {
      justify-content: flex-start;
    }
    .cap-icon {
      display: none;
    }
    .growth-banner {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 36px;
      padding: 24px 18px;
    }
    .growth-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
