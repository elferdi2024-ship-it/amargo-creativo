---
// filepath: src/components/ProjectModal.astro
// Editorial quick-preview case modal with metrics, stack & direct WhatsApp quote CTA
---
<div
  class="modal-overlay"
  id="modalOverlay"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="modalTitle"
>
  <div class="modal-shell" id="modalShell">
    <div class="modal-sheet-grab" aria-hidden="true"><span></span></div>
    <div class="modal-topbar">
      <span class="modal-kicker" id="modalKicker">CASO DE ÉXITO</span>
      <button type="button" class="modal-close" id="modalClose" aria-label="Cerrar vista previa del proyecto">
        <span>ESC</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="modal-content">
      <div class="modal-left">
        <h3 id="modalTitle">Proyecto</h3>
        <p class="modal-desc" id="modalDesc">Descripción del proyecto.</p>

        <div class="modal-metrics-grid">
          <div class="modal-metric">
            <span class="mm-label">RESULTADO CLAVE</span>
            <strong class="mm-val" id="modalResult">—</strong>
          </div>
          <div class="modal-metric-row">
            <div class="modal-metric">
              <span class="mm-label">TELEMETRÍA</span>
              <strong class="mm-val tabular" id="modalSpeed">&lt; 0.8s</strong>
            </div>
            <div class="modal-metric">
              <span class="mm-label">LIGHTHOUSE</span>
              <strong class="mm-val mm-perf tabular" id="modalPerf">100/100</strong>
            </div>
          </div>
        </div>

        <div class="modal-tags" id="modalTags"></div>

        <div class="modal-actions">
          <a
            href="#"
            id="modalLink"
            target="_blank"
            rel="noopener noreferrer"
            class="modal-btn-primary"
            data-cursor="VISITAR"
          >
            <span>ABRIR EN PRODUCCIÓN</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a
            href="#"
            id="modalWa"
            target="_blank"
            rel="noopener noreferrer"
            class="modal-btn-secondary"
            data-cursor="WHATSAPP"
          >
            <span>COTIZAR SIMILAR</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="modal-right">
        <div class="modal-img-frame">
          <img
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            id="modalImg"
            alt="Vista previa del proyecto"
            width="800"
            height="600"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(11, 13, 10, 0.84);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--overlay-text);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(20px + env(safe-area-inset-top)) var(--gut) calc(20px + env(safe-area-inset-bottom));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s var(--ease), visibility 0s linear 0.35s;
  }

  .modal-overlay:global(.active) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.35s var(--ease), visibility 0s;
  }

  .modal-shell {
    width: 100%;
    max-width: 1120px;
    max-height: 90dvh;
    overflow-y: auto;
    background: var(--overlay-bg);
    border: 1px solid rgba(245, 243, 236, 0.16);
    border-radius: var(--radius-md);
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.55);
    transform: translate3d(0, 28px, 0) scale(0.985);
    transition: transform 0.45s var(--ease-emphasis);
    contain: layout style paint;
  }

  .modal-overlay:global(.active) .modal-shell {
    transform: translate3d(0, 0, 0) scale(1);
  }

  .modal-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 24px;
    border-bottom: 1px solid rgba(245, 243, 236, 0.12);
  }

  .modal-kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--electric);
  }

  .modal-close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 243, 236, 0.08);
    color: #f5f3ec;
    border: 1px solid rgba(245, 243, 236, 0.18);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .modal-close:hover {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  .modal-content {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(24px, 4vw, 44px);
    align-items: center;
  }

  .modal-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .modal-left h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #f5f3ec;
  }

  .modal-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: rgba(245, 243, 236, 0.8);
    max-width: 50ch;
  }

  .modal-metrics-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border: 1px solid rgba(245, 243, 236, 0.14);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
  }

  .modal-metric-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(245, 243, 236, 0.1);
  }

  .modal-metric {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mm-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: rgba(245, 243, 236, 0.56);
    text-transform: uppercase;
  }

  .mm-val {
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    color: #f5f3ec;
  }

  .mm-perf {
    color: var(--electric);
    font-family: var(--font-mono);
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .modal-tags :global(.modal-tag) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(245, 243, 236, 0.2);
    color: rgba(245, 243, 236, 0.85);
  }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }

  .modal-btn-primary,
  .modal-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.25s var(--ease), background-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .modal-btn-primary {
    background: var(--electric);
    color: #11120f;
    border: 1px solid var(--electric);
  }

  .modal-btn-primary:hover {
    transform: translate3d(0, -2px, 0);
    background: #ffffff;
    border-color: #ffffff;
  }

  .modal-btn-secondary {
    background: transparent;
    color: #f5f3ec;
    border: 1px solid rgba(245, 243, 236, 0.28);
  }

  .modal-btn-secondary:hover {
    transform: translate3d(0, -2px, 0);
    border-color: var(--electric);
    color: var(--electric);
  }

  .modal-img-frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(245, 243, 236, 0.14);
    background: #0a0b09;
  }

  .modal-img-frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .modal-sheet-grab {
    display: none;
  }

  @media (max-width: 820px) {
    .modal-overlay {
      align-items: flex-end;
      padding: 0;
    }
    .modal-shell {
      max-height: 90dvh;
      border-radius: 22px 22px 0 0;
      border-bottom: none;
      transform: translate3d(0, 100%, 0);
      padding-bottom: env(safe-area-inset-bottom);
      overscroll-behavior: contain;
    }
    .modal-overlay:global(.active) .modal-shell {
      transform: translate3d(0, 0, 0);
    }
    .modal-sheet-grab {
      display: flex;
      justify-content: center;
      padding: 10px 0 2px;
    }
    .modal-sheet-grab span {
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: rgba(245, 243, 236, 0.28);
    }
    .modal-close {
      min-height: 36px;
      padding: 6px 14px;
    }
    .modal-content {
      grid-template-columns: 1fr;
      padding: 18px 20px 26px;
      gap: 18px;
    }
    .modal-right {
      order: -1;
    }
    .modal-actions {
      flex-direction: column;
    }
    .modal-btn-primary,
    .modal-btn-secondary {
      width: 100%;
      padding: 14px 20px;
    }
  }
</style>
