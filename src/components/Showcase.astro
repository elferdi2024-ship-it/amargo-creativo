---
// filepath: src/components/Showcase.astro
// Gallery-grade Awwwards Case Study Showcase:
// - Editorial browser-framed project plates so every screenshot looks cohesive & museum-clean
// - Zero floating pill overload; crisp KPI hierarchy; touch-first mobile filter bar
import { projects } from '../lib/projects';

export interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayedProjects = limit ? projects.slice(0, limit) : projects;

const countAll = displayedProjects.length;
const countMarketplace = displayedProjects.filter((p) => p.category === 'marketplace').length;
const countSaas = displayedProjects.filter((p) => p.category === 'saas').length;
const countEcommerce = displayedProjects.filter((p) => p.category === 'ecommerce').length;

const categoryLabels: Record<string, string> = {
  marketplace: 'MARKETPLACE',
  saas: 'SAAS & APPS',
  ecommerce: 'E-COMMERCE',
};
---
<section class="showcase" id="showcase">
  <div class="showcase-ambient-bg ambient-parallax" aria-hidden="true"></div>

  <div class="showcase-head">
    <div class="showcase-head-left">
      <div class="section-label">
        <span class="num">03</span>
        <span>CASOS EN PRODUCCIÓN</span>
      </div>
      <h2 data-reveal-words>TRABAJOS <em>seleccionados</em></h2>
      <div class="showcase-filters" role="group" aria-label="Filtrar proyectos">
        <button type="button" class="filter-btn active" data-filter="all" aria-pressed="true">
          TODOS ({countAll})
        </button>
        {countMarketplace > 0 && (
          <button type="button" class="filter-btn" data-filter="marketplace" aria-pressed="false">
            MARKETPLACE ({countMarketplace})
          </button>
        )}
        {countSaas > 0 && (
          <button type="button" class="filter-btn" data-filter="saas" aria-pressed="false">
            SAAS &amp; APPS ({countSaas})
          </button>
        )}
        {countEcommerce > 0 && (
          <button type="button" class="filter-btn" data-filter="ecommerce" aria-pressed="false">
            E-COMMERCE ({countEcommerce})
          </button>
        )}
      </div>
    </div>

    <div class="showcase-head-right">
      <div class="showcase-nav-controls" aria-label="Navegar carrusel de proyectos">
        <button type="button" class="sc-arrow-btn" id="showcasePrev" aria-label="Proyecto anterior" data-cursor="ANTERIOR">←</button>
        <button type="button" class="sc-arrow-btn" id="showcaseNext" aria-label="Siguiente proyecto" data-cursor="SIGUIENTE">→</button>
      </div>
      <a href="/proyectos" class="see-all-top-btn" data-cursor="ARCHIVO">
        <span>VER TODOS ({projects.length})</span> →
      </a>
    </div>
  </div>

  <div class="projects-drag" id="projectsDrag" data-cursor="ARRASTRAR">
    {displayedProjects.map((project, idx) => (
      <article
        class="project-card"
        tabindex="0"
        role="button"
        aria-label={`Ver caso de éxito ${project.title}`}
        data-cursor="VER CASO"
        data-category={project.category}
        data-title={project.title}
        data-desc={project.desc}
        data-url={project.url}
        data-img={project.img}
        data-kicker={`${project.client} • ${project.location}`}
        data-result={project.keyResult}
        data-speed={project.architecture.speed}
        data-perf={String(project.lighthouse.perf)}
        data-tags={project.tags.join('|')}
      >
        <div class="pc-frame">
          <div class="pc-browser-bar" aria-hidden="true">
            <span class="pc-dots"><i></i><i></i><i></i></span>
            <span class="pc-domain">{project.liveUrlLabel}</span>
            <span class="pc-lh-mini tabular">LH {project.lighthouse.perf}</span>
          </div>
          <div class="pc-img-wrap">
            <img
              src={project.img}
              class="pc-img"
              alt={`Interfaz en producción de ${project.title}`}
              width={project.aspectWidth}
              height={project.aspectHeight}
              loading="lazy"
              fetchpriority={idx > 1 ? 'low' : 'auto'}
              decoding="async"
            />
            <div class="pc-hover-scrim" aria-hidden="true">
              <span class="pc-open-pill">VER CASO ↗</span>
            </div>
          </div>
        </div>

        <div class="pc-meta">
          <div class="pc-meta-top">
            <span class="pc-index tabular">{String(idx + 1).padStart(2, '0')} · {categoryLabels[project.category]}</span>
            <span class="pc-speed-inline tabular">⚡ {project.architecture.speed.split('•')[0].trim()}</span>
          </div>
          <h3 class="pc-title">{project.title}</h3>
          <p class="pc-result-line">{project.keyResult}</p>
          <div class="pc-tags">
            {project.tags.slice(0, 2).map((tag) => (
              <span class="pc-tag">{tag}</span>
            ))}
          </div>
        </div>
      </article>
    ))}

    {limit && (
      <div class="project-card see-all-card">
        <a href="/proyectos" class="see-all-box" data-cursor="VER TODOS">
          <span class="see-all-tag">● ARCHIVO COMPLETO</span>
          <h3 class="see-all-heading">VER LOS {projects.length} PROYECTOS</h3>
          <p class="see-all-text">Marketplaces, AI SaaS, delivery hiperlocal y tiendas D2C en vivo.</p>
          <span class="see-all-cta-btn">EXPLORAR ARCHIVO ↗</span>
        </a>
      </div>
    )}
  </div>

  <div class="showcase-progress-bar" aria-hidden="true">
    <div class="showcase-progress-fill" id="showcaseProgressFill"></div>
  </div>
</section>

<style>
  .showcase {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(64px, 11vh, 136px) var(--gut);
    width: 100%;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    border-bottom: 1px solid var(--line);
  }

  .showcase-ambient-bg {
    position: absolute;
    top: 2%;
    right: -2%;
    width: clamp(260px, 40vw, 600px);
    height: 62%;
    background-image: url('/backgrounds/bg-ambient-3.webp');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: top right;
    opacity: 0.16;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
    filter: contrast(1.12) brightness(0.98);
    mask-image: radial-gradient(ellipse 68% 68% at 64% 38%, black 22%, transparent 74%);
    -webkit-mask-image: radial-gradient(ellipse 68% 68% at 64% 38%, black 22%, transparent 74%);
  }

  :global(body.theme-dark) .showcase-ambient-bg,
  :global(body.theme-electric) .showcase-ambient-bg {
    opacity: 0.14;
    mix-blend-mode: screen;
    filter: invert(1) contrast(1.2);
  }

  :global(body.theme-mate) .showcase-ambient-bg {
    opacity: 0.18;
    mix-blend-mode: screen;
    filter: invert(1) sepia(0.35) hue-rotate(60deg);
  }

  .showcase-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: clamp(20px, 3.5vw, 36px);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(28px, 4vw, 44px);
    flex-wrap: wrap;
    gap: 20px;
    position: relative;
    z-index: 2;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mute);
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 14px;
  }

  .section-label .num {
    color: #f5f3ec;
    font-weight: 700;
    background: var(--mate);
    padding: 3px 8px;
    border-radius: 2px;
  }

  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #11120f;
  }

  .showcase-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(32px, 6.2vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .showcase-filters {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--line-strong);
    padding: 7px 15px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
    cursor: pointer;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease), border-color 0.22s var(--ease);
  }

  .filter-btn:hover {
    background: var(--ink);
    color: var(--bone);
  }

  .filter-btn.active {
    background: var(--mate);
    color: #f5f3ec;
    border-color: var(--mate);
  }

  :global(body.theme-dark) .filter-btn.active,
  :global(body.theme-electric) .filter-btn.active {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  .showcase-head-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .showcase-nav-controls {
    display: inline-flex;
    gap: 6px;
  }

  .sc-arrow-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease), transform 0.22s var(--ease);
  }

  .sc-arrow-btn:hover {
    background: var(--ink);
    color: var(--bone);
    transform: translate3d(0, -1px, 0);
  }

  .see-all-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 9px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease), border-color 0.22s var(--ease);
  }

  .see-all-top-btn:hover {
    background: var(--mate);
    color: #f5f3ec;
    border-color: var(--mate);
  }

  /* Horizontal Gallery Rail */
  .projects-drag {
    display: flex;
    gap: 22px;
    cursor: grab;
    user-select: none;
    padding-bottom: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y pan-x;
    position: relative;
    z-index: 2;
  }

  .projects-drag::-webkit-scrollbar {
    display: none;
  }

  .projects-drag.active {
    cursor: grabbing;
    scroll-snap-type: none !important;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: clamp(320px, 38vw, 490px);
    scroll-snap-align: start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.38s var(--ease-emphasis), box-shadow 0.38s var(--ease), border-color 0.3s var(--ease);
  }

  .project-card:active {
    transform: scale(0.985);
    transition-duration: 110ms;
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translate3d(0, -4px, 0);
      border-color: var(--mate);
      box-shadow: 0 22px 48px -22px var(--shadow-tint);
    }

    :global(body.theme-dark) .project-card:hover,
    :global(body.theme-electric) .project-card:hover,
    :global(body.theme-mate) .project-card:hover {
      border-color: var(--electric);
    }

    .project-card:hover .pc-img {
      transform: scale(1.045);
    }

    .project-card:hover .pc-hover-scrim {
      opacity: 1;
    }
  }

  .project-card.hidden {
    display: none !important;
  }

  /* Editorial Browser Frame */
  .pc-frame {
    background: var(--charcoal);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }

  .pc-browser-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 14px;
    background: rgba(17, 18, 15, 0.96);
    border-bottom: 1px solid rgba(245, 243, 236, 0.08);
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(245, 243, 236, 0.6);
  }

  .pc-dots {
    display: inline-flex;
    gap: 5px;
  }

  .pc-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(245, 243, 236, 0.22);
    display: block;
  }

  .pc-domain {
    letter-spacing: 0.03em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pc-lh-mini {
    color: var(--electric);
    font-weight: 700;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .pc-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #141612;
  }

  .pc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    pointer-events: none;
    transition: transform 0.7s var(--ease-emphasis), opacity 0.4s var(--ease);
    opacity: 0;
  }

  .pc-img.loaded,
  :global(.pc-img.loaded) {
    opacity: 1;
  }

  .pc-hover-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17, 18, 15, 0.55) 0%, transparent 45%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 14px;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .pc-open-pill {
    background: var(--electric);
    color: #11120f;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }

  /* Card Editorial Body */
  .pc-meta {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .pc-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--mute);
  }

  .pc-speed-inline {
    color: var(--mate);
    font-weight: 700;
  }

  :global(body.theme-dark) .pc-speed-inline,
  :global(body.theme-electric) .pc-speed-inline,
  :global(body.theme-mate) .pc-speed-inline {
    color: var(--electric);
  }

  .pc-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(19px, 1.9vw, 24px);
    text-transform: uppercase;
    letter-spacing: -0.025em;
    color: var(--ink);
    line-height: 1.08;
  }

  .pc-result-line {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--mute);
    line-height: 1.45;
  }

  .pc-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 6px;
  }

  .pc-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    opacity: 0.8;
  }

  /* See All End Card */
  .see-all-card {
    border: 1px solid rgba(137, 179, 88, 0.35);
    background: var(--mate-deep);
  }

  .see-all-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 36px 28px;
    text-decoration: none;
    color: #f5f3ec;
    width: 100%;
    height: 100%;
    gap: 14px;
  }

  .see-all-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--electric);
    letter-spacing: 0.1em;
  }

  .see-all-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.04;
    text-transform: uppercase;
    color: #f5f3ec;
  }

  .see-all-text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(245, 243, 236, 0.78);
  }

  .see-all-cta-btn {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: var(--electric);
    color: #11120f;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
  }

  /* Carousel Progress Bar */
  .showcase-progress-bar {
    width: 100%;
    height: 2px;
    background: var(--line);
    overflow: hidden;
    position: relative;
    z-index: 2;
  }

  .showcase-progress-fill {
    width: 100%;
    height: 100%;
    background: var(--mate);
    transform: scaleX(0.15);
    transform-origin: 0 50%;
    transition: transform 0.16s ease-out;
  }

  :global(body.theme-dark) .showcase-progress-fill,
  :global(body.theme-electric) .showcase-progress-fill,
  :global(body.theme-mate) .showcase-progress-fill {
    background: var(--electric);
  }

  @media (max-width: 768px) {
    .showcase {
      padding: 56px var(--gut);
    }
    .showcase-head {
      padding-bottom: 16px;
      margin-bottom: 20px;
      gap: 14px;
    }
    .showcase-head-left {
      width: 100%;
    }
    .showcase-head h2 {
      font-size: clamp(30px, 8.5vw, 42px);
    }
    .showcase-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-top: 14px;
      padding-bottom: 2px;
      width: 100%;
    }
    .showcase-filters::-webkit-scrollbar {
      display: none;
    }
    .showcase-nav-controls {
      display: none;
    }
    .showcase-head-right {
      width: 100%;
    }
    .see-all-top-btn {
      width: 100%;
      justify-content: center;
    }
    .projects-drag {
      gap: 14px;
      padding-bottom: 20px;
    }
    .project-card {
      width: 82vw;
      max-width: 340px;
    }
    .pc-img {
      opacity: 1 !important;
    }
    .pc-meta {
      padding: 14px 16px 16px;
      gap: 6px;
    }
    .pc-title {
      font-size: 18px;
    }
    .pc-result-line {
      font-size: 12.5px;
    }
  }
</style>
