---
// filepath: src/components/Marquee.astro
// Marquee editorial de alta precisión: CSS continuo ininterrumpido + motor RAF garantizado en cualquier celular
---
<div class="marquee" id="marqueeRoot" aria-hidden="true">
  <div class="marquee-track" id="marqueeTrack">
    <!-- Grupo 1 -->
    <div class="marquee-group">
      <span class="bone-block">STARTUPS<span class="star">/</span></span>
      <span class="italic">crecimiento</span>
      <span class="mate-block">PYMES<span class="star">/</span></span>
      <span>APLICACIONES</span>
      <span class="rust-block">E-COMMERCE<span class="star">/</span></span>
      <span class="italic">ventas</span>
      <span class="bone-block">DISEÑO WEB<span class="star">/</span></span>
      <span>RESULTADOS</span>
    </div>
    <!-- Grupo 2 -->
    <div class="marquee-group" aria-hidden="true">
      <span class="bone-block">STARTUPS<span class="star">/</span></span>
      <span class="italic">crecimiento</span>
      <span class="mate-block">PYMES<span class="star">/</span></span>
      <span>APLICACIONES</span>
      <span class="rust-block">E-COMMERCE<span class="star">/</span></span>
      <span class="italic">ventas</span>
      <span class="bone-block">DISEÑO WEB<span class="star">/</span></span>
      <span>RESULTADOS</span>
    </div>
    <!-- Grupo 3 (Garantiza buffer continuo en pantallas ultra-wide y rotación mobile) -->
    <div class="marquee-group" aria-hidden="true">
      <span class="bone-block">STARTUPS<span class="star">/</span></span>
      <span class="italic">crecimiento</span>
      <span class="mate-block">PYMES<span class="star">/</span></span>
      <span>APLICACIONES</span>
      <span class="rust-block">E-COMMERCE<span class="star">/</span></span>
      <span class="italic">ventas</span>
      <span class="bone-block">DISEÑO WEB<span class="star">/</span></span>
      <span>RESULTADOS</span>
    </div>
    <!-- Grupo 4 -->
    <div class="marquee-group" aria-hidden="true">
      <span class="bone-block">STARTUPS<span class="star">/</span></span>
      <span class="italic">crecimiento</span>
      <span class="mate-block">PYMES<span class="star">/</span></span>
      <span>APLICACIONES</span>
      <span class="rust-block">E-COMMERCE<span class="star">/</span></span>
      <span class="italic">ventas</span>
      <span class="bone-block">DISEÑO WEB<span class="star">/</span></span>
      <span>RESULTADOS</span>
    </div>
  </div>
</div>

<style>
  .marquee {
    background: var(--marquee-bg);
    color: var(--marquee-text);
    border-top: 1px solid var(--marquee-bg);
    border-bottom: 1px solid var(--marquee-bg);
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    width: 100%;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }

  .marquee-track {
    display: flex;
    align-items: stretch;
    width: max-content;
    flex-shrink: 0;
    will-change: transform;
    /* Movimiento continuo CSS de base a prueba de fallos */
    animation: marqueeLoop 28s linear infinite;
  }

  @keyframes marqueeLoop {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-group {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .marquee-track span {
    padding: 16px 24px;
    display: inline-flex;
    align-items: center;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 3.5vw, 44px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .marquee-track .italic {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    color: #0a0a0a;
    background: var(--electric);
    padding-left: 20px;
    padding-right: 20px;
  }

  .marquee-track .bone-block {
    background: var(--bone);
    color: #0a0a0a;
  }

  .marquee-track .mate-block {
    background: var(--mate);
    color: var(--bone);
  }

  .marquee-track .rust-block {
    background: var(--rust);
    color: var(--bone);
  }

  .marquee-track .star {
    font-size: 0.8em;
    padding: 0 0 0 8px;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .marquee-track span {
      padding: 12px 16px;
      font-size: clamp(17px, 4.2vw, 24px);
    }
  }
</style>

<script>
  // Motor redundante de animación física: si el navegador del celular pausa CSS por ahorro de batería,
  // el bucle rAF toma el control instantáneamente garantizando movimiento continuo.
  (function initMarqueeEngine() {
    const track = document.getElementById('marqueeTrack');
    if (!track) return;

    let posX = 0;
    let baseSpeed = 1.15;
    let currentSpeed = baseSpeed;
    let targetSpeed = baseSpeed;
    let halfWidth = 0;
    let lastScrollY = window.scrollY;
    let isRafActive = false;

    function measure() {
      if (track) {
        // La mitad corresponde a 2 de los 4 grupos
        halfWidth = track.scrollWidth / 2;
      }
    }

    measure();
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('orientationchange', measure, { passive: true });

    // Verificamos si la animación CSS está corriendo efectivamente en el dispositivo
    function checkAndDrive() {
      // Si la animación CSS está pausada por el OS (ej. ahorro de batería Android / prefers-reduced-motion)
      const computed = window.getComputedStyle(track);
      const isPaused = computed.animationPlayState === 'paused' || computed.animationName === 'none';

      if (isPaused && !isRafActive) {
        isRafActive = true;
        track.style.animation = 'none';

        function step() {
          currentSpeed += (targetSpeed - currentSpeed) * 0.12;
          posX -= currentSpeed;
          if (halfWidth > 0 && posX <= -halfWidth) {
            posX += halfWidth;
          }
          track.style.transform = `translate3d(${posX.toFixed(2)}px, 0, 0)`;
          requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
    }

    // Aceleración reactiva al scrollear (tacto inercial fluido)
    window.addEventListener('scroll', () => {
      const sy = window.scrollY;
      const dy = Math.abs(sy - lastScrollY);
      lastScrollY = sy;

      if (dy > 3) {
        targetSpeed = baseSpeed + Math.min(dy * 0.15, 6);
        clearTimeout((window as any).__amargoMarqueeTimeout);
        (window as any).__amargoMarqueeTimeout = setTimeout(() => {
          targetSpeed = baseSpeed;
        }, 120);
      }
    }, { passive: true });

    // Ejecución inicial y tras hidratación
    setTimeout(measure, 300);
    setTimeout(checkAndDrive, 500);
  })();
</script>
