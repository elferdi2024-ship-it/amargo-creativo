---
// filepath: src/components/Marquee.astro
// Accessible Editorial Marquee:
// - Respects prefers-reduced-motion strictly (static ribbon, zero forced rAF)
// - Includes WCAG 2.2.2 pause/play control without aria-pressed conflict
// - Smooth CSS compositor-only transform
---
<div class="marquee" id="marqueeRoot" role="region" aria-label="Principios de Amargo Creativo">
  <div class="marquee-track" id="marqueeTrack" aria-hidden="true">
    {[0, 1, 2, 3].map(() => (
      <div class="marquee-group">
        <span class="bone-block">APPS A MEDIDA<span class="star">/</span></span>
        <span class="italic">inteligencia artificial</span>
        <span class="mate-block">SUPER-APPS &amp; PWA<span class="star">/</span></span>
        <span>SOFTWARE SAAS</span>
        <span class="rust-block">COMERCIO PROPIO<span class="star">/</span></span>
        <span class="italic">diseño de autor</span>
        <span class="bone-block">PORTALES B2B<span class="star">/</span></span>
        <span>100% TUYO</span>
      </div>
    ))}
  </div>
  <button
    type="button"
    class="marquee-pause-btn"
    id="marqueePauseBtn"
    aria-label="Pausar cinta en movimiento"
    title="Pausar o reanudar movimiento"
  >
    <span class="mp-icon" aria-hidden="true">❚❚</span>
  </button>
</div>

<style>
  .marquee {
    background: var(--marquee-bg);
    color: var(--marquee-text);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    width: 100%;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
  }

  .marquee-track {
    display: flex;
    align-items: stretch;
    width: max-content;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marqueeLoop 32s linear infinite;
    }
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
    .marquee.is-paused .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marqueeLoop {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-group {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .marquee-track span {
    padding: 15px 24px;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(18px, 3vw, 38px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .marquee-track .italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: #11120f;
    background: var(--electric);
    padding-left: 22px;
    padding-right: 22px;
  }

  .marquee-track .bone-block {
    background: var(--bone);
    color: var(--ink);
  }

  .marquee-track .mate-block {
    background: var(--mate);
    color: #f5f3ec;
  }

  .marquee-track .rust-block {
    background: var(--rust);
    color: #f5f3ec;
  }

  .marquee-track .star {
    font-size: 0.72em;
    padding: 0 0 0 10px;
    opacity: 0.45;
  }

  .marquee-pause-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(245, 243, 236, 0.25);
    background: rgba(17, 18, 15, 0.85);
    color: #f5f3ec;
    font-size: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .marquee-pause-btn:hover,
  .marquee-pause-btn:focus-visible {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-pause-btn {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .marquee-track span {
      padding: 12px 16px;
      font-size: clamp(16px, 4vw, 22px);
    }
  }
</style>

<script>
  const marqueeRoot = document.getElementById('marqueeRoot');
  const pauseBtn = document.getElementById('marqueePauseBtn');
  if (marqueeRoot && pauseBtn) {
    let paused = false;
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      marqueeRoot.classList.toggle('is-paused', paused);
      const icon = pauseBtn.querySelector('.mp-icon');
      if (icon) icon.textContent = paused ? '▶' : '❚❚';
      pauseBtn.setAttribute('aria-label', paused ? 'Reanudar cinta en movimiento' : 'Pausar cinta en movimiento');
    });
  }
</script>
