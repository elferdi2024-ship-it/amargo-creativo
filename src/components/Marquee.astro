---
// filepath: src/components/Marquee.astro
// Bullet-proof Mobile & Desktop Marquee (fixes Xiaomi HyperOS / Android battery saver CSS pause + sticky touch :hover)
// - Runs CSS compositor animation by default
// - Self-healing rAF detector: if OS/HyperOS freezes CSS keyframes, smoothly takes over with IO-gated 60/120fps rAF
// - Hover pause strictly scoped to @media (hover: hover) so touch taps never freeze it
// - Always-accessible WCAG 2.2.2 Pause/Play control
---
<div class="marquee" id="marqueeRoot" role="region" aria-label="Especialidades de Amargo Creativo">
  <div class="marquee-track" id="marqueeTrack" aria-hidden="true">
    {[0, 1, 2, 3].map(() => (
      <div class="marquee-group">
        <span class="bone-block">APPS A MEDIDA<span class="star">/</span></span>
        <span class="italic">inteligencia artificial</span>
        <span class="mate-block">SUPER-APPS &amp; PWA<span class="star">/</span></span>
        <span>SOFTWARE SAAS</span>
        <span class="rust-block">COMERCIO PROPIO<span class="star">/</span></span>
        <span class="italic">diseño de autor</span>
        <span class="bone-block">PORTALES B2B<span class="star">/</span></span>
        <span>100% TUYO</span>
      </div>
    ))}
  </div>
  <button
    type="button"
    class="marquee-pause-btn"
    id="marqueePauseBtn"
    aria-label="Pausar cinta en movimiento"
    title="Pausar o reanudar movimiento"
  >
    <span class="mp-icon" aria-hidden="true">❚❚</span>
  </button>
</div>

<style>
  .marquee {
    background: var(--marquee-bg);
    color: var(--marquee-text);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    width: 100%;
    position: relative;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .marquee-track {
    display: flex;
    align-items: stretch;
    width: max-content;
    flex-shrink: 0;
    animation: marqueeLoop 28s linear infinite;
    will-change: transform;
  }

  /* Hover pause ONLY on real mouse pointers (prevents sticky-hover freeze on touch screens!) */
  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  .marquee.is-paused .marquee-track {
    animation-play-state: paused !important;
  }

  @keyframes marqueeLoop {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-group {
    display: flex;
    align-items: stretch;
    flex-shrink: 0;
  }

  .marquee-track span {
    padding: 15px 24px;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(18px, 3vw, 38px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .marquee-track .italic {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: #11120f;
    background: var(--electric);
    padding-left: 22px;
    padding-right: 22px;
  }

  .marquee-track .bone-block {
    background: var(--bone);
    color: var(--ink);
  }

  .marquee-track .mate-block {
    background: var(--mate);
    color: #f5f3ec;
  }

  .marquee-track .rust-block {
    background: var(--rust);
    color: #f5f3ec;
  }

  .marquee-track .star {
    font-size: 0.72em;
    padding: 0 0 0 10px;
    opacity: 0.45;
  }

  .marquee-pause-btn {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(245, 243, 236, 0.28);
    background: rgba(17, 18, 15, 0.86);
    color: #f5f3ec;
    font-size: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), transform 0.15s var(--ease);
  }

  .marquee-pause-btn:active {
    transform: translateY(-50%) scale(0.9);
  }

  @media (hover: hover) {
    .marquee-pause-btn:hover {
      background: var(--electric);
      color: #11120f;
      border-color: var(--electric);
    }
  }

  @media (max-width: 768px) {
    .marquee-track span {
      padding: 12px 16px;
      font-size: clamp(16px, 4vw, 22px);
    }
  }
</style>

<script>
  (function initResilientMarquee() {
    const root = document.getElementById('marqueeRoot');
    const track = document.getElementById('marqueeTrack');
    const pauseBtn = document.getElementById('marqueePauseBtn');
    if (!root || !track) return;

    let userPaused = false;
    let isVisible = true;
    let useRafDriver = false;
    let posX = 0;
    let halfWidth = 0;
    let lastTs = 0;
    let scrollBoost = 0;
    let lastScrollY = window.scrollY;
    let rafId = 0;

    const measure = () => {
      halfWidth = track.scrollWidth / 2;
    };

    const syncPauseBtn = () => {
      root.classList.toggle('is-paused', userPaused);
      if (pauseBtn) {
        const icon = pauseBtn.querySelector('.mp-icon');
        if (icon) icon.textContent = userPaused ? '▶' : '❚❚';
        pauseBtn.setAttribute('aria-label', userPaused ? 'Reanudar cinta en movimiento' : 'Pausar cinta en movimiento');
      }
    };

    pauseBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      syncPauseBtn();
      if (!userPaused && useRafDriver && isVisible && !rafId) {
        lastTs = performance.now();
        rafId = requestAnimationFrame(stepRaf);
      }
    });

    // Subtle inertial speed boost when scrolling on touch/desktop (when rAF driver is active)
    window.addEventListener(
      'scroll',
      () => {
        const sy = window.scrollY;
        const dy = Math.abs(sy - lastScrollY);
        lastScrollY = sy;
        if (dy > 2) scrollBoost = Math.min(220, scrollBoost + dy * 2.2);
      },
      { passive: true }
    );

    function stepRaf(now: number) {
      rafId = 0;
      if (!useRafDriver || userPaused || !isVisible) return;
      const dt = Math.min(0.05, Math.max(0.004, (now - lastTs) / 1000));
      lastTs = now;
      if (!halfWidth) measure();

      const basePxPerSec = window.innerWidth < 768 ? 58 : 74;
      scrollBoost *= 0.9;
      posX -= (basePxPerSec + scrollBoost) * dt;
      if (halfWidth > 0 && posX <= -halfWidth) {
        posX += halfWidth;
      }
      track.style.transform = `translate3d(${posX.toFixed(1)}px, 0, 0)`;
      rafId = requestAnimationFrame(stepRaf);
    }

    function activateRafFallback() {
      if (useRafDriver) return;
      useRafDriver = true;
      measure();
      track.style.animation = 'none';
      lastTs = performance.now();
      if (!userPaused && isVisible) {
        rafId = requestAnimationFrame(stepRaf);
      }
    }

    // Pause rAF when scrolled off-screen (zero battery drain!)
    new IntersectionObserver((entries) => {
      isVisible = entries[0]?.isIntersecting ?? true;
      if (useRafDriver && isVisible && !userPaused && !rafId) {
        lastTs = performance.now();
        rafId = requestAnimationFrame(stepRaf);
      }
    }).observe(root);

    window.addEventListener('resize', measure, { passive: true });
    measure();

    // Real motion detector: sample CSS transform twice; if OS/HyperOS froze CSS keyframes, take over with rAF!
    setTimeout(() => {
      if (userPaused || useRafDriver) return;
      const t1 = getComputedStyle(track).transform;
      setTimeout(() => {
        if (userPaused || useRafDriver || !isVisible) return;
        const t2 = getComputedStyle(track).transform;
        if (t1 === t2) {
          activateRafFallback();
        }
      }, 240);
    }, 350);
  })();
</script>
