---
// filepath: src/components/Metrics.astro
// Métricas & Impacto: Tipografía brutalista, cero saturación de texto y diseño arquitectónico

interface Metric {
  num: string;
  label: string;
  desc: string;
}

const metrics: Metric[] = [
  {
    num: "VENTAS",
    label: "CONVERSIÓN DIRECTA",
    desc: "Embudos 1-click a WhatsApp sin fricción para cerrar clientes en minutos."
  },
  {
    num: "< 0.8s",
    label: "CARGA INSTANTÁNEA",
    desc: "Apertura récord en cualquier celular sin esperas ni caídas de rebote."
  },
  {
    num: "GOOGLE",
    label: "SEO & POSICIONAMIENTO",
    desc: "Visibilidad orgánica en Uruguay, Argentina y España con datos estructurados."
  },
  {
    num: "100%",
    label: "ACTIVO PROPIO",
    desc: "Código de autor, dominio y bases de datos 100% tuyos sin alquileres cautivos."
  }
];
---
<section class="metrics-impact">
  <div class="graphic-mark" aria-hidden="true">+</div>
  <div class="mi-inner">
    <div class="mi-head">
      <div class="section-label">
        <span class="num">05</span>
        <span>ESTRATEGIA &bull; IMPACTO</span>
      </div>
      <h2>Estrategia. <em>Sin vueltas.</em></h2>
      <p class="mi-tagline">Rendimiento extremo, diseño radical y conversión directa.</p>
      
      <div class="mi-stamp-badge" aria-hidden="true">
        <span class="stamp-dot">●</span>
        <span>ESTÁNDAR AMARGO &bull; 0.0s LATENCY</span>
      </div>
    </div>
    
    <div class="mi-cards">
      {metrics.map(metric => (
        <div class="mi-card">
          <div class="mi-card-top">
            <div class="mi-num">{metric.num}</div>
            <div class="mi-label">{metric.label}</div>
          </div>
          <div class="mi-desc">{metric.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics-impact {
    background: var(--marquee-bg);
    color: var(--marquee-text);
    padding: clamp(90px, 13vh, 160px) var(--gut);
    border-bottom: 1px solid var(--marquee-bg);
    width: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }
  .metrics-impact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.15) 1px, transparent 1px);
    background-size: 24px 24px;
    z-index: 0;
    opacity: 0.2;
    mask-image: linear-gradient(to right, black, transparent 70%);
    -webkit-mask-image: linear-gradient(to right, black, transparent 70%);
    pointer-events: none;
  }
  :global(body.theme-electric) .metrics-impact::before {
    background-image: radial-gradient(rgba(241, 255, 90, 0.2) 1px, transparent 1px);
  }
  :global(body.theme-mate) .metrics-impact::before {
    background-image: radial-gradient(rgba(151, 188, 98, 0.2) 1px, transparent 1px);
  }
  .mi-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(244, 241, 234, 0.7);
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 20px;
    font-family: 'JetBrains Mono', monospace;
  }
  .section-label .num {
    color: #0a0a0a;
    font-weight: 700;
    background: var(--electric);
    padding: 3px 8px;
    border-radius: 2px;
  }
  .mi-head h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 68px);
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0 0 16px;
    letter-spacing: -0.025em;
  }
  .mi-head h2 em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
  }
  .mi-tagline {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(244, 241, 234, 0.85);
    margin: 0 0 24px;
    max-width: 360px;
  }
  :global(body.theme-electric) .mi-tagline {
    color: rgba(241, 255, 90, 0.9);
  }

  .mi-stamp-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--electric);
    padding: 6px 12px;
    border: 1px solid rgba(212, 255, 0, 0.3);
    background: rgba(212, 255, 0, 0.05);
  }
  .stamp-dot {
    font-size: 8px;
  }

  .mi-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  :global(body.theme-electric) .mi-cards {
    background: rgba(241, 255, 90, 0.15);
    border: 1px solid rgba(241, 255, 90, 0.25);
  }
  :global(body.theme-mate) .mi-cards {
    background: rgba(151, 188, 98, 0.15);
    border: 1px solid rgba(151, 188, 98, 0.25);
  }
  .mi-card {
    background: var(--marquee-bg);
    padding: clamp(24px, 3.2vw, 36px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
    cursor: default;
    position: relative;
  }
  .mi-card:hover {
    background: var(--electric);
    color: #0a0a0a;
  }
  .mi-card:hover .mi-num {
    color: #0a0a0a;
  }
  .mi-card:hover .mi-label {
    color: #0a0a0a;
  }
  .mi-card:hover .mi-desc {
    color: rgba(10, 10, 10, 0.85);
  }
  .mi-num {
    font-family: 'Anton', sans-serif;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1;
    color: var(--electric);
    transition: color 0.3s;
  }
  .mi-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(244, 241, 234, 0.95);
    font-weight: 700;
    margin-top: 6px;
    transition: color 0.3s;
  }
  .mi-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(244, 241, 234, 0.8);
    transition: color 0.3s;
  }
  @media (min-width: 600px) {
    .mi-cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 900px) {
    .metrics-impact {
      padding: clamp(64px, 10vh, 100px) var(--gut);
    }
    .mi-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  .metrics-impact .graphic-mark {
    position: absolute;
    bottom: -10%;
    left: -5%;
    font-size: 35vw;
    line-height: 1;
    color: rgba(255, 255, 255, 0.03);
    pointer-events: none;
    font-family: 'Space Grotesk', sans-serif;
  }
</style>
