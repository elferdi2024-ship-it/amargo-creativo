---
// filepath: src/components/Metrics.astro
// Architectural 2x2 Swiss Bento Grid (even on Mobile — fits cleanly in 1 viewport!)
interface Metric {
  num: string;
  label: string;
  desc: string;
}

const metrics: Metric[] = [
  {
    num: "APPS & IA",
    label: "SOFTWARE A MEDIDA",
    desc: "Escáneres IA, super-apps de delivery, mapas en vivo y portales B2B."
  },
  {
    num: "0% FEE",
    label: "CANAL PROPIO",
    desc: "Vendé directo por web y WhatsApp sin regalar 30% en comisiones."
  },
  {
    num: "100%",
    label: "ACTIVO TUYO",
    desc: "Código, datos y nube a tu nombre. Cero dependencias cautivas."
  },
  {
    num: "END-TO-END",
    label: "IDEA A PRODUCCIÓN",
    desc: "Diseño, ingeniería, SEO y despliegue en un solo equipo directo."
  }
];
---
<section class="metrics-impact">
  <div class="mi-inner">
    <div class="mi-head">
      <div class="section-label">
        <span class="num">04</span>
        <span>PRODUCTO &bull; IMPACTO</span>
      </div>
      <h2 data-reveal-words>Software real. <em>Sin vueltas.</em></h2>
      <p class="mi-tagline">Apps, herramientas operativas y diseño de autor que generan retorno.</p>
    </div>

    <div class="mi-cards">
      {metrics.map((metric, i) => (
        <article class="mi-card" data-reveal-block style={`--rd:${i * 60}ms`}>
          <div class="mi-num tabular">{metric.num}</div>
          <div class="mi-label">{metric.label}</div>
          <p class="mi-desc">{metric.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics-impact {
    background: var(--marquee-bg);
    color: var(--marquee-text);
    padding: clamp(64px, 11vh, 136px) var(--gut);
    border-bottom: 1px solid rgba(245, 243, 236, 0.12);
    width: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .metrics-impact::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(245, 243, 236, 0.14) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.18;
    mask-image: linear-gradient(to right, black, transparent 72%);
    -webkit-mask-image: linear-gradient(to right, black, transparent 72%);
    pointer-events: none;
  }

  .mi-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .section-label {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(245, 243, 236, 0.68);
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 16px;
    font-family: var(--font-mono);
  }

  .section-label .num {
    color: #11120f;
    font-weight: 700;
    background: var(--electric);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .mi-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 4.4vw, 64px);
    line-height: 0.94;
    text-transform: uppercase;
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }

  .mi-head h2 em {
    font-family: var(--font-serif);
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--electric);
  }

  .mi-tagline {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
    color: rgba(245, 243, 236, 0.78);
    max-width: 34ch;
  }

  .mi-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(245, 243, 236, 0.14);
    border: 1px solid rgba(245, 243, 236, 0.14);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .mi-card {
    background: var(--marquee-bg);
    padding: clamp(18px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: background-color 0.28s var(--ease), color 0.28s var(--ease);
  }

  .mi-card:hover {
    background: var(--electric);
    color: #11120f;
  }

  .mi-card:hover .mi-num,
  .mi-card:hover .mi-label {
    color: #11120f;
  }

  .mi-card:hover .mi-desc {
    color: rgba(17, 18, 15, 0.8);
  }

  .mi-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(22px, 3.2vw, 42px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--electric);
  }

  .mi-label {
    font-family: var(--font-mono);
    font-size: clamp(9px, 1vw, 10.5px);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 243, 236, 0.94);
    font-weight: 700;
    margin-top: 2px;
  }

  .mi-desc {
    font-family: var(--font-body);
    font-size: clamp(12px, 1.1vw, 13.5px);
    line-height: 1.45;
    color: rgba(245, 243, 236, 0.72);
    margin-top: 4px;
  }

  @media (max-width: 860px) {
    .metrics-impact {
      padding: 56px var(--gut);
    }
    .mi-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .mi-card {
      padding: 18px 14px;
    }
  }
</style>
