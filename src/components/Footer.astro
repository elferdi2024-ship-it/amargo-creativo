---
// filepath: src/components/Footer.astro
// Architectural Awwwards Footer: Fixed HTML structure, monumental signature, clean 3-column grid
---
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a href="#top" class="footer-wordmark" aria-label="Volver al inicio de Amargo Creativo">
          AMARGO<span class="wm-dot">.</span>
        </a>
        <p class="footer-phrase">
          <em>"Siempre es una buena hora para compartir un amargo."</em>
        </p>
        <div class="clock-block">
          <span>HORA EN ATLÁNTIDA, UY</span>
          <strong id="clockUY" class="tabular">--:--:--</strong>
        </div>
      </div>

      <div class="footer-nav-col">
        <h3 class="footer-col-title">NAVEGACIÓN</h3>
        <nav class="footer-links" aria-label="Enlaces del pie de página">
          <a href="/proyectos">Proyectos &amp; Casos</a>
          <a href="/servicios-crecimiento">Servicios &amp; CRO</a>
          <a href="/facturacion">Sistemas B2B</a>
          <a href="/manifiesto">Manifiesto &amp; Método</a>
        </nav>
      </div>

      <div class="footer-contact-col">
        <h3 class="footer-col-title">CONTACTO DIRECTO</h3>
        <div class="footer-links">
          <a
            href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-wa-pill"
            data-cursor="WHATSAPP"
          >
            WHATSAPP +598 98 300 491 ↗
          </a>
          <a href="mailto:amargo.creativo@gmail.com">amargo.creativo@gmail.com</a>
          <a
            href="https://www.instagram.com/amargocreativo"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram @amargocreativo ↗
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copy">
        © 2026 AMARGO CREATIVO™ &mdash; ATLÁNTIDA, CANELONES, URUGUAY &bull; ARGENTINA &bull; ESPAÑA
      </div>
      <div class="footer-meta-right">
        <span class="footer-stack">PRODUCT STUDIO &bull; APPS &bull; IA &bull; WEB</span>
        <a href="#top" class="back-top-btn" data-cursor="SUBIR" aria-label="Volver arriba">
          ARRIBA ↑
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-text);
    padding: clamp(56px, 8vh, 96px) var(--gut) calc(44px + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(245, 243, 236, 0.12);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(245, 243, 236, 0.14) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.08;
    mask-image: linear-gradient(to top, black, transparent 82%);
    -webkit-mask-image: linear-gradient(to top, black, transparent 82%);
    pointer-events: none;
  }

  .footer-container {
    max-width: var(--max);
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 5vw, 56px);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--footer-text);
    text-decoration: none;
    display: inline-block;
    width: fit-content;
  }

  .wm-dot {
    color: var(--electric);
  }

  .footer-phrase em {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--mate-light);
    font-weight: 400;
  }

  .clock-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
  }

  .clock-block span {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    color: rgba(245, 243, 236, 0.56);
  }

  .clock-block strong {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--footer-text);
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 243, 236, 0.52);
    margin-bottom: 16px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .footer-links a {
    color: rgba(245, 243, 236, 0.88);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 14.5px;
    transition: color 0.2s var(--ease), transform 0.25s var(--ease);
  }

  .footer-links a:hover {
    color: var(--electric);
    transform: translate3d(4px, 0, 0);
  }

  .footer-wa-pill {
    display: inline-flex;
    align-items: center;
    background: var(--electric);
    color: #11120f !important;
    font-family: var(--font-mono) !important;
    font-size: 10.5px !important;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 4px;
  }

  .footer-wa-pill:hover {
    background: #ffffff;
    color: #11120f !important;
    transform: translate3d(0, -2px, 0) !important;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(245, 243, 236, 0.12);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(245, 243, 236, 0.6);
  }

  .footer-meta-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-stack {
    color: var(--mate-light);
    font-weight: 600;
  }

  .back-top-btn {
    color: var(--footer-text);
    text-decoration: none;
    border: 1px solid rgba(245, 243, 236, 0.22);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-weight: 700;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .back-top-btn:hover {
    background: var(--electric);
    color: #11120f;
    border-color: var(--electric);
  }

  @media (max-width: 820px) {
    .site-footer {
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
