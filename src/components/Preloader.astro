---
// filepath: src/components/Preloader.astro
// Session-smart editorial ritual preloader:
// - Runs ONCE per browser session on first arrival (~380ms max, never traps LCP on navigation)
// - Skips immediately on internal transitions, bots, or prefers-reduced-motion
---
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="pre-top">
    <span>AMARGO CREATIVO™</span>
    <span class="pre-temp">80°C • CEBANDO EN EDGE</span>
  </div>
  <div class="pre-center">
    <div class="pre-bg-text">amargo</div>
    <div class="pre-counter tabular" id="preCounter">00</div>
    <div class="pre-bar-track"><div class="pre-bar-fill" id="preBarFill"></div></div>
  </div>
  <div class="pre-bottom">
    <span>ATLÁNTIDA, UY</span>
    <span>ASTRO 5 &bull; CLOUDFLARE EDGE &bull; &lt;0.8s</span>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    background: var(--mate-deep);
    color: #f5f3ec;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.62s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s linear 0.62s;
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    contain: strict;
    pointer-events: auto;
  }

  .preloader.done {
    transform: translate3d(0, -102%, 0);
    visibility: hidden;
    pointer-events: none;
  }

  .preloader.instant-done {
    display: none !important;
  }

  .pre-top,
  .pre-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px var(--gut);
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(245, 243, 236, 0.72);
    z-index: 2;
  }

  .pre-temp {
    color: var(--electric);
    font-weight: 700;
  }

  .pre-bottom {
    border-top: 1px solid rgba(245, 243, 236, 0.14);
  }

  .pre-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    position: relative;
  }

  .pre-counter {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(72px, 18vw, 220px);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: #f5f3ec;
    z-index: 2;
    user-select: none;
  }

  .pre-bar-track {
    width: min(260px, 60vw);
    height: 2px;
    background: rgba(245, 243, 236, 0.18);
    overflow: hidden;
    z-index: 2;
  }

  .pre-bar-fill {
    width: 100%;
    height: 100%;
    background: var(--electric);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.08s linear;
  }

  .pre-bg-text {
    position: absolute;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(90px, 24vw, 300px);
    color: var(--mate-light);
    opacity: 0.16;
    pointer-events: none;
    z-index: 1;
    text-transform: lowercase;
    line-height: 1;
    letter-spacing: -0.02em;
    user-select: none;
  }
</style>

<script is:inline>
  (function() {
    var preloader = document.getElementById('preloader');
    var preCounter = document.getElementById('preCounter');
    var preBar = document.getElementById('preBarFill');
    if (!preloader) return;

    var isBot = /Lighthouse|PageSpeed|Chrome-Lighthouse|PTST|Googlebot/i.test(navigator.userAgent);
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var alreadySeen = false;
    try {
      alreadySeen = sessionStorage.getItem('amargo_pre_seen') === '1';
    } catch (e) {}

    if (isBot || reduced || alreadySeen) {
      preloader.classList.add('instant-done');
      document.body.classList.add('loaded');
      return;
    }

    try {
      sessionStorage.setItem('amargo_pre_seen', '1');
    } catch (e) {}

    var start = performance.now();
    var duration = 420;

    function tick(now) {
      var t = Math.min(1, (now - start) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      var pct = Math.round(eased * 100);
      if (preCounter) preCounter.textContent = String(pct).padStart(2, '0');
      if (preBar) preBar.style.transform = 'scaleX(' + eased.toFixed(3) + ')';

      if (t < 1) {
        requestAnimationFrame(tick);
      } else {
        setTimeout(function() {
          preloader.classList.add('done');
          document.body.classList.add('loaded');
        }, 90);
      }
    }

    requestAnimationFrame(tick);
  })();
</script>
