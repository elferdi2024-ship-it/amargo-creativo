---
// filepath: src/components/Preloader.astro
---
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="pre-top">
    <span>AMARGO CREATIVO™</span>
    <span>CARGANDO MOTOR...</span>
  </div>
  <div class="pre-center">
    <div class="pre-bg-text">amargo</div>
    <div class="pre-counter" id="preCounter">00</div>
  </div>
  <div class="pre-bottom">
    <div class="pre-marquee">ATLÁNTIDA — CANELONES — URUGUAY — MOTORES DIGITALES — DISEÑO WEB — APPS — VENTAS — CRECIMIENTO — </div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 10001;
    background: var(--hero-bg);
    color: var(--hero-text);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.8s var(--ease-emphasis);
    overflow: hidden;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
    will-change: transform;
  }
  .preloader.done {
    transform: translateY(-100%);
    pointer-events: none;
  }
  .pre-top {
    display: flex;
    justify-content: space-between;
    padding: 24px var(--gut);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mate-light);
    z-index: 2;
    font-weight: 500;
  }
  :global(body.theme-electric) .pre-top {
    color: #888880;
  }
  .pre-center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.4s var(--ease), opacity 0.4s var(--ease);
  }
  .pre-counter {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(80px, 25vw, 300px);
    line-height: 0.8;
    color: var(--hero-text);
    z-index: 2;
    mix-blend-mode: exclusion;
    user-select: none;
  }
  .pre-bg-text {
    position: absolute;
    bottom: 8%;
    left: 0;
    width: 100%;
    text-align: center;
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(60px, 22vw, 280px);
    color: var(--mate-light);
    opacity: 0.35;
    pointer-events: none;
    z-index: 1;
    text-transform: lowercase;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  :global(body.theme-electric) .pre-bg-text {
    color: var(--electric);
    opacity: 0.25;
  }
  .pre-bottom {
    padding: 24px var(--gut);
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    width: 100%;
  }
  .pre-marquee {
    display: inline-block;
    animation: preMarquee 20s linear infinite;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hero-text);
    opacity: 0.7;
    will-change: transform;
  }
  @keyframes preMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
