---
// filepath: src/components/InstagramFeed.astro

export interface InstagramPost {
  id: string;
  img: string;
  caption: string;
  likes: string;
  comments: string;
  category: string;
  date: string;
  url: string;
}

const instagramUrl = "https://www.instagram.com/amargocreativo?igsi=MTU5Y2NmYnAzNXUwZQ%3D%3D";

const posts: InstagramPost[] = [
  {
    id: "post-1",
    img: "/instagram/post-1.jpg",
    category: "STUDIO RITUAL",
    date: "HACE 2 DÍAS",
    caption: "El ritual del amargo antes de cada gran deploy a producción. Código artesanal y rendimiento sin compromisos.",
    likes: "342",
    comments: "28",
    url: instagramUrl
  },
  {
    id: "post-2",
    img: "/instagram/post-2.jpg",
    category: "FILOSOFÍA AMARGO",
    date: "HACE 4 DÍAS",
    caption: "Menos burocracia, más código de élite. Filosofía del mate aplicada a la arquitectura de software de alta velocidad.",
    likes: "418",
    comments: "35",
    url: instagramUrl
  },
  {
    id: "post-3",
    img: "/instagram/post-3.jpg",
    category: "UI/UX & PERFORMANCE",
    date: "HACE 1 SEMANA",
    caption: "100/100 Lighthouse o nada. Diseñamos experiencias visuales inmersivas con tiempos de carga sub-segundo.",
    likes: "512",
    comments: "44",
    url: instagramUrl
  },
  {
    id: "post-4",
    img: "/instagram/post-4.jpg",
    category: "FOOD TECH LAUNCH",
    date: "HACE 1 SEMANA",
    caption: "Lanzamiento Legendary Burger: constructor interactivo de hamburguesas en tiempo real con checkout directo a WhatsApp.",
    likes: "296",
    comments: "19",
    url: instagramUrl
  },
  {
    id: "post-5",
    img: "/instagram/post-5.jpg",
    category: "EDITORIAL DESIGN",
    date: "HACE 2 SEMANAS",
    caption: "Curaduría visual y dirección de arte para marcas de alto impacto desde Atlántida, Costa de Oro.",
    likes: "380",
    comments: "26",
    url: instagramUrl
  },
  {
    id: "post-6",
    img: "/instagram/post-6.jpg",
    category: "CREATIVE TECH",
    date: "HACE 3 SEMANAS",
    caption: "Explorando nuevas fronteras en micro-animaciones, WebGL e interfaces reactivas de alta tensión.",
    likes: "465",
    comments: "39",
    url: instagramUrl
  }
];
---
<section class="ig-section" id="instagram">
  <div class="ig-container">
    <div class="ig-head">
      <div class="ig-head-left">
        <div class="section-label"><span class="num">10</span> COMUNIDAD DIGITAL</div>
        <h2 class="ig-title">NUESTRO <em>instagram</em></h2>
      </div>
      <div class="ig-head-right">
        <a 
          href={instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="ig-handle-badge"
          data-cursor="SEGUIR"
        >
          <svg class="ig-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="ig-handle-text">@amargocreativo</span>
          <span class="ig-live-dot" aria-hidden="true"></span>
        </a>
        <div class="ig-sub-info">Cultura, diseño & código en tiempo real</div>
      </div>
    </div>

    <div class="ig-grid">
      {posts.map((post) => (
        <a 
          href={post.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="ig-card" 
          data-cursor="VER IG"
          aria-label={`Post de Instagram: ${post.caption}`}
        >
          <div class="ig-media-wrap">
            <img 
              src={post.img} 
              alt={post.caption} 
              class="ig-img" 
              loading="lazy" 
              width="600" 
              height="600" 
            />
            <div class="ig-overlay">
              <div class="ig-overlay-top">
                <span class="ig-tag">{post.category}</span>
                <span class="ig-date">{post.date}</span>
              </div>
              <p class="ig-caption">{post.caption}</p>
              <div class="ig-overlay-bottom">
                <div class="ig-stats">
                  <span class="ig-stat">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    {post.likes}
                  </span>
                  <span class="ig-stat">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18z"/></svg>
                    {post.comments}
                  </span>
                </div>
                <div class="ig-arrow-btn">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M7 17L17 7M7 7h10v10"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="ig-corner-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="ig-cta-banner">
      <div class="ig-cta-content">
        <div class="ig-cta-text">
          <h3>¿QUERÉS VER MÁS DEL PROCESO?</h3>
          <p>Compartimos lanzamientos semanales, trucos de desarrollo, directos y reflexiones sobre el mundo digital.</p>
        </div>
        <a 
          href={instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="ig-cta-btn"
          data-cursor="INSTAGRAM"
        >
          <span>SEGUIR @AMARGOCREATIVO</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M7 17L17 7M7 7h10v10"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ig-section {
    background: var(--bg);
    color: var(--ink);
    padding: clamp(60px, 10vh, 120px) var(--gut);
    border-top: 1px solid var(--line);
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  .ig-container {
    max-width: var(--max);
    margin: 0 auto;
    width: 100%;
  }
  .ig-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 24px;
  }
  .section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }
  .section-label .num {
    color: var(--bone);
    font-weight: 700;
    background: var(--mate);
    padding: 4px 8px;
  }
  :global(body.theme-electric) .section-label .num {
    background: var(--electric);
    color: #0a0a0a;
  }
  .ig-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 7vw, 110px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .ig-title em {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    text-transform: lowercase;
    font-weight: 400;
    color: var(--rust);
  }
  .ig-head-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .ig-handle-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: all 0.3s var(--ease);
  }
  .ig-handle-badge:hover {
    background: var(--ink);
    color: var(--bone);
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  :global(body.theme-electric) .ig-handle-badge:hover {
    background: var(--electric);
    color: #0a0a0a;
    border-color: var(--electric);
  }
  .ig-icon {
    width: 16px;
    height: 16px;
    color: var(--rust);
    transition: transform 0.3s var(--ease);
  }
  :global(body.theme-electric) .ig-icon {
    color: var(--electric);
  }
  .ig-handle-badge:hover .ig-icon {
    transform: scale(1.15) rotate(5deg);
    color: inherit;
  }
  .ig-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: igPulse 2s infinite ease-in-out;
  }
  @keyframes igPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .ig-sub-info {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
    text-align: right;
  }
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }
  .ig-card {
    position: relative;
    border: 1px solid var(--line);
    background: var(--charcoal);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    aspect-ratio: 1 / 1;
    display: block;
    cursor: pointer;
  }
  .ig-media-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .ig-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease), filter 0.5s var(--ease);
    filter: grayscale(10%) contrast(105%);
  }
  .ig-card:hover .ig-img {
    transform: scale(1.08);
    filter: grayscale(0%) contrast(110%);
  }
  .ig-corner-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    z-index: 2;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .ig-corner-icon svg {
    width: 16px;
    height: 16px;
  }
  .ig-card:hover .ig-corner-icon {
    opacity: 0;
    transform: scale(0.8);
  }
  .ig-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(8px);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease), visibility 0.4s;
    z-index: 3;
    color: #f4f1ea;
  }
  .ig-card:hover .ig-overlay {
    opacity: 1;
    visibility: visible;
  }
  .ig-overlay-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .ig-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--electric);
    background: rgba(255, 255, 255, 0.08);
    padding: 4px 8px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .ig-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(244, 241, 234, 0.6);
  }
  .ig-caption {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(12px, 1.2vw, 15px);
    line-height: 1.45;
    color: #ffffff;
    font-weight: 500;
    margin: 12px 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ig-overlay-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 14px;
  }
  .ig-stats {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .ig-stat {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    color: #f4f1ea;
  }
  .ig-stat svg {
    width: 15px;
    height: 15px;
    color: var(--rust);
  }
  .ig-arrow-btn {
    width: 36px;
    height: 36px;
    background: var(--electric);
    color: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transform: translate(10px, 10px);
    opacity: 0;
    transition: all 0.3s var(--ease-emphasis);
  }
  .ig-arrow-btn svg {
    width: 18px;
    height: 18px;
  }
  .ig-card:hover .ig-arrow-btn {
    transform: translate(0, 0);
    opacity: 1;
  }
  .ig-cta-banner {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0a0a0a;
    padding: clamp(28px, 4vw, 48px);
    position: relative;
    overflow: hidden;
    color: #ffffff;
    border-radius: 2px;
  }
  :global(body.theme-electric) .ig-cta-banner {
    background: #000000;
    border-color: #2e3010;
  }
  :global(body.theme-mate) .ig-cta-banner {
    background: #070d09;
    border-color: #223727;
  }
  .ig-cta-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--rust), var(--electric), var(--mate));
  }
  .ig-cta-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    position: relative;
    z-index: 1;
  }
  .ig-cta-text h3 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(20px, 2.8vw, 36px);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 8px;
    color: #ffffff;
  }
  :global(body.theme-electric) .ig-cta-text h3 {
    color: #f1ff5a;
  }
  .ig-cta-text p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    color: rgba(244, 241, 234, 0.85);
    max-width: 580px;
    line-height: 1.55;
  }
  :global(body.theme-electric) .ig-cta-text p {
    color: rgba(241, 255, 90, 0.8);
  }
  .ig-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--electric);
    color: #0a0a0a;
    padding: 16px 28px;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--electric);
    transition: all 0.35s var(--ease);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
  }
  .ig-cta-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s var(--ease);
  }
  .ig-cta-btn:hover {
    background: #ffffff;
    color: #0a0a0a;
    border-color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(212, 255, 0, 0.28);
  }
  .ig-cta-btn:hover svg {
    transform: translate(3px, -3px);
  }
  .ig-cta-btn:active {
    transform: scale(0.98);
  }

  @media (max-width: 900px) {
    .ig-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .ig-head {
      flex-direction: column;
      align-items: flex-start;
    }
    .ig-head-right {
      align-items: flex-start;
      width: 100%;
    }
    .ig-sub-info {
      text-align: left;
    }
    .ig-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .ig-cta-banner {
      padding: 28px 16px;
    }
    .ig-cta-text h3 {
      font-size: clamp(18px, 5vw, 26px);
      line-height: 1.15;
      overflow-wrap: break-word;
    }
    .ig-cta-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .ig-cta-btn {
      width: 100%;
      justify-content: center;
      padding: 14px 12px;
      font-size: 11px;
      letter-spacing: 0.03em;
      gap: 8px;
      box-sizing: border-box;
    }
    .ig-cta-btn svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }
  }
</style>
