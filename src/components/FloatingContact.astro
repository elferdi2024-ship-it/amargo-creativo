---
// filepath: src/components/FloatingContact.astro
// Non-intrusive, thumb-ergonomic WhatsApp conversion pill (hides near Contact section)
---
<div class="floating-contact" id="floatingContact" aria-hidden="true">
  <a
    href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto"
    target="_blank"
    rel="noopener noreferrer"
    class="fc-btn"
    id="fcBtn"
    data-cursor="WHATSAPP"
    aria-label="Hablar directamente por WhatsApp con Amargo Creativo"
  >
    <span class="fc-status-dot" aria-hidden="true"></span>
    <span class="fc-text">
      <strong>WHATSAPP</strong>
      <span class="fc-extra">DIRECTO</span>
    </span>
    <span class="fc-arrow" aria-hidden="true">↗</span>
  </a>
</div>

<script>
  function initFloatingContact() {
    const fc = document.getElementById('floatingContact');
    if (!fc) return;
    const contactSection = document.getElementById('contact');
    const footerSection = document.querySelector('footer');
    let hideZoneInView = false;
    let contactVisible = false;
    let footerVisible = false;
    let isVisible = false;

    const syncZone = () => {
      hideZoneInView = contactVisible || footerVisible;
      checkVisibility();
    };

    if (contactSection) {
      new IntersectionObserver(
        (entries) => {
          contactVisible = entries[0]?.isIntersecting ?? false;
          syncZone();
        },
        { threshold: 0.1 }
      ).observe(contactSection);
    }

    if (footerSection) {
      new IntersectionObserver(
        (entries) => {
          footerVisible = entries[0]?.isIntersecting ?? false;
          syncZone();
        },
        { threshold: 0.05 }
      ).observe(footerSection);
    }

    function checkVisibility() {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const shouldShow = scrollY > 420 && !hideZoneInView;
      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        fc.classList.toggle('visible', shouldShow);
        fc.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
      }
    }

    window.addEventListener('scroll', checkVisibility, { passive: true });
    checkVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingContact);
  } else {
    initFloatingContact();
  }
</script>

<style>
  .floating-contact {
    position: fixed;
    bottom: calc(20px + env(safe-area-inset-bottom));
    right: clamp(16px, 3vw, 28px);
    z-index: var(--z-float);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(0, 18px, 0) scale(0.95);
    transition: opacity 0.35s var(--ease), transform 0.38s var(--ease-emphasis);
  }

  .floating-contact.visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    pointer-events: auto;
  }

  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--mate-deep);
    color: #f5f3ec;
    border: 1px solid rgba(210, 246, 56, 0.45);
    border-radius: var(--radius-pill);
    padding: 11px 18px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 12px 30px rgba(17, 18, 15, 0.28);
    transition:
      transform 0.28s var(--ease-emphasis),
      box-shadow 0.28s var(--ease),
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .fc-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--electric);
    box-shadow: 0 0 8px var(--electric);
    flex-shrink: 0;
  }

  .fc-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .fc-text strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.03em;
  }

  .fc-extra {
    color: rgba(245, 243, 236, 0.65);
    font-size: 9.5px;
  }

  .fc-arrow {
    color: var(--electric);
    font-weight: 700;
    transition: transform 0.25s var(--ease);
  }

  .fc-btn:hover {
    background: var(--electric);
    color: #11120f;
    border-color: #11120f;
    transform: translate3d(0, -2px, 0);
    box-shadow: 0 16px 36px rgba(17, 18, 15, 0.34);
  }

  .fc-btn:hover .fc-extra,
  .fc-btn:hover .fc-arrow {
    color: #11120f;
  }

  .fc-btn:hover .fc-status-dot {
    background: var(--mate);
    box-shadow: none;
  }

  .fc-btn:hover .fc-arrow {
    transform: translate3d(2px, -2px, 0);
  }

  .fc-btn:active {
    transform: scale(0.96);
  }

  @media (max-width: 600px) {
    .floating-contact {
      bottom: calc(16px + env(safe-area-inset-bottom));
      right: 14px;
    }
    .fc-extra {
      display: none;
    }
    .fc-btn {
      padding: 10px 14px;
    }
  }
</style>
