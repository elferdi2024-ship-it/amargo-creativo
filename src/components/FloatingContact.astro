---
// filepath: src/components/FloatingContact.astro
---
<div class="floating-contact" id="floatingContact" aria-hidden="true">
  <a 
    href="https://wa.me/59898300491?text=Hola%20Amargo%20Creativo,%20quiero%20cotizar%20un%20proyecto" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="fc-btn"
    id="fcBtn"
    data-cursor="WHATSAPP"
    aria-label="Hablar directamente por WhatsApp con Amargo Creativo"
  >
    <span class="fc-status-dot" aria-hidden="true"></span>
    <span class="fc-text">
      <strong>HABLEMOS</strong>
      <span class="fc-extra">• WHATSAPP DIRECTO</span>
    </span>
    <span class="fc-arrow" aria-hidden="true">↗</span>
  </a>
</div>

<script>
  function initFloatingContact() {
    const fc = document.getElementById('floatingContact');
    if (!fc) return;

    let isVisible = false;

    function checkVisibility() {
      const scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      if (scrollY > 260) {
        if (!isVisible) {
          fc.classList.add('visible');
          fc.setAttribute('aria-hidden', 'false');
          isVisible = true;
        }
      } else {
        if (isVisible) {
          fc.classList.remove('visible');
          fc.setAttribute('aria-hidden', 'true');
          isVisible = false;
        }
      }
    }

    window.addEventListener('scroll', checkVisibility, { passive: true });
    if ((window as any).lenis?.on) {
      (window as any).lenis.on('scroll', checkVisibility);
    }
    checkVisibility();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingContact);
  } else {
    initFloatingContact();
  }
</script>

<style>
  .floating-contact {
    position: fixed;
    bottom: calc(24px + env(safe-area-inset-bottom));
    right: clamp(16px, 3vw, 32px);
    z-index: 95;
    pointer-events: none;
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
    will-change: transform, opacity;
  }

  .floating-contact.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--bone);
    border: 1px solid var(--line);
    padding: 10px 18px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0px var(--electric);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), background 0.25s, color 0.25s;
    will-change: transform;
    border-radius: 0px;
  }

  :global(body.theme-electric) .fc-btn {
    background: var(--electric);
    color: #0a0a0a;
    box-shadow: 4px 4px 0px #0a0a0a;
    border-color: #0a0a0a;
  }

  :global(body.theme-mate) .fc-btn {
    box-shadow: 4px 4px 0px var(--mate-light);
  }

  .fc-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00ff66;
    display: inline-block;
    flex-shrink: 0;
    box-shadow: 0 0 8px #00ff66;
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .fc-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .fc-text strong {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .fc-extra {
    color: var(--mute);
    font-size: 10px;
    transition: color 0.2s;
  }

  :global(body.theme-electric) .fc-extra {
    color: rgba(10, 10, 10, 0.7);
  }

  .fc-arrow {
    font-weight: 700;
    color: var(--electric);
    font-size: 13px;
    transition: transform 0.3s var(--ease);
  }

  :global(body.theme-electric) .fc-arrow {
    color: #0a0a0a;
  }

  .fc-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px var(--electric);
    background: #000;
    color: #fff;
  }

  :global(body.theme-electric) .fc-btn:hover {
    box-shadow: 6px 6px 0px #ffffff;
  }

  .fc-btn:hover .fc-arrow {
    transform: translate(2px, -2px);
  }

  .fc-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px var(--electric);
  }

  @media (max-width: 600px) {
    .floating-contact {
      bottom: calc(16px + env(safe-area-inset-bottom));
      right: 16px;
    }
    .fc-extra {
      display: none;
    }
    .fc-btn {
      padding: 9px 13px;
      font-size: 10.5px;
      gap: 8px;
    }
  }
</style>
