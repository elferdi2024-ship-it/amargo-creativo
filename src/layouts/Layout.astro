---
// filepath: src/layouts/Layout.astro
import '../styles/global.css';
import '../styles/motion.css';
import Preloader from '../components/Preloader.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import ProjectModal from '../components/ProjectModal.astro';
import FloatingContact from '../components/FloatingContact.astro';
import { projects } from '../lib/projects';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  preloadHero?: boolean;
  includeFaqSchema?: boolean;
  includeShowcaseSchema?: boolean;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const SITE_URL = 'https://amargo-creativo.pages.dev';

const {
  title = 'Amargo Creativo™ | Diseño Web de Élite, Apps & SEO en Uruguay, Argentina y España',
  description = 'Agencia creativa de ingeniería web de alto rendimiento (<0.8s), aplicaciones a medida, SEO técnico y conversión directa a WhatsApp desde Atlántida, Uruguay para UY, AR y ES.',
  image = `${SITE_URL}/og-image.jpg`,
  canonicalUrl,
  preloadHero = false,
  includeFaqSchema = false,
  includeShowcaseSchema = false,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const resolvedCanonical =
  canonicalUrl ||
  new URL(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, ''), SITE_URL).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: `${SITE_URL}/`,
    name: 'Amargo Creativo',
    description: 'Diseño web de alto rendimiento (<0.8s), apps a medida y SEO técnico en Uruguay, Argentina y España.',
    inLanguage: 'es',
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@type': 'Person',
    '@id': `${SITE_URL}/#person`,
    name: 'Ferdi',
    jobTitle: 'Director Técnico & Software Performance Architect',
    worksFor: { '@id': `${SITE_URL}/#organization` },
    url: SITE_URL,
    image: `${SITE_URL}/amargo-isologo.jpg`,
    sameAs: [
      'https://www.instagram.com/amargocreativo',
      'https://github.com/elferdi2024',
    ],
    description:
      'Especialista en desarrollo web de alto rendimiento (<0.8s), arquitectura Astro 5 & Next.js 15, SEO técnico y embudos de conversión directa a WhatsApp.',
    knowsAbout: [
      'Desarrollo Web de Alto Rendimiento',
      'Astro 5 & Next.js 15',
      'Algolia SSR InstantSearch',
      'SEO Técnico & Local SEO',
      'Core Web Vitals',
      'Optimización de Conversiones (CRO)',
      'WhatsApp Commerce',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Atlántida',
      addressRegion: 'Canelones',
      addressCountry: 'UY',
    },
  },
  {
    '@type': ['Organization', 'ProfessionalService', 'LocalBusiness'],
    '@id': `${SITE_URL}/#organization`,
    name: 'Amargo Creativo',
    alternateName: ['Amargo Studio', 'Amargo Web', 'Amargo Creativo Digital'],
    url: SITE_URL,
    logo: `${SITE_URL}/amargo-isologo.jpg`,
    image,
    description,
    telephone: '+59898300491',
    email: 'amargo.creativo@gmail.com',
    priceRange: '$$',
    currenciesAccepted: 'UYU, ARS, USD, EUR',
    paymentAccepted: 'Transferencia Bancaria (BROU, Santander, Itaú), Mercado Pago, Stripe, Wise, Crypto',
    foundingDate: '2024',
    founder: { '@id': `${SITE_URL}/#person` },
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Atlántida, Costa de Oro',
      addressLocality: 'Atlántida',
      addressRegion: 'Canelones',
      postalCode: '16000',
      addressCountry: 'UY',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: -34.7719,
      longitude: -55.7594,
    },
    areaServed: [
      { '@type': 'Country', name: 'Uruguay' },
      { '@type': 'Country', name: 'Argentina' },
      { '@type': 'Country', name: 'España' },
    ],
    sameAs: ['https://www.instagram.com/amargocreativo'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de Ingeniería Web, Apps y Posicionamiento SEO',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Diseño y Creación de Páginas Web de Alto Rendimiento',
            description: 'Sitios web ultrarrápidos (<0.8s) mobile-first con conversión directa a WhatsApp.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Desarrollo de Aplicaciones Web y SaaS',
            description: 'Marketplaces, portales B2B, cotizadores inteligentes y software a medida en la nube.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Posicionamiento SEO Técnico & Motores IA',
            description: 'Core Web Vitals en verde, Schema.org estructurado y SEO multi-región UY/AR/ES.',
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'CRO & WhatsApp Commerce',
            description: 'Embudos comerciales sin fricción orientados a consultas calificadas por WhatsApp.',
          },
        },
      ],
    },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${resolvedCanonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: item.name,
      item: item.url,
    })),
  });
}

if (includeShowcaseSchema) {
  graph.push({
    '@type': 'ItemList',
    '@id': `${resolvedCanonical}#showcase`,
    name: 'Casos de Éxito y Proyectos Activos de Amargo Creativo',
    itemListElement: projects.map((p, i) => ({
      '@type': 'CreativeWork',
      position: i + 1,
      name: p.title,
      description: p.desc,
      url: p.url,
    })),
  });
}

if (includeFaqSchema) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${resolvedCanonical}#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: '¿Cuánto tiempo toma el desarrollo de mi web o app?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Una Landing Page de alta conversión o sitio corporativo toma entre 10 y 14 días hábiles. Proyectos complejos con paneles SaaS o e-commerce avanzados toman entre 3 y 5 semanas con cronograma cerrado.',
        },
      },
      {
        '@type': 'Question',
        name: '¿El sitio web y el código serán 100% de mi propiedad?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Sí, absolutamente. Todo el código fuente, diseño, dominio y cuentas quedan a tu nombre sin dependencias cautivas ni alquileres ocultos.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Cómo optimizan la web para posicionar en Google en Uruguay, Argentina y España?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Aplicamos SEO técnico nativo: carga sub-segundo (<0.8s), Core Web Vitals en verde, Schema.org multi-región y arquitectura semántica limpia.',
        },
      },
      {
        '@type': 'Question',
        name: '¿Qué formas de pago aceptan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Esquema 50% al inicio y 50% contra entrega final. Transferencias en Uruguay (BROU, Santander, Itaú), Argentina (Mercado Pago / transferencia), Stripe, Wise y crypto.',
        },
      },
    ],
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Amargo Creativo">
  <meta name="theme-color" content="#152e1a">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="canonical" href={resolvedCanonical}>
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>

  <!-- Geotargeting -->
  <meta name="geo.region" content="UY-CA">
  <meta name="geo.placename" content="Atlántida, Canelones, Uruguay">
  <meta name="geo.position" content="-34.7719;-55.7594">
  <meta name="ICBM" content="-34.7719, -55.7594">

  <!-- Hreflang Multi-regional (dynamic per page) -->
  {!noindex && (
    <>
      <link rel="alternate" hreflang="es-UY" href={resolvedCanonical} />
      <link rel="alternate" hreflang="es-AR" href={resolvedCanonical} />
      <link rel="alternate" hreflang="es-ES" href={resolvedCanonical} />
      <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />
    </>
  )}

  <!-- Open Graph / WhatsApp -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={resolvedCanonical}>
  <meta property="og:locale" content="es_UY">
  <meta property="og:locale:alternate" content="es_AR">
  <meta property="og:locale:alternate" content="es_ES">
  <meta property="og:site_name" content="Amargo Creativo">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:image:secure_url" content={image}>
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Amargo Creativo — Ingeniería Web de Alto Rendimiento en Uruguay, Argentina y España">

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>
  <meta name="twitter:image:alt" content="Amargo Creativo — Agencia Digital de Alto Rendimiento">

  <!-- Conditional LCP Hero Poster Preload (Home only, avoids bandwidth waste on subpages) -->
  {preloadHero && (
    <>
      <link rel="preload" as="image" href="/amargo-hero-mobile.webp" type="image/webp" media="(max-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="/amargo-hero-pc.webp" type="image/webp" media="(min-width: 769px)" fetchpriority="high">
    </>
  )}

  <!-- Structured Data JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Editorial Typography Pipeline (4 cohesive families, non-render-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap">
  </noscript>

  <script is:inline>
    (function() {
      try {
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var bot = /Lighthouse|PageSpeed|Chrome-Lighthouse|PTST|Googlebot/i.test(navigator.userAgent);
        if (!rm && !bot) {
          document.documentElement.classList.add('mx');
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    (function() {
      try {
        var saved = localStorage.getItem('amargo_theme') || 'default';
        document.documentElement.setAttribute('data-theme', saved);
        if (saved !== 'default') {
          document.documentElement.classList.add('theme-' + saved);
          var setBodyTheme = function() {
            if (document.body) {
              document.body.classList.remove('theme-default');
              document.body.classList.add('theme-' + saved);
            }
          };
          if (document.body) setBodyTheme();
          else document.addEventListener('DOMContentLoaded', setBodyTheme, { once: true });
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="theme-default">
  <a href="#main-content" class="skip-link">Saltar al contenido</a>
  <div class="grain" aria-hidden="true"></div>
  <Preloader />
  <CustomCursor />

  <slot />

  <ProjectModal />
  <ThemeSwitcher />
  <FloatingContact />
  <div id="amargoToast" class="amargo-toast" role="status" aria-live="polite"></div>

  <script>
    import Lenis from 'lenis';

    const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- 1. GLOBAL TOAST HELPER ---
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    function showToast(msg: string) {
      const el = document.getElementById('amargoToast');
      if (!el) return;
      el.textContent = msg;
      el.classList.add('is-shown');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove('is-shown'), 2400);
    }
    (window as any).amargoToast = showToast;

    // --- 2. SMOOTH SCROLL (LENIS DESKTOP + CLEAN FALLBACK) ---
    let lenisInstance: Lenis | null = null;
    if (isDesktop && !prefersReducedMotion) {
      try {
        lenisInstance = new Lenis({
          duration: 1.05,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 0.92,
        });
        function lenisRaf(time: number) {
          lenisInstance?.raf(time);
          requestAnimationFrame(lenisRaf);
        }
        requestAnimationFrame(lenisRaf);
      } catch (e) {
        console.warn('Lenis fallback', e);
      }
    }

    const fallbackLenis = {
      scrollTo: (target: any, opts: any = {}) => {
        const offset = opts.offset || 0;
        const behavior: ScrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';
        if (target === 0 || target === '#top') {
          window.scrollTo({ top: 0, behavior });
        } else if (typeof target === 'number') {
          window.scrollTo({ top: target + offset, behavior });
        } else if (target instanceof HTMLElement) {
          const top = target.getBoundingClientRect().top + window.scrollY + offset;
          window.scrollTo({ top, behavior });
        } else if (typeof target === 'string') {
          const el = document.querySelector(target);
          if (el) {
            const top = el.getBoundingClientRect().top + window.scrollY + offset;
            window.scrollTo({ top, behavior });
          }
        }
      },
      stop: () => document.body.classList.add('no-scroll'),
      start: () => document.body.classList.remove('no-scroll'),
      on: (event: string, cb: any) => {
        if (event === 'scroll') {
          window.addEventListener(
            'scroll',
            () => cb({ actualScroll: window.scrollY, velocity: 0 }),
            { passive: true }
          );
        }
      },
    };

    const lenis: any = lenisInstance || fallbackLenis;
    (window as any).lenis = lenis;

    // Anchor links
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (!href || href === '#' || href === '#!') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          if (href === '#top') {
            lenis.scrollTo(0, { duration: 1.1 });
          } else {
            lenis.scrollTo(target, { offset: -64, duration: 1.1 });
          }
        } else if (window.location.pathname !== '/' && window.location.pathname !== '') {
          e.preventDefault();
          window.location.href = '/' + href;
        }
      });
    });

    // Brand logo: scroll to top on home
    const brandBtn = document.getElementById('brandBtn');
    brandBtn?.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        lenis.scrollTo(0, { duration: 1.1 });
      }
    });

    // --- 3. EDITORIAL LERP CURSOR (IDLE-AWARE & CLEAN BOUNDARY) ---
    const cursor = document.getElementById('cursor');
    const cursorDot = document.getElementById('cursorDot');
    const cursorText = document.getElementById('cursorText');

    if (isDesktop && !prefersReducedMotion && cursor && cursorDot && cursorText) {
      document.body.classList.add('has-custom-cursor');
      let mouseX = -100, mouseY = -100;
      let cursorX = -100, cursorY = -100;
      let visible = false;
      let rafId = 0;

      const renderCursor = () => {
        rafId = 0;
        cursorDot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
        cursorX += (mouseX - cursorX) * 0.24;
        cursorY += (mouseY - cursorY) * 0.24;
        cursor.style.transform = `translate3d(${cursorX.toFixed(1)}px, ${cursorY.toFixed(1)}px, 0) translate(-50%, -50%)`;
        if (Math.abs(mouseX - cursorX) > 0.25 || Math.abs(mouseY - cursorY) > 0.25) {
          rafId = requestAnimationFrame(renderCursor);
        }
      };

      window.addEventListener(
        'mousemove',
        (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (!visible) {
            cursorX = mouseX;
            cursorY = mouseY;
            visible = true;
            cursor.classList.add('is-visible');
            cursorDot.classList.add('is-visible');
          }
          if (!rafId) rafId = requestAnimationFrame(renderCursor);
        },
        { passive: true }
      );

      document.addEventListener('mouseleave', () => {
        visible = false;
        cursor.classList.remove('is-visible', 'hover');
        cursorDot.classList.remove('is-visible');
      });

      const interactiveSelector =
        'a, button, [data-cursor], .cap-item, .project-card, .mi-card, .faq-trigger, .theme-dot';
      document.addEventListener('mouseover', (e) => {
        const hit = (e.target as HTMLElement | null)?.closest(interactiveSelector);
        if (hit) {
          cursor.classList.add('hover');
          cursorText.textContent = hit.getAttribute('data-cursor') || 'VER';
        } else {
          cursor.classList.remove('hover');
        }
      });
    }

    // --- 4. PHYSICS-BASED MAGNETIC BUTTONS ---
    if (isDesktop && !prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>('.magnetic-btn, #magneticEmailWrap, #magneticWaWrap').forEach((magEl) => {
        let mX = 0, mY = 0;
        let targetX = 0, targetY = 0;
        let isHovered = false;
        let magRaf: number | null = null;

        function renderMagnetic() {
          if (!isHovered && Math.abs(mX) < 0.05 && Math.abs(mY) < 0.05) {
            magEl.style.transform = 'translate3d(0,0,0)';
            magRaf = null;
            return;
          }
          mX += (targetX - mX) * 0.2;
          mY += (targetY - mY) * 0.2;
          magEl.style.transform = `translate3d(${mX.toFixed(2)}px, ${mY.toFixed(2)}px, 0)`;
          magRaf = requestAnimationFrame(renderMagnetic);
        }

        magEl.addEventListener(
          'mousemove',
          (e) => {
            isHovered = true;
            const rect = magEl.getBoundingClientRect();
            const strength = magEl.classList.contains('magnetic-btn') ? 0.28 : 0.36;
            targetX = (e.clientX - rect.left - rect.width / 2) * strength;
            targetY = (e.clientY - rect.top - rect.height / 2) * strength;
            if (!magRaf) magRaf = requestAnimationFrame(renderMagnetic);
          },
          { passive: true }
        );

        magEl.addEventListener('mouseleave', () => {
          isHovered = false;
          targetX = 0;
          targetY = 0;
          if (!magRaf) magRaf = requestAnimationFrame(renderMagnetic);
        });
      });
    }

    // --- 5. WORD-MASK SPLITTER & SCROLL REVEAL ENGINE ---
    function splitWordsForReveal(el: HTMLElement) {
      if (el.classList.contains('is-split')) return;
      const plain = el.textContent?.trim();
      if (plain && !el.getAttribute('aria-label')) {
        el.setAttribute('aria-label', plain);
      }
      let wordIdx = 0;

      function walk(node: Node) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent || '';
          if (!text.trim()) return;
          const frag = document.createDocumentFragment();
          const parts = text.split(/(\s+)/);
          parts.forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) {
              frag.appendChild(document.createTextNode(part));
            } else {
              const wrap = document.createElement('span');
              wrap.className = 'hw';
              wrap.setAttribute('aria-hidden', 'true');
              const inner = document.createElement('span');
              inner.className = 'hwi';
              inner.style.setProperty('--i', String(wordIdx++));
              inner.textContent = part;
              wrap.appendChild(inner);
              frag.appendChild(wrap);
            }
          });
          node.parentNode?.replaceChild(frag, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const childNodes = Array.from(node.childNodes);
          childNodes.forEach(walk);
        }
      }

      walk(el);
      el.classList.add('is-split');
    }

    if (document.documentElement.classList.contains('mx') && !prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>('[data-reveal-words]').forEach(splitWordsForReveal);
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
    );

    document
      .querySelectorAll('.manifesto-body, .manifesto-body .line, .projects-drag, .process-item, [data-reveal-words], [data-reveal-block]')
      .forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.96 && rect.bottom > 0) {
          el.classList.add('is-in');
        } else {
          revealObserver.observe(el);
        }
      });

    // --- 6. SHOWCASE FILTERS, DRAG & CAROUSEL CONTROLS ---
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        projectCards.forEach((card) => {
          if (card.classList.contains('see-all-card')) return;
          const category = card.getAttribute('data-category');
          card.classList.toggle('hidden', filter !== 'all' && category !== filter);
        });

        const dragEl = document.getElementById('projectsDrag');
        if (dragEl) dragEl.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });

    const drag = document.getElementById('projectsDrag');
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let dragMoved = false;

    if (drag) {
      const progressBar = document.getElementById('showcaseProgressFill');
      const prevBtn = document.getElementById('showcasePrev');
      const nextBtn = document.getElementById('showcaseNext');

      const updateCarouselProgress = () => {
        if (!progressBar) return;
        const maxScroll = Math.max(1, drag.scrollWidth - drag.clientWidth);
        const ratio = Math.min(1, Math.max(0.08, (drag.scrollLeft / maxScroll) * 0.92 + 0.08));
        progressBar.style.transform = `scaleX(${ratio.toFixed(3)})`;
      };

      drag.addEventListener('scroll', updateCarouselProgress, { passive: true });
      window.addEventListener('resize', updateCarouselProgress, { passive: true });
      updateCarouselProgress();

      const slideBy = (dir: number) => {
        const card = drag.querySelector<HTMLElement>('.project-card:not(.hidden)');
        const step = (card?.offsetWidth || 420) + 24;
        drag.scrollBy({ left: dir * step, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
      };

      prevBtn?.addEventListener('click', () => slideBy(-1));
      nextBtn?.addEventListener('click', () => slideBy(1));

      drag.addEventListener('mousedown', (e) => {
        isDown = true;
        dragMoved = false;
        drag.classList.add('active');
        startX = e.pageX - drag.offsetLeft;
        scrollLeft = drag.scrollLeft;
      });

      const stopDrag = () => {
        if (!isDown) return;
        isDown = false;
        drag.classList.remove('active');
      };

      drag.addEventListener('mouseleave', stopDrag);
      drag.addEventListener('mouseup', stopDrag);
      drag.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - drag.offsetLeft;
        if (Math.abs(x - startX) > 6) dragMoved = true;
        drag.scrollLeft = scrollLeft - (x - startX) * 1.4;
      });
    }

    // --- 7. ENRICHED PROJECT MODAL (FOCUS MANAGEMENT + ARCHITECTURAL SPECS) ---
    const modalOverlay = document.getElementById('modalOverlay');
    const modalClose = document.getElementById('modalClose');
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalKicker = document.getElementById('modalKicker');
    const modalResult = document.getElementById('modalResult');
    const modalSpeed = document.getElementById('modalSpeed');
    const modalPerf = document.getElementById('modalPerf');
    const modalTags = document.getElementById('modalTags');
    const modalLink = document.getElementById('modalLink') as HTMLAnchorElement | null;
    const modalWa = document.getElementById('modalWa') as HTMLAnchorElement | null;
    const modalImg = document.getElementById('modalImg') as HTMLImageElement | null;
    let lastFocusedBeforeModal: HTMLElement | null = null;

    document.querySelectorAll<HTMLElement>('.project-card[data-title]').forEach((card) => {
      const openCardModal = (e: Event) => {
        if (dragMoved) {
          e.preventDefault();
          dragMoved = false;
          return;
        }
        e.preventDefault();
        lastFocusedBeforeModal = document.activeElement as HTMLElement | null;
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const url = card.getAttribute('data-url') || '#';
        const img = card.getAttribute('data-img') || '';
        const kicker = card.getAttribute('data-kicker') || 'CASO DE ÉXITO';
        const result = card.getAttribute('data-result') || '';
        const speed = card.getAttribute('data-speed') || '';
        const perf = card.getAttribute('data-perf') || '99';
        const tagsRaw = card.getAttribute('data-tags') || '';

        if (modalTitle) modalTitle.textContent = title;
        if (modalDesc) modalDesc.textContent = desc;
        if (modalKicker) modalKicker.textContent = kicker;
        if (modalResult) modalResult.textContent = result;
        if (modalSpeed) modalSpeed.textContent = speed;
        if (modalPerf) modalPerf.textContent = `${perf}/100`;
        if (modalLink) modalLink.href = url;
        if (modalWa) {
          modalWa.href = `https://wa.me/59898300491?text=${encodeURIComponent(
            `Hola Amargo Creativo, vi el caso ${title} y quiero cotizar un proyecto similar`
          )}`;
        }
        if (modalImg) {
          modalImg.src = img;
          modalImg.alt = `Vista previa en producción de ${title}`;
        }
        if (modalTags) {
          modalTags.innerHTML = tagsRaw
            .split('|')
            .filter(Boolean)
            .map((t) => `<span class="modal-tag">${t}</span>`)
            .join('');
        }

        if (modalOverlay) {
          modalOverlay.classList.add('active');
          modalOverlay.setAttribute('aria-hidden', 'false');
        }
        lenis.stop();
        setTimeout(() => modalClose?.focus({ preventScroll: true }), 120);
      };

      card.addEventListener('click', openCardModal);
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          openCardModal(e);
        }
      });
    });

    function closeModal() {
      if (!modalOverlay) return;
      modalOverlay.classList.remove('active');
      modalOverlay.setAttribute('aria-hidden', 'true');
      lenis.start();
      lastFocusedBeforeModal?.focus({ preventScroll: true });
    }

    modalClose?.addEventListener('click', closeModal);
    modalOverlay?.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalOverlay?.classList.contains('active')) {
        closeModal();
      }
    });

    // --- 8. FAQ ACCORDION ---
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger');
      trigger?.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        faqItems.forEach((other) => {
          other.classList.remove('active');
          other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
        });
        if (!isActive) {
          item.classList.add('active');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // --- 9. PROCESS SPOTLIGHT ---
    const processList = document.getElementById('processList');
    const spotlight = document.getElementById('spotlight');
    if (processList && spotlight && isDesktop && !prefersReducedMotion) {
      let pRect: DOMRect | null = null;
      processList.addEventListener('mouseenter', () => {
        pRect = processList.getBoundingClientRect();
        spotlight.style.opacity = '1';
      });
      processList.addEventListener(
        'mousemove',
        (e) => {
          if (!pRect) pRect = processList.getBoundingClientRect();
          const y = e.clientY - pRect.top;
          spotlight.style.transform = `translate3d(0, ${(y - 100).toFixed(1)}px, 0)`;
        },
        { passive: true }
      );
      processList.addEventListener('mouseleave', () => {
        spotlight.style.opacity = '0';
        pRect = null;
      });
    }

    // --- 10. IMAGE FADE-IN ---
    document.querySelectorAll<HTMLImageElement>('.pc-img').forEach((imageEl) => {
      if (imageEl.complete) imageEl.classList.add('loaded');
      else imageEl.addEventListener('load', () => imageEl.classList.add('loaded'), { once: true });
    });

    // --- 11. REALTIME URUGUAY CLOCK ---
    const clockUY = document.getElementById('clockUY');
    if (clockUY) {
      const uyFormatter = new Intl.DateTimeFormat('es-UY', {
        timeZone: 'America/Montevideo',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      const updateClocks = () => {
        clockUY.textContent = uyFormatter.format(new Date());
      };
      setInterval(updateClocks, 1000);
      updateClocks();
    }

    // --- 12. ZERO-KB TACTILE AUDIO ENGINE (OPT-IN) ---
    class StudioSoundEngine {
      private ctx: AudioContext | null = null;
      private isMuted = true;

      constructor() {
        const saved = typeof localStorage !== 'undefined' ? localStorage.getItem('amargo_audio') : null;
        this.isMuted = saved !== 'true';
        this.updateButtons();
        this.bindEvents();
      }

      private initCtx() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
      }

      public toggle(): boolean {
        this.isMuted = !this.isMuted;
        try {
          localStorage.setItem('amargo_audio', (!this.isMuted).toString());
        } catch {}
        this.updateButtons();
        if (!this.isMuted) this.playClick(950, 0.035, 'triangle');
        return !this.isMuted;
      }

      public playClick(freq = 1100, duration = 0.02, type: OscillatorType = 'triangle') {
        if (this.isMuted) return;
        try {
          this.initCtx();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(80, this.ctx.currentTime + duration);
          gain.gain.setValueAtTime(0.03, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch {}
      }

      public playTick() {
        if (this.isMuted) return;
        try {
          this.initCtx();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1400, this.ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(400, this.ctx.currentTime + 0.012);
          gain.gain.setValueAtTime(0.014, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + 0.012);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + 0.012);
        } catch {}
      }

      private updateButtons() {
        document.querySelectorAll('.sound-toggle-btn').forEach((btn) => {
          btn.classList.toggle('active', !this.isMuted);
          btn.setAttribute('aria-pressed', (!this.isMuted).toString());
          const stateEl = btn.querySelector('.sound-state-text');
          if (stateEl) stateEl.textContent = this.isMuted ? 'OFF' : 'ON';
        });
      }

      private bindEvents() {
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement)?.closest('button, a, .tactile-card, .theme-dot, .client-tab-btn');
          if (!target) return;
          if (target.classList.contains('sound-toggle-btn')) {
            e.preventDefault();
            this.toggle();
          } else {
            this.playClick(900, 0.022, 'triangle');
          }
        });

        if (isDesktop) {
          document.querySelectorAll('a, button, .cap-item, .project-card').forEach((el) => {
            el.addEventListener('mouseenter', () => this.playTick(), { passive: true });
          });
        }
      }
    }

    (window as any).soundEngine = new StudioSoundEngine();
  </script>
</body>
</html>
