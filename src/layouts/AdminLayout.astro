---
// filepath: src/layouts/AdminLayout.astro
export const prerender = false;

import { isAuthenticated } from "../lib/auth";

const authed = await isAuthenticated(Astro.cookies, Astro.request);
if (!authed) {
  const currentPath = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/admin/login?redirect=${encodeURIComponent(currentPath)}`);
}

interface Props {
  title: string;
  activeSection?: "dashboard" | "proposals" | "clients" | "projects" | "content" | "pipeline" | "documents" | "templates" | "contracts" | "finanzas" | "automatizaciones";
}

const { title, activeSection = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Admin Amargo Creativo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="admin-app">
      <!-- MOBILE BACKDROP -->
      <div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

      <!-- SIDEBAR / MOBILE DRAWER -->
      <aside id="admin-sidebar" class="sidebar">
        <div class="sidebar-header">
          <div class="brand-group">
            <a href="/admin" class="brand">AMARGO.</a>
            <span class="badge">ADMIN</span>
          </div>
          <!-- Close button on mobile -->
          <button id="sidebar-close-btn" class="sidebar-close-btn" aria-label="Cerrar menú">
            ✕
          </button>
        </div>

        <nav class="nav-menu">
          <div class="nav-group-label">COMERCIAL & CLIENTES</div>
          <a href="/admin" class={`nav-item ${activeSection === "dashboard" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/pipeline" class={`nav-item ${activeSection === "pipeline" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Pipeline Visual</span>
          </a>
          <a href="/admin/proposals" class={`nav-item ${activeSection === "proposals" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>Propuestas</span>
          </a>
          <a href="/admin/plantillas-propuestas" class={`nav-item ${Astro.url.pathname.includes("plantillas-propuestas") ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
            <span>Plantillas Propuesta</span>
          </a>
          <a href="/admin/clients" class={`nav-item ${activeSection === "clients" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Clientes</span>
          </a>

          <div class="nav-group-label">FINANZAS & COBROS (UY)</div>
          <a href="/admin/finanzas" class={`nav-item ${activeSection === "finanzas" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span>Finanzas & Facturas</span>
          </a>

          <div class="nav-group-label">PRODUCCIÓN & MARKETING</div>
          <a href="/admin/projects" class={`nav-item ${activeSection === "projects" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            <span>Proyectos</span>
          </a>
          <a href="/admin/contenido" class={`nav-item ${activeSection === "content" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
            <span>Content Engine</span>
          </a>

          <div class="nav-group-label">ACTIVOS, LEGAL & AUTO</div>
          <a href="/admin/documents" class={`nav-item ${activeSection === "documents" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            <span>Documentos</span>
          </a>
          <a href="/admin/templates" class={`nav-item ${activeSection === "templates" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            <span>Plantillas Contrato</span>
          </a>
          <a href="/admin/contracts" class={`nav-item ${activeSection === "contracts" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
            <span>Generar Contrato</span>
          </a>
          <a href="/admin/automatizaciones" class={`nav-item ${activeSection === "automatizaciones" ? "active" : ""}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <span>Automatizaciones</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <a href="/" target="_blank" class="footer-link">
            <span>Ver sitio público</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
          <button id="logout-btn" class="logout-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Cerrar sesión</span>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT WRAPPER -->
      <div class="main-wrapper">
        <!-- TOP NAV BAR -->
        <header class="top-nav">
          <div class="header-left">
            <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Abrir menú">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <h1 class="page-title">{title}</h1>
          </div>
          <div class="header-right">
            <slot name="header-actions">
              <a href="/admin/proposals/new" class="btn-primary-sm">
                <span>+ Propuesta</span>
              </a>
            </slot>
          </div>
        </header>

        <!-- PAGE BODY -->
        <main class="page-body">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const sidebar = document.getElementById("admin-sidebar");
      const backdrop = document.getElementById("mobile-backdrop");
      const menuBtn = document.getElementById("mobile-menu-btn");
      const closeBtn = document.getElementById("sidebar-close-btn");
      const logoutBtn = document.getElementById("logout-btn");

      function openMenu() {
        sidebar?.classList.add("open");
        backdrop?.classList.add("open");
        document.body.style.overflow = "hidden";
      }

      function closeMenu() {
        sidebar?.classList.remove("open");
        backdrop?.classList.remove("open");
        document.body.style.overflow = "";
      }

      menuBtn?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", closeMenu);
      backdrop?.addEventListener("click", closeMenu);

      logoutBtn?.addEventListener("click", async () => {
        try {
          await fetch("/api/admin/auth", { method: "DELETE" });
          window.location.href = "/admin/login";
        } catch {
          window.location.href = "/admin/login";
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --adm-bg: #0E1611;
    --adm-sidebar: #141E18;
    --adm-card: #18261E;
    --adm-card-hover: #1E3026;
    --adm-ink: #F4F6F2;
    --adm-mute: #85968B;
    --adm-mate: #3A7D44;
    --adm-mate-light: #97BC62;
    --adm-lime: #C8FF00;
    --adm-border: #24352A;
    --adm-border-light: #32473A;
    --adm-danger: #EF4444;
    --adm-warning: #F59E0B;
    --adm-success: #10B981;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--adm-bg);
    color: var(--adm-ink);
    font-family: "Archivo", system-ui, -apple-system, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .admin-app {
    display: flex;
    min-height: 100vh;
    width: 100%;
  }

  /* Mobile Backdrop */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    z-index: 99;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-backdrop.open {
    display: block;
    opacity: 1;
  }

  /* Sidebar */
  .sidebar {
    width: 260px;
    background: var(--adm-sidebar);
    border-right: 1px solid var(--adm-border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 100;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar-header {
    padding: 1.25rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--adm-border);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
    color: var(--adm-ink);
    text-decoration: none;
  }

  .badge {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    padding: 0.2rem 0.45rem;
    background: rgba(200, 255, 0, 0.15);
    color: var(--adm-lime);
    border-radius: 4px;
    font-weight: 700;
  }

  .sidebar-close-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--adm-mute);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }

  .nav-menu {
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-group-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--adm-mute);
    padding: 0.75rem 0.5rem 0.25rem;
    font-weight: 600;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    color: var(--adm-mute);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--adm-ink);
  }

  .nav-item.active {
    background: var(--adm-card);
    color: var(--adm-lime);
    font-weight: 700;
    border: 1px solid var(--adm-border);
  }

  .sidebar-footer {
    padding: 1rem 0.75rem;
    border-top: 1px solid var(--adm-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    color: var(--adm-mute);
    text-decoration: none;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--adm-ink);
  }

  .logout-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: none;
    color: var(--adm-mute);
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    border-radius: 6px;
    width: 100%;
    text-align: left;
    transition: all 0.15s ease;
  }

  .logout-btn:hover {
    color: var(--adm-danger);
    background: rgba(239, 68, 68, 0.1);
  }

  /* Main Area */
  .main-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--adm-border);
    background: rgba(14, 22, 17, 0.9);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 20;
    gap: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--adm-ink);
    padding: 0.35rem;
    cursor: pointer;
    border-radius: 6px;
  }

  .page-title {
    font-size: clamp(1.05rem, 3.5vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--adm-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-right {
    flex-shrink: 0;
  }

  .page-body {
    padding: clamp(1rem, 3vw, 2rem);
    flex: 1;
    width: 100%;
    max-width: 100%;
  }

  /* Global Admin Component Styles */
  .btn-primary-sm {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--adm-lime);
    color: #141E18;
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.82rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-primary-sm:hover {
    background: #b5e600;
    transform: translateY(-1px);
  }

  .btn-outline-sm {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    color: var(--adm-ink);
    border: 1px solid var(--adm-border);
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.82rem;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .btn-outline-sm:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--adm-ink);
  }

  .card-box {
    background: var(--adm-card);
    border: 1px solid var(--adm-border);
    border-radius: 12px;
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  /* Tables */
  .adm-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--adm-border);
    border-radius: 10px;
    background: var(--adm-card);
    max-width: 100%;
  }

  .adm-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .adm-table th {
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--adm-border);
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--adm-mute);
    background: rgba(0, 0, 0, 0.2);
  }

  .adm-table td {
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--adm-border);
    color: var(--adm-ink);
  }

  .adm-table tr:last-child td {
    border-bottom: none;
  }

  .adm-table tr:hover td {
    background: var(--adm-card-hover);
  }

  /* Status Badges */
  .badge-status {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
    white-space: nowrap;
  }

  .status-draft { background: rgba(133, 150, 139, 0.15); color: #B2C0B8; border: 1px solid #33473B; }
  .status-issued { background: rgba(59, 130, 246, 0.15); color: #60A5FA; border: 1px solid rgba(59, 130, 246, 0.3); }
  .status-sent { background: rgba(99, 102, 241, 0.15); color: #818CF8; border: 1px solid rgba(99, 102, 241, 0.3); }
  .status-active { background: rgba(151, 188, 98, 0.15); color: #97BC62; border: 1px solid rgba(151, 188, 98, 0.3); }
  .status-accepted { background: rgba(200, 255, 0, 0.18); color: var(--adm-lime); border: 1px solid rgba(200, 255, 0, 0.4); }
  .status-paid { background: rgba(16, 185, 129, 0.18); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.4); }
  .status-partial { background: rgba(245, 158, 11, 0.18); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.4); }
  .status-overdue { background: rgba(239, 68, 68, 0.18); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.4); }
  .status-rejected { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .status-disabled { background: rgba(100, 116, 139, 0.15); color: #94A3B8; border: 1px solid rgba(100, 116, 139, 0.3); }
  .status-finished { background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .status-paused { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }
  .status-published { background: rgba(200, 255, 0, 0.2); color: var(--adm-lime); border: 1px solid var(--adm-lime); }
  .status-archived { background: rgba(100, 116, 139, 0.15); color: #94A3B8; border: 1px solid rgba(100, 116, 139, 0.3); }

  /* RESPONSIVE MOBILE OVERHAUL (< 900px) */
  @media (max-width: 900px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      height: 100vh;
      transform: translateX(-100%);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.5);
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .sidebar-close-btn {
      display: block;
    }

    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .top-nav {
      padding: 0.85rem 1rem;
    }
  }
</style>
