---
// filepath: src/layouts/AdminLayout.astro
export const prerender = false;

import { isAuthenticated } from "../lib/auth";

const runtimeEnv = (Astro.locals as { runtime?: { env?: Record<string, string> } })?.runtime?.env || {};
const authed = await isAuthenticated(Astro.cookies, Astro.request, runtimeEnv.ADMIN_SESSION_SECRET);
if (!authed) {
  const currentPath = Astro.url.pathname + Astro.url.search;
  return Astro.redirect(`/admin/login?redirect=${encodeURIComponent(currentPath)}`);
}

interface Props {
  title: string;
  activeSection?: "dashboard" | "proposals" | "clients" | "projects" | "content" | "pipeline" | "documents" | "templates" | "contracts" | "finanzas" | "automatizaciones" | "seguridad";
}

const { title, activeSection = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Amargo Studio OS</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0c120e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="admin-app">
      <!-- MOBILE BACKDROP -->
      <div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

      <!-- SIDEBAR / MOBILE DRAWER -->
      <aside id="admin-sidebar" class="sidebar" aria-label="Navegación principal">
        <div class="sidebar-header">
          <div class="brand-group">
            <a href="/admin" class="brand">AMARGO.</a>
            <span class="badge">OS v2</span>
          </div>
          <button id="sidebar-close-btn" class="sidebar-close-btn" type="button" aria-label="Cerrar menú">
            ✕
          </button>
        </div>

        <nav class="nav-menu">
          <div class="nav-group-label">COMERCIAL &amp; CLIENTES</div>
          <a href="/admin" class={`nav-item ${activeSection === "dashboard" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>
            <span>Dashboard</span>
          </a>
          <a href="/admin/pipeline" class={`nav-item ${activeSection === "pipeline" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Pipeline Kanban</span>
          </a>
          <a href="/admin/proposals" class={`nav-item ${activeSection === "proposals" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>Propuestas</span>
          </a>
          <a href="/admin/plantillas-propuestas" class={`nav-item ${Astro.url.pathname.includes("plantillas-propuestas") ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect></svg>
            <span>Plantillas</span>
          </a>
          <a href="/admin/clients" class={`nav-item ${activeSection === "clients" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Clientes</span>
          </a>

          <div class="nav-group-label">FINANZAS &amp; CFE (UY)</div>
          <a href="/admin/finanzas" class={`nav-item ${activeSection === "finanzas" && !Astro.url.pathname.includes("configuracion") ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span>Finanzas &amp; Facturas</span>
          </a>
          <a href="/admin/finanzas/configuracion" class={`nav-item ${Astro.url.pathname.includes("finanzas/configuracion") ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Configuración CFE</span>
          </a>

          <div class="nav-group-label">PRODUCCIÓN &amp; IA</div>
          <a href="/admin/projects" class={`nav-item ${activeSection === "projects" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            <span>Proyectos</span>
          </a>
          <a href="/admin/contenido" class={`nav-item ${activeSection === "content" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
            <span>Content Engine IA</span>
          </a>

          <div class="nav-group-label">ACTIVOS, LEGAL &amp; AUTO</div>
          <a href="/admin/documents" class={`nav-item ${activeSection === "documents" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            <span>Documentos</span>
          </a>
          <a href="/admin/templates" class={`nav-item ${activeSection === "templates" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
            <span>Plantillas Contrato</span>
          </a>
          <a href="/admin/contracts" class={`nav-item ${activeSection === "contracts" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
            <span>Generar Contrato</span>
          </a>
          <a href="/admin/automatizaciones" class={`nav-item ${activeSection === "automatizaciones" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <span>Automatizaciones</span>
          </a>
          <a href="/admin/seguridad" class={`nav-item ${activeSection === "seguridad" ? "active" : ""}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Seguridad &amp; 2FA</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <a href="/" target="_blank" rel="noopener noreferrer" class="footer-link">
            <span>Sitio público</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
          <button id="logout-btn" class="logout-btn" type="button">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Cerrar sesión</span>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT WRAPPER -->
      <div class="main-wrapper">
        <header class="top-nav">
          <div class="header-left">
            <button id="mobile-menu-btn" class="mobile-menu-btn" type="button" aria-label="Abrir menú">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="3" y1="7" x2="21" y2="7"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="17" x2="21" y2="17"></line>
              </svg>
            </button>
            <h1 class="page-title">{title}</h1>
          </div>

          <div class="header-right">
            <button id="cmd-palette-trigger" class="cmd-trigger-btn" type="button" aria-label="Buscar o ejecutar comando (Ctrl+K)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span class="cmd-trigger-text">Buscar en Studio OS...</span>
              <kbd class="cmd-kbd">⌘K</kbd>
            </button>
            <slot name="header-actions">
              <a href="/admin/proposals/new" class="btn-primary-sm">
                <span>+ Propuesta</span>
              </a>
            </slot>
          </div>
        </header>

        <main class="page-body">
          <slot />
        </main>
      </div>
    </div>

    <!-- MOBILE BOTTOM DOCK (<= 900px) -->
    <nav class="mobile-bottom-dock" aria-label="Accesos rápidos móvil">
      <a href="/admin" class={`dock-item ${activeSection === "dashboard" ? "active" : ""}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect></svg>
        <span>Inicio</span>
      </a>
      <a href="/admin/pipeline" class={`dock-item ${activeSection === "pipeline" ? "active" : ""}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
        <span>Pipeline</span>
      </a>
      <a href="/admin/proposals" class={`dock-item ${activeSection === "proposals" ? "active" : ""}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        <span>Propuestas</span>
      </a>
      <a href="/admin/finanzas" class={`dock-item ${activeSection === "finanzas" ? "active" : ""}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        <span>Finanzas</span>
      </a>
      <button type="button" id="dock-menu-btn" class="dock-item">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
        <span>Más</span>
      </button>
    </nav>

    <!-- COMMAND PALETTE MODAL (⌘K / Ctrl+K) -->
    <div id="cmd-palette-overlay" class="cmd-overlay" aria-hidden="true">
      <div class="cmd-dialog" role="dialog" aria-modal="true" aria-label="Búsqueda rápida de Studio OS">
        <div class="cmd-input-row">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input id="cmd-input" type="text" placeholder="Buscar cliente, propuesta, proyecto, factura o acción..." autocomplete="off" />
          <button type="button" id="cmd-close" class="cmd-esc">ESC</button>
        </div>
        <div id="cmd-results" class="cmd-results" role="listbox"></div>
        <div class="cmd-footer">
          <span>↑↓ Navegar</span>
          <span>↵ Abrir</span>
          <span>ESC Cerrar</span>
        </div>
      </div>
    </div>

    <!-- GLOBAL ADMIN TOAST -->
    <div id="admin-toast" class="admin-toast" role="status" aria-live="polite"></div>

    <script>
      const sidebar = document.getElementById("admin-sidebar");
      const backdrop = document.getElementById("mobile-backdrop");
      const menuBtn = document.getElementById("mobile-menu-btn");
      const dockMenuBtn = document.getElementById("dock-menu-btn");
      const closeBtn = document.getElementById("sidebar-close-btn");
      const logoutBtn = document.getElementById("logout-btn");

      const haptic = () => {
        if ("vibrate" in navigator) {
          try { navigator.vibrate(8); } catch {}
        }
      };

      // Global Admin Toast helper
      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function showAdminToast(message: string, variant: "success" | "error" | "info" = "success") {
        const el = document.getElementById("admin-toast");
        if (!el) return;
        el.textContent = message;
        el.className = `admin-toast is-visible toast-${variant}`;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.remove("is-visible"), 3000);
      }
      (window as unknown as { adminToast?: typeof showAdminToast }).adminToast = showAdminToast;

      function openMenu() {
        sidebar?.classList.add("open");
        backdrop?.classList.add("open");
        document.body.style.overflow = "hidden";
        haptic();
      }

      function closeMenu() {
        sidebar?.classList.remove("open");
        backdrop?.classList.remove("open");
        document.body.style.overflow = "";
      }

      menuBtn?.addEventListener("click", openMenu);
      dockMenuBtn?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", closeMenu);
      backdrop?.addEventListener("click", closeMenu);

      logoutBtn?.addEventListener("click", async () => {
        try {
          await fetch("/api/admin/auth", { method: "DELETE" });
        } finally {
          window.location.href = "/admin/login";
        }
      });

      // ---- COMMAND PALETTE (⌘K / Ctrl+K) ----
      const cmdOverlay = document.getElementById("cmd-palette-overlay");
      const cmdTrigger = document.getElementById("cmd-palette-trigger");
      const cmdClose = document.getElementById("cmd-close");
      const cmdInput = document.getElementById("cmd-input") as HTMLInputElement | null;
      const cmdResults = document.getElementById("cmd-results");

      const QUICK_COMMANDS = [
        { title: "+ Nueva Propuesta Comercial", subtitle: "Crear Magic Link interactivo", href: "/admin/proposals/new", badge: "ACCIÓN" },
        { title: "+ Nueva Factura CFE (UY)", subtitle: "Emitir comprobante fiscal", href: "/admin/finanzas/facturas/nueva", badge: "ACCIÓN" },
        { title: "Pipeline Visual Kanban", subtitle: "Embudo de ventas y etapas", href: "/admin/pipeline", badge: "MÓDULO" },
        { title: "Finanzas & Facturas", subtitle: "KPIs USD/UYU, IVA 22% y cobros", href: "/admin/finanzas", badge: "MÓDULO" },
        { title: "Content Engine IA", subtitle: "Posts y casos de estudio", href: "/admin/contenido", badge: "MÓDULO" },
        { title: "Automatizaciones & Webhooks", subtitle: "Cola WhatsApp y webhooks n8n", href: "/admin/automatizaciones", badge: "MÓDULO" },
        { title: "Seguridad & Google Authenticator 2FA", subtitle: "Generar QR TOTP y estado de entorno", href: "/admin/seguridad", badge: "2FA" },
        { title: "Directorio de Clientes", subtitle: "CRM y contactos WhatsApp", href: "/admin/clients", badge: "MÓDULO" },
        { title: "Generar Contrato Legal", subtitle: "Plantillas y firma", href: "/admin/contracts", badge: "MÓDULO" },
      ];

      interface CmdItem {
        title: string;
        subtitle: string;
        href: string;
        badge?: string;
      }

      let currentItems: CmdItem[] = [...QUICK_COMMANDS];
      let activeIndex = 0;
      let searchDebounce: ReturnType<typeof setTimeout> | undefined;

      function renderCmdItems(items: CmdItem[]) {
        if (!cmdResults) return;
        currentItems = items;
        activeIndex = 0;
        if (items.length === 0) {
          cmdResults.innerHTML = `<div class="cmd-empty">Sin resultados para esa búsqueda.</div>`;
          return;
        }
        cmdResults.innerHTML = items
          .map(
            (item, idx) => `
            <a href="${item.href}" class="cmd-item ${idx === 0 ? "is-selected" : ""}" data-idx="${idx}" role="option">
              <div class="cmd-item-main">
                <strong>${item.title}</strong>
                <span>${item.subtitle}</span>
              </div>
              ${item.badge ? `<span class="cmd-item-badge">${item.badge}</span>` : ""}
            </a>`
          )
          .join("");
      }

      function updateSelection(newIdx: number) {
        if (!cmdResults || currentItems.length === 0) return;
        activeIndex = (newIdx + currentItems.length) % currentItems.length;
        cmdResults.querySelectorAll(".cmd-item").forEach((el, idx) => {
          el.classList.toggle("is-selected", idx === activeIndex);
          if (idx === activeIndex) el.scrollIntoView({ block: "nearest" });
        });
      }

      async function queryStudio(q: string) {
        const clean = q.trim().toLowerCase();
        const localMatches = QUICK_COMMANDS.filter(
          (c) => !clean || `${c.title} ${c.subtitle}`.toLowerCase().includes(clean)
        );
        renderCmdItems(localMatches);

        try {
          const res = await fetch(`/api/admin/search?q=${encodeURIComponent(q.trim())}`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.ok && Array.isArray(data.results)) {
            const combined = clean ? [...data.results, ...localMatches] : [...localMatches.slice(0, 4), ...data.results.slice(0, 8)];
            renderCmdItems(combined);
          }
        } catch {}
      }

      function openCmdPalette() {
        if (!cmdOverlay) return;
        cmdOverlay.classList.add("open");
        cmdOverlay.setAttribute("aria-hidden", "false");
        if (cmdInput) {
          cmdInput.value = "";
          setTimeout(() => cmdInput.focus(), 40);
        }
        queryStudio("");
        haptic();
      }

      function closeCmdPalette() {
        if (!cmdOverlay) return;
        cmdOverlay.classList.remove("open");
        cmdOverlay.setAttribute("aria-hidden", "true");
      }

      cmdTrigger?.addEventListener("click", openCmdPalette);
      cmdClose?.addEventListener("click", closeCmdPalette);
      cmdOverlay?.addEventListener("click", (e) => {
        if (e.target === cmdOverlay) closeCmdPalette();
      });

      cmdInput?.addEventListener("input", () => {
        clearTimeout(searchDebounce);
        const val = cmdInput.value;
        searchDebounce = setTimeout(() => queryStudio(val), 140);
      });

      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (cmdOverlay?.classList.contains("open")) closeCmdPalette();
          else openCmdPalette();
          return;
        }

        if (!cmdOverlay?.classList.contains("open")) {
          if (e.key === "Escape") closeMenu();
          return;
        }

        if (e.key === "Escape") {
          e.preventDefault();
          closeCmdPalette();
        } else if (e.key === "ArrowDown") {
          e.preventDefault();
          updateSelection(activeIndex + 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          updateSelection(activeIndex - 1);
        } else if (e.key === "Enter" && currentItems[activeIndex]) {
          e.preventDefault();
          window.location.href = currentItems[activeIndex].href;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --adm-bg: #0b110d;
    --adm-sidebar: #101813;
    --adm-card: #152119;
    --adm-card-hover: #1b2a20;
    --adm-ink: #f4f6f2;
    --adm-mute: #889b8e;
    --adm-mate: #2f6f3c;
    --adm-mate-light: #97bc62;
